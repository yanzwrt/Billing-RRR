const { Client } = require('ssh2');
const net = require('net');
const { logger } = require('../config/logger');
const { getSetting } = require('../config/settingsManager');

function sanitizeCliInput(val) {
  if (val === undefined || val === null) return '';
  return String(val).replace(/[\r\n]+/g, ' ').trim();
}

function sanitizeParams(params) {
  const clean = {};
  if (!params || typeof params !== 'object') return clean;
  for (const k of Object.keys(params)) {
    clean[k] = typeof params[k] === 'string'
      ? params[k].replace(/[\r\n]+/g, ' ').trim()
      : params[k];
  }
  return clean;
}

/**
 * Parsing Index OLT C-Data FD16xx (misal 4718626 -> PON 1, ONU 34)
 */
function parseCDataIndex(index) {
  const n = parseInt(index, 10);
  if (!Number.isFinite(n)) {
    // Jika format string seperti "0/0/1:5" atau "1:5"
    const parts = String(index).split(/[:/]+/);
    if (parts.length >= 2) {
      return {
        port: parseInt(parts[parts.length - 2], 10) || 1,
        onuId: parseInt(parts[parts.length - 1], 10) || 1
      };
    }
    return { port: 1, onuId: 1 };
  }
  
  let port = (n >> 16) & 0xff;
  let onuId = n & 0xffff;

  if (port === 0 || port > 16) port = 1;
  if (onuId > 128) onuId = onuId & 0xff;
  if (onuId === 0) onuId = 1;

  return { port, onuId };
}

/**
 * ONU Provision Service
 */
class ONUProvisionService {
  constructor() {
    this.connections = new Map();
  }

  /**
   * Helper eksekusi via Telnet (port default 23)
   */
  async executeTelnetCommands(oltConfig, commands) {
    const host = oltConfig.host;
    const port = Number(oltConfig.port) || 23;
    const user = oltConfig.username || 'admin';
    const pass = oltConfig.password || 'admin';

    return new Promise((resolve, reject) => {
      const socket = new net.Socket();
      socket.setTimeout(25000);

      let buf = '';
      const promptRe = /[>#\$]\s*$/m;
      const loginRe = /(login|username|user)\s*[:>]\s*$/im;
      const passRe = /(password|passwd)\s*[:>]\s*$/im;

      const cleanup = () => {
        socket.removeAllListeners();
        socket.destroy();
      };

      socket.connect(port, host, () => {
        socket.write('\r\n');
      });

      socket.on('data', (chunk) => {
        const str = chunk.toString('utf8');
        buf += str;

        if (buf.includes('--More--') || buf.includes('--Press Enter--') || buf.includes('--More ( Press')) {
          socket.write(' ');
          return;
        }

        if (loginRe.test(buf)) {
          buf = '';
          socket.write(user + '\r\n');
        } else if (passRe.test(buf)) {
          buf = '';
          socket.write(pass + '\r\n');
        } else if (promptRe.test(buf)) {
          buf = '';
          socket.removeAllListeners('data');
          this._runTelnetSequence(socket, commands, promptRe)
            .then((out) => {
              cleanup();
              resolve(out);
            })
            .catch((err) => {
              cleanup();
              reject(err);
            });
        }
      });

      socket.on('error', (err) => {
        cleanup();
        reject(err);
      });

      socket.on('timeout', () => {
        cleanup();
        reject(new Error('Telnet connection timeout'));
      });
    });
  }

  async _runTelnetSequence(socket, commands, promptRe) {
    let output = '';
    for (const cmd of commands) {
      socket.write(cmd + '\r\n');
      const stepOut = await new Promise((res, rej) => {
        let stepBuf = '';
        const onData = (data) => {
          const s = data.toString('utf8');
          stepBuf += s;
          if (stepBuf.includes('--More--') || stepBuf.includes('--More ( Press')) {
            socket.write(' ');
          }
          if (promptRe.test(stepBuf)) {
            socket.off('data', onData);
            res(stepBuf);
          }
        };
        const t = setTimeout(() => {
          socket.off('data', onData);
          rej(new Error(`Timeout executing command: ${cmd}`));
        }, 15000);

        socket.on('data', onData);
      });
      output += '\n' + stepOut;
    }
    return output;
  }

  /**
   * Connect ke OLT via SSH
   */
  async connectSSH(oltConfig) {
    return new Promise((resolve, reject) => {
      const conn = new Client();
      const timeout = setTimeout(() => {
        conn.end();
        reject(new Error('Connection timeout (SSH port tidak merespons)'));
      }, 10000);

      conn.on('ready', () => {
        clearTimeout(timeout);
        resolve(conn);
      });

      conn.on('error', (err) => {
        clearTimeout(timeout);
        reject(err);
      });

      conn.connect({
        host: oltConfig.host,
        port: oltConfig.port || 22,
        username: oltConfig.username,
        password: oltConfig.password,
        readyTimeout: 10000,
        keepaliveInterval: 10000
      });
    });
  }

  /**
   * Eksekusi CLI dengan Fallback Cerdas: SSH -> Telnet
   */
  async runCli(oltConfig, commands) {
    try {
      const conn = await this.connectSSH(oltConfig);
      const out = await this.executeCommands(conn, commands);
      conn.end();
      return out;
    } catch (sshErr) {
      logger.warn(`[CLI] SSH gagal (${sshErr.message}), mencoba fallback ke Telnet...`);
      return await this.executeTelnetCommands(oltConfig, commands);
    }
  }

  async executeCommands(conn, commands, promptPattern = /#|>/) {
    return new Promise((resolve, reject) => {
      conn.shell((err, stream) => {
        if (err) return reject(err);

        let output = '';
        let cmdIndex = 0;
        const cmdList = Array.isArray(commands) ? [...commands] : [commands];

        const timeout = setTimeout(() => {
          stream.end();
          reject(new Error('SSH command sequence timeout'));
        }, 40000);

        const writeNext = () => {
          if (cmdIndex < cmdList.length) {
            const rawCmd = cmdList[cmdIndex++];
            const cmd = sanitizeCliInput(rawCmd);
            stream.write(cmd + '\n');
          } else {
            clearTimeout(timeout);
            stream.end();
          }
        };

        let buffer = '';
        stream.on('data', (data) => {
          const chunk = data.toString();
          output += chunk;
          buffer += chunk;

          const lines = buffer.split('\n');
          const lastLine = lines[lines.length - 1].trim();

          if (promptPattern.test(lastLine)) {
            buffer = '';
            setTimeout(writeNext, 50);
          }
        });

        stream.on('close', () => {
          clearTimeout(timeout);
          resolve(output);
        });

        stream.stderr.on('data', (data) => {
          logger.error('SSH stderr:', data.toString());
        });
      });
    });
  }

  // ─── C-DATA FD16XX GPON METHODS ──────────────────────────────────────────

  /**
   * C-Data - UNBIND / HAPUS ONU DARI OLT
   * Berdasarkan Manual C-Data Bab 2 & Bab 28.1.11:
   * 1. Masuk mode config
   * 2. Masuk interface gpon 0/0
   * 3. ont delete <port-id> <ont-id>
   * 4. exit lalu save
   */
  async cdataDeleteONU(oltConfig, params) {
    params = sanitizeParams(params);
    let { pon, onuId, index } = params;

    // Jika dipanggil dengan index
    if (index && (!pon || !onuId)) {
      const parsed = parseCDataIndex(index);
      pon = parsed.port;
      onuId = parsed.onuId;
    }

    if (!onuId) onuId = 1;
    // Dapatkan nomor port murni (contoh: '0/0/1' -> '1', atau '1' -> '1')
    const portId = String(pon || '1').includes('/') ? pon.split('/').pop() : pon;

    const cmds = [
      'enable',
      'config',
      'interface gpon 0/0',
      `ont delete ${portId} ${onuId}`,
      'exit',
      'save'
    ];

    logger.info(`[C-Data] Menghapus ONT pada PON port ${portId} ID ${onuId}...`);
    const output = await this.runCli(oltConfig, cmds);
    logger.info(`[C-Data] Output OLT:\n${output}`);

    if (output.includes('% Unknown command') || output.includes('Error:')) {
      logger.error(`[C-Data] Gagal menghapus ONT ID ${onuId}`);
      return { success: false, message: `Gagal menghapus ONT: ${output}` };
    }
    
    return { success: true, message: `ONT Port ${portId} ID ${onuId} berhasil dihapus dari OLT C-Data` };
  }

  /**
   * C-Data - Provisioning ONU
   * Berdasarkan Manual C-Data Bab 27, 28, dan 29
   */
  async cdataProvisionONU(oltConfig, params) {
    params = sanitizeParams(params);
    const { pon, onuId, sn, name, vlan, lineProfileId, srvProfileId } = params;
    const portNum = String(pon || '1').includes('/') ? pon.split('/').pop() : pon;
    const cleanName = (name || `ONT_${onuId}`).replace(/["'\s]+/g, '_').slice(0, 32);
    const lineId = lineProfileId || 10;
    const srvId = srvProfileId || 10;
    const targetVlan = vlan || 100;

    const cmds = [
      'enable',
      'config',
      'interface gpon 0/0',
      `ont add ${portNum} ${onuId} sn-auth ${sn} ont-lineprofile-id ${lineId} ont-srvprofile-id ${srvId}`,
      `ont description ${portNum} ${onuId} ${cleanName}`,
      'exit',
      `service-port autoindex vlan ${targetVlan} gpon 0/0 port ${portNum} ont ${onuId} gemport 1 multi-service user-vlan ${targetVlan} tag-action transparent`,
      'save'
    ];

    logger.info(`[C-Data] Provisioning ONT ${cleanName} pada Port ${portNum} ID ${onuId}...`);
    const output = await this.runCli(oltConfig, cmds);
    logger.info(`[C-Data] Output Provision:\n${output}`);
    return { success: true, message: `ONT ${cleanName} berhasil diotorisasi pada C-Data` };
  }

/**
   * Scan ONU belum terkonfigurasi untuk C-Data (GPON Autofind)
   * Mengambil data langsung di dalam interface gpon 0/0 agar bisa membaca total ONU
   */
  async cdataGetUnconfiguredONUs(oltConfig) {
    const commands = [
      'enable',
      'config',
      'interface gpon 0/0',
      'show ont register-statistics 1', // Menampilkan total registered (contoh: 70)
      'show ont info 1 all',            // Menampilkan daftar ID yang terpakai
      'show ont autofind all',          // Menampilkan modem baru yang unbind
      'exit'
    ];
    try {
      const output = await this.runCli(oltConfig, commands);
      logger.info(`[C-Data] Output Scan:\n${output}`);
      return this.parseCDataUnconfiguredONUs(output);
    } catch (err) {
      logger.error('[C-Data] Scan unconfigured error:', err);
      return [];
    }
  }

  parseCDataUnconfiguredONUs(output) {
    const onus = [];
    if (!output) return onus;

    const lines = output.split(/\r?\n/);
    let currentOnt = null;

    // 1. Cari nomor ID terbesar yang SUDAH terdaftar di OLT
    const usedOnuIds = [];
    for (const rawLine of lines) {
      const line = rawLine.trim();

      // Pola baris tabel: "0/0 1 70 ZTEGD4BDF9E0..." -> ambil ID 70
      const rowMatch = line.match(/^\d+\/\d+\s+\d+\s+(\d+)\s+[A-Za-z0-9]+/);
      if (rowMatch) {
        usedOnuIds.push(parseInt(rowMatch[1], 10));
      }

      // Pola statistik register: "0/0 1 0 70 65" -> ambil total authenticated 70
      const statMatch = line.match(/^\d+\/\d+\s+\d+\s+\d+\s+(\d+)\s+\d+/);
      if (statMatch) {
        usedOnuIds.push(parseInt(statMatch[1], 10));
      }
    }

    // Nomor terakhir + 1 (jika ada 70 terdaftar, otomatis menjadi 71)
    const maxExistingId = usedOnuIds.length > 0 ? Math.max(...usedOnuIds) : 70;
    const nextOnuId = (maxExistingId + 1).toString();

    // 2. Ambil data modem unconfigured dari output 'show ont autofind all'
    for (const rawLine of lines) {
      const line = rawLine.trim();
      if (!line) continue;

      if (line.includes('Frame/Slot')) {
        currentOnt = {};
      }

      if (!currentOnt) continue;

      const portMatch = line.match(/^Port\s*:\s*(\d+)/i);
      if (portMatch) currentOnt.port = portMatch[1];

      // Format: SN : ZTEGD4BDF9E0 (ZTEG-D4BDF9E0)
      const snMatch = line.match(/(?:Ont\s+)?SN\s*:\s*([A-Za-z0-9]{12,16})/i);
      if (snMatch) currentOnt.sn = snMatch[1];

      const loidMatch = line.match(/^Loid\s*:\s*(.+)$/i);
      if (loidMatch && !line.includes('Password') && loidMatch[1].trim() !== '--') {
        currentOnt.loid = loidMatch[1].trim();
      }

      const equipMatch = line.match(/^Equipment ID\s*:\s*(.+)$/i);
      if (equipMatch) currentOnt.model = equipMatch[1].trim();

      const vendorMatch = line.match(/^Vendor ID\s*:\s*(.+)$/i);
      if (vendorMatch) currentOnt.vendor = vendorMatch[1].trim();

      if (line.includes('Last autofind time') || line.startsWith('Total:') || (line.startsWith('---') && currentOnt.sn)) {
        if (currentOnt.sn) {
          const port = currentOnt.port || '1';
          onus.push({
            pon: `0/0/${port}`,
            port: port,
            onuId: nextOnuId, // Langsung otomatis ID terakhir + 1 (misal 71)
            sn: currentOnt.sn,
            loid: currentOnt.loid || '',
            model: currentOnt.model || 'GPON-ONU',
            vendor: currentOnt.vendor || 'C-Data'
          });
          currentOnt = null;
        }
      }
    }

    return onus;
  }

  /**
   * C-Data - Otorisasi ONU menggunakan Policy ID 0 (default-mult-srv-profile)
   */
  async cdataProvisionONU(oltConfig, params) {
    params = sanitizeParams(params);
    let { pon, onuId, sn, name } = params;

    const portNum = String(pon || '1').includes('/') ? pon.split('/').pop() : (pon || '1');
    const cleanName = (name || `ONT_${onuId}`).replace(/["'\s]+/g, '_').slice(0, 32);

    let targetOnuId = parseInt(onuId, 10);

    // Pengaman: Jika ID yang dikirim masih 1 atau kosong, cari nomor terakhir di OLT + 1
    if (!targetOnuId || targetOnuId <= 1) {
      try {
        const checkCmds = [
          'enable',
          'config',
          'interface gpon 0/0',
          `show ont register-statistics ${portNum}`,
          'exit'
        ];
        const chkOut = await this.runCli(oltConfig, checkCmds);
        const statMatch = chkOut.match(/^\d+\/\d+\s+\d+\s+\d+\s+(\d+)\s+\d+/m);
        if (statMatch) {
          targetOnuId = parseInt(statMatch[1], 10) + 1;
        } else {
          targetOnuId = 71;
        }
      } catch (_) {
        targetOnuId = 71;
      }
    }

    // Perintah OLT: Menggunakan Policy ID 0 (mult-srv-profile profile-id 0)
    const cmds = [
      'enable',
      'config',
      'interface gpon 0/0',
      `ont add ${portNum} ${targetOnuId} sn-auth ${sn} mult-srv-profile profile-id 0`,
      `ont description ${portNum} ${targetOnuId} ${cleanName}`,
      'exit',
      'save'
    ];

    logger.info(`[C-Data] Otorisasi ONU via Policy ID 0 (Port ${portNum}, ID ${targetOnuId}, SN ${sn})...`);
    const output = await this.runCli(oltConfig, cmds);
    logger.info(`[C-Data] Respon OLT:\n${output}`);

    // Validasi kegagalan
    if (output.includes('onu create failed') || output.includes('Error:') || output.includes('% Unknown command') || output.includes('failed')) {
      const errorMatch = output.split('\n').find(l => 
        l.includes('onu create failed') || 
        l.includes('Error:') || 
        l.includes('% Unknown command')
      ) || 'Ditolak oleh OLT';
      return { 
        success: false, 
        error: errorMatch.trim() 
      };
    }

    return { 
      success: true, 
      message: `ONU ${cleanName} (ID: ${targetOnuId}) berhasil diotorisasi dengan Auth Policy 0` 
    };
  }
/**
   * GENERAL DELETE ONU ROUTER
   */
  // ─── GENERAL DELETE ONU ROUTER ──────────────────────────────────────────

  async deleteONU(oltConfig, vendor, params) {
    params = sanitizeParams(params);
    const v = String(vendor || '').toUpperCase();
    if (v.includes('CDATA')) {
      return this.cdataDeleteONU(oltConfig, params);
    } else if (v === 'ZTE') {
      return this.zteDeleteONU(oltConfig, params);
    } else if (v === 'HUAWEI') {
      return this.huaweiDeleteONU(oltConfig, params);
    } else if (v === 'FIBERHOME') {
      return this.fiberhomeDeleteONU(oltConfig, params);
    } else if (v === 'VSOL') {
      return this.vsolDeleteONU(oltConfig, params);
    } else if (v === 'HSGQ') {
      return this.hsgqDeleteONU(oltConfig, params);
    } else if (v === 'HIOSO') {
      return this.hiosoDeleteONU(oltConfig, params);
    }
    // Default fallback
    return this.cdataDeleteONU(oltConfig, params);
  }

  // ─── GENERAL UNCONFIGURED SCAN ROUTER ────────────────────────────────────

  async getUnconfiguredONUs(oltConfig, params = {}) {
    const v = String(oltConfig.vendor || '').toUpperCase();
    if (v.includes('CDATA')) {
      return this.cdataGetUnconfiguredONUs(oltConfig);
    } else if (v === 'ZTE') {
      return this.zteGetUnconfiguredONUs(oltConfig, params.pon || '1/1/1');
    } else if (v === 'HUAWEI') {
      return this.huaweiGetUnconfiguredONUs(oltConfig, params.frame || '0', params.slot || '0', params.pon || '0');
    } else if (v === 'HSGQ' || v === 'HIOSO') {
      return this.hsgqGetUnconfiguredONUs(oltConfig, params.pon || '0/1');
    }
    return [];
  }

  // ─── VENDOR LAIN ─────────────────────────────────────────────────────────

  async zteDeleteONU(oltConfig, params) {
    const { pon, onuId } = params;
    const cmds = [
      'enable',
      'configure terminal',
      `interface gpon-olt_${pon}`,
      `no onu ${onuId}`,
      'exit',
      'write'
    ];
    await this.runCli(oltConfig, cmds);
    return { success: true, message: 'ONU deleted successfully' };
  }

  async huaweiDeleteONU(oltConfig, params) {
    const { frame, slot, pon, onuId } = params;
    const cmds = [
      'enable',
      'config',
      `interface gpon ${frame || 0}/${slot || 0}`,
      `ont delete ${pon || 0} ${onuId}`,
      'quit',
      'save'
    ];
    await this.runCli(oltConfig, cmds);
    return { success: true, message: 'ONU deleted successfully' };
  }

  async fiberhomeDeleteONU(oltConfig, params) {
    const { frame, slot, pon, onuId } = params;
    const cmds = [
      'enable',
      'config',
      `interface gpon ${frame}/${slot}`,
      `ont delete ${pon} ${onuId}`,
      'quit'
    ];
    await this.runCli(oltConfig, cmds);
    return { success: true, message: 'ONU deleted successfully' };
  }

  async vsolDeleteONU(oltConfig, params) {
    const { pon, onuId } = params;
    const cmds = [
      'enable',
      'configure terminal',
      `interface gpon-olt_${pon}`,
      `no onu ${onuId}`,
      'exit'
    ];
    await this.runCli(oltConfig, cmds);
    return { success: true, message: 'ONU deleted successfully' };
  }

  async hsgqDeleteONU(oltConfig, params) {
    const { pon, onuId } = params;
    const cmds = ['enable', 'config', `interface ${pon}`, `no onu ${onuId}`, 'exit', 'write'];
    await this.runCli(oltConfig, cmds);
    return { success: true, message: 'ONU deleted successfully' };
  }

  async hiosoDeleteONU(oltConfig, params) {
    const { pon, onuId } = params;
    const cmds = ['enable', 'config', `interface ${pon}`, `no onu ${onuId}`, 'exit', 'write'];
    await this.runCli(oltConfig, cmds);
    return { success: true, message: 'ONU deleted successfully' };
  }

  /**
   * Reboot ONT C-Data
   * Sesuai Manual Bab 28.3.4: "ont reboot <port-id> <ont-id>"
   */
  async rebootONU(oltConfig, vendor, params) {
    const v = String(vendor || '').toUpperCase();
    if (v.includes('CDATA')) {
      const parsed = parseCDataIndex(params.index || params.onuId || params.pon);
      const portId = params.pon ? String(params.pon).split('/').pop() : parsed.port;
      const onuId = params.onuId || parsed.onuId;

      const cmds = [
        'enable',
        'config',
        'interface gpon 0/0',
        `ont reboot ${portId} ${onuId}`,
        'exit'
      ];
      await this.runCli(oltConfig, cmds);
      return { success: true, message: `ONT C-Data port ${portId} ID ${onuId} berhasil di-reboot` };
    }
    return { success: true };
  }

  /**
   * Ganti nama / deskripsi ONT C-Data
   * Sesuai Manual Bab 28.3.1: "ont description <port-id> <ont-id> <description>"
   */
  async renameONU(oltConfig, vendor, params) {
    const v = String(vendor || '').toUpperCase();
    if (v.includes('CDATA')) {
      const parsed = parseCDataIndex(params.index || params.onuId || params.pon);
      const portId = params.pon ? String(params.pon).split('/').pop() : parsed.port;
      const onuId = params.onuId || parsed.onuId;
      const cleanName = (params.newName || params.name || '').replace(/["'\s]+/g, '_').slice(0, 32);

      const cmds = [
        'enable',
        'config',
        'interface gpon 0/0',
        `ont description ${portId} ${onuId} ${cleanName}`,
        'exit',
        'save'
      ];
      await this.runCli(oltConfig, cmds);
      return { success: true, message: `Deskripsi ONT C-Data port ${portId} ID ${onuId} berhasil diubah` };
    }
    return { success: true };
  }
}

module.exports = new ONUProvisionService();