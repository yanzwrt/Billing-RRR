function getAllOlts() {
  return db.prepare('SELECT * FROM olts ORDER BY created_at DESC').all();
}
function getActiveOlts() {
  return db.prepare('SELECT * FROM olts WHERE is_active = 1').all();
}
function getOltById(id) {
  return db.prepare('SELECT * FROM olts WHERE id = ?').get(id);
}
function deleteOlt(id) {
  return db.prepare('DELETE FROM olts WHERE id = ?').run(id);
}
function createOlt(data) {
  const telnetPort = parseInt(data.telnet_port, 10);
  const stmt = db.prepare(`
    INSERT INTO olts (name, host, snmp_community, snmp_port, brand, description, is_active, web_user, web_password, telnet_port, enable_password)
    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
  `);
  return stmt.run(
    data.name, data.host, data.snmp_community || 'private', data.snmp_port || 161,
    data.brand || 'cdata', data.description || '', data.is_active !== undefined ? data.is_active : 1,
    data.web_user || 'root', data.web_password || '',
    Number.isFinite(telnetPort) && telnetPort > 0 ? telnetPort : 23,
    data.enable_password || null
  );
}
function updateOlt(id, data) {
  const telnetPort = parseInt(data.telnet_port, 10);
  const stmt = db.prepare(`
    UPDATE olts 
    SET name = ?, host = ?, snmp_community = ?, snmp_port = ?, brand = ?, description = ?, is_active = ?, web_user = ?, web_password = ?, telnet_port = ?, enable_password = ?
    WHERE id = ?
  `);
  return stmt.run(
    data.name, data.host, data.snmp_community || 'private', data.snmp_port, data.brand,
    data.description, data.is_active ? 1 : 0, data.web_user || 'root', data.web_password || '',
    Number.isFinite(telnetPort) && telnetPort > 0 ? telnetPort : 23,
    data.enable_password || null, id
  );
}

const normalizeOid = (oid) => (oid ? oid.replace(/^iso\./, '1.').replace(/^\./, '') : '');

const extractIdx = (rawOid, baseOid) => {
  const normRaw = normalizeOid(rawOid);
  const normBase = normalizeOid(baseOid);
  if (normRaw.startsWith(normBase + '.')) return normRaw.substring(normBase.length + 1);
  if (normRaw.startsWith(normBase)) return normRaw.substring(normBase.length).replace(/^\./, '');
  return rawOid.split('.').slice(-1)[0];
};

const oidUnderBase = (rawOid, baseOid) => {
  const normRaw = normalizeOid(rawOid);
  const normBase = normalizeOid(baseOid);
  return normRaw.startsWith(normBase + '.') || normRaw === normBase;
};

function formatSnWithColons(val) {
  if (!val || typeof val !== 'string') return val;
  const clean = val.replace(/[^a-zA-Z0-9]/g, '').toUpperCase();
  if (/^[0-9A-F]{12}$/.test(clean) || /^[0-9A-F]{16}$/.test(clean)) {
    return clean.match(/.{1,2}/g).join(':');
  }
  return val;
}

// ============================================================================
// >>> AWAL PERUBAHAN DECODESN (Merapikan format SN/MAC dari Hex & String OLT C-Data) <<<
// ============================================================================
const decodeSn = (val) => {
  if (!val) return '-';
  
  // Jika berupa Buffer dari respons SNMP
  if (Buffer.isBuffer(val)) {
    // 1. Cek apakah berupa string ASCII normal dan bersih
    const ascii = val.toString('utf8').replace(/\0/g, '').trim();
    if (ascii.length >= 4 && /^[\x20-\x7E]+$/.test(ascii) && !/[\x00-\x1F\x7F]/.test(ascii)) {
      return ascii;
    }
    
    // 2. Jika berupa Hex-STRING mentah dari OLT C-Data (biasanya 8 byte)
    const hex = val.toString('hex').toUpperCase();
    if (val.length === 8) {
      const vendorPart = val.subarray(0, 4).toString('utf8').replace(/[^a-zA-Z0-9]/g, '');
      const serialPart = val.subarray(4).toString('hex').toUpperCase();
      if (vendorPart.length >= 2) {
        return `${vendorPart}${serialPart}`;
      }
    }
    return hex;
  }
  
  // Jika berupa string biasa
  let res = String(val).replace(/\0/g, '').trim();
  return res || '-';
};
// ============================================================================
// >>> AKHIR PERUBAHAN DECODESN <<<
// ============================================================================

const decodeUptime = (ticks) => {
  if (!ticks) return 'N/A';
  let seconds = Math.floor(ticks / 100);
  const days = Math.floor(seconds / 86400);
  seconds %= 86400;
  const hours = Math.floor(seconds / 3600);
  seconds %= 3600;
  const minutes = Math.floor(seconds / 60);
  return `${days}d ${hours}h ${minutes}m`;
};

function cleanOnuName(rawName) {
  if (!rawName) return '';
  let s = Buffer.isBuffer(rawName) ? rawName.toString('utf8') : String(rawName);
  s = s.replace(/\0/g, '').trim();
  s = s.replace(/^gpon\s+[\d/:]+\s+onu\s+\d+\s+/i, '');
  s = s.replace(/^epon\s+[\d/:]+\s+(onu\s+)?\d+\s+/i, '');
  s = s.replace(/^onu\s+\d+\s+/i, '');
  return s.trim() || rawName;
}

const bufferToInt = (val) => {
  if (val == null) return null;
  if (typeof val === 'number') return val;
  if (typeof val === 'bigint') return Number(val);
  if (typeof val === 'string') {
    const n = Number(val);
    return Number.isFinite(n) ? n : null;
  }
  if (Buffer.isBuffer(val)) {
    if (val.length === 1) return val.readUInt8(0);
    if (val.length === 2) return val.readInt16BE(0);
    if (val.length === 4) return val.readInt32BE(0);
    const n = Number(val.toString());
    return Number.isFinite(n) ? n : null;
  }
  return null;
};

const bufferToCounterBigInt = (val) => {
  if (val == null) return null;
  if (typeof val === 'bigint') return val;
  if (typeof val === 'number') return BigInt(Math.max(0, Math.floor(val)));
  if (Buffer.isBuffer(val)) {
    if (val.length === 8) {
      try { return val.readBigUInt64BE(0); } catch (e) { return null; }
    }
    if (val.length === 4) {
      try { return BigInt(val.readUInt32BE(0)); } catch (e) { return null; }
    }
  }
  try { return BigInt(String(val).trim()); } catch (e) { return null; }
};

const decodeOpticalPower = (raw) => {
  if (raw == null) return 'N/A';
  let num = bufferToInt(raw);
  if (num == null) {
    const m = String(raw).match(/[-+]?\d*\.?\d+/);
    if (m) num = parseFloat(m[0]);
  }
  if (num == null || isNaN(num) || num === 0 || num === 65535 || num === -65535 || num === 2147483647) {
    return 'N/A';
  }

  if (num > 32767 && num <= 65535) num = num - 65536;

  let dbm = num;
  
  // Jika nilai positif (biasanya Tx Power ONU, misal 202 -> 2.02 atau 218 -> 2.18)
  if (num > 0 && num < 1000) {
    dbm = num / 100;
  } 
  // Jika nilai minus besar (biasanya Rx Power / redaman, misal -2056 / -2538)
  else if (Math.abs(num) >= 500) {
    dbm = num / 100;
  } else if (Math.abs(num) >= 50) {
    dbm = num / 10;
  }

  if (dbm > 25 || dbm < -50) return 'N/A';
  return `${dbm.toFixed(2)} dBm`;
};

const decodeDistance = (raw) => {
  const dist = bufferToInt(raw);
  if (dist == null || dist <= 0 || dist > 40000) return '-';
  if (dist >= 1000) {
    return `${(dist / 1000).toFixed(2)} km (${dist} m)`;
  }
  return `${dist} m`;
};

function findOpticalValue(map, idx) {
  if (!map) return null;
  if (map[idx] !== undefined) return map[idx];

  const possibleKeys = [
    `${idx}.1`,
    `${idx}.2`,
    `${idx}.0`,
    `1.1.${idx}`,
    `1.${idx}`
  ];
  for (const pk of possibleKeys) {
    if (map[pk] !== undefined) return map[pk];
  }

  const prefix = `${idx}.`;
  for (const k of Object.keys(map)) {
    if (k.startsWith(prefix) || k.endsWith(`.${idx}`)) return map[k];
  }
  return null;
}

const slowWalk = async (session, baseOid, maxEntries = 5000) => {
  const results = {};
  let walkCount = 0;

  return new Promise((resolve) => {
    session.subtree(
      baseOid,
      20,
      (varbinds) => {
        for (const vb of varbinds) {
          if (!vb || vb.oid == null) continue;
          if (snmp.isVarbindError(vb)) continue;
          if (!oidUnderBase(vb.oid, baseOid)) continue;

          const idx = extractIdx(vb.oid, baseOid);
          results[idx] = vb.value;
          walkCount++;
          if (walkCount >= maxEntries) break;
        }
      },
      () => resolve(results)
    );
  });
};

const snmpGet = async (session, oids) => {
  try {
    const vbs = await new Promise((rv, rj) => {
      session.get(oids, (err, result) => {
        if (err) rj(err);
        else rv(result);
      });
    });
    return vbs.map(vb => {
      if (!vb || snmp.isVarbindError(vb)) return null;
      return vb.value;
    });
  } catch (e) {
    return oids.map(() => null);
  }
};

// ─── METRIK SISTEM: SUHU, CPU, RAM (MURNI SNMP C-DATA FD1601S) ───────────────

/**
 * Membaca Suhu, CPU, RAM MURNI via SNMP (Hasil SNMPWALK Asli C-Data)
 * .8.1.0  = CPU (1%)
 * .8.6.0  = Suhu (31°C / 32°C)
 * .8.21.0 = RAM (52%)
 */
async function fetchCDataSystemMetrics(session, stats) {
  try {
    const oids = [
      '1.3.6.1.4.1.34592.1.3.100.1.8.1.0',  // 0: CPU Usage (%)
      '1.3.6.1.4.1.34592.1.3.100.1.8.21.0', // 1: Memory Usage Resmi (%)
      '1.3.6.1.4.1.34592.1.3.100.1.8.6.0',  // 2: Suhu Internal OLT (°C)
      '1.3.6.1.4.1.34592.1.3.100.1.8.2.0',  // 3: Total RAM (MB)
      '1.3.6.1.4.1.34592.1.3.100.1.8.3.0'   // 4: Free RAM (MB)
    ];

    const vals = await snmpGet(session, oids);

    // 1. CPU (%)
    const cpuVal = bufferToInt(vals[0]);
    if (cpuVal != null && cpuVal >= 0 && cpuVal <= 100) {
      stats.cpu = `${cpuVal}%`;
    }

    // 2. RAM (%)
    const ramPctVal = bufferToInt(vals[1]);
    if (ramPctVal != null && ramPctVal >= 1 && ramPctVal <= 100) {
      stats.ram = `${ramPctVal}%`;
    } else {
      const total = bufferToInt(vals[3]);
      const free = bufferToInt(vals[4]);
      if (total && free != null && total > 0) {
        stats.ram = `${Math.round(((total - free) / total) * 100)}%`;
      }
    }

    // 3. SUHU (°C) - DARI OID .8.6.0
    const tempVal = bufferToInt(vals[2]);
    if (tempVal != null && tempVal >= 15 && tempVal <= 85) {
      stats.temp = `${tempVal}°C`;
    }
  } catch (e) {
    logger.debug(`[OLT-Metrics] SNMP metrics read error: ${e.message}`);
  }
}

// ─── TRAFIK UPLINK LIVE PER DETIK ────────────────────────────────────────────

const GPON_PORT_INDEX = '1310721';

let lastGponOutBytes = null; // Download
let lastGponInBytes = null;  // Upload
let lastGponTimestamp = null;
let permanentLastDown = 0;   // Nilai terakhir yang valid
let permanentLastUp = 0;

/**
 * Membaca Trafik Riil Port GPON 0/0/1 (Index 1310721) MURNI SNMP
 * Realtime 1 Detik, Presisi Gabungan Uplink 1 & 2, Anti-Drop
 */
// --- [GANTI FUNGSI INI DI oltService.js] ---
async function fetchUplinkTraffic(session, stats) {
  try {
    const oids = [
      `1.3.6.1.2.1.31.1.1.1.10.${GPON_PORT_INDEX}`, // 0: OutOctets 64-bit (Download)
      `1.3.6.1.2.1.31.1.1.1.6.${GPON_PORT_INDEX}`,  // 1: InOctets 64-bit (Upload)
      `1.3.6.1.2.1.2.2.1.16.${GPON_PORT_INDEX}`,    // 2: 32-bit Out fallback (Download)
      `1.3.6.1.2.1.2.2.1.10.${GPON_PORT_INDEX}`     // 3: 32-bit In fallback (Upload)
    ];

    const vals = await snmpGet(session, oids);
    
    // Ambil dari 64-bit, jika null/gagal otomatis ambil dari 32-bit fallback
    const outByte = bufferToCounterBigInt(vals[0]) ?? bufferToCounterBigInt(vals[2]);
    const inByte = bufferToCounterBigInt(vals[1]) ?? bufferToCounterBigInt(vals[3]);

    if (outByte == null || inByte == null) {
      stats.uplink_rx = permanentLastDown;
      stats.uplink_tx = permanentLastUp;
      return;
    }

    const now = Date.now();

    if (lastGponOutBytes !== null && lastGponTimestamp !== null) {
      const dt = (now - lastGponTimestamp) / 1000;

      if (dt >= 0.3 && dt <= 15) {
        const wrap64 = BigInt(1) << BigInt(64);

        let dOut = outByte - lastGponOutBytes;
        if (dOut < BigInt(0)) dOut += wrap64;

        let dIn = inByte - lastGponInBytes;
        if (dIn < BigInt(0)) dIn += wrap64;

        const calcDown = Math.round(Number(dOut) / dt);
        const calcUp = Math.round(Number(dIn) / dt);

        if (calcDown >= 0 && calcDown < 1000000000) {
          permanentLastDown = calcDown;
        }
        if (calcUp >= 0 && calcUp < 500000000) {
          permanentLastUp = calcUp;
        }

        lastGponOutBytes = outByte;
        lastGponInBytes = inByte;
        lastGponTimestamp = now;
      }
    } else {
      lastGponOutBytes = outByte;
      lastGponInBytes = inByte;
      lastGponTimestamp = now;
    }

    stats.uplink_rx = permanentLastDown;
    stats.uplink_tx = permanentLastUp;
  } catch (e) {
    logger.debug(`[OLT-Traffic] Port read error: ${e.message}`);
    stats.uplink_rx = permanentLastDown;
    stats.uplink_tx = permanentLastUp;
  }
}

// ─── GET OLT STATS ──────────────────────────────────────────────────────────

const statsCache = new Map();

async function getOltStats(id, full = true) {
  const cacheKey = `${id}:${full}`;
  const now = Date.now();
  const cached = statsCache.get(cacheKey);
  
  if (full && cached && (now - cached.timestamp < 1500)) {
    return cached.data;
  }
  
  const result = await getOltStatsInternal(id, full);
  if (result && !result.error && full) {
    statsCache.set(cacheKey, { data: result, timestamp: Date.now() });
  }
  return result;
}

async function getOltStatsInternal(id, full = true) {
  const olt = getOltById(id);
  if (!olt) return null;

  const stats = {
    id:          olt.id,
    name:        olt.name,
    host:        olt.host,
    brand:       olt.brand,
    status:      'Offline',
    error:       null,
    uptime:      'N/A',
    temp:        'N/A',
    cpu:         'N/A',
    ram:         'N/A',
    onus_total:  0,
    onus_online: 0,
    onus_offline: 0,
    onus_weak:   0,
    onus:        [],
    unauth_onus: [],
    cards:       [],
    voltage:     'N/A',
    uplink_rx:   0,
    uplink_tx:   0,
  };

  const community = olt.snmp_community || 'private';
  const activeProfile = BRAND_PROFILES.cdata[0];

  const session = snmp.createSession(olt.host, community, {
    port:     olt.snmp_port || 161,
    timeout:  4000,
    retries:  2,
    version:  snmp.Version2c,
  });

  return new Promise((resolve) => {
    let isResolved = false;
    const safeResolve = (data) => {
      if (isResolved) return;
      isResolved = true;
      clearTimeout(globalTimeout);
      try { session.close(); } catch (e) {}
      resolve(data);
    };

    const globalTimeout = setTimeout(() => {
      stats.error = `Timeout menghubungkan ke OLT ${olt.host}`;
      safeResolve(stats);
    }, 45000);

    (async () => {
      try {
        const uptimeVbs = await new Promise(rv => {
          session.get(['1.3.6.1.2.1.1.3.0'], (err, vbs) => {
            if (err) rv([]);
            else rv(vbs);
          });
        });

        if (!uptimeVbs[0] || snmp.isVarbindError(uptimeVbs[0])) {
          stats.error = `Gagal terhubung ke OLT ${olt.host}:${olt.snmp_port || 161}`;
          safeResolve(stats);
          return;
        }

        stats.uptime = decodeUptime(uptimeVbs[0].value);
        stats.status = 'Online';

        const onlineVals = ONLINE_VALUES.cdata;

        // Ambil trafik dan metrik Suhu/CPU/RAM via SNMP murni secara paralel
        const systemMetricsPromise = Promise.all([
          fetchUplinkTraffic(session, stats),
          fetchCDataSystemMetrics(session, stats)
        ]);

        if (!full) {
          await systemMetricsPromise;
          safeResolve(stats);
          return;
        }

        // Ambil data tabel ONU lengkap
        const [statusMap, nameMap, snMap, rxMap, txMap1, txMap2, distMap] = await Promise.all([
          slowWalk(session, activeProfile.status_table),
          slowWalk(session, activeProfile.name_table),
          slowWalk(session, activeProfile.sn_table),
          slowWalk(session, activeProfile.rx_power_table),
          slowWalk(session, activeProfile.tx_power_table),
          slowWalk(session, activeProfile.tx_alt1),
          slowWalk(session, activeProfile.distance_table),
        ]);

        await systemMetricsPromise;

        const allIndices = new Set([
          ...Object.keys(statusMap),
          ...Object.keys(nameMap),
          ...Object.keys(snMap)
        ]);

        stats.onus_total = allIndices.size;
        const onus = [];
        let weakCount = 0;

        for (const idx of allIndices) {
          const stRaw = statusMap[idx];
          const stInt = bufferToInt(stRaw);
          const stStr = String(stRaw || '').trim().toLowerCase();
          
          const isUp = stInt != null
            ? onlineVals.includes(stInt)
            : (stStr.includes('up') || stStr.includes('online') || stStr.includes('working') || stStr.includes('active'));

          const rawName = nameMap[idx];
          const cleanName = cleanOnuName(rawName) || `ONU-${idx}`;
          const sn = snMap[idx] ? decodeSn(snMap[idx]) : '-';

          const rxRaw = findOpticalValue(rxMap, idx);
          let txRaw = findOpticalValue(txMap1, idx);
          if (txRaw == null) txRaw = findOpticalValue(txMap2, idx);

          const rx = decodeOpticalPower(rxRaw);
          const tx = decodeOpticalPower(txRaw);
          const distance = decodeDistance(distMap[idx]);

          if (isUp) stats.onus_online++;
          else stats.onus_offline++;

          if (rx !== 'N/A') {
            const rxNum = parseFloat(rx);
            if (Number.isFinite(rxNum) && rxNum < -27) weakCount++;
          }

          onus.push({
            index: idx,
            id: idx,
            name: cleanName,
            sn,
            status: isUp ? 'Online' : 'Offline',
            tx,
            rx,
            distance,
            firmware: '-',
            uptime: '-'
          });
        }

        stats.onus_weak = weakCount;
        stats.onus = enrichOnusWithCustomerData(onus.sort((a, b) => a.name.localeCompare(b.name)));
        safeResolve(stats);
      } catch (err) {
        stats.error = err.message;
        safeResolve(stats);
      }
    })();
  });
}

// >>> [MULAI KODE PENGGANTI BARU] <<<
// ============================================================================
// >>> PERBAIKAN: AMBIL MAC ADDRESS LANGSUNG DARI TABEL CUSTOMERS DATABASE <<<
// ============================================================================
function enrichOnusWithCustomerData(onus) {
  if (!Array.isArray(onus) || onus.length === 0) return onus;
  try {
    const custs = db.prepare(`
      SELECT id, name, pppoe_username, mac_address, genieacs_tag, phone, address 
      FROM customers
    `).all() || [];
    
    for (const onu of onus) {
      const snClean = String(onu.sn || '').replace(/[^a-zA-Z0-9]/g, '').toLowerCase();
      const onuNameClean = String(onu.name || '').trim().toLowerCase();

      let matched = null;

      for (const c of custs) {
        const cTag = String(c.genieacs_tag || '').replace(/[^a-zA-Z0-9]/g, '').toLowerCase();
        const cMac = String(c.mac_address || '').replace(/[^a-zA-Z0-9]/g, '').toLowerCase();
        const cUser = String(c.pppoe_username || '').trim().toLowerCase();
        const cName = String(c.name || '').trim().toLowerCase();

        // 1. Prioritas Utama: Cocok Berdasarkan Serial Number (SN) / Tag / MAC (Harus persis sama)
        if (snClean && snClean.length >= 4) {
          if (cTag && cTag === snClean) { matched = c; break; }
          if (cMac && cMac === snClean) { matched = c; break; }
        }

        // 2. Prioritas Kedua: Username PPPoE HARUS SAMA PERSIS (Exact Match)
        if (cUser && cUser === onuNameClean) {
          matched = c;
          break;
        }

        // 3. Prioritas Ketiga: Nama Pelanggan Sama Persis
        if (cName && cName === onuNameClean) {
          matched = c;
          break;
        }
      }

      if (matched) {
        onu.customer_id = matched.id;
        onu.customer_name = matched.name;
        onu.customer_phone = matched.phone || null;
        onu.mac_address = matched.mac_address || '-';
      }
    }
  } catch (e) {
    logger.error(`[EnrichError] ${e.message}`);
  }
  return onus;
}
