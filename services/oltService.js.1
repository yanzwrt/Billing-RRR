/**
 * Ubah Nama / Deskripsi ONU MURNI via MIB SNMP SET (Instan & Beban CPU 0%)
 * OID: 1.3.6.1.4.1.17409.2.8.4.1.1.2.{index}
 */
async function renameOnu(oltId, index, newName) {
  const olt = getOltById(oltId);
  if (!olt) throw new Error('OLT tidak ditemukan');

  const community = olt.snmp_community || 'private';
  const session = snmp.createSession(olt.host, community, { 
    port: olt.snmp_port || 161, 
    version: snmp.Version2c,
    timeout: 3000
  });

  const oid = `1.3.6.1.4.1.17409.2.8.4.1.1.2.${index}`;

  return new Promise((resolve, reject) => {
    session.set([{ oid, type: snmp.ObjectType.OctetString, value: String(newName) }], (error) => {
      session.close();
      if (error) {
        logger.error(`[SNMP-Rename] Gagal ubah nama index ${index}: ${error.message}`);
        reject(new Error(`Gagal mengubah nama via MIB SNMP: ${error.message}`));
      } else {
        logger.info(`[SNMP-Rename] Berhasil ubah nama index ${index} -> ${newName}`);
        statsCache.clear();
        resolve(true);
      }
    });
  });
}

