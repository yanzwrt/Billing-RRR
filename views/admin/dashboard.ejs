async function initCustomerCache() {
  try {
    const res = await fetch('/admin/customers/export');
  } catch(e) {}
}

function escHtml(s) {
  return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

function getDeviceCustomerName(d) {
  if (!d) return 'Perangkat Tanpa Nama';

  if (d.customer_name && d.customer_name !== '-' && d.customer_name !== 'N/A') {
    return d.customer_name;
  }

  let ssidClean = String(d.ssid || '').trim();
  if (ssidClean && ssidClean !== '-' && !ssidClean.toLowerCase().startsWith('zte') && !ssidClean.toLowerCase().startsWith('huawei')) {
    let candidate = ssidClean.replace(/^IKDMP[-_\s]*/i, '').trim();
    if (candidate.length > 2) return candidate;
  }

  let pppoe = String(d.pppoeUsername || '').trim();
  if (pppoe && pppoe !== '-' && pppoe !== 'N/A') {
    if (pppoe.includes('@')) return pppoe.split('@')[1].toUpperCase();
    return pppoe;
  }

  const rawTags = Array.isArray(d.tags) ? d.tags : [d.tags || ''];
  const cleanTags = rawTags.filter(Boolean).map(t => String(t).trim());
  return cleanTags[0] || d.serialNumber || 'Pelanggan';
}

const I18N = {
