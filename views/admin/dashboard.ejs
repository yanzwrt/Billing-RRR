<!-- [TAMBAHAN: LOGIKA REGISTRASI PUSH NOTIFIKASI ADMIN] -->
<script>
  function urlB64ToUint8(base64String) {
    const padding = '='.repeat((4 - (base64String.length % 4)) % 4);
    const base64 = (base64String + padding).replace(/\-/g, '+').replace(/_/g, '/');
    const rawData = window.atob(base64);
    const outputArray = new Uint8Array(rawData.length);
    for (let i = 0; i < rawData.length; ++i) {
      outputArray[i] = rawData.charCodeAt(i);
    }
    return outputArray;
  }

  async function enablePushAdmin() {
    try {
      const permission = await Notification.requestPermission();
      if (permission !== 'granted') {
        alert('Izin notifikasi ditolak. Harap izinkan notifikasi di setelan browser HP Anda.');
        return;
      }

      const promptEl = document.getElementById('pushPromptAdmin');
      if (promptEl) promptEl.style.display = 'none';

      if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
        throw new Error('Browser ini tidak mendukung Push Notifications.');
      }

      const registration = await navigator.serviceWorker.register('/sw.js', { scope: '/' });
      
      let activeWorker = registration.active;
      if (!activeWorker) {
        await new Promise((resolve) => {
          navigator.serviceWorker.ready.then((reg) => {
            activeWorker = reg.active;
            resolve();
          });
          setTimeout(resolve, 3000);
        });
      }

      const keyRes = await fetch('/api/push/public-key');
      const keyData = await keyRes.json();
      if (!keyData.success || !keyData.publicKey) {
        throw new Error('Gagal mengambil kunci keamanan server.');
      }

      let subscription = await registration.pushManager.getSubscription();
      if (!subscription) {
        subscription = await registration.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey: urlB64ToUint8(keyData.publicKey)
        });
      }

      const saveRes = await fetch('/api/push/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          role: 'admin',
          userId: 'admin',
          subscription: subscription
        })
      });
      const saveResult = await saveRes.json();

      if (saveResult.success) {
        alert('✅ Berhasil! Perangkat Anda kini terdaftar untuk menerima notifikasi.');
        fetch('/api/push/test', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            role: 'admin',
            title: '🔔 NOTIFIKASI ADMIN',
            body: 'Notifikasi berhasil masuk ke panel Android Anda!',
            url: '/admin'
          })
        });
      } else {
        alert('Gagal menyimpan token ke server: ' + saveResult.error);
      }
    } catch (e) {
      console.error('Push Error:', e);
      alert('Gagal mengaktifkan: ' + e.message);
    }
  }

  window.addEventListener('DOMContentLoaded', async () => {
    const isLocalHttp = window.location.protocol === 'http:' && 
                        window.location.hostname !== 'localhost' && 
                        window.location.hostname !== '127.0.0.1';
    
    if (isLocalHttp) return;

    if (!('serviceWorker' in navigator) || !('PushManager' in window)) return;
    
    if (Notification.permission !== 'granted') {
      const promptEl = document.getElementById('pushPromptAdmin');
      if (promptEl) promptEl.style.display = 'flex';
    } else {
      try {
        const reg = await getAdminServiceWorker();
        let sub = await reg.pushManager.getSubscription();
        if (sub) {
          fetch('/api/push/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ role: 'admin', userId: 'admin', subscription: sub })
          });
        }
      } catch (err) {}
    }
  });
</script>

<!-- [TAMBAHAN: ENGINE MONITORING TRAFIK & CUSTOM CENTER MODAL] -->
<script>
// --- 1. MODAL DIALOG POPUP CENTER SYSTEM ---
function showCenterAlert(title, message, type = 'info') {
  return new Promise((resolve) => {
    const overlay = document.getElementById('appCenterModal');
    const iconWrap = document.getElementById('appCenterIcon');
    const iconI = document.getElementById('appCenterIconI');
    const titleEl = document.getElementById('appCenterTitle');
    const descEl = document.getElementById('appCenterDesc');
    const btnsWrap = document.getElementById('appCenterBtns');

    iconWrap.className = 'app-center-icon ' + type;
    if (type === 'warn') iconI.className = 'bi bi-exclamation-triangle-fill';
    else if (type === 'danger') iconI.className = 'bi bi-x-circle-fill';
    else if (type === 'success') iconI.className = 'bi bi-check-circle-fill';
    else iconI.className = 'bi bi-info-circle-fill';

    titleEl.textContent = title;
    descEl.textContent = message;

    btnsWrap.innerHTML = `
      <button type="button" class="btn btn-p" id="appCenterBtnOk" style="background:var(--primary);color:#fff;">OK</button>
    `;

    document.getElementById('appCenterBtnOk').onclick = () => {
      overlay.classList.remove('show');
      resolve(true);
    };

    overlay.classList.add('show');
  });
}

function showCenterConfirm(title, message, confirmText = 'Lanjutkan', cancelText = 'Batal', type = 'warn') {
  return new Promise((resolve) => {
    const overlay = document.getElementById('appCenterModal');
    const iconWrap = document.getElementById('appCenterIcon');
    const iconI = document.getElementById('appCenterIconI');
    const titleEl = document.getElementById('appCenterTitle');
    const descEl = document.getElementById('appCenterDesc');
    const btnsWrap = document.getElementById('appCenterBtns');

    iconWrap.className = 'app-center-icon ' + type;
    if (type === 'danger') iconI.className = 'bi bi-trash-fill';
    else iconI.className = 'bi bi-exclamation-triangle-fill';

    titleEl.textContent = title;
    descEl.textContent = message;

    btnsWrap.innerHTML = `
      <button type="button" class="btn btn-g" id="appCenterBtnCancel">${cancelText}</button>
      <button type="button" class="btn ${type === 'danger' ? 'btn-d' : 'btn-p'}" id="appCenterBtnConfirm" style="background:${type === 'danger' ? 'var(--danger)' : 'var(--primary)'};color:#fff;">${confirmText}</button>
    `;

    document.getElementById('appCenterBtnCancel').onclick = () => {
      overlay.classList.remove('show');
      resolve(false);
    };

    document.getElementById('appCenterBtnConfirm').onclick = () => {
      overlay.classList.remove('show');
      resolve(true);
    };

    overlay.classList.add('show');
  });
}

