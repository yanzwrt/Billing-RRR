// --- 2. LOGIKA MONITORING TRAFIK REAL-TIME ---
let trafficChart = null;
let trafficPollingTimer = null;
let trafficPollingActive = false;
let currentRouterId = null;
let currentInterfaceName = null;
let currentInterfaceList = [];
let peakRxMbps = 0;
let peakTxMbps = 0;

async function initTrafficSection() {
  initTrafficChart();
  await loadTrafficRouters();
}

function initTrafficChart() {
  const canvas = document.getElementById('trafficLiveChart');
  if (!canvas) return;
  if (trafficChart) return;

  const ctx = canvas.getContext('2d');
  const labels = Array(20).fill('');
  const initialDataRx = Array(20).fill(0);
  const initialDataTx = Array(20).fill(0);

  trafficChart = new Chart(ctx, {
    type: 'line',
    data: {
      labels: labels,
      datasets: [
        {
          label: 'Download (RX)',
          data: initialDataRx,
          borderColor: '#10b981',
          backgroundColor: 'rgba(16, 185, 129, 0.12)',
          fill: true,
          tension: 0.35,
          borderWidth: 2,
          pointRadius: 2,
          pointHoverRadius: 5
        },
        {
          label: 'Upload (TX)',
          data: initialDataTx,
          borderColor: '#3b82f6',
          backgroundColor: 'rgba(59, 130, 246, 0.12)',
          fill: true,
          tension: 0.35,
          borderWidth: 2,
          pointRadius: 2,
          pointHoverRadius: 5
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      animation: false,
      plugins: {
        legend: {
          display: true,
          position: 'top',
          labels: { color: getComputedStyle(document.body).getPropertyValue('--text') || '#cbd5e1', font: { weight: '600' } }
        },
        tooltip: {
          callbacks: {
            label: (ctx) => `${ctx.dataset.label}: ${ctx.parsed.y.toFixed(2)} Mbps`
          }
        }
      },
      scales: {
        x: { grid: { display: false }, ticks: { display: false } },
        y: {
          beginAtZero: true,
          grid: { color: 'rgba(148, 163, 184, 0.1)' },
          ticks: {
            color: getComputedStyle(document.body).getPropertyValue('--muted') || '#94a3b8',
            callback: (val) => val + ' Mbps'
          }
        }
      }
    }
  });
}

/* [GANTI: LOAD ROUTER DENGAN MEMORI ROUTER TERAKHIR]                        */
async function loadTrafficRouters() {
  const selectRouter = document.getElementById('tf-select-router');
  try {
    const res = await fetch('/admin/api/traffic/routers');
    const json = await res.json();

    if (!json.ok || !Array.isArray(json.routers) || json.routers.length === 0) {
      selectRouter.innerHTML = '<option value="" disabled selected>Tidak ada router aktif</option>';
      return;
    }

    // Ambil riwayat router terakhir yang pernah dibuka dari localStorage
    const savedLastRouterId = localStorage.getItem('tf_last_selected_router');
    const isSavedRouterValid = json.routers.some(r => String(r.id) === String(savedLastRouterId));
    
    // Gunakan router yang tersimpan jika ada, jika tidak default ke router pertama
    currentRouterId = isSavedRouterValid ? savedLastRouterId : json.routers[0].id;

    selectRouter.innerHTML = json.routers.map((r) => {
      const isSelected = String(r.id) === String(currentRouterId);
      const typeStr = [r.isPppoe ? 'PPPoE' : '', r.isHotspot ? 'Hotspot' : ''].filter(Boolean).join('/');
      const label = `${r.name} (${r.host}) ${typeStr ? '[' + typeStr + ']' : ''}`;
      return `<option value="${r.id}" ${isSelected ? 'selected' : ''}>${escHtml(label)}</option>`;
    }).join('');

    await loadTrafficInterfaces(currentRouterId);
  } catch (err) {
    selectRouter.innerHTML = '<option value="" disabled selected>Gagal memuat router</option>';
  }
}

/* [GANTI: LOAD INTERFACE DENGAN MEMORI INTERFACE PER ROUTER]                */
async function loadTrafficInterfaces(routerId) {
  const selectIface = document.getElementById('tf-select-interface');
  selectIface.innerHTML = '<option value="" disabled selected>Memuat interface...</option>';
  stopTrafficPolling();

  try {
    const res = await fetch('/admin/api/traffic/interfaces?router_id=' + routerId);
    const json = await res.json();

    if (!json.ok || !Array.isArray(json.interfaces) || json.interfaces.length === 0) {
      selectIface.innerHTML = '<option value="" disabled selected>Tidak ada interface ditemukan</option>';
      renderInterfacesTable([]);
      return;
    }

    currentInterfaceList = json.interfaces;

    // KUNCI: Cek apakah ada interface yang pernah dipilih khusus untuk router ini
    const memoryKey = 'tf_saved_iface_router_' + routerId;
    const savedIfaceForThisRouter = localStorage.getItem(memoryKey);

    // Cek apakah interface yang diingat masih ada di router
    const matchedSaved = currentInterfaceList.find(i => i.name === savedIfaceForThisRouter);
    
    // Jika ada yang tersimpan gunakan itu, jika belum ada default ke interface pertama
    const defaultTarget = matchedSaved || currentInterfaceList[0];
    currentInterfaceName = defaultTarget.name;

    // Simpan status aktif
    localStorage.setItem(memoryKey, currentInterfaceName);
    localStorage.setItem('tf_last_selected_router', routerId);

    selectIface.innerHTML = currentInterfaceList.map((i) => {
      const isSelected = i.name === currentInterfaceName;
      const statusIcon = i.running ? '🟢' : '⚪';
      const commentStr = i.comment ? ` - ${i.comment}` : '';
      return `<option value="${escHtml(i.name)}" ${isSelected ? 'selected' : ''}>${statusIcon} ${escHtml(i.name)} (${i.type}${commentStr})</option>`;
    }).join('');

    renderInterfacesTable(currentInterfaceList);
    updateInterfaceStaticInfo(defaultTarget);

    // Reset dan atur grafik ke interface yang terpilih
    peakRxMbps = 0;
    peakTxMbps = 0;
    document.getElementById('tf-chart-peak').textContent = 'Puncak: RX 0 Mbps | TX 0 Mbps';
    document.getElementById('tf-chart-target-label').textContent = `${currentInterfaceName}`;

    if (trafficChart) {
      trafficChart.data.datasets[0].data = Array(20).fill(0);
      trafficChart.data.datasets[1].data = Array(20).fill(0);
      trafficChart.update();
    }

    startTrafficPolling();
  } catch (err) {
    selectIface.innerHTML = '<option value="" disabled selected>Gagal membaca interface</option>';
  }
}

function renderInterfacesTable(interfaces) {
  const tbody = document.getElementById('tf-interfaces-tbody');
  const badge = document.getElementById('tf-total-interfaces-badge');
  badge.textContent = `${interfaces.length} interface`;

  if (interfaces.length === 0) {
    tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted" style="padding:24px;">Tidak ada interface pada router ini</td></tr>';
    return;
  }

  tbody.innerHTML = interfaces.map((i, idx) => {
    const isSelected = i.name === currentInterfaceName;
    const runningBadge = i.running 
      ? '<span class="badge ds-on"><span class="dot dot-on"></span>Running</span>'
      : (i.disabled ? '<span class="badge bd">Disabled</span>' : '<span class="badge bm">Link Down</span>');
    
    const rxStr = formatBytes(i.rxByte);
    const txStr = formatBytes(i.txByte);

    return `
      <tr style="${isSelected ? 'background:rgba(59,130,246,0.08);font-weight:600;' : ''}">
        <td class="text-muted">${idx + 1}</td>
        <td>
          <div style="font-weight:700;">${escHtml(i.name)}</div>
          <div style="font-size:11px;color:var(--muted);">${escHtml(i.comment || '')}</div>
        </td>
        <td><span class="badge bm">${escHtml(i.type)}</span></td>
        <td>${runningBadge}</td>
        <td><code>${escHtml(i.macAddress)}</code></td>
        <td><i class="bi bi-arrow-down" style="color:var(--success)"></i> ${rxStr}</td>
        <td><i class="bi bi-arrow-up" style="color:var(--primary)"></i> ${txStr}</td>
        <td style="text-align:center;">
          <button class="btn btn-g btn-sm" onclick="selectInterfaceFromTable('${escHtml(i.name)}')">
            <i class="bi bi-activity"></i> Pantau
          </button>
        </td>
      </tr>
    `;
  }).join('');
}

function selectInterfaceFromTable(name) {
  const selectIface = document.getElementById('tf-select-interface');
  selectIface.value = name;
  onTrafficInterfaceChange();
}

function updateInterfaceStaticInfo(iface) {
  if (!iface) return;
  const statusEl = document.getElementById('tf-val-status');
  statusEl.innerHTML = iface.running 
    ? '<span style="color:var(--success);font-weight:800;"><i class="bi bi-check-circle-fill"></i> Link Aktif (Up)</span>'
    : (iface.disabled ? '<span style="color:var(--danger);font-weight:800;"><i class="bi bi-dash-circle-fill"></i> Dinonaktifkan</span>' : '<span style="color:var(--muted);font-weight:800;"><i class="bi bi-x-circle"></i> Link Putus (Down)</span>');

  document.getElementById('tf-sub-type').textContent = `Tipe Port: ${iface.type}`;
  document.getElementById('tf-val-mac').textContent = iface.macAddress || '-';
  document.getElementById('tf-sub-comment').textContent = `Catatan: ${iface.comment || '-'}`;
  document.getElementById('tf-sub-rx').textContent = `Akumulasi: ${formatBytes(iface.rxByte)}`;
  document.getElementById('tf-sub-tx').textContent = `Akumulasi: ${formatBytes(iface.txByte)}`;
}

function onTrafficRouterChange() {
  currentRouterId = document.getElementById('tf-select-router').value;
  loadTrafficInterfaces(currentRouterId);
}

/* [GANTI: SIMPAN INTERFACE SETIAP KALI USER MEMILIH INTERFACE BARU]         */
function onTrafficInterfaceChange() {
  currentInterfaceName = document.getElementById('tf-select-interface').value;

  // SIMPAN KE MEMORI BROWSER SPESIFIK UNTUK ROUTER INI
  if (currentRouterId && currentInterfaceName) {
    localStorage.setItem('tf_saved_iface_router_' + currentRouterId, currentInterfaceName);
  }

  const target = currentInterfaceList.find(i => i.name === currentInterfaceName);
  if (target) updateInterfaceStaticInfo(target);
  renderInterfacesTable(currentInterfaceList);

  peakRxMbps = 0;
  peakTxMbps = 0;
  document.getElementById('tf-chart-peak').textContent = 'Puncak: RX 0 Mbps | TX 0 Mbps';
  document.getElementById('tf-chart-target-label').textContent = `${currentInterfaceName}`;

  if (trafficChart) {
    trafficChart.data.datasets[0].data = Array(20).fill(0);
    trafficChart.data.datasets[1].data = Array(20).fill(0);
    trafficChart.update();
  }

  startTrafficPolling();
}

function startTrafficPolling() {
  stopTrafficPolling();
  trafficPollingActive = true;
  document.getElementById('btn-poll-icon').className = 'bi bi-pause-fill';
  document.getElementById('btn-poll-label').textContent = 'Pause Polling';
  document.getElementById('tf-live-indicator').style.background = 'var(--success)';
  document.getElementById('tf-live-status-text').textContent = 'Traffic Live';

  pollTrafficSample();
  trafficPollingTimer = setInterval(pollTrafficSample, 2500);
}

function stopTrafficPolling() {
  if (trafficPollingTimer) {
    clearInterval(trafficPollingTimer);
    trafficPollingTimer = null;
  }
  trafficPollingActive = false;
  const icon = document.getElementById('btn-poll-icon');
  const label = document.getElementById('btn-poll-label');
  const ind = document.getElementById('tf-live-indicator');
  const txt = document.getElementById('tf-live-status-text');
  if (icon) icon.className = 'bi bi-play-fill';
  if (label) label.textContent = 'Mulai Polling';
  if (ind) ind.style.background = 'var(--muted)';
  if (txt) txt.textContent = 'Polling Dijeda';
}

function toggleTrafficPolling() {
  if (trafficPollingActive) stopTrafficPolling();
  else startTrafficPolling();
}

async function pollTrafficSample() {
  if (!currentRouterId || !currentInterfaceName) return;

  try {
    const url = `/admin/api/traffic/monitor?router_id=${encodeURIComponent(currentRouterId)}&interface=${encodeURIComponent(currentInterfaceName)}`;
    const res = await fetch(url);
    const json = await res.json();

    if (!json.ok || !json.data) return;

    const d = json.data;
    const rx = Number(d.rxMbps || 0);
    const tx = Number(d.txMbps || 0);

    document.getElementById('tf-val-rx').innerHTML = `${rx.toFixed(2)} <span style="font-size:13px;font-weight:600;">Mbps</span>`;
    document.getElementById('tf-val-tx').innerHTML = `${tx.toFixed(2)} <span style="font-size:13px;font-weight:600;">Mbps</span>`;

    if (rx > peakRxMbps) peakRxMbps = rx;
    if (tx > peakTxMbps) peakTxMbps = tx;
    document.getElementById('tf-chart-peak').textContent = `Puncak: RX ${peakRxMbps.toFixed(2)} Mbps | TX ${peakTxMbps.toFixed(2)} Mbps`;

    const now = new Date();
    document.getElementById('tf-clock-last').textContent = 'Pembaruan: ' + now.toLocaleTimeString('id-ID');

    if (trafficChart) {
      const timeLabel = now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0') + ':' + now.getSeconds().toString().padStart(2, '0');
      
      trafficChart.data.labels.shift();
      trafficChart.data.labels.push(timeLabel);

      trafficChart.data.datasets[0].data.shift();
      trafficChart.data.datasets[0].data.push(rx);

      trafficChart.data.datasets[1].data.shift();
      trafficChart.data.datasets[1].data.push(tx);

      trafficChart.update('none');
    }
  } catch (err) {}
}

function formatBytes(bytes) {
  const b = Number(bytes || 0);
  if (b === 0) return '0 B';
  const k = 1024;
  const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
  const i = Math.floor(Math.log(b) / Math.log(k));
  return parseFloat((b / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}
