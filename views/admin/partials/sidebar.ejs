<!-- >>> AKHIR CSS KHUSUS DROPDOWN NOTIFIKASI <<< -->

<script>
(function() {
  function updateSidebarGreetingAndClock() {
    // Menghitung waktu khusus zona WIB (UTC+7)
    const now = new Date();
    const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
    const wibTime = new Date(utc + (3600000 * 7));

    const hours = wibTime.getHours();
    const minutes = String(wibTime.getMinutes()).padStart(2, '0');
    const seconds = String(wibTime.getSeconds()).padStart(2, '0');

    // Menentukan sapaan berdasarkan jam WIB
    let greeting = 'Selamat Malam';
    if (hours >= 4 && hours < 11) {
      greeting = 'Selamat Pagi';
    } else if (hours >= 11 && hours < 15) {
      greeting = 'Selamat Siang';
    } else if (hours >= 15 && hours < 18) {
      greeting = 'Selamat Sore';
    }

    // Pasang ke elemen UI
    const greetingEl = document.getElementById('sbGreetingText');
    const clockEl = document.getElementById('sbLiveClock');

    if (greetingEl) greetingEl.textContent = greeting;
    if (clockEl) clockEl.textContent = `${String(hours).padStart(2, '0')}:${minutes}:${seconds} WIB`;
  }

  // Jalankan langsung saat halaman termuat
  updateSidebarGreetingAndClock();
  // Perbarui jam setiap detik secara realtime
  setInterval(updateSidebarGreetingAndClock, 1000);
})();
</script>

<!-- >>> AWAL JAVASCRIPT NOTIFIKASI SIDEBAR (TELEPORT KE BODY & TOUCH UNLOCKED) <<< -->
<script>
let currentServerNotifTotal = 0;

function getNotifItemKey(item) {
  const subId = item.latestId || item.count || 0;
  return `${item.type}_${subId}`;
}

function getDismissedNotifKeys() {
  try {
    return JSON.parse(localStorage.getItem('dismissed_notif_keys') || '[]');
  } catch (_) {
    return [];
  }
}

function onNotificationItemClick(itemType, latestId, count) {
  const subId = latestId || count || 0;
  const key = `${itemType}_${subId}`;
  
  const dismissed = getDismissedNotifKeys();
  if (!dismissed.includes(key)) {
    dismissed.push(key);
    if (dismissed.length > 50) dismissed.shift();
    localStorage.setItem('dismissed_notif_keys', JSON.stringify(dismissed));
  }

  if (itemType === 'payment_invoice' && latestId) {
    localStorage.setItem('last_seen_paid_invoice_id', latestId);
  }

  fetchSidebarNotifications();
}

function positionNotifDropdown() {
  const dropdown = document.getElementById('sidebarNotifDropdown');
  const btn = document.getElementById('btnSidebarNotif');
  if (!dropdown || !btn) return;

  const rect = btn.getBoundingClientRect();
  const dropdownWidth = Math.min(290, window.innerWidth - 20);
  const screenWidth = window.innerWidth;
  const screenHeight = window.innerHeight;

  let top = rect.bottom + 8;
  let left = rect.left;

  // Sesuaikan posisi jika di layar ponsel/PWA keluar tepi
  if (left + dropdownWidth > screenWidth - 10) {
    left = screenWidth - dropdownWidth - 10;
  }
  if (left < 10) {
    left = 10;
  }

  dropdown.style.width = `${dropdownWidth}px`;
  dropdown.style.top = `${top}px`;
  dropdown.style.left = `${left}px`;

  // Hitung sisa ruang tinggi layar agar list otomatis membatasi tinggi dan memunculkan scrollbar
  const listEl = document.getElementById('sbNotifListContainer');
  const availableListHeight = Math.max(140, screenHeight - top - 110);
  if (listEl) {
    listEl.style.maxHeight = `${availableListHeight}px`;
    listEl.style.height = 'auto';
  }
}

function toggleSidebarNotifDropdown(event) {
  if (event) {
    event.preventDefault();
    event.stopPropagation();
  }
  const dropdown = document.getElementById('sidebarNotifDropdown');
  if (!dropdown) return;

  const isShown = dropdown.classList.contains('show');
  if (!isShown) {
    document.querySelectorAll('.sb-notif-dropdown.show').forEach(el => el.classList.remove('show'));
    dropdown.classList.add('show');
    positionNotifDropdown();
    fetchSidebarNotifications();
  } else {
    dropdown.classList.remove('show');
  }
}

// Tutup jika klik di luar dropdown
document.addEventListener('click', function(e) {
  const dropdown = document.getElementById('sidebarNotifDropdown');
  const btn = document.getElementById('btnSidebarNotif');
  if (dropdown && dropdown.classList.contains('show')) {
    if (!dropdown.contains(e.target) && (!btn || !btn.contains(e.target))) {
      dropdown.classList.remove('show');
    }
  }
});

async function fetchSidebarNotifications(isManual = false) {
  try {
    const lastSeenInvId = localStorage.getItem('last_seen_paid_invoice_id') || 0;
    const res = await fetch(`/admin/api/notifications/summary?last_seen_invoice_id=${encodeURIComponent(lastSeenInvId)}`);
    if (!res.ok) return;
    const data = await res.json();
    if (!data || !data.success) return;

    const badge = document.getElementById('sidebarNotifBadge');
    const icon = document.getElementById('sidebarNotifIcon');
    const totalBadge = document.getElementById('sbNotifTotalBadge');
    const container = document.getElementById('sbNotifListContainer');

    const dismissedKeys = new Set(getDismissedNotifKeys());

    const activeItems = (data.items || []).filter(item => {
      const key = getNotifItemKey(item);
      return !dismissedKeys.has(key);
    });

    const activeTotalCount = activeItems.reduce((acc, curr) => acc + (curr.count || 1), 0);

    if (badge) {
      if (activeTotalCount > 0) {
        badge.innerText = activeTotalCount > 99 ? '99+' : activeTotalCount;
        badge.style.display = 'block';
        if (icon) icon.style.color = '#ef4444';
      } else {
        badge.style.display = 'none';
        if (icon) icon.style.color = '#64748b';
      }
    }

    if (totalBadge) {
      totalBadge.innerText = `${activeTotalCount} Belum Dibaca`;
    }

    if (container) {
      if (activeItems.length > 0) {
        container.innerHTML = activeItems.map(item => `
          <a href="${item.url}" class="sb-notif-item" onclick="onNotificationItemClick('${item.type}', ${item.latestId || 0}, ${item.count || 1})">
            <div class="sb-notif-icon-box" style="background: ${item.color}20; color: ${item.color};">
              <i class="bi ${item.icon}"></i>
            </div>
            <div class="sb-notif-body">
              <div class="sb-notif-title">${item.title}</div>
              <div class="sb-notif-desc">${item.desc}</div>
            </div>
            <div class="sb-notif-badge-pill" style="background: ${item.color}20; color: ${item.color};">
              ${item.count}
            </div>
          </a>
        `).join('');
      } else {
        container.innerHTML = `
          <div style="text-align: center; padding: 25px 10px; color: #94a3b8; font-size: 11px;">
            <i class="bi bi-bell-slash" style="font-size: 24px; display: block; margin-bottom: 6px; opacity: 0.6;"></i>
            Semua beres! Tidak ada notifikasi tertunda.
          </div>
        `;
      }
    }

    if (isManual) {
      const btnIcon = document.querySelector('#sidebarNotifDropdown .sb-notif-footer i');
      if (btnIcon) {
        btnIcon.classList.add('spin');
        setTimeout(() => btnIcon.classList.remove('spin'), 600);
      }
    }
  } catch (err) {
    console.debug('[Notif] Polling error:', err);
  }
}

// INISIALISASI & TELEPORTASI KE LUAR CONTAINER SIDEBAR
document.addEventListener('DOMContentLoaded', () => {
  const dropdown = document.getElementById('sidebarNotifDropdown');
  // Pindahkan elemen dropdown langsung ke document.body agar tidak terkunci oleh transform/overflow sidebar HP
  if (dropdown && dropdown.parentElement !== document.body) {
    document.body.appendChild(dropdown);
  }

  // Buka blokir touch event di HP Android agar usapan jari tidak dicegat sidebar
  if (dropdown) {
    dropdown.addEventListener('touchmove', function(e) {
      e.stopPropagation();
    }, { passive: true });
    dropdown.addEventListener('wheel', function(e) {
      e.stopPropagation();
    }, { passive: true });
  }

  fetchSidebarNotifications();
  setInterval(fetchSidebarNotifications, 12000);
});

window.addEventListener('resize', () => {
  const dropdown = document.getElementById('sidebarNotifDropdown');
  if (dropdown && dropdown.classList.contains('show')) {
    positionNotifDropdown();
  }
});
</script>
<!-- >>> AKHIR JAVASCRIPT NOTIFIKASI SIDEBAR <<< -->

<script>
  function toggleSidebar() {
    const sb = document.getElementById('sidebar');
    const ov = document.getElementById('sidebarOverlay');
    sb.classList.toggle('open');
    ov.classList.toggle('show');
  }

  function showLockedMenuNotice(message) {
    const modal = document.getElementById('lockedMenuModal');
    const messageBox = document.getElementById('lockedMenuModalMessage');
    if (messageBox) {
      messageBox.textContent = message || 'Menu ini sedang terkunci.';
    }
    if (modal) {
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
    return false;
  }

  function hideLockedMenuNotice() {
    const modal = document.getElementById('lockedMenuModal');
    if (modal) {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }
  }

  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') hideLockedMenuNotice();
  });
</script>
<script src="/js/theme.js"></script>
<script src="/js/soundbox.js"></script>

<!-- Bottom Navigation (Mobile Only) -->
<nav class="bottom-nav" id="bottomNav">
  <% (sidebarBottomNavItems || []).slice(0, 4).forEach((item) => { %>
    <a
      href="<%= item.hrefResolved %>"
      class="bn-item <%= (item.activePages || []).includes(activePage) ? 'active' : '' %>"
      <% if (item.locked) { %>
        onclick='return showLockedMenuNotice(<%- JSON.stringify(item.lockedMessage) %>)'
      <% } %>
    >
      <i class="<%= item.icon %>"></i>
      <span><%= item.labelKey ? t(item.labelKey, item.labelDefault) : item.labelDefault %></span>
    </a>
  <% }) %>
  <button class="bn-item" onclick="toggleSidebar()">
    <i class="bi bi-grid-3x3-gap"></i>
    <span><%= t('common.menu', 'Menu') %></span>
  </button>
</nav>
