<script>
// === MULAI PERUBAHAN: SCRIPT DETAIL LIVE RAPI & DIALOG CENTER ===
const routersData = JSON.parse(document.getElementById('routers-data').textContent);
let currentModalRouterId = null;
let currentModalData = null;

const I18N = {
  testConfirm: "<%= t('admin.routers.confirm.test', 'Test koneksi ke router ini?') %>",
  systemError: "<%= t('admin.routers.js.system_error', 'Terjadi kesalahan sistem.') %>"
};

/* --- FUNGSI DIALOG CENTER KUSTOM (ALERT & CONFIRM) --- */
function showCustomAlert(message, type = 'info', title = null) {
  return new Promise((resolve) => {
    const overlay = document.getElementById('customDialogOverlay');
    const iconEl = document.getElementById('customDialogIcon');
    const titleEl = document.getElementById('customDialogTitle');
    const msgEl = document.getElementById('customDialogMsg');
    const btnsEl = document.getElementById('customDialogBtns');

    const icons = {
      success: '<i class="bi bi-check-circle-fill"></i>',
      danger: '<i class="bi bi-x-circle-fill"></i>',
      warning: '<i class="bi bi-exclamation-triangle-fill"></i>',
      info: '<i class="bi bi-info-circle-fill"></i>'
    };

    const defaultTitles = {
      success: 'Berhasil',
      danger: 'Terjadi Kesalahan',
      warning: 'Perhatian',
      info: 'Informasi'
    };

    iconEl.className = 'custom-dialog-icon ' + type;
    iconEl.innerHTML = icons[type] || icons.info;
    titleEl.textContent = title || defaultTitles[type] || 'Pemberitahuan';
    msgEl.innerHTML = message;

    btnsEl.innerHTML = `
      <button type="button" class="btn btn-p px-4 fw-bold" id="btn-dialog-ok">OK</button>
    `;

    overlay.classList.add('active');

    document.getElementById('btn-dialog-ok').onclick = () => {
      overlay.classList.remove('active');
      resolve(true);
    };
  });
}

function showCustomConfirm(message, title = 'Konfirmasi Tindakan', type = 'warning') {
  return new Promise((resolve) => {
    const overlay = document.getElementById('customDialogOverlay');
    const iconEl = document.getElementById('customDialogIcon');
    const titleEl = document.getElementById('customDialogTitle');
    const msgEl = document.getElementById('customDialogMsg');
    const btnsEl = document.getElementById('customDialogBtns');

    const icons = {
      warning: '<i class="bi bi-question-circle-fill"></i>',
      danger: '<i class="bi bi-exclamation-octagon-fill"></i>',
      info: '<i class="bi bi-shield-lock-fill"></i>'
    };

    iconEl.className = 'custom-dialog-icon ' + type;
    iconEl.innerHTML = icons[type] || icons.warning;
    titleEl.textContent = title;
    msgEl.innerHTML = message;

    btnsEl.innerHTML = `
      <button type="button" class="btn btn-g px-3" id="btn-dialog-cancel">Batal</button>
      <button type="button" class="btn ${type === 'danger' ? 'btn-d' : 'btn-p'} px-4 fw-bold" id="btn-dialog-confirm">Lanjutkan</button>
    `;

    overlay.classList.add('active');

    document.getElementById('btn-dialog-cancel').onclick = () => {
      overlay.classList.remove('active');
      resolve(false);
    };

    document.getElementById('btn-dialog-confirm').onclick = () => {
      overlay.classList.remove('active');
      resolve(true);
    };
  });
}

async function confirmDeleteRouter(id, name) {
  const confirmed = await showCustomConfirm(
    `Apakah Anda yakin ingin menghapus router <strong>"${name}"</strong>?<br><span class="text-danger small">Tindakan ini tidak dapat dibatalkan.</span>`,
    'Hapus Router?',
    'danger'
  );

  if (confirmed) {
    const form = document.getElementById('globalDeleteForm');
    form.action = '/admin/routers/' + id + '/delete';
    form.submit();
  }
}

function openModal(id){document.getElementById(id).classList.add('show')}
function closeModal(id){document.getElementById(id).classList.remove('show')}

function switchView(mode) {
  const gridBtn = document.getElementById('btn-view-grid');
  const tableBtn = document.getElementById('btn-view-table');
  const gridContainer = document.getElementById('view-grid-container');
  const tableContainer = document.getElementById('view-table-container');

  if (mode === 'grid') {
    gridBtn.classList.add('active');
    tableBtn.classList.remove('active');
    gridContainer.style.display = 'grid';
    tableContainer.style.display = 'none';
  } else {
    tableBtn.classList.add('active');
    gridBtn.classList.remove('active');
    gridContainer.style.display = 'none';
    tableContainer.style.display = 'block';
  }
}

function formatBytes(bytes) {
  if (!bytes || bytes === 0) return '0 MB';
  const mb = bytes / (1024 * 1024);
  return mb >= 1024 ? (mb / 1024).toFixed(1) + ' GB' : mb.toFixed(0) + ' MB';
}

async function loadRouterLiveSummary(r) {
  try {
    const res = await fetch('/admin/api/routers/' + r.id + '/details');
    const data = await res.json();
    if (!data.success || !data.live) return;

    const live = data.live;
    const pill = document.getElementById('status-pill-' + r.id);
    const cpuLbl = document.getElementById('cpu-load-lbl-' + r.id);
    const cpuBar = document.getElementById('cpu-load-bar-' + r.id);
    const ramLbl = document.getElementById('ram-usage-lbl-' + r.id);
    const ramBar = document.getElementById('ram-usage-bar-' + r.id);
    const specCust = document.getElementById('spec-cust-' + r.id);
    const specPppoe = document.getElementById('spec-pppoe-' + r.id);
    const specHs = document.getElementById('spec-hs-' + r.id);

    if (pill) {
      if (live.connected) {
        pill.className = 'rc-status-pill online';
        pill.innerHTML = '<span class="rc-status-dot"></span> Online';
      } else {
        pill.className = 'rc-status-pill offline';
        pill.innerHTML = '<span class="rc-status-dot"></span> Offline';
      }
    }

    if (specCust) specCust.textContent = live.customersCount || 0;
    if (specPppoe) specPppoe.textContent = live.activePppoe || 0;
    if (specHs) specHs.textContent = live.activeHotspot || 0;

    if (live.connected) {
      const cpu = live.cpuLoad || 0;
      if (cpuLbl) cpuLbl.textContent = cpu + '%';
      if (cpuBar) {
        cpuBar.style.width = cpu + '%';
        cpuBar.className = 'rc-progress-bar ' + (cpu > 80 ? 'bg-red' : (cpu > 50 ? 'bg-yellow' : 'bg-green'));
      }

      if (live.totalMemory > 0) {
        const usedMem = live.totalMemory - live.freeMemory;
        const memPercent = Math.round((usedMem / live.totalMemory) * 100);
        if (ramLbl) ramLbl.textContent = formatBytes(usedMem) + ' / ' + formatBytes(live.totalMemory);
        if (ramBar) {
          ramBar.style.width = memPercent + '%';
          ramBar.className = 'rc-progress-bar ' + (memPercent > 85 ? 'bg-red' : (memPercent > 65 ? 'bg-yellow' : 'bg-green'));
        }
      }
    }
  } catch (e) {}
}

function switchModalTab(tabName) {
  const tabs = ['sys', 'pppoe', 'hs'];
  tabs.forEach(t => {
    const btn = document.getElementById('mtab-btn-' + t);
    const content = document.getElementById('mtab-content-' + t);
    if (btn) btn.classList.toggle('active', t === tabName);
    if (content) content.style.display = (t === tabName) ? 'block' : 'none';
  });
}

/* --- TAMPILAN DETAIL LIVE YANG LEBIH RAPI & TERSTRUKTUR --- */
async function openLiveDetailModal(id) {
  currentModalRouterId = id;
  const router = routersData.find(r => r.id === id);
  const nameEl = document.getElementById('modal-router-name');
  const bodyEl = document.getElementById('modal-router-body');

  if (nameEl) nameEl.textContent = 'Detail Live: ' + (router ? router.name : '#' + id);
  bodyEl.innerHTML = `
    <div class="text-center py-5 text-muted">
      <i class="bi bi-arrow-repeat spin fs-1 mb-2 d-block text-primary"></i>
      <span class="fw-bold">Mengambil data telemetri MikroTik...</span>
    </div>
  `;
  openModal('routerLiveModal');

  try {
    const res = await fetch('/admin/api/routers/' + id + '/details');
    const data = await res.json();

    if (!data.success) throw new Error(data.error || 'Gagal mengambil data router');
    currentModalData = data;
    const l = data.live;
    const r = data.router;

    const usedMem = l.totalMemory - l.freeMemory;
    const memPercent = l.totalMemory > 0 ? Math.round((usedMem / l.totalMemory) * 100) : 0;
    const usedHdd = l.totalHdd - l.freeHdd;
    const hddPercent = l.totalHdd > 0 ? Math.round((usedHdd / l.totalHdd) * 100) : 0;

    const pppoeRows = (l.activePppoeList && l.activePppoeList.length > 0) ? l.activePppoeList.map((p, idx) => `
      <tr>
        <td class="text-muted ps-3">${idx + 1}</td>
        <td class="fw-bold text-primary">${p.name}</td>
        <td class="font-monospace text-info">${p.address || '-'}</td>
        <td><span class="badge" style="background:rgba(245,158,11,0.15); color:#f59e0b;"><i class="bi bi-clock me-1"></i>${p.uptime || '-'}</span></td>
        <td class="text-muted font-monospace pe-3">${p.callerId || '-'}</td>
      </tr>
    `).join('') : `<tr><td colspan="5" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-1"></i>Tidak ada sesi PPPoE aktif saat ini</td></tr>`;

    const hsRows = (l.activeHotspotList && l.activeHotspotList.length > 0) ? l.activeHotspotList.map((h, idx) => `
      <tr>
        <td class="text-muted ps-3">${idx + 1}</td>
        <td class="fw-bold text-success">${h.user}</td>
        <td class="font-monospace text-info">${h.address || '-'}</td>
        <td class="text-muted font-monospace">${h.mac || '-'}</td>
        <td class="pe-3"><span class="badge" style="background:rgba(245,158,11,0.15); color:#f59e0b;"><i class="bi bi-clock me-1"></i>${h.uptime || '-'}</span></td>
      </tr>
    `).join('') : `<tr><td colspan="5" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-1"></i>Tidak ada user hotspot aktif saat ini</td></tr>`;

    // === MULAI PERUBAHAN: INNERHTML DETAIL LIVE YANG SANGAT RAPI & PRESISI ===
    bodyEl.innerHTML = `
      <!-- 1. Top Header Bar -->
      <div class="live-top-banner">
        <div class="d-flex align-items-center gap-3">
          <div style="width:42px; height:42px; border-radius:10px; background:rgba(99,102,241,0.15); display:flex; align-items:center; justify-content:center; color:#6366f1; font-size:20px;">
            <i class="bi bi-router"></i>
          </div>
          <div>
            <h6 class="fw-bold mb-0" style="color:var(--modal-text); font-size:16px;">${r.name}</h6>
            <div class="small text-muted font-monospace mt-1" style="font-size:11.5px;">
              <span><i class="bi bi-hdd-network me-1"></i>${r.host}:${r.port}</span>
              <span class="mx-2">•</span>
              <span><i class="bi bi-person me-1"></i>${r.user}</span>
            </div>
          </div>
        </div>
        <div>
          ${l.connected 
            ? '<span class="rc-status-pill online"><span class="rc-status-dot"></span> Online</span>' 
            : '<span class="rc-status-pill offline"><span class="rc-status-dot"></span> Terputus</span>'}
        </div>
      </div>

      ${l.error ? `<div class="alert alert-danger mb-3 p-3 small"><i class="bi bi-exclamation-triangle-fill me-2"></i><strong>MikroTik Error:</strong> ${l.error}</div>` : ''}

      <!-- 2. Modal Tabs Switcher -->
      <div class="d-flex gap-2 mb-3 pb-2" style="border-bottom: 1px solid var(--modal-border);">
        <button type="button" class="modal-tab-btn active" id="mtab-btn-sys" onclick="switchModalTab('sys')">
          <i class="bi bi-speedometer2"></i> Ringkasan Sistem
        </button>
        <button type="button" class="modal-tab-btn" id="mtab-btn-pppoe" onclick="switchModalTab('pppoe')">
          <i class="bi bi-plug"></i> PPPoE Aktif (${l.activePppoe || 0})
        </button>
        <button type="button" class="modal-tab-btn" id="mtab-btn-hs" onclick="switchModalTab('hs')">
          <i class="bi bi-wifi"></i> Hotspot Aktif (${l.activeHotspot || 0})
        </button>
      </div>

      <!-- TAB 1: System & Metrics Grid -->
      <div id="mtab-content-sys">
        <!-- 3 Cards Sejajar: CPU, RAM, DISK -->
        <div class="live-metric-grid">
          <div class="live-metric-card">
            <span class="live-metric-title"><i class="bi bi-cpu"></i> CPU Load</span>
            <span class="live-metric-val ${l.cpuLoad > 80 ? 'text-danger' : (l.cpuLoad > 50 ? 'text-warning' : 'text-success')}">
              ${l.cpuLoad ?? 0}%
            </span>
            <div class="rc-progress">
              <div class="rc-progress-bar ${l.cpuLoad > 80 ? 'bg-red' : (l.cpuLoad > 50 ? 'bg-yellow' : 'bg-green')}" style="width: ${l.cpuLoad || 0}%;"></div>
            </div>
          </div>

          <div class="live-metric-card">
            <span class="live-metric-title"><i class="bi bi-memory"></i> RAM Terpakai</span>
            <span class="live-metric-val text-info">${memPercent}%</span>
            <div class="rc-progress mb-1">
              <div class="rc-progress-bar ${memPercent > 85 ? 'bg-red' : (memPercent > 65 ? 'bg-yellow' : 'bg-green')}" style="width: ${memPercent}%;"></div>
            </div>
            <small class="text-muted" style="font-size:10px;">${formatBytes(usedMem)} / ${formatBytes(l.totalMemory)}</small>
          </div>

          <div class="live-metric-card">
            <span class="live-metric-title"><i class="bi bi-hdd"></i> Penyimpanan</span>
            <span class="live-metric-val text-warning">${hddPercent}%</span>
            <div class="rc-progress mb-1">
              <div class="rc-progress-bar ${hddPercent > 85 ? 'bg-red' : (hddPercent > 65 ? 'bg-yellow' : 'bg-green')}" style="width: ${hddPercent}%;"></div>
            </div>
            <small class="text-muted" style="font-size:10px;">${formatBytes(usedHdd)} / ${formatBytes(l.totalHdd)}</small>
          </div>
        </div>

        <!-- 2 Kolom: Kiri Spesifikasi Board, Kanan Status Pelanggan -->
        <div class="live-specs-grid">
          <!-- Kiri: Spesifikasi RouterOS -->
          <div class="live-card-section">
            <div class="live-section-title"><i class="bi bi-info-circle text-primary"></i> Informasi Perangkat</div>
            <div class="spec-item">
              <span class="spec-lbl"><i class="bi bi-tag"></i> Identity:</span>
              <span class="spec-val">${l.identity || '-'}</span>
            </div>
            <div class="spec-item">
              <span class="spec-lbl"><i class="bi bi-motherboard"></i> Model / Board:</span>
              <span class="spec-val text-info">${l.boardName || '-'}</span>
            </div>
            <div class="spec-item">
              <span class="spec-lbl"><i class="bi bi-patch-check"></i> RouterOS:</span>
              <span class="spec-val text-success">${l.version || '-'}</span>
            </div>
            <div class="spec-item">
              <span class="spec-lbl"><i class="bi bi-cpu"></i> Arsitektur:</span>
              <span class="spec-val">${l.architecture || '-'} (${l.cpuCount || 1} Core)</span>
            </div>
            <div class="spec-item">
              <span class="spec-lbl"><i class="bi bi-clock-history"></i> Uptime:</span>
              <span class="spec-val text-warning">${l.uptime || '-'}</span>
            </div>
          </div>

          <!-- Kanan: Status Koneksi Pelanggan -->
          <div class="live-card-section">
            <div class="live-section-title"><i class="bi bi-people text-success"></i> Status Sesi Pelanggan</div>
            <div class="counter-stack">
              <div class="counter-pill">
                <span class="spec-lbl"><i class="bi bi-person-lines-fill"></i> Total Pelanggan DB</span>
                <span class="fw-bold fs-6 text-primary">${l.customersCount || 0}</span>
              </div>
              <div class="counter-pill">
                <span class="spec-lbl"><i class="bi bi-plug-fill text-success"></i> Sesi PPPoE Aktif</span>
                <span class="fw-bold fs-6 text-success">${l.activePppoe || 0}</span>
              </div>
              <div class="counter-pill">
                <span class="spec-lbl"><i class="bi bi-wifi text-warning"></i> Sesi Hotspot Aktif</span>
                <span class="fw-bold fs-6 text-warning">${l.activeHotspot || 0}</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 2: PPPoE Sessions Table -->
      <div id="mtab-content-pppoe" style="display:none;">
        <div class="table-responsive rounded-3" style="max-height: 340px; overflow-y: auto; border: 1px solid var(--modal-border);">
          <table class="table modal-table-adaptive table-hover table-sm mb-0 align-middle small">
            <thead class="sticky-top" style="background:var(--modal-table-bg);">
              <tr>
                <th class="ps-3 py-2">#</th>
                <th class="py-2">Username</th>
                <th class="py-2">IP Address</th>
                <th class="py-2">Uptime</th>
                <th class="pe-3 py-2">Caller ID / MAC</th>
              </tr>
            </thead>
            <tbody>
              ${pppoeRows}
            </tbody>
          </table>
        </div>
      </div>

      <!-- TAB 3: Hotspot Sessions Table -->
      <div id="mtab-content-hs" style="display:none;">
        <div class="table-responsive rounded-3" style="max-height: 340px; overflow-y: auto; border: 1px solid var(--modal-border);">
          <table class="table modal-table-adaptive table-hover table-sm mb-0 align-middle small">
            <thead class="sticky-top" style="background:var(--modal-table-bg);">
              <tr>
                <th class="ps-3 py-2">#</th>
                <th class="py-2">User / Voucher</th>
                <th class="py-2">IP Address</th>
                <th class="py-2">MAC Address</th>
                <th class="pe-3 py-2">Uptime</th>
              </tr>
            </thead>
            <tbody>
              ${hsRows}
            </tbody>
          </table>
        </div>
      </div>
    `;
    // === SELESAI PERUBAHAN: INNERHTML DETAIL LIVE RAPI & PRESISI ===
  } catch (e) {
    bodyEl.innerHTML = `
      <div class="alert alert-danger p-4 text-center">
        <i class="bi bi-exclamation-triangle-fill fs-2 mb-2 d-block"></i>
        <h6 class="fw-bold">Gagal Mengambil Data Live</h6>
        <p class="small mb-0">${e.message}</p>
      </div>
    `;
  }
}

function refreshCurrentModal() {
  if (currentModalRouterId) openLiveDetailModal(currentModalRouterId);
}

function editRouter(idx) {
  const r = routersData[idx];
  document.getElementById('editForm').action = '/admin/routers/' + r.id + '/update';
  document.getElementById('e_name').value = r.name;
  document.getElementById('e_host').value = r.host;
  document.getElementById('e_port').value = r.port;
  document.getElementById('e_user').value = r.user;
  document.getElementById('e_active').value = r.is_active;
  document.getElementById('e_desc').value = r.description || '';
  
  document.getElementById('e_is_pppoe').checked = (Number(r.is_pppoe) === 1);
  document.getElementById('e_is_hotspot').checked = (Number(r.is_hotspot) === 1);

  openModal('editModal');
}

async function testConn(id) {
  const confirmed = await showCustomConfirm(I18N.testConfirm, 'Test Koneksi Router', 'info');
  if(!confirmed) return;
  try {
    const res = await fetch('/admin/api/routers/' + id + '/test');
    const data = await res.json();
    if(data.success) {
      await showCustomAlert(data.message, 'success', 'Koneksi Berhasil');
    } else {
      await showCustomAlert(data.error || 'Gagal terhubung ke router.', 'danger', 'Koneksi Gagal');
    }
    loadRouterLiveSummary({ id });
  } catch (e) { 
    showCustomAlert(I18N.systemError, 'danger'); 
  }
}

function copyIsolirScript() {
  const ta = document.getElementById('isolir-script-body');
  if (!ta || !ta.value) return;
  ta.select();
  document.execCommand('copy');
  showCustomAlert('<%= t('admin.routers.isolir_script_copied', 'Script berhasil disalin ke clipboard.') %>', 'success', 'Berhasil Menyalin');
}
// === SELESAI PERUBAHAN: SCRIPT DETAIL LIVE RAPI & DIALOG CENTER ===

// Auto load metrics for all routers on page load
window.addEventListener('DOMContentLoaded', () => {
  routersData.forEach(r => {
    loadRouterLiveSummary(r);
  });
});
</script>
</body>
</html>
