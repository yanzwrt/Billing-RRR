        </div>

        <!-- Kecepatan Berdampingan (Download & Upload - Edit) -->
        <div class="form-row" style="background:rgba(59,130,246,0.04);padding:12px 14px;border-radius:10px;margin-top:10px;border:1px solid rgba(59,130,246,0.12);">
          <div class="fg">
            <label class="fl" style="color:var(--primary);font-weight:700;"><i class="bi bi-download"></i> Kecepatan Download (Mbps) *</label>
            <input class="fc" name="speed_down" id="e_down" type="number" step="any" min="0" required>
          </div>
          <div class="fg">
            <label class="fl" style="color:var(--info);font-weight:700;"><i class="bi bi-upload"></i> Kecepatan Upload (Mbps) *</label>
            <input class="fc" name="speed_up" id="e_up" type="number" step="any" min="0" required>
          </div>
        </div>

        <!-- Kecepatan UpTo (Batas Maksimum - Edit) -->
        <div style="background:rgba(16,185,129,0.04);padding:12px 14px;border-radius:10px;margin-top:10px;border:1px dashed rgba(16,185,129,0.25);">
          <div class="fw6" style="font-size:12px;margin-bottom:8px;color:var(--success)"><i class="bi bi-speedometer2"></i> Fitur Kecepatan UpTo / Max Rate (Opsional)</div>
          <div class="form-row">
            <div class="fg">
              <label class="fl">Download UpTo (Mbps)</label>
              <input class="fc" name="speed_down_upto" id="e_down_upto" type="number" step="any" min="0" placeholder="Kosongkan jika tanpa UpTo (mis: 20)">
            </div>
            <div class="fg">
              <label class="fl">Upload UpTo (Mbps)</label>
              <input class="fc" name="speed_up_upto" id="e_up_upto" type="number" step="any" min="0" placeholder="Kosongkan jika tanpa UpTo (mis: 10)">
            </div>
          </div>
          <small class="text-muted" style="font-size:11px;display:block;margin-top:2px;">
            Bila diisi, paket akan tampil sebagai: <strong>10 Mbps (Up to 20 Mbps)</strong> di invoice & portal pelanggan.
          </small>
        </div>

        <div style="background: rgba(34,197,94,0.06); padding: 12px 14px; border-radius: 10px; margin-top: 10px;">
          <div class="fw6" style="font-size:12px;margin-bottom:8px;color:var(--success)"><i class="bi bi-percent"></i> Promo & prorata tagihan</div>
          <div class="form-row">
            <div class="fg"><label class="fl">Harga promo (Rp / siklus)</label><input class="fc" name="promo_price" id="e_promo_price" type="number" min="0" placeholder="Kosong = tanpa harga promo"></div>
            <div class="fg"><label class="fl">Jumlah bulan promo</label><input class="fc" name="promo_cycles" id="e_promo_cycles" type="number" min="0" value="0"></div>
          </div>
          <div class="flex ai-c" style="gap:8px;margin-top:4px">
            <input type="checkbox" name="prorate_first_invoice" id="e_prorate" value="1">
            <label for="e_prorate" style="margin:0;font-size:12px">Prorata tagihan pertama (tanggal pasang = bulan tagihan)</label>
          </div>
        </div>
        
        <div style="background: rgba(99,102,241,0.06); padding: 12px 14px; border-radius: 10px; margin-top: 10px;">
          <div class="fw6" style="font-size:12px;margin-bottom:8px;color:var(--primary)"><i class="bi bi-calculator"></i> Pengaturan Pajak & Regulasi (PPN & USO)</div>
          <div class="form-row" style="margin-bottom: 8px;">
            <div class="fg">
              <label style="display:flex; align-items:center; gap:8px; font-size:12px; font-weight:700; margin-top: 26px;">
                <input type="checkbox" name="use_ppn" id="e_use_ppn" value="1">
                Aktifkan PPN
              </label>
            </div>
            <div class="fg">
              <label class="fl">Persentase PPN (%)</label>
              <input class="fc" name="ppn_percentage" id="e_ppn_percentage" type="number" step="any" min="0">
            </div>
          </div>
          <div class="form-row">
            <div class="fg">
              <label style="display:flex; align-items:center; gap:8px; font-size:12px; font-weight:700; margin-top: 26px;">
                <input type="checkbox" name="use_uso" id="e_use_uso" value="1">
                Aktifkan ULO/USO
              </label>
            </div>
            <div class="fg">
              <label class="fl">Persentase ULO/USO (%)</label>
              <input class="fc" name="uso_percentage" id="e_uso_percentage" type="number" step="any" min="0">
            </div>
          </div>
        </div>

        <div class="fg" style="margin-top:10px;"><label class="fl"><%= t('admin.packages.form.description', 'Deskripsi') %></label><textarea class="fc" name="description" id="e_desc"></textarea></div>

        <!-- Dynamic Speed & FUP Section (Edit) -->
        <div style="background: rgba(0,0,0,0.02); padding: 15px; border-radius: 12px; margin-top: 15px;">
          <div class="flex ai-c mb8" style="gap:10px">
            <input type="checkbox" name="use_night_speed" id="e_use_night" value="1" onchange="toggleEditNight()">
            <h6 style="font-size:12px; margin: 0; color: var(--primary); text-transform: uppercase; letter-spacing: 0.5px;"><i class="bi bi-clock"></i> Aktifkan Jam Kalong</h6>
          </div>
          <div id="e_night_fields" style="display:none">
            <div class="fg">
              <label class="fl">Nama Profile Malam (MikroTik)</label>
              <div style="display:flex;gap:8px">
                <select class="fs" id="e_night_profile_select" style="max-width:200px" onchange="document.getElementById('e_night_profile').value=this.value">
                  <option value="">-- Pilih Profile --</option>
                </select>
                <input class="fc" name="night_profile_name" id="e_night_profile">
              </div>
            </div>
            <div class="form-row">
              <div class="fg"><label class="fl">Download Malam (Mbps)</label><input class="fc" name="night_speed_down" id="e_night_down" type="number" step="any" min="0"></div>
              <div class="fg"><label class="fl">Upload Malam (Mbps)</label><input class="fc" name="night_speed_up" id="e_night_up" type="number" step="any" min="0"></div>
            </div>
          </div>
          
          <hr style="opacity:0.1; margin: 15px 0;">

          <div class="flex ai-c mb8" style="gap:10px">
            <input type="checkbox" name="use_fup" id="e_use_fup" value="1" onchange="toggleEditFup()">
            <h6 style="font-size:12px; margin: 0; color: var(--danger); text-transform: uppercase; letter-spacing: 0.5px;"><i class="bi bi-speedometer2"></i> Aktifkan FUP</h6>
          </div>
          <div id="e_fup_fields" style="display:none">
            <div class="fg">
              <label class="fl">Nama Profile FUP (MikroTik)</label>
              <div style="display:flex;gap:8px">
                <select class="fs" id="e_fup_profile_select" style="max-width:200px" onchange="document.getElementById('e_fup_profile').value=this.value">
                  <option value="">-- Pilih Profile --</option>
                </select>
                <input class="fc" name="fup_profile_name" id="e_fup_profile">
              </div>
            </div>
            <div class="form-row">
              <div class="fg"><label class="fl">Batas Kuota (GB)</label><input class="fc" name="fup_limit_gb" id="e_fup_limit" type="number" step="any" min="0"></div>
              <div class="fg"><label class="fl">Speed Setelah FUP (Mbps)</label><input class="fc" name="fup_speed_down" id="e_fup_speed" type="number" step="any" min="0"></div>
            </div>
          </div>
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('editModal')"><%= t('common.cancel', 'Batal') %></button>
        <button type="submit" class="btn btn-p"><i class="bi bi-check-lg"></i> <%= t('admin.packages.update', 'Update') %></button>
      </div>
    </form>
  </div>
</div>

<script type="application/json" id="packages-data"><%- JSON.stringify(packages) %></script>
<script>
const packagesData = JSON.parse(document.getElementById('packages-data').textContent);
function openModal(id){document.getElementById(id).classList.add('show')}
function closeModal(id){document.getElementById(id).classList.remove('show')}
document.querySelectorAll('.mo').forEach(m=>m.addEventListener('click',e=>{if(e.target===m)m.classList.remove('show')}));

let currentFetchedProfiles = { add: [], edit: [] };

// Handler ketika Router MikroTik atau Jenis Layanan diganti
async function onPackageRouterOrTypeChange(mode) {
  const routerId = document.getElementById(mode === 'add' ? 'add_router_id' : 'e_router_id')?.value || '';
  const serviceType = document.getElementById(mode === 'add' ? 'add_service_type' : 'e_service_type')?.value || 'pppoe';
  const selEl = document.getElementById(mode === 'add' ? 'add_profile_select' : 'e_profile_select');
  const hintEl = document.getElementById(mode === 'add' ? 'add_profile_hint' : 'e_profile_hint');

  if (!selEl) return;
  selEl.innerHTML = '<option value="">-- Memuat profil... --</option>';
  if (hintEl) hintEl.textContent = `Menghubungi MikroTik (${serviceType.toUpperCase()})...`;

  try {
    let url = '';
    if (serviceType === 'hotspot') {
      url = routerId ? `/admin/api/mikrotik/hotspot-user-profiles?routerId=${encodeURIComponent(routerId)}` : '/admin/api/mikrotik/hotspot-user-profiles';
    } else {
      url = routerId ? `/admin/api/mikrotik/profiles?routerId=${encodeURIComponent(routerId)}` : '/admin/api/mikrotik/profiles';
    }

    const res = await fetch(url);
    if (!res.ok) throw new Error('Gagal mengambil profil dari router');
    const profiles = await res.json();
    currentFetchedProfiles[mode] = Array.isArray(profiles) ? profiles : [];

    selEl.innerHTML = '<option value="">-- Pilih dari MikroTik --</option>';
    if (currentFetchedProfiles[mode].length === 0) {
      if (hintEl) hintEl.textContent = `Tidak ada profil ${serviceType.toUpperCase()} yang ditemukan di router ini.`;
      return;
    }

    currentFetchedProfiles[mode].forEach(p => {
      const pName = p.name || '';
      const rate = p.rateLimit || p['rate-limit'] || '';
      const label = rate ? `${pName} (${rate})` : pName;
      selEl.insertAdjacentHTML('beforeend', `<option value="${pName}">${label}</option>`);
    });

    if (hintEl) hintEl.textContent = `Tersedia ${currentFetchedProfiles[mode].length} profil ${serviceType.toUpperCase()}.`;
  } catch (err) {
    selEl.innerHTML = '<option value="">-- Gagal memuat profil --</option>';
    if (hintEl) hintEl.textContent = 'Koneksi ke router gagal atau timeout: ' + err.message;
  }
}

// Helper untuk parsing string rate-limit MikroTik (contoh: "10M/20M" atau "512k/2M")
function parseMikrotikRateLimit(rateStr) {
  if (!rateStr) return null;
  const parts = String(rateStr).trim().split(/\s+/)[0].split('/');
  if (parts.length < 2) return null;

  const toMbps = (s) => {
    const raw = String(s || '').trim().toLowerCase();
    if (raw.endsWith('m')) return parseFloat(raw);
    if (raw.endsWith('k')) return parseFloat((parseFloat(raw) / 1000).toFixed(2));
    const num = parseFloat(raw);
    return !isNaN(num) ? parseFloat((num / 1000000).toFixed(2)) : 0;
  };

  const uploadMbps = toMbps(parts[0]);
  const downloadMbps = toMbps(parts[1]);
  return { uploadMbps, downloadMbps };
}

// Handler saat salah satu profil dipilih di dropdown
// Handler saat salah satu profil dipilih di dropdown
function onProfileSelected(mode, profileName) {
  if (!profileName) return;
  const nameInput = document.getElementById(mode === 'add' ? 'add_name' : 'e_name');
  
  // HANYA isi otomatis nama paket jika kotak nama masih kosong!
  // Jika admin sudah mengetik nama custom, JANGAN timpa nama tersebut!
  if (nameInput && (!nameInput.value || nameInput.value.trim() === '')) {
    nameInput.value = profileName;
  }

  const list = currentFetchedProfiles[mode] || [];
  const found = list.find(p => p.name === profileName);
  if (!found) return;

  const rate = found.rateLimit || found['rate-limit'] || '';
  const parsed = parseMikrotikRateLimit(rate);
  if (parsed) {
    const downInput = document.getElementById(mode === 'add' ? 'add_down' : 'e_down');
    const upInput = document.getElementById(mode === 'add' ? 'add_up' : 'e_up');
    if (downInput && parsed.downloadMbps > 0) downInput.value = parsed.downloadMbps;
    if (upInput && parsed.uploadMbps > 0) upInput.value = parsed.uploadMbps;
  }
}

// FUNGSI EDIT PAKET (RESPONSIF, LANGSUNG TAMPIL & NAMA TIDAK AKAN HILANG)
async function editPkg(idx) {
  try {
    const p = packagesData[idx];
    if (!p) {
      alert('Data paket tidak ditemukan.');
      return;
    }

    // 1. Buka modal duluan agar terasa instan saat tombol ditekan
    openModal('editModal');

    document.getElementById('editForm').action = '/admin/packages/' + p.id + '/update';

    // 2. Kunci nama custom paket langsung ke kotak nama tampilan
    const customPackageName = p.name || '';
    const nameInput = document.getElementById('e_name');
    if (nameInput) nameInput.value = customPackageName;

    document.getElementById('e_price').value = p.price || 0;
    document.getElementById('e_promo_price').value = (p.promo_price != null && p.promo_price !== '') ? p.promo_price : '';
    document.getElementById('e_promo_cycles').value = p.promo_cycles != null ? p.promo_cycles : 0;
    document.getElementById('e_prorate').checked = !!p.prorate_first_invoice;
    document.getElementById('e_use_ppn').checked = !!p.use_ppn;
    document.getElementById('e_ppn_percentage').value = p.ppn_percentage != null ? p.ppn_percentage : 11.0;
    document.getElementById('e_use_uso').checked = !!p.use_uso;
    document.getElementById('e_uso_percentage').value = p.uso_percentage != null ? p.uso_percentage : 1.75;
    document.getElementById('e_down').value = p.speed_down ? (p.speed_down / 1000) : 0;
    document.getElementById('e_up').value = p.speed_up ? (p.speed_up / 1000) : 0;
    document.getElementById('e_down_upto').value = p.speed_down_upto ? (p.speed_down_upto / 1000) : '';
    document.getElementById('e_up_upto').value = p.speed_up_upto ? (p.speed_up_upto / 1000) : '';
    document.getElementById('e_night_down').value = p.night_speed_down ? (p.night_speed_down / 1000) : 0;
    document.getElementById('e_night_up').value = p.night_speed_up ? (p.night_speed_up / 1000) : 0;
    document.getElementById('e_night_profile').value = p.night_profile_name || '';
    document.getElementById('e_use_night').checked = !!p.use_night_speed;
    document.getElementById('e_night_fields').style.display = p.use_night_speed ? 'block' : 'none';

    document.getElementById('e_fup_limit').value = p.fup_limit_gb || 0;
    document.getElementById('e_fup_speed').value = p.fup_speed_down ? (p.fup_speed_down / 1000) : 0;
    document.getElementById('e_fup_profile').value = p.fup_profile_name || '';
    document.getElementById('e_use_fup').checked = !!p.use_fup;
    document.getElementById('e_fup_fields').style.display = p.use_fup ? 'block' : 'none';

    document.getElementById('e_active').value = p.is_active ? '1' : '0';
    document.getElementById('e_desc').value = p.description || '';

    const isPrepaid = p.billing_type === 'prepaid';
    document.getElementById('e_billing_type').value = isPrepaid ? 'prepaid' : 'postpaid';
    document.getElementById('e_duration_days').value = p.duration_days || 30;
    document.getElementById('e_duration_days_fg').style.display = isPrepaid ? 'block' : 'none';

    // 3. Set Router & Tipe Layanan
    if (document.getElementById('e_router_id')) {
      document.getElementById('e_router_id').value = p.router_id || '';
    }
    if (document.getElementById('e_service_type')) {
      document.getElementById('e_service_type').value = p.service_type || 'pppoe';
    }

    // 4. Muat daftar profil MikroTik di latar belakang
    const targetMikrotikProfile = p.mikrotik_profile || p.name || '';
    const selEdit = document.getElementById('e_profile_select');
    if (selEdit && targetMikrotikProfile) {
      selEdit.innerHTML = `<option value="${targetMikrotikProfile}">${targetMikrotikProfile}</option>`;
      selEdit.value = targetMikrotikProfile;
    }

    await onPackageRouterOrTypeChange('edit');

    // Pastikan pilihan dropdown dan input nama tetap sinkron setelah fetch selesai
    if (selEdit && targetMikrotikProfile) {
      selEdit.value = targetMikrotikProfile;
    }
    if (nameInput) {
      nameInput.value = customPackageName;
    }
  } catch (err) {
    console.error('Error saat membuka modal edit paket:', err);
    alert('Terjadi kesalahan saat membuka form edit: ' + err.message);
  }
}

function toggleAddBillingType(val) {
  document.getElementById('add_duration_days_fg').style.display = (val === 'prepaid') ? 'block' : 'none';
}
function toggleEditBillingType(val) {
  document.getElementById('e_duration_days_fg').style.display = (val === 'prepaid') ? 'block' : 'none';
}
function toggleAddNight() { document.getElementById('add_night_fields').style.display = document.getElementById('add_use_night').checked ? 'block' : 'none'; }
function toggleAddFup() { document.getElementById('add_fup_fields').style.display = document.getElementById('add_use_fup').checked ? 'block' : 'none'; }
function toggleEditNight() { document.getElementById('e_night_fields').style.display = document.getElementById('e_use_night').checked ? 'block' : 'none'; }
function toggleEditFup() { document.getElementById('e_fup_fields').style.display = document.getElementById('e_use_fup').checked ? 'block' : 'none'; }
setTimeout(()=>document.querySelectorAll('.alert').forEach(a=>a.style.display='none'),4000);

// Inisialisasi awal saat halaman dibuka
document.addEventListener('DOMContentLoaded', () => {
  onPackageRouterOrTypeChange('add');
});
</script>
</body>
</html>
