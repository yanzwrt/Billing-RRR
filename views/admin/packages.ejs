<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= t('admin.packages.title', 'Paket Internet') %> | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    /* Responsive Mobile CSS */
    @media (max-width: 768px) {
      .card-hd { flex-direction: column !important; align-items: stretch !important; gap: 10px !important; }
      .card-hd > div { flex-wrap: wrap !important; width: 100% !important; justify-content: stretch !important; }
      .card-hd select { width: 100% !important; }
      .card-hd .btn { flex: 1 1 auto; justify-content: center; }
      .mo .mb { width: 95vw !important; max-width: 95vw !important; margin: 10px auto !important; padding: 14px !important; border-radius: 14px !important; }
      .mo .mbody { max-height: 72vh !important; padding-right: 4px !important; }
      .form-row { flex-direction: column !important; gap: 8px !important; }
      .form-row > .fg { width: 100% !important; max-width: 100% !important; margin-bottom: 6px !important; }
      .mf { flex-wrap: wrap !important; gap: 8px !important; }
      .mf button, .mf a { flex: 1 1 100% !important; text-align: center !important; justify-content: center !important; }
    }
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'packages', company }) %>
<div class="mw">
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-box-seam"></i> <%= t('admin.packages.title', 'Paket Internet') %></div>
    <div class="tb-right">
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %></span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </div>
  <div class="page">

    <% if (msg) { %>
    <div class="alert alert-<%= msg.type==='success'?'s':'d' %>">
      <i class="bi bi-<%= msg.type==='success'?'check-circle':'exclamation-circle' %>"></i> <%= msg.text %>
    </div>
    <% } %>

    <div class="card">
      <div class="card-hd">
        <h6><i class="bi bi-box-seam"></i> <%= t('admin.packages.list', 'Daftar Paket') %> (<%= packages.length %>)</h6>
        <div style="display:flex;align-items:center;gap:10px">
          <% if (typeof routers !== 'undefined' && routers && routers.length > 0) { %>
          <select class="fs" style="width:160px" onchange="window.location.href='/admin/set-active-router?router_id=' + this.value">
            <option value="all" <%= (!selectedRouterId) ? 'selected' : '' %>>🌐 Semua Router</option>
            <% routers.forEach(r => { %>
              <option value="<%= r.id %>" <%= (selectedRouterId === r.id) ? 'selected' : '' %>>🔌 <%= r.name %></option>
            <% }) %>
          </select>
          <% } %>
          <button class="btn btn-p btn-sm" onclick="openModal('addModal')"><i class="bi bi-plus-lg"></i> <%= t('admin.packages.add', 'Tambah Paket') %></button>
        </div>
      </div>
      <div class="tbl-wrap">
        <table class="dtbl">
          <thead>
            <tr>
              <th>#</th>
              <th><%= t('admin.packages.table.name', 'Nama Paket') %></th>
              <th><%= t('admin.packages.table.price_month', 'Harga / Bulan') %></th>
              <th>Promo / Prorata</th>
              <th><%= t('admin.packages.table.speed', 'Kecepatan') %></th>
              <th><%= t('admin.packages.table.description', 'Deskripsi') %></th>
              <th><%= t('admin.packages.table.customers', 'Pelanggan') %></th>
              <th><%= t('admin.packages.table.status', 'Status') %></th>
              <th><%= t('common.actions', 'Aksi') %></th>
            </tr>
          </thead>
          <tbody>
          <% if (packages.length===0) { %>
            <tr><td colspan="9" class="text-center text-muted" style="padding:32px"><%= t('admin.packages.empty', 'Belum ada paket. Tambah paket pertama!') %></td></tr>
          <% } %>
          <% packages.forEach((p,i)=>{ %>
            <tr>
              <td class="text-muted"><%= i+1 %></td>
              <td class="fw6">
                <div><%= p.name %></div>
                <div style="margin-top:3px">
                  <% if (p.billing_type === 'prepaid') { %>
                    <span class="badge bs" style="font-size:10px;padding:2px 6px;font-weight:700;"><i class="bi bi-clock-history"></i> Prabayar (<%= p.duration_days || 30 %> Hari)</span>
                  <% } else { %>
                    <span class="badge bp" style="font-size:10px;padding:2px 6px;font-weight:600;"><i class="bi bi-calendar-check"></i> Pascabayar</span>
                  <% } %>
                </div>
              </td>
              <td class="fw6" style="color:var(--success)">
                Rp <%= p.price.toLocaleString('id-ID') %>
                <% if (p.use_ppn) { %><br><span class="badge bp" style="font-size:9px;padding:2px 4px;margin-top:2px;display:inline-block">+ PPN <%= p.ppn_percentage %>%</span><% } %>
                <% if (p.use_uso) { %><br><span class="badge bm" style="font-size:9px;padding:2px 4px;margin-top:2px;display:inline-block">+ USO <%= p.uso_percentage %>%</span><% } %>
              </td>
              <td style="font-size:11px;max-width:160px">
                <% if (p.promo_cycles > 0 && p.promo_price != null && p.promo_price !== '') { %>
                  <span class="badge bp">Promo</span> Rp <%= Number(p.promo_price).toLocaleString('id-ID') %> × <%= p.promo_cycles %> bln
                <% } else { %><span class="text-muted">—</span><% } %>
                <% if (p.prorate_first_invoice) { %><br><span class="badge bs" style="margin-top:4px;display:inline-block">Prorata 1×</span><% } %>
              </td>
              <td>
                <% if (p.speed_down) { %>
                  <div style="white-space:nowrap;font-weight:700;">
                    <span class="badge bp"><i class="bi bi-download"></i> <%= (p.speed_down/1000).toFixed(0) %> Mbps</span>
                    <% if (p.speed_down_upto && p.speed_down_upto > p.speed_down) { %>
                      <span class="badge bs" style="font-size:10px;padding:2px 5px;">UpTo <%= (p.speed_down_upto/1000).toFixed(0) %>M</span>
                    <% } %>
                  </div>
                  <div style="white-space:nowrap;font-weight:700;margin-top:4px;">
                    <span class="badge bm"><i class="bi bi-upload"></i> <%= (p.speed_up/1000).toFixed(0) %> Mbps</span>
                    <% if (p.speed_up_upto && p.speed_up_upto > p.speed_up) { %>
                      <span class="badge bs" style="font-size:10px;padding:2px 5px;">UpTo <%= (p.speed_up_upto/1000).toFixed(0) %>M</span>
                    <% } %>
                  </div>
                <% } else { %><span class="text-muted">-</span><% } %>
              </td>
              <td style="color:var(--muted);font-size:12px"><%= p.description||'-' %></td>
              <td class="text-center"><span class="badge bm"><%= p.customer_count %> <%= t('admin.packages.customers_suffix', 'pelanggan') %></span></td>
              <td><% if(p.is_active){%><span class="badge bs"><%= t('common.active', 'Aktif') %></span><%}else{%><span class="badge bd"><%= t('common.inactive', 'Nonaktif') %></span><%}%></td>
              <td>
                <button class="btn btn-g btn-icon btn-sm" data-idx="<%= i %>" onclick="editPkg(+this.dataset.idx)"><i class="bi bi-pencil"></i></button>
                <form method="POST" action="/admin/packages/<%= p.id %>/delete" style="display:inline" onsubmit="return confirm('<%= t('admin.packages.confirm.delete', 'Hapus paket ini? Pelanggan yang menggunakan paket ini akan kehilangan referensi paket.') %>')">
                  <button class="btn btn-d btn-icon btn-sm"><i class="bi bi-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal Tambah -->
<div class="mo" id="addModal">
  <div class="mb" style="max-width:680px;">
    <div class="mh"><span class="mt"><i class="bi bi-plus-square"></i> <%= t('admin.packages.add', 'Tambah Paket') %></span><button class="mc" onclick="closeModal('addModal')">&times;</button></div>
    <form method="POST" action="/admin/packages">
      <div class="mbody" style="max-height:70vh; overflow-y:auto; padding-right:6px;">
        <!-- BAGIAN BARU: PILIHAN ROUTER & TIPE LAYANAN -->
        <div style="background:rgba(59,130,246,0.06);padding:12px 14px;border-radius:10px;margin-bottom:14px;border:1px solid rgba(59,130,246,0.2);">
          <div class="fw6" style="font-size:12px;margin-bottom:8px;color:var(--primary);">
            <i class="bi bi-hdd-network"></i> Router MikroTik & Jenis Layanan
          </div>
          <div class="form-row" style="margin-bottom:0">
            <div class="fg">
              <label class="fl">Pilih Router MikroTik *</label>
              <select class="fs" name="router_id" id="add_router_id" onchange="onPackageRouterOrTypeChange('add')">
                <option value="">-- Default Router --</option>
                <% if (typeof routers !== 'undefined' && routers && routers.length > 0) { %>
                  <% routers.forEach(r => { %>
                    <option value="<%= r.id %>"><%= r.name %> (<%= r.host %>)</option>
                  <% }) %>
                <% } %>
              </select>
            </div>
            <div class="fg">
              <label class="fl">Tipe Layanan *</label>
              <select class="fs" name="service_type" id="add_service_type" onchange="onPackageRouterOrTypeChange('add')" style="font-weight:700;">
                <option value="pppoe" selected>⚡ PPPoE (PPP Profile)</option>
                <option value="hotspot">📡 Hotspot (User Profile / Voucher)</option>
              </select>
            </div>
          </div>
        </div>

        <div class="form-row">
          <div class="fg" style="flex:1;">
            <label class="fl"><i class="bi bi-cpu text-primary"></i> Profile di MikroTik *</label>
            <select class="fs" name="mikrotik_profile" id="add_profile_select" onchange="onProfileSelected('add', this.value)" required>
              <option value="">-- Pilih Profile MikroTik --</option>
            </select>
            <small class="text-muted" id="add_profile_hint" style="font-size:10.5px;display:block;margin-top:3px;">Memuat profil...</small>
          </div>
          <div class="fg" style="flex:1.2;">
            <label class="fl"><i class="bi bi-tag text-success"></i> Nama Paket Tampilan (Bebas) *</label>
            <input class="fc" name="name" id="add_name" required placeholder="Contoh: 1 Device (Rp 40.000)">
            <small class="text-muted" style="font-size:10.5px;display:block;margin-top:3px;">Nama ini yang muncul di invoice, billing & pelanggan.</small>
          </div>
        </div>
        
        <div class="form-row">
          <div class="fg"><label class="fl"><%= t('admin.packages.form.price_month', 'Harga / Bulan (Rp)') %> *</label><input class="fc" name="price" type="number" min="0" required placeholder="150000"></div>
          <div class="fg"><label class="fl"><%= t('admin.packages.form.status', 'Status') %></label>
            <select class="fs" name="is_active"><option value="1"><%= t('common.active', 'Aktif') %></option><option value="0"><%= t('common.inactive', 'Nonaktif') %></option></select>
          </div>
        </div>

        <!-- Tipe Billing: Pascabayar vs Prabayar -->
        <div class="form-row" style="background:rgba(99,102,241,0.05);padding:12px 14px;border-radius:10px;margin-top:10px;border:1px solid rgba(99,102,241,0.15);">
          <div class="fg">
            <label class="fl"><i class="bi bi-credit-card-2-front text-primary me-1"></i> Tipe Penagihan / Billing *</label>
            <select class="fs" name="billing_type" id="add_billing_type" onchange="toggleAddBillingType(this.value)">
              <option value="postpaid" selected>Pascabayar (Kalender / Jatuh Tempo Tetap)</option>
              <option value="prepaid">Prabayar (Masa Aktif Bergulir)</option>
            </select>
          </div>
          <div class="fg" id="add_duration_days_fg" style="display:none">
            <label class="fl"><i class="bi bi-clock-history text-warning me-1"></i> Durasi Masa Aktif (Hari) *</label>
            <input class="fc" name="duration_days" id="add_duration_days" type="number" min="1" value="30" placeholder="30">
            <small class="text-muted" style="font-size:11px;display:block;margin-top:2px;">
              Pelanggan aktif selama X hari sejak aktivasi / pembayaran.
            </small>
          </div>
        </div>

        <!-- Kecepatan Berdampingan (Download & Upload) -->
        <div class="form-row" style="background:rgba(59,130,246,0.04);padding:12px 14px;border-radius:10px;margin-top:10px;border:1px solid rgba(59,130,246,0.12);">
          <div class="fg">
            <label class="fl" style="color:var(--primary);font-weight:700;"><i class="bi bi-download"></i> Kecepatan Download (Mbps) *</label>
            <input class="fc" name="speed_down" id="add_down" type="number" step="any" min="0" placeholder="Contoh: 10" required>
          </div>
          <div class="fg">
            <label class="fl" style="color:var(--info);font-weight:700;"><i class="bi bi-upload"></i> Kecepatan Upload (Mbps) *</label>
            <input class="fc" name="speed_up" id="add_up" type="number" step="any" min="0" placeholder="Contoh: 5" required>
          </div>
        </div>

        <!-- Kecepatan UpTo / Maximum Burst Rate (Opsional Manual) -->
        <div style="background:rgba(16,185,129,0.04);padding:12px 14px;border-radius:10px;margin-top:10px;border:1px dashed rgba(16,185,129,0.25);">
          <div class="fw6" style="font-size:12px;margin-bottom:8px;color:var(--success)"><i class="bi bi-speedometer2"></i> Fitur Kecepatan UpTo / Max Rate (Opsional)</div>
          <div class="form-row">
            <div class="fg">
              <label class="fl">Download UpTo (Mbps)</label>
              <input class="fc" name="speed_down_upto" id="add_down_upto" type="number" step="any" min="0" placeholder="Kosongkan jika tanpa UpTo (mis: 20)">
            </div>
            <div class="fg">
              <label class="fl">Upload UpTo (Mbps)</label>
              <input class="fc" name="speed_up_upto" id="add_up_upto" type="number" step="any" min="0" placeholder="Kosongkan jika tanpa UpTo (mis: 10)">
            </div>
          </div>
          <small class="text-muted" style="font-size:11px;display:block;margin-top:2px;">
            Bila diisi, paket akan tampil sebagai: <strong>10 Mbps (Up to 20 Mbps)</strong> di invoice & portal pelanggan.
          </small>
        </div>
        <div style="background: rgba(34,197,94,0.06); padding: 12px 14px; border-radius: 10px; margin-top: 10px;">
          <div class="fw6" style="font-size:12px;margin-bottom:8px;color:var(--success)"><i class="bi bi-percent"></i> Promo & prorata tagihan</div>
          <div class="form-row">
            <div class="fg"><label class="fl">Harga promo (Rp / siklus)</label><input class="fc" name="promo_price" type="number" min="0" placeholder="Opsional, mis. 99000"></div>
            <div class="fg"><label class="fl">Jumlah bulan promo</label><input class="fc" name="promo_cycles" type="number" min="0" value="0" placeholder="0 = tanpa promo"></div>
          </div>
          <div class="flex ai-c" style="gap:8px;margin-top:4px">
            <input type="checkbox" name="prorate_first_invoice" id="add_prorate" value="1">
            <label for="add_prorate" style="margin:0;font-size:12px">Prorata tagihan <strong>pertama</strong> jika pasang di tengah bulan (proporsi sisa hari, perlu tanggal pasang di data pelanggan)</label>
          </div>
        </div>
        
        <div style="background: rgba(99,102,241,0.06); padding: 12px 14px; border-radius: 10px; margin-top: 10px;">
          <div class="fw6" style="font-size:12px;margin-bottom:8px;color:var(--primary)"><i class="bi bi-calculator"></i> Pengaturan Pajak & Regulasi (PPN & USO)</div>
          <div class="form-row" style="margin-bottom: 8px;">
            <div class="fg">
              <label style="display:flex; align-items:center; gap:8px; font-size:12px; font-weight:700; margin-top: 26px;">
                <input type="checkbox" name="use_ppn" id="add_use_ppn" value="1">
                Aktifkan PPN
              </label>
            </div>
            <div class="fg">
              <label class="fl">Persentase PPN (%)</label>
              <input class="fc" name="ppn_percentage" type="number" step="any" min="0" value="11.0">
            </div>
          </div>
          <div class="form-row">
            <div class="fg">
              <label style="display:flex; align-items:center; gap:8px; font-size:12px; font-weight:700; margin-top: 26px;">
                <input type="checkbox" name="use_uso" id="add_use_uso" value="1">
                Aktifkan ULO/USO
              </label>
            </div>
            <div class="fg">
              <label class="fl">Persentase ULO/USO (%)</label>
              <input class="fc" name="uso_percentage" type="number" step="any" min="0" value="1.75">
            </div>
          </div>
        </div>

        <div class="form-row">
          <div class="fg"><label class="fl"><%= t('admin.packages.form.speed_up', 'Kecepatan Upload (Mbps)') %></label><input class="fc" name="speed_up" type="number" step="any" min="0" placeholder="5"></div>
          <div class="fg"><label class="fl"><%= t('admin.packages.form.status', 'Status') %></label>
            <select class="fs" name="is_active"><option value="1"><%= t('common.active', 'Aktif') %></option><option value="0"><%= t('common.inactive', 'Nonaktif') %></option></select>
          </div>
        </div>
        <div class="fg"><label class="fl"><%= t('admin.packages.form.description', 'Deskripsi') %></label><textarea class="fc" name="description" placeholder="<%= t('admin.packages.form.optional', 'Opsional...') %>"></textarea></div>
        
        <!-- Dynamic Speed & FUP Section -->
        <div style="background: rgba(0,0,0,0.02); padding: 15px; border-radius: 12px; margin-top: 15px;">
          <div class="flex ai-c mb8" style="gap:10px">
            <input type="checkbox" name="use_night_speed" id="add_use_night" value="1" onchange="toggleAddNight()">
            <h6 style="font-size:12px; margin: 0; color: var(--primary); text-transform: uppercase; letter-spacing: 0.5px;"><i class="bi bi-clock"></i> Aktifkan Jam Kalong</h6>
          </div>
          <div id="add_night_fields" style="display:none">
            <div class="fg">
              <label class="fl">Nama Profile Malam (MikroTik)</label>
              <div style="display:flex;gap:8px">
                <select class="fs" id="add_night_profile_select" style="max-width:200px" onchange="document.getElementById('add_night_profile_input').value=this.value">
                  <option value="">-- Pilih Profile --</option>
                </select>
                <input class="fc" name="night_profile_name" id="add_night_profile_input" placeholder="Atau ketik manual...">
              </div>
            </div>
            <div class="form-row">
              <div class="fg"><label class="fl">Download Malam (Mbps)</label><input class="fc" name="night_speed_down" type="number" step="any" min="0" placeholder="20"></div>
              <div class="fg"><label class="fl">Upload Malam (Mbps)</label><input class="fc" name="night_speed_up" type="number" step="any" min="0" placeholder="10"></div>
            </div>
            <div style="font-size: 10px; color: var(--muted); margin-top: 4px;">Sistem akan ganti profile ppp pelanggan ke profile ini pada jam 00:00 - 06:00.</div>
          </div>
          
          <hr style="opacity:0.1; margin: 15px 0;">

          <div class="flex ai-c mb8" style="gap:10px">
            <input type="checkbox" name="use_fup" id="add_use_fup" value="1" onchange="toggleAddFup()">
            <h6 style="font-size:12px; margin: 0; color: var(--danger); text-transform: uppercase; letter-spacing: 0.5px;"><i class="bi bi-speedometer2"></i> Aktifkan FUP</h6>
          </div>
          <div id="add_fup_fields" style="display:none">
            <div class="fg">
              <label class="fl">Nama Profile FUP (MikroTik)</label>
              <div style="display:flex;gap:8px">
                <select class="fs" id="add_fup_profile_select" style="max-width:200px" onchange="document.getElementById('add_fup_profile_input').value=this.value">
                  <option value="">-- Pilih Profile --</option>
                </select>
                <input class="fc" name="fup_profile_name" id="add_fup_profile_input" placeholder="Atau ketik manual...">
              </div>
            </div>
            <div class="form-row">
              <div class="fg"><label class="fl">Batas Kuota (GB)</label><input class="fc" name="fup_limit_gb" type="number" step="any" min="0" placeholder="300"></div>
              <div class="fg"><label class="fl">Speed Setelah FUP (Mbps)</label><input class="fc" name="fup_speed_down" type="number" step="any" min="0" placeholder="2"></div>
            </div>
          </div>
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('addModal')"><%= t('common.cancel', 'Batal') %></button>
        <button type="submit" class="btn btn-p"><i class="bi bi-check-lg"></i> <%= t('common.save', 'Simpan') %></button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Edit -->
<div class="mo" id="editModal">
  <div class="mb" style="max-width:680px;">
    <div class="mh"><span class="mt"><i class="bi bi-pencil"></i> <%= t('admin.packages.edit', 'Edit Paket') %></span><button class="mc" onclick="closeModal('editModal')">&times;</button></div>
    <form method="POST" id="editForm">
      <div class="mbody" style="max-height:70vh; overflow-y:auto; padding-right:6px;">
        <!-- BAGIAN BARU: PILIHAN ROUTER & TIPE LAYANAN EDIT -->
        <div style="background:rgba(59,130,246,0.06);padding:12px 14px;border-radius:10px;margin-bottom:14px;border:1px solid rgba(59,130,246,0.2);">
          <div class="fw6" style="font-size:12px;margin-bottom:8px;color:var(--primary);">
            <i class="bi bi-hdd-network"></i> Router MikroTik & Jenis Layanan
          </div>
          <div class="form-row" style="margin-bottom:0">
            <div class="fg">
              <label class="fl">Pilih Router MikroTik *</label>
              <select class="fs" name="router_id" id="e_router_id" onchange="onPackageRouterOrTypeChange('edit')">
                <option value="">-- Default Router --</option>
                <% if (typeof routers !== 'undefined' && routers && routers.length > 0) { %>
                  <% routers.forEach(r => { %>
                    <option value="<%= r.id %>"><%= r.name %> (<%= r.host %>)</option>
                  <% }) %>
                <% } %>
              </select>
            </div>
            <div class="fg">
              <label class="fl">Tipe Layanan *</label>
              <select class="fs" name="service_type" id="e_service_type" onchange="onPackageRouterOrTypeChange('edit')" style="font-weight:700;">
                <option value="pppoe">⚡ PPPoE (PPP Profile)</option>
                <option value="hotspot">📡 Hotspot (User Profile / Voucher)</option>
              </select>
            </div>
          </div>
        </div>

        <div class="form-row">
          <div class="fg" style="flex:1;">
            <label class="fl"><i class="bi bi-cpu text-primary"></i> Profile di MikroTik *</label>
            <select class="fs" name="mikrotik_profile" id="e_profile_select" onchange="onProfileSelected('edit', this.value)" required>
              <option value="">-- Pilih Profile MikroTik --</option>
            </select>
            <small class="text-muted" id="e_profile_hint" style="font-size:10.5px;display:block;margin-top:3px;">Memuat profil...</small>
          </div>
          <div class="fg" style="flex:1.2;">
            <label class="fl"><i class="bi bi-tag text-success"></i> Nama Paket Tampilan (Bebas) *</label>
            <input class="fc" name="name" id="e_name" required placeholder="Contoh: 1 Device (Rp 40.000)">
            <small class="text-muted" style="font-size:10.5px;display:block;margin-top:3px;">Nama ini yang muncul di invoice, billing & pelanggan.</small>
          </div>
        </div>
		
        <div class="form-row">
          <div class="fg"><label class="fl"><%= t('admin.packages.form.price_month', 'Harga / Bulan (Rp)') %> *</label><input class="fc" name="price" id="e_price" type="number" min="0" required></div>
          <div class="fg"><label class="fl"><%= t('admin.packages.form.status', 'Status') %></label>
            <select class="fs" name="is_active" id="e_active"><option value="1"><%= t('common.active', 'Aktif') %></option><option value="0"><%= t('common.inactive', 'Nonaktif') %></option></select>
          </div>
        </div>

        <!-- Tipe Billing: Pascabayar vs Prabayar (Edit) -->
        <div class="form-row" style="background:rgba(99,102,241,0.05);padding:12px 14px;border-radius:10px;margin-top:10px;border:1px solid rgba(99,102,241,0.15);">
          <div class="fg">
            <label class="fl"><i class="bi bi-credit-card-2-front text-primary me-1"></i> Tipe Penagihan / Billing *</label>
            <select class="fs" name="billing_type" id="e_billing_type" onchange="toggleEditBillingType(this.value)">
              <option value="postpaid">Pascabayar (Kalender / Jatuh Tempo Tetap)</option>
              <option value="prepaid">Prabayar (Masa Aktif Bergulir)</option>
            </select>
          </div>
          <div class="fg" id="e_duration_days_fg" style="display:none">
            <label class="fl"><i class="bi bi-clock-history text-warning me-1"></i> Durasi Masa Aktif (Hari) *</label>
            <input class="fc" name="duration_days" id="e_duration_days" type="number" min="1" value="30" placeholder="30">
            <small class="text-muted" style="font-size:11px;display:block;margin-top:2px;">
              Pelanggan aktif selama X hari sejak aktivasi / pembayaran.
            </small>
