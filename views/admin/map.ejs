                  <span style="color:#64748b;">Live DL</span>
                  <span id="cust_${cust.id}_dl_val" style="color:#2563eb; font-family:monospace;">0.00 Mbps</span>
                </div>
                <canvas class="cp-spark" id="cust_${cust.id}_dl_chart" width="160" height="20" data-max="${downMaxMbps}"></canvas>
