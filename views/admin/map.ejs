<script>
  function showModernSaveSuccessModal(data) {
    if (document.getElementById('resModalTitle')) document.getElementById('resModalTitle').innerText = data.title || 'Jalur Kabel Berhasil Disimpan!';
    if (document.getElementById('resCustName')) document.getElementById('resCustName').innerText = data.targetName;
    if (document.getElementById('resPortLabel')) document.getElementById('resPortLabel').innerText = data.portLabel;
    if (document.getElementById('resPortOutput')) document.getElementById('resPortOutput').innerText = `${data.portOutputDbm > 0 ? '+' : ''}${data.portOutputDbm} dBm`;
    if (document.getElementById('resDistance')) document.getElementById('resDistance').innerText = `${data.distanceMeters} meter`;
    if (document.getElementById('resFiberLoss')) document.getElementById('resFiberLoss').innerText = `-${(data.fiberLoss + data.spliceLoss).toFixed(2)} dB (${data.spliceCount} splice)`;
    if (document.getElementById('resTotalLoss')) document.getElementById('resTotalLoss').innerText = `-${data.totalDropLoss} dB`;
    if (document.getElementById('resFinalRx')) document.getElementById('resFinalRx').innerText = `${data.finalRxDbm > 0 ? '+' : ''}${data.finalRxDbm} dBm`;

