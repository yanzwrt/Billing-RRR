<script id="customers-data" type="application/json"><%- JSON.stringify(customers).replace(/<\/script/g, '<\\/script').replace(/<!--/g, '<\\!--') %></script>
<script id="odps-data" type="application/json"><%- JSON.stringify(odps).replace(/<\/script/g, '<\\/script').replace(/<!--/g, '<\\!--') %></script>

<script>
// Data global list pelanggan dan odp untuk pilihan dropdown port
const globalCustomers = JSON.parse(document.getElementById('customers-data').textContent || '[]');
const globalOdps = JSON.parse(document.getElementById('odps-data').textContent || '[]');

// === [FUNGSI UTAMA HITUNG JARAK DAN LINK BUDGET OPTIK YANG KONSISTEN] ===
function normalizePathToLatLngs(rawCablePath) {
  if (!rawCablePath) return [];
  let pointsList = [];
  try {
    const parsed = typeof rawCablePath === 'string' ? JSON.parse(rawCablePath) : rawCablePath;
    if (parsed && typeof parsed === 'object' && !Array.isArray(parsed) && Array.isArray(parsed.points)) {
      pointsList = parsed.points;
    } else if (Array.isArray(parsed)) {
      pointsList = parsed;
    }
  } catch (e) { return []; }

  const cleanCoords = [];
  pointsList.forEach(pt => {
    if (!pt) return;
    let lat = 0, lng = 0;
    if (typeof pt === 'object' && !Array.isArray(pt)) {
      lat = parseFloat(pt.lat !== undefined ? pt.lat : pt[0]);
      lng = parseFloat(pt.lng !== undefined ? pt.lng : pt[1]);
    } else if (Array.isArray(pt)) {
      lat = parseFloat(pt[0]);
      lng = parseFloat(pt[1]);
    }
    if (!isNaN(lat) && !isNaN(lng)) {
      cleanCoords.push([lat, lng]);
    }
  });
  return cleanCoords;
}

function calculatePolylineLengthMeters(rawCablePathOrLatLngs) {
  const coords = Array.isArray(rawCablePathOrLatLngs) && Array.isArray(rawCablePathOrLatLngs[0]) 
    ? rawCablePathOrLatLngs 
    : normalizePathToLatLngs(rawCablePathOrLatLngs);

  if (!Array.isArray(coords) || coords.length < 2) return 0;
  
  let totalMeters = 0;
  for (let i = 0; i < coords.length - 1; i++) {
    const p1 = L.latLng(coords[i][0], coords[i][1]);
    const p2 = L.latLng(coords[i+1][0], coords[i+1][1]);
    totalMeters += p1.distanceTo(p2);
  }
  return Math.round(totalMeters);
}

// Fungsi universal menghitung total susut optik dari sebuah jalur kabel
function getRouteOpticalLoss(cablePathRaw) {
  let distanceMeters = 0;
  let spliceCount = 0;

  if (cablePathRaw) {
    try {
      const cleanCoords = normalizePathToLatLngs(cablePathRaw);
      if (cleanCoords.length >= 2) {
        distanceMeters = calculatePolylineLengthMeters(cleanCoords);
      }
      const parsed = typeof cablePathRaw === 'string' ? JSON.parse(cablePathRaw) : cablePathRaw;
      const pts = (parsed && typeof parsed === 'object' && !Array.isArray(parsed) && Array.isArray(parsed.points)) 
        ? parsed.points 
        : (Array.isArray(parsed) ? parsed : []);
      
      spliceCount = pts.filter((p, idx) => idx > 0 && idx < pts.length - 1 && p.isSplice).length;
    } catch(e) {}
  }

  // Standar redaman optik:
  // 1. Serat kabel FO: 0.35 dB per Kilometer
  const fiberLoss = parseFloat(((distanceMeters / 1000) * 0.40).toFixed(2));
  // 2. Titik sambungan splice tengah: 0.20 dB per titik
  const spliceLoss = parseFloat((spliceCount * 0.20).toFixed(2));

  return {
    distanceMeters,
    spliceCount,
    fiberLoss,
    spliceLoss,
    totalLoss: parseFloat((fiberLoss + spliceLoss).toFixed(2))
  };
}
