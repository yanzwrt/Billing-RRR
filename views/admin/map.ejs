  const div = document.createElement('div');
  div.className = 'splitter-row';
  div.style.cssText = 'display: flex; gap: 8px; align-items: center; margin-bottom: 8px; background: #f8fafc; padding: 8px; border-radius: 8px; border: 1px solid #e2e8f0;';
  
  div.innerHTML = `
    <div style="flex: 1;">
      <label style="font-size: 10px; font-weight: 700; color: #64748b;">TIPE</label>
      <select name="splitter_types[]" class="fc splitter-type" onchange="updateSplitterRatios(this)">
        <option value="PLC" ${type==='PLC'?'selected':''}>PLC</option>
        <option value="FBT" ${type==='FBT'?'selected':''}>FBT</option>
      </select>
    </div>
    <div style="flex: 1.5;">
      <label style="font-size: 10px; font-weight: 700; color: #64748b;">RASIO</label>
      <select name="splitter_ratios[]" class="fc splitter-ratio" onchange="recalculateEstimatedPower(); renderPortAllocationUI(window.__currentEditingPorts || []);">
      </select>
    </div>
    <div style="padding-top: 14px;">
      <button type="button" class="btn btn-sm btn-danger" onclick="this.closest('.splitter-row').remove(); recalculateEstimatedPower(); renderPortAllocationUI(window.__currentEditingPorts || []);" title="Hapus Splitter"><i class="bi bi-trash"></i></button>
    </div>
  `;
  
  container.appendChild(div);
  updateSplitterRatios(div.querySelector('.splitter-type'), ratio);
}

function toggleManualDbm(checkbox) {
  const inputField = document.getElementById('e_odp_input_power');
  if (!inputField) return;
  if (checkbox.checked) {
    inputField.removeAttribute('readonly');
    inputField.style.background = '#ffffff';
  } else {
    inputField.setAttribute('readonly', 'true');
    inputField.style.background = '#f1f5f9';
    recalculateEstimatedPower();
  }
}

