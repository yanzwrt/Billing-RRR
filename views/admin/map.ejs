  } catch (e) {
    console.error("Data mapping error:", e);
  }

  // Registries
  const odpMap = {}; 
  const customerMap = {}; 

  // 1. DAFTARKAN SEMUA ODP KE REGISTRY
  odps.forEach(odp => {
    if (odp.lat && odp.lng) {
      odpMap[odp.id] = {
        coord: [parseFloat(odp.lat), parseFloat(odp.lng)],
        data: odp
      };
    }
  });

  // === [MULAI KODE BARU: TARIK GARIS TRUNK & TAMPILKAN ICON SPLICE DI PETA] ===
  odps.forEach(odp => {
    if (odp.lat && odp.lng && odp.parent_odp_id && odpMap[odp.parent_odp_id]) {
      const parentCoord = odpMap[odp.parent_odp_id].coord;
      const childCoord = [parseFloat(odp.lat), parseFloat(odp.lng)];
      
      let pathCoords = [parentCoord, childCoord];
      let rawPointsData = [];
      let cableColor = '#f59e0b'; // Default Oranye

      if (odp.cable_path) {
        try {
          const parsed = JSON.parse(odp.cable_path);
          // Format baru: { color, points }
          if (parsed && typeof parsed === 'object' && !Array.isArray(parsed) && Array.isArray(parsed.points)) {
            cableColor = parsed.color || '#f59e0b';
            rawPointsData = parsed.points;
            pathCoords = parsed.points.map(pt => [
              (typeof pt.lat === 'number') ? pt.lat : pt[0],
              (typeof pt.lng === 'number') ? pt.lng : pt[1]
            ]);
          } 
          // Format lama: [...] array murni
          else if (Array.isArray(parsed) && parsed.length >= 2) {
            rawPointsData = parsed;
            pathCoords = parsed.map(pt => [
              (typeof pt.lat === 'number') ? pt.lat : (Array.isArray(pt) ? pt[0] : parseFloat(pt)),
              (typeof pt.lng === 'number') ? pt.lng : (Array.isArray(pt) ? pt[1] : parseFloat(pt))
            ]);
          }
        } catch(e) {}
      }
      
      // Garis kabel trunk dengan warna dinamis sesuai pilihan
      L.polyline(pathCoords, {
        color: cableColor,
        weight: 4.5,
        opacity: 0.95,
        dashArray: '6, 6',
        className: 'flowing-line'
      }).addTo(map);

      // Render marker icon splice di peta jika ada titik splice di tengah rute
      if (rawPointsData && rawPointsData.length > 2) {
        rawPointsData.forEach((pt, sIdx) => {
          if (sIdx > 0 && sIdx < rawPointsData.length - 1 && pt.isSplice) {
            const pLat = (typeof pt.lat === 'number') ? pt.lat : pt[0];
            const pLng = (typeof pt.lng === 'number') ? pt.lng : pt[1];

            const spliceMarkerIcon = L.divIcon({
              className: 'custom-div-icon',
              html: `<div class="pin-splice" title="Titik Sambungan Splice / Joint Box (-0.2 dB)"><i class="bi bi-tools"></i></div>`,
              iconSize: [18, 18],
              iconAnchor: [9, 9]
            });

            L.marker([pLat, pLng], { icon: spliceMarkerIcon, zIndexOffset: 2500 })
              .addTo(map)
              .bindPopup(`
                <div style="font-size: 12px; width: 200px;">
                  <div style="font-weight: 800; color: #9333ea; margin-bottom: 4px;">
                    <i class="bi bi-tools me-1"></i> Titik Sambungan Splice
                  </div>
                  <div style="font-size: 11px; color: #475569;">Jalur: <strong>${escapeHtml(odp.name)}</strong> ke Induk</div>
                  <div style="font-size: 11px; color: #dc2626; font-weight: 700; margin-top: 2px;">Redaman: -0.20 dB</div>
                  <div style="font-size: 10px; color: #64748b; margin-top: 4px;">Koordinat: ${Number(pLat).toFixed(6)}, ${Number(pLng).toFixed(6)}</div>
                </div>
              `);
          }
        });
      }
    }
  });
  // ======================================================================

  // 3. RENDER MARKER ODP
  odps.forEach(odp => {
    if (odp.lat && odp.lng) {
      const lat = parseFloat(odp.lat);
      const lng = parseFloat(odp.lng);

      const odpIcon = L.divIcon({
        className: 'custom-onu-icon',
        html: `
          <div class="odp-marker-node" id="odp-node-${odp.id}">
            <div class="odp-marker-pin" title="${escapeHtml(odp.name)} (ODP)">
              <i class="bi bi-box-seam-fill"></i>
            </div>
            <div class="odp-marker-label">
              <span class="odp-marker-name">${escapeHtml(odp.name)}</span>
            </div>
          </div>
        `,
        iconSize: [26, 26],
        iconAnchor: [13, 13]
      });

      const marker = L.marker([lat, lng], { icon: odpIcon }).addTo(map);
      
      let portsHtml = '<div style="margin-top:8px; max-height:120px; overflow-y:auto; border-top:1px solid #e2e8f0; padding-top:6px;"><div style="font-size:11px; font-weight:700; color:#64748b; margin-bottom:4px;">STATUS PORT SPLITTER:</div>';
      if (odp.ports && odp.ports.length > 0) {
        odp.ports.forEach(p => {
          const isUsed = p.target_type && p.target_type !== 'EMPTY';
          const badgeColor = isUsed ? '#10b981' : '#94a3b8';
          const targetName = p.target_type === 'CUSTOMER' ? (p.customer_name || 'Pelanggan') : (p.target_type === 'CHILD_ODP' ? (p.child_odp_name || 'ODP Anak') : 'Kosong');
          portsHtml += `<div style="font-size:10.5px; display:flex; justify-content:space-between; padding:2px 4px; border-bottom:1px solid #f1f5f9;">
            <span>Port ${p.port_number}</span>
            <span style="color:${badgeColor}; font-weight:700;">${targetName}</span>
          </div>`;
        });
      } else {
        portsHtml += '<div style="font-size:10.5px; color:#94a3b8;">Belum ada konfigurasi port.</div>';
      }
      portsHtml += '</div>';

      // === [KODE FINAL: POPUP DETAIL ODP PROFESIONAL & DETAIL LOSS LAPANGAN] ===
      const popCalc = getOdpIncomingPower(odp.id, odp.parent_odp_id, odp.lat, odp.lng);
      const displayInputPower = odp.parent_odp_id ? popCalc.powerDbm : parseFloat(odp.input_power_dbm !== undefined ? odp.input_power_dbm : 9.0);

      // Hitung rincian optical link budget dari jalur ODP
      let fiberLossDb = 0.0;
      let spliceCount = 0;
      let spliceLossDb = 0.0;
      let pigtailLossDb = odp.parent_odp_id ? 0.40 : 0.0; // Ujung pangkal + ujung penerima
      let distanceM = popCalc.distanceMeters || 0;

      if (odp.cable_path) {
        try {
          const parsed = JSON.parse(odp.cable_path);
          const pts = (parsed && typeof parsed === 'object' && !Array.isArray(parsed) && Array.isArray(parsed.points))
            ? parsed.points
            : (Array.isArray(parsed) ? parsed : []);
          
          if (pts.length >= 2) {
            spliceCount = pts.filter((p, idx) => idx > 0 && idx < pts.length - 1 && p.isSplice).length;
            spliceLossDb = parseFloat((spliceCount * 0.20).toFixed(2));
          }
        } catch(e) {}
      }
      fiberLossDb = parseFloat(((distanceM / 1000) * 0.40).toFixed(2));
      const totalBudgetLoss = parseFloat((fiberLossDb + spliceLossDb + pigtailLossDb).toFixed(2));

      // Warna badge input daya
      let powerBg = '#dcfce7';
      let powerColor = '#15803d';
      if (displayInputPower < -18.0) { powerBg = '#fef3c7'; powerColor = '#b45309'; }
      if (displayInputPower < -24.0) { powerBg = '#fee2e2'; powerColor = '#b91c1c'; }

      // =========GENERATOR SLIDER & TAB PILL SPLITTER BERSIH PER-SPLITTER========= 
      const portsList = odp.ports || [];
      const splittersList = (odp.splitters && odp.splitters.length > 0) 
        ? odp.splitters 
        : [{ splitter_index: 1, splitter_type: (odp.splitter_type || 'PLC'), splitter_ratio: (odp.splitter_ratio || '1:8') }];

      const totalSplitters = splittersList.length;
      let splitterSlidesHtml = '';
      let splitterPillsHtml = '';

      splittersList.forEach((sp, sIdx) => {
        const sNum = sIdx + 1;
        const isActiveSlide = (sIdx === 0);
        const sType = sp.splitter_type || 'PLC';
        const sRatio = sp.splitter_ratio || (sType === 'FBT' ? '5:95' : '1:8');

        // Filter hanya port milik splitter nomor ini
        const thisSplitterPorts = portsList.filter(p => Number(p.splitter_index || 1) === sNum);
        const usedThisSplitter = thisSplitterPorts.filter(p => p.target_type && p.target_type !== 'EMPTY').length;
        const totalThisSplitter = thisSplitterPorts.length || (sType === 'FBT' ? 2 : 4);

        // Buat Pill Tab Mini
        splitterPillsHtml += `
          <button type="button" 
                  class="odp-pill-btn ${isActiveSlide ? 'active' : ''}" 
                  id="pill_odp_${odp.id}_${sIdx}"
                  onclick="switchOdpSplitterSlide(${odp.id}, ${sIdx}, ${totalSplitters})"
                  title="${sType} ${sRatio}">
            #${sNum} ${sType} ${sRatio} (${usedThisSplitter}/${totalThisSplitter})
          </button>
        `;

        // Render port-port adapter mini khusus splitter ini
        let portsGridContent = '';
        if (thisSplitterPorts.length > 0) {
          thisSplitterPorts.forEach(p => {
            const isUsed = p.target_type && p.target_type !== 'EMPTY';
            let ledBg = '#94a3b8';
            let targetLabel = 'Kosong';

            if (p.target_type === 'CUSTOMER') {
              ledBg = '#22c55e';
              targetLabel = p.customer_name || 'Pelanggan';
            } else if (p.target_type === 'CHILD_ODP') {
              ledBg = '#38bdf8';
              targetLabel = p.child_odp_name || 'ODP Cabang';
            } else if (p.target_type === 'INTERNAL_SPLITTER') {
              ledBg = '#facc15';
              targetLabel = 'Jumper Int';
            }

            // Hitung estimasi output port spesifik
            let portOutDbm = '-';
            if (typeof calculateUniversalPortPower === 'function') {
              portOutDbm = calculateUniversalPortPower(odp, sIdx, p.port_number);
            }

            const rawTargetName = p.target_type === 'CUSTOMER' ? (p.customer_name || 'Pelanggan') : (p.target_type === 'CHILD_ODP' ? (p.child_odp_name || 'ODP Cabang') : (p.target_type === 'INTERNAL_SPLITTER' ? 'Jumper Internal' : 'Port Kosong'));
            const connNear = p.connector_near || 'PIGTAIL';
            const connFar = p.connector_far || 'FASTCON';

            portsGridContent += `
              <div class="odp-mini-port ${!isUsed ? 'is-empty' : ''}" 
                   id="mini_port_${odp.id}_${sNum}_${p.port_number}"
                   title="Klik untuk lihat detail Port ${p.port_number}"
                   onclick="showPortQuickDetail(${odp.id}, ${sNum}, ${p.port_number}, '${escapeHtml(targetLabel)}', '${p.target_type || 'EMPTY'}', '${escapeHtml(rawTargetName)}', '${portOutDbm}', '${connNear}', '${connFar}', '${p.target_id || ''}')">
                <span class="p-led" style="background:${ledBg};"></span>
                <div class="p-name">P-${p.port_number}</div>
                <div class="p-target">${escapeHtml(targetLabel)}</div>
              </div>
            `;
          });
        } else {
          portsGridContent = `<div style="font-size:10.5px; color:#94a3b8; text-align:center; grid-column:span 3; padding:8px;">Belum ada port di Splitter #${sNum}</div>`;
        }

        // Wadah Slide Splitter
        splitterSlidesHtml += `
          <div class="odp-splitter-slide ${isActiveSlide ? 'active' : ''}" id="slide_odp_${odp.id}_${sIdx}">
            <div class="odp-mini-ports-container">
              ${portsGridContent}
            </div>
          </div>
        `;
      });

      // Panel Header Carousel Splitter
      const carouselControlHtml = `
        <div style="margin-top: 4px; margin-bottom: 8px; border-top: 1px solid #e2e8f0; padding-top: 6px;">
          <div class="odp-carousel-header">
            <span class="odp-carousel-title" id="title_odp_${odp.id}">
              <i class="bi bi-hdd-network text-primary"></i> 
              Splitter #1: ${splittersList[0].splitter_type || 'PLC'} (${splittersList[0].splitter_ratio || '1:8'})
            </span>
            ${totalSplitters > 1 ? `
              <div class="odp-carousel-arrows">
                <button type="button" class="odp-nav-btn" onclick="prevOdpSplitterSlide(${odp.id}, ${totalSplitters})" title="Splitter Sebelumnya">
                  <i class="bi bi-chevron-left"></i>
                </button>
                <button type="button" class="odp-nav-btn" onclick="nextOdpSplitterSlide(${odp.id}, ${totalSplitters})" title="Splitter Berikutnya">
                  <i class="bi bi-chevron-right"></i>
                </button>
              </div>
            ` : ''}
          </div>

          ${totalSplitters > 1 ? `
            <div class="odp-pill-container" id="pills_container_odp_${odp.id}">
              ${splitterPillsHtml}
            </div>
          ` : ''}

          <!-- Wadah Port-Port Splitter yang Terpisah -->
          <div id="slides_container_odp_${odp.id}">
            ${splitterSlidesHtml}
          </div>

          <!-- Wadah Kartu Detail Port Saat Diklik -->
          <div id="odp_port_detail_view_${odp.id}" style="display: none;"></div>
        </div>
      `;
      // =========================================================================

      // Card analisis loss hulu jika ODP memiliki Induk
      let budgetAnalysisHtml = '';
      // === [KODE BARU: RINCIAN LOSS JARAK DAN LOSS KABEL DETAIL PADA POPUP ODP] ===
      if (odp.parent_odp_id) {
        budgetAnalysisHtml = `
          <div class="odp-budget-card">
            <div class="odp-budget-row">
              <span><i class="bi bi-geo-alt-fill text-primary me-1"></i>Jalur dari Induk</span>
              <span style="font-weight:700;">${escapeHtml(popCalc.portSource || odp.parent_odp_name || 'ODP Pusat')}</span>
            </div>
            <div class="odp-budget-row">
              <span><i class="bi bi-box-arrow-right text-success me-1"></i>Daya Keluar Port Induk</span>
              <span style="font-weight:700; color:#0284c7;">${popCalc.parentPortPower > 0 ? '+' : ''}${popCalc.parentPortPower} dBm</span>
            </div>
            <div class="odp-budget-row">
              <span><i class="bi bi-rulers me-1"></i>Jarak Kabel ke Induk</span>
              <span><strong>${popCalc.distanceMeters} m</strong> <small style="color:#64748b;">(${(popCalc.distanceMeters/1000).toFixed(2)} km)</small></span>
            </div>
            <div class="odp-budget-row">
              <span><i class="bi bi-activity text-info me-1"></i>Loss Kabel (0.35 dB/km)</span>
              <span style="color:#d97706; font-weight:700;">-${popCalc.fiberLossDb} dB</span>
            </div>
            ${popCalc.spliceCount > 0 ? `
            <div class="odp-budget-row">
              <span><i class="bi bi-tools text-purple me-1" style="color:#9333ea;"></i>Sambungan Splice (${popCalc.spliceCount} titik)</span>
              <span style="color:#9333ea; font-weight:700;">-${popCalc.spliceLossDb} dB</span>
            </div>
            ` : ''}
            <div class="odp-budget-row">
              <span><i class="bi bi-plug-fill text-warning me-1"></i>Konektor Penerima</span>
              <span><small style="color:#64748b;">-${popCalc.farLoss} dB</small></span>
            </div>
            <div class="odp-budget-row">
              <span><i class="bi bi-arrow-down-right-circle text-danger me-1"></i>Total Susut/Loss Kabel</span>
              <span style="color:#dc2626; font-weight:800; font-family:monospace; font-size:11.5px;">-${popCalc.cableLossDb} dB</span>
            </div>
          </div>
        `;
      }
	  else {
        budgetAnalysisHtml = `
          <div style="background:#eff6ff; border:1px solid #bfdbfe; border-radius:8px; padding:6px 10px; font-size:11px; color:#1e40af; margin-bottom:8px; font-weight:700;">
            <i class="bi bi-hdd-rack-fill me-1"></i> ODP Pusat / Server Utama (Sumber Laser)
          </div>
        `;
      }

      marker.bindPopup(`
        <div class="odp-pro-popup">
          <div class="odp-pro-header">
            <div class="odp-pro-title">
              <i class="bi bi-box-seam-fill text-warning"></i>
              <span>${escapeHtml(odp.name)}</span>
            </div>
            <div class="odp-pro-badge" style="background:${powerBg}; color:${powerColor}; border:1px solid ${powerColor}40;">
              Rx: ${displayInputPower > 0 ? '+' : ''}${displayInputPower} dBm
            </div>
          </div>

          ${odp.description ? `<div style="font-size:11px; color:#64748b; margin-bottom:8px;"><i class="bi bi-info-circle me-1"></i>${escapeHtml(odp.description)}</div>` : ''}

          <!-- Kartu Analisis Link Budget -->
          ${budgetAnalysisHtml}

          <!-- Visualisasi Port Splitter Carousel Opsi B -->
          ${carouselControlHtml}

          <!-- Tombol Aksi Bawah Rapi -->
          <div class="odp-action-btns-grid">
            <button type="button" class="odp-act-btn odp-btn-edit" onclick='editOdp(${JSON.stringify(odp)})' title="Edit Pengaturan ODP">
              <i class="bi bi-pencil-square"></i> Edit
            </button>
            ${odp.parent_odp_id ? `
              <button type="button" class="odp-act-btn odp-btn-cable" onclick="startOdpCableDrawing(${odp.id}, ${lat}, ${lng}, ${odp.parent_odp_id})" title="Atur rute kabel ke Induk">
                <i class="bi bi-bezier2"></i> Jalur
              </button>
              <button type="button" class="odp-act-btn odp-btn-otdr" onclick="openOtdrModal('odp', ${odp.id})" title="Lacak titik putus kabel via OTDR">
                <i class="bi bi-crosshair"></i> OTDR
              </button>
            ` : ''}
          </div>
        </div>
      `);
      // === [AKHIR KODE POPUP DETAIL ODP PROFESIONAL] ===

      // PENTING: Masukkan kembali marker ke odpMap agar pencarian & klik fokus tidak error!
      odpMap[odp.id] = {
        marker,
        data: odp,
        coord: [lat, lng]
      };
    }
  });

  // === [MULAI KODE PERBAIKAN: HANYA GAMBAR JALUR KABEL JIKA SUDAH DIALOKASIKAN DI PORT ODP] ===
  // 1. Kumpulkan pemetaan ID pelanggan yang sah mendapatkan alokasi port ODP: Map(customerId -> odpId)
  const customerAllocatedPortMap = new Map();
  odps.forEach(o => {
    if (o.ports && Array.isArray(o.ports)) {
      o.ports.forEach(p => {
        if (p.target_type === 'CUSTOMER' && p.target_id) {
          customerAllocatedPortMap.set(Number(p.target_id), Number(o.id));
        }
      });
    }
  });

  // 2. Render Customer ONU Markers
  customers.forEach(cust => {
    if (cust.lat && cust.lng) {
      const lat = parseFloat(cust.lat);
      const lng = parseFloat(cust.lng);
      const is_active = cust.status === 'active';
      const downMaxMbps = (cust.speed_down && Number(cust.speed_down) > 0) ? Math.max(1, Math.round(Number(cust.speed_down) / 1000)) : 10;
      const upMaxMbps = (cust.speed_up && Number(cust.speed_up) > 0) ? Math.max(1, Math.round(Number(cust.speed_up) / 1000)) : 10;
      const waLink = buildWaLink(cust.phone, cust.name);
      
      // Validasi: Garis kabel HANYA digambar jika pelanggan terdaftar di port ODP!
      let polyline = null;
      const connectedOdpId = customerAllocatedPortMap.get(Number(cust.id));

      if (connectedOdpId && odpMap[connectedOdpId]) {
        let pathCoords = [[lat, lng], odpMap[connectedOdpId].coord];
        
        let rawCustPoints = [];
        if (cust.cable_path) {
          try {
            const parsed = JSON.parse(cust.cable_path);
            const pts = (parsed && typeof parsed === 'object' && !Array.isArray(parsed) && Array.isArray(parsed.points)) 
              ? parsed.points 
              : (Array.isArray(parsed) ? parsed : []);

            if (pts.length >= 2) {
              rawCustPoints = pts;
              pathCoords = pts.map(pt => [
                (typeof pt.lat === 'number') ? pt.lat : (Array.isArray(pt) ? parseFloat(pt[0]) : parseFloat(pt)),
                (typeof pt.lng === 'number') ? pt.lng : (Array.isArray(pt) ? parseFloat(pt[1]) : parseFloat(pt))
              ]);
            }
          } catch(e) {}
        }

        polyline = L.polyline(pathCoords, {
          color: is_active ? '#3b82f6' : '#ef4444',
          weight: 3,
          opacity: 0.8,
          dashArray: '10, 10',
          className: 'flowing-line'
        }).addTo(map);

        // Render marker icon splice di rute kabel pelanggan jika ada titik splice
        if (rawCustPoints && rawCustPoints.length > 2) {
          rawCustPoints.forEach((pt, sIdx) => {
            if (sIdx > 0 && sIdx < rawCustPoints.length - 1 && pt.isSplice) {
              const pLat = (typeof pt.lat === 'number') ? pt.lat : pt[0];
              const pLng = (typeof pt.lng === 'number') ? pt.lng : pt[1];

              const spliceMarkerIcon = L.divIcon({
              className: 'custom-div-icon',
              html: `<div class="pin-splice" title="Titik Sambungan Drop Core (-0.2 dB)"><i class="bi bi-tools"></i></div>`,
              iconSize: [18, 18],
              iconAnchor: [9, 9]
            });

              L.marker([pLat, pLng], { icon: spliceMarkerIcon, zIndexOffset: 2500 })
                .addTo(map)
                .bindPopup(`
                  <div style="font-size: 12px; width: 200px;">
                    <div style="font-weight: 800; color: #9333ea; margin-bottom: 4px;">
                      <i class="bi bi-tools me-1"></i> Titik Sambungan Drop Core
                    </div>
                    <div style="font-size: 11px; color: #475569;">Pelanggan: <strong>${escapeHtml(cust.name)}</strong></div>
                    <div style="font-size: 11px; color: #dc2626; font-weight: 700; margin-top: 2px;">Redaman: -0.20 dB</div>
                    <div style="font-size: 10px; color: #64748b; margin-top: 4px;">Koordinat: ${Number(pLat).toFixed(6)}, ${Number(pLng).toFixed(6)}</div>
                  </div>
                `);
            }
          });
        }

        polyline.on('click', (e) => {
          if (currentEditingPolyline === polyline) {
             L.DomEvent.stopPropagation(e);
          }
        });
      }
  // === [AKHIR KODE PERBAIKAN: HANYA GAMBAR JALUR KABEL JIKA SUDAH DIALOKASIKAN] ===

      // Customer Marker Icon with Clean Floating Name
      const onuIcon = L.divIcon({
        className: 'custom-onu-icon',
        html: `
          <div class="onu-marker-node ${is_active ? 'is-active' : 'is-suspended'}" id="onu-node-${cust.id}">
            <div class="onu-marker-pin" title="${escapeHtml(cust.name)} (${is_active ? 'Aktif' : 'Isolir'})">
              <i class="bi bi-router-fill"></i>
            </div>
            <div class="onu-marker-label">
              <span class="onu-marker-name">${escapeHtml(cust.name)}</span>
            </div>
          </div>
        `,
        iconSize: [26, 26],
        iconAnchor: [13, 13]
      });

      const marker = L.marker([lat, lng], { icon: onuIcon }).addTo(map);

      // === [KODE FINAL: POPUP PELANGGAN MODERN CLEAN UI - RAPI & ELEGAN] ===
      marker.bindPopup(`
        <div class="cust-popup">
