    <!-- Baris 2: Konektor 2 Ujung (Ujung Pangkal di ODP vs Ujung Akhir di Tujuan) -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; align-items: center; border-top: 1px dashed #cbd5e1; padding-top: 8px;">
      <div>
        <label style="font-size: 10.5px; font-weight: 800; color: #0284c7; display: flex; align-items: center; justify-content: space-between; margin-bottom: 3px;">
          <span>1. KONEKTOR PANGKAL (DI ODP INI):</span>
          <span style="font-size: 9.5px; font-weight: 700; color: #64748b;">(Adapter Box)</span>
        </label>
        <select id="editor_connector_near_${portObj.portKey}" class="fc" style="font-size: 12px; font-weight: 600; padding: 5px 8px;" onchange="onPortPropertyChange('${portObj.portKey}')">
          <option value="PIGTAIL" ${connNear === 'PIGTAIL' ? 'selected' : ''}>Pigtail (Splice Las -0.30 dB)</option>
          <option value="FASTCON" ${connNear === 'FASTCON' ? 'selected' : ''}>Fast Connector (-1.00 dB)</option>
        </select>
      </div>

      <div>
        <label style="font-size: 10.5px; font-weight: 800; color: #16a34a; display: flex; align-items: center; justify-content: space-between; margin-bottom: 3px;">
          <span>2. KONEKTOR UJUNG (DI TUJUAN):</span>
          <span style="font-size: 9.5px; font-weight: 700; color: #64748b;">(Modem / Roset / ODP Anak)</span>
        </label>
        <select id="editor_connector_far_${portObj.portKey}" class="fc" style="font-size: 12px; font-weight: 600; padding: 5px 8px;" onchange="onPortPropertyChange('${portObj.portKey}')">
          <option value="FASTCON" ${connFar === 'FASTCON' ? 'selected' : ''}>Fast Connector (-1.00 dB)</option>
          <option value="PIGTAIL" ${connFar === 'PIGTAIL' ? 'selected' : ''}>Pigtail (Splice Las -0.30 dB)</option>
        </select>
      </div>
    </div>
  `;
// === [AKHIR KODE BARU: DUA UJUNG KONEKTOR] ===

  // Render opsi spesifik pertama kali sesuai kategori awal
  populateTargetDropdown(portObj.portKey, portObj.targetType, portObj.targetId, portObj.splitterIndex);
}

// 5. Mengisi Dropdown Spesifik dengan Filter Cerdas (Mencegah Dobel Alokasi)
function populateTargetDropdown(portKey, category, selectedId, currentSplitterIndex) {
  const targetSelect = document.getElementById(`editor_target_item_${portKey}`);
  if (!targetSelect) return;

  targetSelect.innerHTML = '';

  if (category === 'EMPTY') {
    targetSelect.disabled = true;
    targetSelect.innerHTML = '<option value="">(Port tidak disambungkan)</option>';
    return;
  }

  targetSelect.disabled = false;

  const currentEditingOdpId = Number(window.__currentEditingOdpId || 0);
  const currentPortsInBox = window.__currentEditingPorts || [];
  const cleanSelectedId = selectedId ? String(selectedId).trim() : '';
  // -------------------------------------------------------------
  
  // A. KATEGORI: PELANGGAN (CUSTOMER)
  if (category === 'CUSTOMER') {
    targetSelect.innerHTML = '<option value="">-- Pilih Pelanggan (Tersedia) --</option>';

    // 1. Kumpulkan ID pelanggan yang sudah dipakai di port lain dalam box ini
    const usedCustomersInThisBox = new Set();
    currentPortsInBox.forEach(p => {
      const pKey = `${p.splitter_index}_${p.port_number}`;
      if (pKey !== portKey && p.target_type === 'CUSTOMER' && p.target_id) {
        usedCustomersInThisBox.add(Number(p.target_id));
      }
    });

    // 2. Kumpulkan ID pelanggan yang sudah terhubung di ODP LAIN di database
    const usedCustomersInOtherOdps = new Set();
    globalOdps.forEach(o => {
      if (Number(o.id) !== currentEditingOdpId && Array.isArray(o.ports)) {
        o.ports.forEach(p => {
          if (p.target_type === 'CUSTOMER' && p.target_id) {
            usedCustomersInOtherOdps.add(Number(p.target_id));
          }
        });
      }
    });

    let availableCount = 0;
    globalCustomers.forEach(c => {
      const custId = Number(c.id);
      const isCurrentlySelected = (cleanSelectedId === String(custId));

      // Cek apakah pelanggan sudah terpakai
      const isUsedHere = usedCustomersInThisBox.has(custId);
      const isUsedElsewhere = usedCustomersInOtherOdps.has(custId) || 
                              (c.odp_id && Number(c.odp_id) !== currentEditingOdpId);

      // Tampilkan HANYA jika belum dipakai dimanapun, ATAU jika pelanggan ini adalah pemilik port saat ini
      if (!isUsedHere && !isUsedElsewhere || isCurrentlySelected) {
        const isSel = isCurrentlySelected ? 'selected' : '';
        targetSelect.innerHTML += `<option value="${c.id}" ${isSel}>${escapeHtml(c.name)} (${c.phone || 'No HP -'})</option>`;
        availableCount++;
      }
    });

    if (availableCount === 0 && !cleanSelectedId) {
      targetSelect.innerHTML = '<option value="">(Semua pelanggan sudah terhubung ke port/ODP)</option>';
    }
  }
  // -------------------------------------------------------------
  
  // B. KATEGORI: ODP LANJUTAN (CHILD_ODP)
  else if (category === 'CHILD_ODP') {
    targetSelect.innerHTML = '<option value="">-- Pilih ODP Lanjutan (Tersedia) --</option>';

    // 1. Kumpulkan ODP yang sudah dipakai di port lain dalam box ini
    const usedChildInThisBox = new Set();
    currentPortsInBox.forEach(p => {
      const pKey = `${p.splitter_index}_${p.port_number}`;
      if (pKey !== portKey && p.target_type === 'CHILD_ODP' && p.target_id) {
        usedChildInThisBox.add(Number(p.target_id));
      }
    });

    let availableCount = 0;
    globalOdps.forEach(o => {
      const oId = Number(o.id);
      const isCurrentlySelected = (cleanSelectedId === String(oId));

      // Syarat ODP Anak bisa dipilih:
      // 1. Bukan dirinya sendiri
      // 2. Belum dipakai di port lain dalam box ini
      // 3. Belum memiliki induk lain (parent_odp_id kosong atau memang menginduk ke ODP ini)
      const isSelf = (oId === currentEditingOdpId);
      const isUsedInOtherPort = usedChildInThisBox.has(oId);
      const hasOtherParent = o.parent_odp_id && Number(o.parent_odp_id) !== currentEditingOdpId;

      if (!isSelf && (!isUsedInOtherPort && !hasOtherParent || isCurrentlySelected)) {
        const isSel = isCurrentlySelected ? 'selected' : '';
        targetSelect.innerHTML += `<option value="${o.id}" ${isSel}>ODP: ${escapeHtml(o.name)}</option>`;
        availableCount++;
      }
    });

    if (availableCount === 0 && !cleanSelectedId) {
      targetSelect.innerHTML = '<option value="">(Tidak ada ODP tersedia tanpa induk)</option>';
    }
  }
  // -------------------------------------------------------------
  
  // C. KATEGORI: SPLITTER INTERNAL DALAM BOX (INTERNAL_SPLITTER)
  else if (category === 'INTERNAL_SPLITTER') {
    targetSelect.innerHTML = '<option value="">-- Pilih Splitter Internal (Tersedia) --</option>';

    // 1. Cari splitter mana saja yang SUDAH memiliki input dari port lain di box ini
    const splittersWithInput = new Set();
    currentPortsInBox.forEach(p => {
      const pKey = `${p.splitter_index}_${p.port_number}`;
      if (pKey !== portKey && (p.target_type === 'INTERNAL_SPLITTER' || String(p.target_type).includes('SPLITTER'))) {
        const targetSpNum = Number(String(p.target_id || '').replace(/[^0-9]/g, ''));
        if (targetSpNum > 0) splittersWithInput.add(targetSpNum);
      }
    });

    const rows = document.querySelectorAll('.splitter-row');
    let availableCount = 0;

    rows.forEach((_, innerIdx) => {
      const splitterNum = innerIdx + 1;
      const isCurrentlySelected = (cleanSelectedId === String(splitterNum));

      // Syarat Splitter Internal bisa dipilih:
      // 1. Bukan Splitter #1 (karena Splitter #1 adalah input utama box ODP)
      // 2. Bukan splitter yang sama dengan port asal (tidak bisa memberi input ke diri sendiri)
      // 3. Splitter tersebut BELUM menerima input dari port lain (atau sedang dipilih di port ini)
      const isSplitterOne = (splitterNum === 1);
      const isSelf = (splitterNum === currentSplitterIndex);
      const alreadyHasInput = splittersWithInput.has(splitterNum);

      if (!isSplitterOne && !isSelf && (!alreadyHasInput || isCurrentlySelected)) {
        const isSel = isCurrentlySelected ? 'selected' : '';
        targetSelect.innerHTML += `<option value="${splitterNum}" ${isSel}>Ke Splitter Internal #${splitterNum} di Box Ini</option>`;
        availableCount++;
      }
    });

    if (availableCount === 0 && !cleanSelectedId) {
      targetSelect.innerHTML = '<option value="">(Semua splitter internal sudah memiliki input)</option>';
    }
  }
}

// Handler saat kategori tujuan diubah
function onPortCategoryChange(portKey) {
  const catSelect = document.getElementById(`editor_category_${portKey}`);
  if (!catSelect) return;

  const category = catSelect.value;
  const parts = portKey.split('_');
  const currentSplitterIndex = Number(parts[0]);

  populateTargetDropdown(portKey, category, '', currentSplitterIndex);

  // Sesuaikan nilai default konektor ujung HANYA saat kategori tujuan berpindah
  const connFarSelect = document.getElementById(`editor_connector_far_${portKey}`);
  if (connFarSelect) {
    if (category === 'CUSTOMER') {
      connFarSelect.value = 'FASTCON';
    } else if (category === 'CHILD_ODP') {
      connFarSelect.value = 'PIGTAIL';
    }
  }

  onPortPropertyChange(portKey);
}

// 6. Menyimpan perubahan konektor / target sambungan
function onPortPropertyChange(portKey) {
  const catSelect = document.getElementById(`editor_category_${portKey}`);
  const targetItemSelect = document.getElementById(`editor_target_item_${portKey}`);
  const connNearSelect = document.getElementById(`editor_connector_near_${portKey}`);
  const connFarSelect = document.getElementById(`editor_connector_far_${portKey}`);
  if (!catSelect || !targetItemSelect) return;

  const categoryVal = catSelect.value;
  const targetIdVal = targetItemSelect.value;
  const connNearVal = connNearSelect ? connNearSelect.value : 'PIGTAIL';
  const connFarVal = connFarSelect ? connFarSelect.value : 'FASTCON';

  let rawTargetValue = 'EMPTY';
  if (categoryVal === 'CUSTOMER' && targetIdVal) rawTargetValue = `CUSTOMER_${targetIdVal}`;
  else if (categoryVal === 'CHILD_ODP' && targetIdVal) rawTargetValue = `CHILD_ODP_${targetIdVal}`;
  else if (categoryVal === 'INTERNAL_SPLITTER' && targetIdVal) rawTargetValue = `SPLITTER_${targetIdVal}`;

  // Update data ke array cache
  const parts = portKey.split('_');
  const sIdx = Number(parts[0]);
  const pNum = Number(parts[1]);

  if (!window.__currentEditingPorts) window.__currentEditingPorts = [];
  const existing = window.__currentEditingPorts.find(ep => Number(ep.splitter_index || 1) === sIdx && ep.port_number === pNum);
  
  if (existing) {
    existing.target_type = categoryVal;
    existing.target_id = targetIdVal ? parseInt(targetIdVal, 10) : null;
    existing.connector_type = `${connNearVal}_${connFarVal}`;
    existing.connector_near = connNearVal; // 👈 Kunci simpan ujung pangkal
    existing.connector_far = connFarVal;   // 👈 Kunci simpan ujung jauh
  } else {
    window.__currentEditingPorts.push({
      splitter_index: sIdx,
      port_number: pNum,
      target_type: categoryVal,
      target_id: targetIdVal ? parseInt(targetIdVal, 10) : null,
      connector_type: `${connNearVal}_${connFarVal}`,
      connector_near: connNearVal,
      connector_far: connFarVal
    });
  }

  // Update input hidden form agar terkirim ke backend
  const hiddenTarget = document.getElementById(`hidden_target_${portKey}`);
  const hiddenConnector = document.getElementById(`hidden_connector_${portKey}`);
  if (hiddenTarget) hiddenTarget.value = rawTargetValue;
  if (hiddenConnector) hiddenConnector.value = `${connNearVal}_${connFarVal}`;

  // Re-render visual port
  renderPortAllocationUI(window.__currentEditingPorts);
}
// === [AKHIR KODE BARU: VISUAL LIGHT THEME & DROPDOWN BERTINGKAT KONEKTOR] ===

// 4. Sinkronisasi Dropdown Rasio Splitter
function updateSplitterRatios(selectElement, selectedVal = '') {
  const row = selectElement ? selectElement.closest('.splitter-row') : document;
  const typeSelect = row ? row.querySelector('.splitter-type') : document.getElementById('e_odp_splitter_type');
  const ratioSelect = row ? row.querySelector('.splitter-ratio') : document.getElementById('e_odp_splitter_ratio');
  
  if (!typeSelect || !ratioSelect) return;

  const currentType = typeSelect.value || 'PLC';
  const list = splitterOptionsData[currentType] || [];
  
  if (!selectedVal && ratioSelect.value) {
    selectedVal = ratioSelect.value;
  }

  ratioSelect.innerHTML = '';
  list.forEach(item => {
    const opt = document.createElement('option');
    opt.value = item.val;
    opt.textContent = item.label;
    if (item.val === selectedVal) opt.selected = true;
    ratioSelect.appendChild(opt);
  });

  if (!ratioSelect.value && ratioSelect.options.length > 0) {
    ratioSelect.selectedIndex = 0;
  }

  recalculateEstimatedPower();
  
  setTimeout(() => {
    renderPortAllocationUI(window.__currentEditingPorts || []);
  }, 50);
}

// === [KODE FINAL PRESISI: HITUNG DAYA MASUK DARI ODP INDUK KE ODP ANAK] ===
function getOdpIncomingPower(childOdpId, parentOdpId, childLat, childLng) {
  if (!parentOdpId) {
    return { powerDbm: 9.0, distanceMeters: 0, cableLossDb: 0, portSource: 'Server Pusat (+9 dBm)' };
  }

  const parent = globalOdps.find(o => Number(o.id) === Number(parentOdpId));
  if (!parent) {
    return { powerDbm: 9.0, distanceMeters: 0, cableLossDb: 0, portSource: 'ODP Pusat' };
  }

  const parentBasePower = parseFloat(parent.input_power_dbm !== undefined && parent.input_power_dbm !== null ? parent.input_power_dbm : 9.0);
  let parentPortPower = null;
  let portLabel = 'Port Trunk';

  // 1. Cari port di ODP induk yang dialokasikan ke ODP anak ini
  const parentPorts = parent.ports || [];
  const linkedPort = parentPorts.find(p => p.target_type === 'CHILD_ODP' && Number(p.target_id) === Number(childOdpId));

  if (linkedPort) {
    const sIdx = Number(linkedPort.splitter_index || 1) - 1;
    const pNum = Number(linkedPort.port_number || 1);
    portLabel = `Splitter #${sIdx + 1} [P-${pNum}]`;

    // GUNAKAN ENGINE YANG SAMA DENGAN KOTAK BIRU MODAL:
    if (typeof calculateUniversalPortPower === 'function') {
      parentPortPower = calculateUniversalPortPower(parent, sIdx, pNum);
    }
  }

  // Fallback jika port induk belum ter-link atau calculateUniversalPortPower tidak mengembalikan angka
  if (parentPortPower === null || isNaN(parentPortPower)) {
    // Ambil default dari Port 2 (Trunk 95%/80%) Splitter 1
    const pSplitters = parent.splitters || [];
    const firstSp = pSplitters[0] || { splitter_type: 'FBT', splitter_ratio: '5:95' };
    let loss = 0.4;
    if (firstSp.splitter_type === 'FBT') {
      const losses = (splitterLossMap.FBT && splitterLossMap.FBT[firstSp.splitter_ratio]) ? splitterLossMap.FBT[firstSp.splitter_ratio] : [14.0, 0.4];
      loss = losses[1]; // Prioritaskan port 2 (Trunk)
    } else {
      loss = (splitterLossMap.PLC && splitterLossMap.PLC[firstSp.splitter_ratio]) || 7.4;
    }
    parentPortPower = parseFloat((parentBasePower - loss - 0.20).toFixed(2));
  }

  // 2. Hitung jarak kabel optik riil
  let distanceMeters = 0;
  const childOdpObj = globalOdps.find(o => Number(o.id) === Number(childOdpId));
  let spliceCount = 0;

  if (childOdpObj && childOdpObj.cable_path) {
    try {
      const parsedPath = JSON.parse(childOdpObj.cable_path);
      const pts = (parsedPath && typeof parsedPath === 'object' && !Array.isArray(parsedPath) && Array.isArray(parsedPath.points)) 
        ? parsedPath.points 
        : (Array.isArray(parsedPath) ? parsedPath : []);

      if (pts.length >= 2) {
        distanceMeters = calculatePolylineLengthMeters(pts.map(p => [(typeof p.lat === 'number' ? p.lat : p[0]), (typeof p.lng === 'number' ? p.lng : p[1])]));
        spliceCount = pts.filter((p, idx) => idx > 0 && idx < pts.length - 1 && p.isSplice).length;
      }
    } catch(e) {}
  }
  
  // Fallback jarak lurus koordinat jika belum digambar
  if (distanceMeters === 0 && parent.lat && parent.lng && childLat && childLng) {
    const p1 = L.latLng(parseFloat(parent.lat), parseFloat(parent.lng));
    const p2 = L.latLng(parseFloat(childLat), parseFloat(childLng));
    distanceMeters = Math.round(p1.distanceTo(p2));
  }

  // 3. Susut Kabel Drop/Trunk ke ODP Anak
  // Serat kabel 0.35 dB/km + Splice 0.20 dB/titik
  const fiberLossDb = parseFloat(((distanceMeters / 1000) * 0.40).toFixed(2));
  const spliceLossDb = parseFloat((spliceCount * 0.20).toFixed(2));

  // Konektor Penerima di ODP Anak (Pigtail -0.2 dB atau Fastcon -0.5 dB)
  // Catatan: Konektor pangkal sudah otomatis terhitung di parentPortPower
  let farLoss = 0.20; 
  if (linkedPort && (linkedPort.connector_far === 'FASTCON' || String(linkedPort.connector_type).includes('FASTCON'))) {
    farLoss = 0.50;
  }

  const totalCableLossDb = parseFloat((fiberLossDb + spliceLossDb + farLoss).toFixed(2));
  
  // Sisa daya bersih yang tiba di box ODP Anak
  const finalArrivedPower = parseFloat((parentPortPower - totalCableLossDb).toFixed(2));

  return {
    powerDbm: finalArrivedPower,
    parentPortPower: parentPortPower,
    distanceMeters,
    fiberLossDb,
    spliceCount,
    spliceLossDb,
    farLoss,
    cableLossDb: totalCableLossDb,
    portSource: `${parent.name} [${portLabel}]`
  };
}
