  function normalizePhone(phone) {
    const raw = String(phone || '').trim();
    const digits = raw.replace(/\D/g, '');
    if (!digits) return '';
    if (digits.startsWith('62')) return digits;
    if (digits.startsWith('0')) return `62${digits.slice(1)}`;
    if (digits.length >= 9) return `62${digits}`;
    return digits;
  }

  function buildWaLink(phone, name) {
    const to = normalizePhone(phone);
    const msg = `Halo ${String(name || '').trim()}`;
    if (!to) return 'javascript:void(0)';
    return `https://wa.me/${to}?text=${encodeURIComponent(msg)}`;
  }
  
// --- BACKGROUND TRAFFIC POLLER FOR ALL MAP CUSTOMERS ---
function initBackgroundTrafficSync() {
  setInterval(async () => {
    // Ambil semua ID pelanggan yang memiliki koordinat GPS dan status aktif di peta
    const activeCustomerIds = Object.keys(customerMap);
    if (activeCustomerIds.length === 0) return;

    // Lakukan fetch secara bergiliran atau batch agar tidak membebani server/router
    for (const custId of activeCustomerIds) {
      // Jika pop-up pelanggan ini sedang terbuka, biarkan interval pop-up yang handle (lewati agar tidak bentrok)
      if (customerTrafficIntervals[custId]) continue; 

      try {
        // Hitung background diam-diam ke server agar database ter-update terus menerus
        await fetch(`/admin/api/customers/${custId}/pppoe-traffic`, { cache: 'no-store' });
      } catch (e) {
        // Abaikan error jaringan sesaat
      }
      // Beri jeda kecil antar request agar router MikroTik tidak kewalahan
      await new Promise(r => setTimeout(r, 1000));
    }
  }, 30000); // Berjalan otomatis setiap 30 detik di background
}

// Jalankan setelah peta selesai dimuat
setTimeout(() => {
  initBackgroundTrafficSync();
}, 5000);
