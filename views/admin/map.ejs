async function fetchCustomerOltMini(customerId) {
  const rxEl = document.getElementById(`cust_${customerId}_olt_rx`);
  const txEl = document.getElementById(`cust_${customerId}_olt_tx`);
  const pillEl = document.getElementById(`cust_${customerId}_olt_pill`);

  if (!rxEl || !txEl) return;

  try {
    const res = await fetch(`/admin/api/customers/${customerId}/olt-optical`, { cache: 'no-store' });
    const json = await res.json();

    if (!json.ok || !json.data || !json.data.available) {
      rxEl.innerHTML = `<span style="color:#94a3b8;">OLT: N/A</span>`;
      txEl.innerHTML = `<span style="color:#94a3b8;">-</span>`;
      if (pillEl) pillEl.style.background = '#f8fafc';
      return;
    }

    const d = json.data;
    const rxStr = String(d.rxPower || '').replace(' dBm', '').trim();
    const txStr = String(d.txPower || '').replace(' dBm', '').trim();
    const rxNum = parseFloat(rxStr);

    rxEl.textContent = `Rx: ${rxStr} dBm`;
    txEl.textContent = `Tx: ${txStr} dBm`;

    if (!isNaN(rxNum) && pillEl) {
      if (rxNum >= -21.0) {
        pillEl.style.borderColor = '#86efac';
        pillEl.style.background = '#f0fdf4';
        rxEl.style.color = '#15803d';
      } else if (rxNum >= -25.0) {
        pillEl.style.borderColor = '#fde047';
        pillEl.style.background = '#fefce8';
        rxEl.style.color = '#b45309';
      } else {
        pillEl.style.borderColor = '#fca5a5';
        pillEl.style.background = '#fef2f2';
        rxEl.style.color = '#b91c1c';
      }
    }
  } catch (err) {
    if (rxEl) rxEl.innerHTML = `<span style="color:#ef4444;">Err</span>`;
    if (txEl) txEl.textContent = '-';
  }
}
