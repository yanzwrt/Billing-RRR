          <!-- 5. Tombol Aksi Rapi Berjajar -->
          <div class="cp-actions-grid">
            <button type="button" onclick="startCableDrawing(${cust.id}, ${lat}, ${lng}, ${cust.odp_id})" class="cp-btn cp-btn-jalur" title="Gambar Jalur Kabel">
              <i class="bi bi-pencil-fill"></i> Jalur
            </button>
            <a href="/admin/customers?search=${encodeURIComponent(cust.name || '')}" class="cp-btn cp-btn-detail" title="Lihat Detail Pelanggan">
              <i class="bi bi-eye"></i> Detail
