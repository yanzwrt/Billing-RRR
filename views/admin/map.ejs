      // === [AKHIR KODE POPUP PELANGGAN KOMPAK] ===

      /* === AWAL PERUBAHAN: TRIGGER TRAFIK, OPTIK OLT & GENIEACS DEVICES SAAT POPUP DIBUKA === */
      marker.on('popupopen', () => {
