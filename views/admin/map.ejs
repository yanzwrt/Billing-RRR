    const clickedPortEl = document.getElementById(`mini_port_${odpId}_${sNum}_${pNum}`);
    if (clickedPortEl) clickedPortEl.classList.add('active-view');

    // Tentukan label kategori
    let typeBadge = '<span style="color:#64748b; font-weight:700;">Kosong</span>';
    let targetLinkBtn = '';

    if (targetType === 'CUSTOMER') {
      typeBadge = '<span style="color:#16a34a; font-weight:800;"><i class="bi bi-person-fill"></i> Pelanggan</span>';
      if (targetId) {
        targetLinkBtn = `<button type="button" class="btn btn-sm btn-outline-primary" style="font-size:10px; padding:2px 7px; margin-top:5px;" onclick="focusCustomer(${targetId})"><i class="bi bi-geo-alt-fill me-1"></i>Fokus ke Pelanggan</button>`;
      }
    } else if (targetType === 'CHILD_ODP') {
      typeBadge = '<span style="color:#0284c7; font-weight:800;"><i class="bi bi-box-seam-fill"></i> ODP Trunk</span>';
      if (targetId) {
        targetLinkBtn = `<button type="button" class="btn btn-sm btn-outline-info" style="font-size:10px; padding:2px 7px; margin-top:5px;" onclick="focusOdp(${targetId})"><i class="bi bi-geo-alt-fill me-1"></i>Fokus ke ODP Anak</button>`;
      }
    } else if (targetType === 'INTERNAL_SPLITTER') {
      typeBadge = '<span style="color:#ca8a04; font-weight:800;"><i class="bi bi-diagram-3-fill"></i> Jumper Splitter</span>';
    }

    const nearLabel = connNear === 'FASTCON' ? 'Fastcon (-1.00 dB)' : 'Pigtail (-0.30 dB)';
    const farLabel = connFar === 'FASTCON' ? 'Fastcon (-1.00 dB)' : 'Pigtail (-0.30 dB)';

    detailBox.innerHTML = `
      <div class="odp-port-detail-card">
        <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px dashed #cbd5e1; padding-bottom:4px; margin-bottom:5px;">
          <strong style="color:#0f172a; font-size:11.5px;">
            <i class="bi bi-info-circle-fill text-primary me-1"></i>Detail: Splitter #${sNum} [Port ${pNum}]
          </strong>
          <span style="font-size:10px; cursor:pointer; color:#ef4444; font-weight:800;" onclick="document.getElementById('odp_port_detail_view_${odpId}').style.display='none'; document.querySelectorAll('[id^=mini_port_${odpId}_]').forEach(el => el.classList.remove('active-view'));">&times; Tutup</span>
        </div>
        <div class="opd-row">
          <span>Kategori:</span>
          <div class="opd-val">${typeBadge}</div>
        </div>
        <div class="opd-row">
          <span>Tujuan:</span>
          <div class="opd-val" style="color:#2563eb; max-width:180px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">${targetName}</div>
        </div>
        <div class="opd-row">
          <span>Daya Keluar Port:</span>
          <div class="opd-val" style="font-family:monospace; color:${portOutDbm !== '-' ? '#0f172a' : '#64748b'};">${portOutDbm !== '-' ? (Number(portOutDbm) > 0 ? '+' : '') + portOutDbm + ' dBm' : '-'}</div>
        </div>
        <div class="opd-row">
          <span>Konektor Pangkal (ODP):</span>
          <div class="opd-val">${nearLabel}</div>
        </div>
        ${targetType === 'CUSTOMER' || targetType === 'CHILD_ODP' ? `
        <div class="opd-row">
          <span>Konektor Ujung (Tujuan):</span>
          <div class="opd-val">${farLabel}</div>
        </div>
        ` : ''}
        ${targetLinkBtn ? `<div style="text-align:right;">${targetLinkBtn}</div>` : ''}
      </div>
    `;

    detailBox.style.display = 'block';
  }

</script>
