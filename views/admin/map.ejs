          <!-- 3. Rincian Optik Drop Core Lengkap (Kedua Ujung Konektor Dihitung) -->
          ${(() => {
            if (!connectedOdpId || !odpMap[connectedOdpId]) {
              return `
                <div style="margin-bottom:8px; padding:6px 10px; background:#fef2f2; border:1px solid #fecaca; border-radius:7px; font-size:11px; color:#b91c1c; font-weight:700;">
                  <i class="bi bi-exclamation-circle-fill me-1"></i> Belum terhubung ke port ODP
                </div>
              `;
            }

            const parentOdpObj = odpMap[connectedOdpId].data;

            // Hitung panjang kabel riil & titik splice via fungsi universal
            const routeOptics = getRouteOpticalLoss(cust.cable_path);
            let custDistanceM = routeOptics.distanceMeters;
            let custSpliceCount = routeOptics.spliceCount;
            let fiberLoss = routeOptics.fiberLoss;
            let midSpliceLoss = routeOptics.spliceLoss;

            if (custDistanceM === 0 && parentOdpObj.lat && parentOdpObj.lng) {
              const p1 = L.latLng(parseFloat(parentOdpObj.lat), parseFloat(parentOdpObj.lng));
              const p2 = L.latLng(lat, lng);
              custDistanceM = Math.round(p1.distanceTo(p2));
              fiberLoss = parseFloat(((custDistanceM / 1000) * 0.40).toFixed(2));
            }

            // === [KODE FINAL: AMBIL DAYA PORT SESUAI RASIO SPLITTER & PORT YANG DIHUBUNGKAN] ===
            const odpPorts = parentOdpObj.ports || [];
            const linkedPort = odpPorts.find(p => p.target_type === 'CUSTOMER' && Number(p.target_id) === Number(cust.id));

            let rawPortPowerBeforeDrop = -7.46;
            let portSourceLabel = linkedPort ? `Port ${linkedPort.port_number}` : 'Port ODP';

            if (linkedPort) {
              const sIdx = Number(linkedPort.splitter_index || 1) - 1;
              const pNum = Number(linkedPort.port_number || 1);
              portSourceLabel = `Splitter #${sIdx + 1} [P-${pNum}]`;

              // Panggil fungsi universal yang menghitung presisi per rasio (1:2, 1:4, 1:8, 1:16, 1:32 / FBT)
              rawPortPowerBeforeDrop = calculateUniversalPortPower(parentOdpObj, sIdx, pNum);
            } else {
              // Jika belum dipetakan ke port spesifik ODP
              const baseDbm = parseFloat(parentOdpObj.input_power_dbm !== undefined ? parentOdpObj.input_power_dbm : 7.54);
              rawPortPowerBeforeDrop = parseFloat((baseDbm - 10.5 - 0.20).toFixed(2));
            }

            // Ambil data konektor pangkal dan konektor ujung modem
            let dbConnNear = 'PIGTAIL';
            let dbConnFar = 'FASTCON';
            if (linkedPort) {
              if (linkedPort.connector_near) dbConnNear = linkedPort.connector_near;
              else if (linkedPort.connector_type && String(linkedPort.connector_type).includes('_')) {
                dbConnNear = String(linkedPort.connector_type).split('_')[0];
              }

              if (linkedPort.connector_far) dbConnFar = linkedPort.connector_far;
              else if (linkedPort.connector_type && String(linkedPort.connector_type).includes('_')) {
                dbConnFar = String(linkedPort.connector_type).split('_')[1];
              }
            }

            const nearLoss = connectorLossMap[dbConnNear] || (dbConnNear === 'FASTCON' ? 1.00 : 0.30);
            const nearLabel = dbConnNear === 'FASTCON' ? 'Fastcon (-1.0 dB)' : 'Pigtail (-0.3 dB)';

            const farLoss = connectorLossMap[dbConnFar] || (dbConnFar === 'FASTCON' ? 1.00 : 0.30);
            const farLabel = dbConnFar === 'FASTCON' ? 'Fastcon (-1.0 dB)' : 'Pigtail (-0.3 dB)';

            // Total susut kabel drop core = Konektor Ujung ODP + Loss Fiber Optik + Titik Splice + Konektor Modem
            const totalDropLoss = parseFloat((nearLoss + fiberLoss + midSpliceLoss + farLoss).toFixed(2));

            // Sinyal Bersih di Modem = Output Port ODP dikurangi Total Susut Drop Core
            const finalRxDbm = parseFloat((rawPortPowerBeforeDrop - totalDropLoss).toFixed(2));

            let rxBg = '#dcfce7';
            let rxColor = '#15803d';
            if (finalRxDbm < -21.0) { rxBg = '#fef3c7'; rxColor = '#b45309'; }
            if (finalRxDbm < -25.0) { rxBg = '#fee2e2'; rxColor = '#b91c1c'; }

            return `
              <div class="cp-optics-panel">
                <div class="cp-optics-header">
                  <span style="font-size:11px; font-weight:800; color:#0f172a;">
                    <i class="bi bi-broadcast-pin text-primary me-1"></i>Estimasi Sinyal Modem
                  </span>
                  <span style="font-size:11px; font-weight:900; font-family:monospace; background:${rxBg}; color:${rxColor}; padding:1.5px 7px; border-radius:4px;">
                    ${finalRxDbm > 0 ? '+' : ''}${finalRxDbm} dBm
                  </span>
                </div>
                <div class="cp-optics-body">
                  <div class="cp-line-item">
                    <span>Sumber Port:</span>
                    <strong style="color:#0f172a;">${escapeHtml(parentOdpObj.name)} [${portSourceLabel}]</strong>
                  </div>
                  <div class="cp-line-item">
                    <span>Panjang Kabel:</span>
                    <span><strong>${custDistanceM} m</strong> 
					<small style="color:#dc2626; font-family:monospace;">(-${fiberLoss} dB)</small>
					</strong>
                  </div>
				  
                  <!-- === AWAL PERUBAHAN: KONEKTOR 1 BARIS, TOTAL SUSUT NAIK, DAN PERANGKAT TERSAMBUNG === -->
                  <div class="cp-line-item">
                    <span>Konektor (In/Out):</span>
                    <strong>
                      <span style="color:#2563eb;">${dbConnNear === 'FASTCON' ? 'Fastcon' : 'Pigtail'}</span> / 
                      <span style="color:#16a34a;">${dbConnFar === 'FASTCON' ? 'Fastcon' : 'Pigtail'}</span>
                      <small style="color:#dc2626; font-family:monospace;">(-${(nearLoss + farLoss).toFixed(2)} dB)</small>
                    </strong>
                  </div>
                  ${custSpliceCount > 0 ? `
                    <div class="cp-line-item" style="color:#9333ea;">
                      <span>Sambungan Splice:</span>
                      <strong>${custSpliceCount} titik (-${midSpliceLoss} dB)</strong>
                    </div>
                  ` : ''}
                  <div class="cp-line-item">
                    <strong>Total Susut Drop Core:</strong>
                    <span style="color:#dc2626; font-family:monospace;">-${totalDropLoss} dB</strong>
                  </div>
                  <div class="cp-line-total">
                    <span><i class="bi bi-phone text-primary me-1"></i>Perangkat Tersambung:</span>
                    <span id="cust_${cust.id}_connected_devices" style="color:#0f172a; font-weight:800; font-family:monospace;">
                      <span style="color:#94a3b8; font-size:10px;">Memuat...</span>
                    </span>
                  </div>
                  <!-- === AKHIR PERUBAHAN === -->
                </div>
              </div>
            `;
          })()}

          <!-- 4. Monitoring Trafik Ringkas -->
          <div class="cp-usage-box">
            <div class="cp-usage-summary">
              <div class="cp-usage-pill">
                <div class="cp-usage-lbl"><i class="bi bi-arrow-down text-primary"></i> Download Hari Ini</div>
