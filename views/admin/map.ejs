  // ─── SEARCH & AUTOCOMPLETE LOGIC ──────────────────────────────────────────
  const searchInput = document.getElementById('mapGlobalSearch');
  const searchDropdown = document.getElementById('mapSearchDropdown');
  const resultsList = document.getElementById('msResultsList');
  const resultsCount = document.getElementById('msHeaderCount');
  const clearBtn = document.getElementById('mapSearchClearBtn');
  let selectedSearchIndex = -1;
  let currentSearchResults = [];

  function highlightMatch(text, query) {
    if (!text) return '';
    if (!query) return escapeHtml(text);
    const escaped = escapeHtml(text);
    const qEsc = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const regex = new RegExp(`(${qEsc})`, 'gi');
    return escaped.replace(regex, '<mark>$1</mark>');
  }

  function doMapSearch(query) {
    const q = (query || '').trim().toLowerCase();
    if (!q) {
      searchDropdown.classList.remove('active');
      clearBtn.style.display = 'none';
      currentSearchResults = [];
      selectedSearchIndex = -1;
      return;
    }

    clearBtn.style.display = 'block';

    const matchedCustomers = customers.filter(c => {
      return (
        String(c.name || '').toLowerCase().includes(q) ||
        String(c.pppoe_username || '').toLowerCase().includes(q) ||
        String(c.phone || '').toLowerCase().includes(q) ||
        String(c.genieacs_tag || '').toLowerCase().includes(q) ||
        String(c.address || '').toLowerCase().includes(q) ||
        String(c.area || '').toLowerCase().includes(q) ||
        String(c.package_name || '').toLowerCase().includes(q) ||
        String(c.odp_name || '').toLowerCase().includes(q)
      );
    });

    const matchedOdps = odps.filter(o => {
      return (
        String(o.name || '').toLowerCase().includes(q) ||
        String(o.description || '').toLowerCase().includes(q)
      );
    });

    currentSearchResults = [
      ...matchedCustomers.map(c => ({ type: 'customer', data: c })),
      ...matchedOdps.map(o => ({ type: 'odp', data: o }))
    ];

    selectedSearchIndex = -1;
    resultsCount.textContent = `${currentSearchResults.length} Ditemukan`;

    if (currentSearchResults.length === 0) {
      resultsList.innerHTML = `
        <div class="ms-empty">
          <i class="bi bi-search" style="font-size: 24px; color: #cbd5e1; display: block; margin-bottom: 6px;"></i>
          Tidak ditemukan data untuk "<strong>${escapeHtml(query)}</strong>"
        </div>
      `;
    } else {
      let html = '';
      currentSearchResults.slice(0, 30).forEach((item, index) => {
        if (item.type === 'customer') {
          const c = item.data;
          const isActive = c.status === 'active';
          const hasGps = Boolean(c.lat && c.lng);
          html += `
            <div class="ms-item" data-index="${index}" onclick="selectSearchResult(${index})">
              <div class="ms-item-icon ${isActive ? 'active' : 'suspended'}">
                <i class="bi bi-router-fill"></i>
              </div>
              <div class="ms-item-info">
                <div class="ms-item-name">
                  <span>${highlightMatch(c.name, query)}</span>
                  ${!hasGps ? '<span style="color:#ef4444; font-size:10px; font-weight:700;"><i class="bi bi-exclamation-triangle"></i> Tanpa GPS</span>' : ''}
                </div>
                <div class="ms-item-meta">
                  ${c.pppoe_username ? `<span>PPPoE: ${highlightMatch(c.pppoe_username, query)}</span> • ` : ''}
                  ${c.phone ? `<span>HP: ${highlightMatch(c.phone, query)}</span> • ` : ''}
                  ${c.odp_name ? `<span>ODP: ${highlightMatch(c.odp_name, query)}</span> • ` : ''}
                  <span>${escapeHtml(c.address || c.package_name || '-')}</span>
                </div>
              </div>
              <span class="ms-item-badge ${isActive ? 'ms-badge-active' : 'ms-badge-suspended'}">
                ${isActive ? 'Aktif' : 'Isolir'}
              </span>
            </div>
          `;
        } else {
          const o = item.data;
          html += `
            <div class="ms-item" data-index="${index}" onclick="selectSearchResult(${index})">
              <div class="ms-item-icon odp">
                <i class="bi bi-box-seam-fill"></i>
              </div>
              <div class="ms-item-info">
                <div class="ms-item-name">
                  <span>${highlightMatch(o.name, query)}</span>
                  <span style="font-size: 10px; color: #b45309; font-weight: 700;">(ODP Box)</span>
                </div>
                <div class="ms-item-meta">${highlightMatch(o.description || 'Titik Distribusi ODP', query)}</div>
              </div>
              <span class="ms-item-badge ms-badge-odp">ODP</span>
            </div>
          `;
        }
      });
      resultsList.innerHTML = html;
    }

    searchDropdown.classList.add('active');
  }

  function clearMapSearch() {
    searchInput.value = '';
    doMapSearch('');
    searchInput.focus();
  }

  function selectSearchResult(index) {
    if (!currentSearchResults[index]) return;
    const item = currentSearchResults[index];
    searchDropdown.classList.remove('active');

    if (item.type === 'customer') {
      focusCustomer(item.data.id);
    } else {
      focusOdp(item.data.id);
    }
  }

  // Keyboard navigation for search results
  searchInput.addEventListener('input', (e) => doMapSearch(e.target.value));
  searchInput.addEventListener('keydown', (e) => {
    if (!searchDropdown.classList.contains('active')) return;
    const items = resultsList.querySelectorAll('.ms-item');
    if (items.length === 0) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      selectedSearchIndex = (selectedSearchIndex + 1) % items.length;
      updateSearchSelection(items);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      selectedSearchIndex = (selectedSearchIndex - 1 + items.length) % items.length;
      updateSearchSelection(items);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (selectedSearchIndex >= 0 && selectedSearchIndex < items.length) {
        selectSearchResult(selectedSearchIndex);
      } else if (items.length > 0) {
        selectSearchResult(0);
      }
    } else if (e.key === 'Escape') {
      searchDropdown.classList.remove('active');
    }
  });

  function updateSearchSelection(items) {
    items.forEach((it, idx) => {
      if (idx === selectedSearchIndex) {
        it.classList.add('selected');
        it.scrollIntoView({ block: 'nearest' });
      } else {
        it.classList.remove('selected');
      }
    });
  }

  // Global hotkey: Ctrl+K or / to search
  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey && e.key.toLowerCase() === 'k') || (e.key === '/' && document.activeElement !== searchInput && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA')) {
      e.preventDefault();
      searchInput.focus();
      searchInput.select();
    }
  });

  // Close search dropdown when clicking outside
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.map-search-box')) {
      searchDropdown.classList.remove('active');
    }
  });

  // ─── FOCUS ACTIONS ────────────────────────────────────────────────────────
  function focusCustomer(id) {
    const entry = customerMap[id];
    if (!entry) {
      const c = customers.find(x => x.id === id);
      if (c && (!c.lat || !c.lng)) {
        alert(`Pelanggan "${c.name}" belum memiliki koordinat GPS.`);
      }
      return;
    }

    const { marker, data } = entry;
    const lat = parseFloat(data.lat);
    const lng = parseFloat(data.lng);

    map.flyTo([lat, lng], 18, { duration: 1 });

    setTimeout(() => {
      marker.openPopup();
      const node = document.getElementById(`onu-node-${id}`);
      if (node) {
        node.classList.add('marker-pulse-highlight');
        setTimeout(() => node.classList.remove('marker-pulse-highlight'), 2500);
      }
    }, 800);
  }

  function focusOdp(id) {
    const entry = odpMap[id];
    if (!entry) return;

    const { marker, coord } = entry;
    map.flyTo(coord, 18, { duration: 1 });

    setTimeout(() => {
      marker.openPopup();
      const node = document.getElementById(`odp-node-${id}`);
      if (node) {
        node.classList.add('marker-pulse-highlight');
        setTimeout(() => node.classList.remove('marker-pulse-highlight'), 2500);
      }
    }, 800);
  }

  function editOdpFromBtn(btn) {
    if (!btn || !btn.dataset) return;
    const odpId = Number(btn.dataset.odpId);
    const found = odps.find(o => Number(o.id) === odpId);
    if (found) editOdp(found);
  }

  function deleteOdpFromBtn(btn) {
    if (!btn || !btn.dataset) return;
    const odpId = btn.dataset.odpId;
    if (confirm('Apakah Anda yakin ingin menghapus ODP ini?')) {
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = `/admin/odps/${odpId}/delete`;
      document.body.appendChild(form);
      form.submit();
    }
  }

  function focusOdpFromBtn(btn) {
    if (!btn || !btn.dataset) return;
    focusOdp(btn.dataset.odpId);
  }

  // ─── FILTER & TOGGLE ACTIONS ──────────────────────────────────────────────
  function applyStatusFilter(status) {
    currentFilter = status;
    document.querySelectorAll('.map-filter-group .map-pill-btn').forEach(b => {
      if (b.id === 'pillAll' && status === 'all') b.classList.add('active');
      else if (b.id === 'pillActive' && status === 'active') b.classList.add('active');
      else if (b.id === 'pillSuspended' && status === 'suspended') b.classList.add('active');
      else if (b.id.startsWith('pill') && b.id !== 'pillLabels') b.classList.remove('active');
    });

    Object.keys(customerMap).forEach(id => {
      const { marker, data, polyline } = customerMap[id];
      const isActive = data.status === 'active';
      let shouldShow = true;

      if (status === 'active' && !isActive) shouldShow = false;
      if (status === 'suspended' && isActive) shouldShow = false;

      if (shouldShow) {
        if (!map.hasLayer(marker)) map.addLayer(marker);
        if (polyline && !map.hasLayer(polyline)) map.addLayer(polyline);
      } else {
        if (map.hasLayer(marker)) map.removeLayer(marker);
        if (polyline && map.hasLayer(polyline)) map.removeLayer(polyline);
      }
    });
  }

  function toggleMarkerLabels() {
    showLabels = !showLabels;
    const btn = document.getElementById('pillLabels');
    const txt = document.getElementById('labelToggleText');
    const mapEl = document.getElementById('map');

    if (showLabels) {
      mapEl.classList.remove('hide-marker-labels');
      btn.classList.add('active');
      txt.textContent = 'Label: ON';
    } else {
      mapEl.classList.add('hide-marker-labels');
      btn.classList.remove('active');
      txt.textContent = 'Label: OFF';
    }
  }

  function fitAllMarkers() {
    const allLayers = [];
    Object.values(customerMap).forEach(e => {
      if (map.hasLayer(e.marker)) allLayers.push(e.marker);
    });
    Object.values(odpMap).forEach(e => {
      if (map.hasLayer(e.marker)) allLayers.push(e.marker);
    });

    if (allLayers.length > 0) {
      const group = L.featureGroup(allLayers);
      map.fitBounds(group.getBounds().pad(0.1));
    } else {
      map.setView([officeCoords.lat, officeCoords.lng], 13);
    }
  }

  // ─── TABBED DATA PANEL LOGIC ──────────────────────────────────────────────
  function switchDataTab(tabId, btn) {
    document.querySelectorAll('.data-tabs-panel .tab-content').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.data-tabs-panel .tab-btn').forEach(el => el.classList.remove('active'));
    
    const target = document.getElementById(tabId);
    if (target) target.classList.add('active');
    if (btn) btn.classList.add('active');
  }

  // Filter Customer Table
  const custTableSearch = document.getElementById('customerTableSearch');
  const custGpsFilter = document.getElementById('customerGpsFilter');
  const custTbody = document.getElementById('customersTableBody');

  function filterCustomerTable() {
    if (!custTbody) return;
    const q = (custTableSearch.value || '').trim().toLowerCase();
    const gpsFilter = custGpsFilter ? custGpsFilter.value : 'all';
    const rows = custTbody.querySelectorAll('tr[data-id]');

    rows.forEach(r => {
      const name = r.getAttribute('data-name') || '';
      const pppoe = r.getAttribute('data-pppoe') || '';
      const phone = r.getAttribute('data-phone') || '';
      const tag = r.getAttribute('data-tag') || '';
      const address = r.getAttribute('data-address') || '';
      const status = r.getAttribute('data-status') || '';
      const hasGps = r.getAttribute('data-hasgps') === '1';

      const matchText = !q || name.includes(q) || pppoe.includes(q) || phone.includes(q) || tag.includes(q) || address.includes(q);
      
      let matchGps = true;
      if (gpsFilter === 'has_gps') matchGps = hasGps;
      else if (gpsFilter === 'no_gps') matchGps = !hasGps;
      else if (gpsFilter === 'active') matchGps = (status === 'active');
      else if (gpsFilter === 'suspended') matchGps = (status !== 'active');

      r.style.display = (matchText && matchGps) ? '' : 'none';
    });
  }

  if (custTableSearch) {
    custTableSearch.addEventListener('input', filterCustomerTable);
  }

  // Filter ODP Table
  (function bindOdpSearch() {
    const input = document.getElementById('odpSearch');
    const tbody = document.getElementById('odpsTbody');
    if (!input || !tbody) return;

    function apply() {
      const q = String(input.value || '').trim().toLowerCase();
      const rows = Array.from(tbody.querySelectorAll('tr[data-name]'));
      rows.forEach(r => {
        const name = String(r.getAttribute('data-name') || '');
        const desc = String(r.getAttribute('data-desc') || '');
        r.style.display = !q || name.includes(q) || desc.includes(q) ? '' : 'none';
      });
    }

    input.addEventListener('input', apply);
    apply();
  })();

  // ─── CABLE DRAWING & MODALS ────────────────────────────────────────────────
  let drawingMap, drawingPolyline, drawingMarkers = [];
  
  function interpolatePoints(p1, p2, count) {
    const points = [p1];
    for (let i = 1; i <= count; i++) {
      const lat = p1[0] + (p2[0] - p1[0]) * (i / (count + 1));
      const lng = p1[1] + (p2[1] - p1[1]) * (i / (count + 1));
      points.push([lat, lng]);
    }
    points.push(p2);
    return points;
  }

  // === [MULAI KODE BARU: TITIK LEKUKAN BISA DIJADIKAN SPLICE POINT DENGAN LOSS] ===
  window.__activeCablePointsData = []; // Menyimpan array objek titik: [{lat, lng, isSplice, loss}]

  function getFlatLatLngs() {
    if (window.__activeCablePointsData && window.__activeCablePointsData.length > 0) {
      return window.__activeCablePointsData;
    }
    if (!drawingPolyline) return [];
    let raw = drawingPolyline.getLatLngs();
    while (Array.isArray(raw) && raw.length > 0 && Array.isArray(raw[0])) {
      raw = raw[0];
    }
    return raw.map(pt => ({
      lat: (typeof pt.lat === 'number') ? pt.lat : pt[0],
      lng: (typeof pt.lng === 'number') ? pt.lng : pt[1],
      isSplice: false
    }));
  }

  function renderEditorMarkers() {
    if (!drawingMap || !drawingPolyline) return;

    if (drawingMarkers && drawingMarkers.length > 0) {
      drawingMarkers.forEach(m => {
        try { drawingMap.removeLayer(m); } catch(e) {}
      });
    }
    drawingMarkers = [];

    const pts = getFlatLatLngs();
    if (!pts || pts.length === 0) return;

    // Hitung total splice di jalur kabel saat ini
    const spliceCount = pts.filter((p, idx) => idx > 0 && idx < pts.length - 1 && p.isSplice).length;
    updateSpliceCounterBadge(spliceCount);

    pts.forEach((pt, index) => {
      const isStart = index === 0;
      const isEnd = index === pts.length - 1;
      const isEdge = isStart || isEnd;
      const isSplice = Boolean(pt.isSplice);

      // Icon khusus: Endpoint (Biru), Splice (Ungu Kotak), Tiang/Belokan (Oranye)
      let iconHtml = '';
      if (isEdge) {
        iconHtml = `<div class="pin-endpoint" title="${isStart ? 'Awal Kabel' : 'Ujung Kabel'}"></div>`;
      } else if (isSplice) {
        iconHtml = `<div class="pin-splice" title="Titik Sambungan Splice / Joint Box (-0.2 dB)"><i class="bi bi-tools"></i></div>`;
      } else {
        iconHtml = `<div class="pin-pole" title="Tiang / Belokan Biasa (0 dB)"></div>`;
      }

      const marker = L.marker([pt.lat, pt.lng], {
        draggable: true,
        zIndexOffset: isSplice ? 3500 : (isEdge ? 3000 : 2000),
        icon: L.divIcon({
          html: iconHtml,
          className: 'custom-div-icon',
          iconSize: isSplice ? [15, 15] : (isEdge ? [15, 15] : [13, 13]),
          iconAnchor: isSplice ? [7.5, 7.5] : (isEdge ? [7.5, 7.5] : [6.5, 6.5])
        })
      }).addTo(drawingMap);

      // Tarik koordinat titik
      marker.on('drag', (e) => {
        pt.lat = e.latlng.lat;
        pt.lng = e.latlng.lng;
        drawingPolyline.setLatLngs(pts.map(p => [p.lat, p.lng]));
      });

      // KLIK KIRI PADA TITIK: Buka Popup Opsi untuk ubah menjadi Splice Point
      if (!isEdge) {
        const popupContent = document.createElement('div');
        popupContent.style.cssText = 'font-size: 12px; width: 175px; text-align: left;';
        popupContent.innerHTML = `
          <div style="font-weight: 800; font-size: 11.5px; margin-bottom: 6px; color: #0f172a; border-bottom: 1px solid #e2e8f0; padding-bottom: 3px;">
            <i class="bi bi-gear-fill text-primary"></i> Pengaturan Titik #${index}
          </div>
          <div style="margin-bottom: 8px;">
            <label style="display: flex; align-items: center; gap: 6px; cursor: pointer; margin-bottom: 4px;">
              <input type="radio" name="pt_type_${index}" value="pole" ${!isSplice ? 'checked' : ''}>
              <span>Tiang / Belok (0 dB)</span>
            </label>
            <label style="display: flex; align-items: center; gap: 6px; cursor: pointer; color: #9333ea; font-weight: 700;">
              <input type="radio" name="pt_type_${index}" value="splice" ${isSplice ? 'checked' : ''}>
              <span>Sambungan/Splice (-0.2 dB)</span>
            </label>
          </div>
          <div style="display: flex; justify-content: space-between; gap: 4px; border-top: 1px solid #e2e8f0; padding-top: 6px;">
            <button type="button" class="btn btn-sm btn-danger" style="font-size: 10.5px; padding: 2px 6px;" id="btn_del_pt_${index}">
              <i class="bi bi-trash"></i> Hapus
            </button>
            <button type="button" class="btn btn-sm btn-p" style="font-size: 10.5px; padding: 2px 8px;" id="btn_save_pt_${index}">
              Terapkan
            </button>
          </div>
        `;

        popupContent.querySelector(`#btn_save_pt_${index}`).onclick = () => {
          const selected = popupContent.querySelector(`input[name="pt_type_${index}"]:checked`).value;
          pt.isSplice = (selected === 'splice');
          pt.loss = pt.isSplice ? 0.20 : 0.0;
          marker.closePopup();
          renderEditorMarkers();
        };

        popupContent.querySelector(`#btn_del_pt_${index}`).onclick = () => {
          marker.closePopup();
          pts.splice(index, 1);
          window.__activeCablePointsData = pts;
          drawingPolyline.setLatLngs(pts.map(p => [p.lat, p.lng]));
          renderEditorMarkers();
        };

        marker.bindPopup(popupContent);
      }

      drawingMarkers.push(marker);
    });

    // Klik langsung pada garis untuk menyisipkan titik baru
    drawingPolyline.off('click');
    drawingPolyline.on('click', (e) => {
      insertPointAtClick(e.latlng);
    });
  }

  // Tampilkan info jumlah sambungan di bagian bawah modal gambar jalur
  function updateSpliceCounterBadge(spliceCount) {
    let badge = document.getElementById('cable_splice_counter_badge');
    if (!badge) {
      const modalBody = document.querySelector('#cablePathModal .mbody');
      if (modalBody) {
        badge = document.createElement('div');
        badge.id = 'cable_splice_counter_badge';
        badge.style.cssText = 'margin-top: 8px; padding: 6px 10px; background: #faf5ff; border: 1.5px solid #d8b4fe; border-radius: 6px; font-size: 11.5px; color: #6b21a8; font-weight: 700; display: flex; justify-content: space-between; align-items: center;';
        modalBody.appendChild(badge);
      }
    }
    if (badge) {
      const extraLoss = (spliceCount * 0.20).toFixed(2);
      badge.innerHTML = `
        <span><i class="bi bi-tools me-1"></i> Titik Sambungan (Splice): <strong>${spliceCount} titik</strong></span>
        <span>Loss Tambahan: <strong>-${extraLoss} dB</strong></span>
      `;
    }
  }

  function insertPointAtClick(clickLatLng) {
    const pts = getFlatLatLngs();
    if (pts.length < 2) return;

    let bestSegmentIndex = 0;
    let minDistance = Infinity;

    for (let i = 0; i < pts.length - 1; i++) {
      const p1 = L.latLng(pts[i].lat, pts[i].lng);
      const p2 = L.latLng(pts[i+1].lat, pts[i+1].lng);
      const mid = L.latLng((p1.lat + p2.lat) / 2, (p1.lng + p2.lng) / 2);
      const d = clickLatLng.distanceTo(mid);
      if (d < minDistance) {
        minDistance = d;
        bestSegmentIndex = i;
      }
    }

    pts.splice(bestSegmentIndex + 1, 0, { lat: clickLatLng.lat, lng: clickLatLng.lng, isSplice: false });
    window.__activeCablePointsData = pts;
    drawingPolyline.setLatLngs(pts.map(p => [p.lat, p.lng]));
    renderEditorMarkers();
  }

  function addMorePoints() {
    if (!drawingPolyline || !drawingMap) return;
    const pts = getFlatLatLngs();
    if (!pts || pts.length < 2) return;

    const newPath = [];
    for (let i = 0; i < pts.length - 1; i++) {
      newPath.push(pts[i]);
      const midLat = (pts[i].lat + pts[i+1].lat) / 2;
      const midLng = (pts[i].lng + pts[i+1].lng) / 2;
      newPath.push({ lat: midLat, lng: midLng, isSplice: false });
    }
    newPath.push(pts[pts.length - 1]);

    window.__activeCablePointsData = newPath;
    drawingPolyline.setLatLngs(newPath.map(p => [p.lat, p.lng]));
    renderEditorMarkers();
  }
  // === [AKHIR KODE BARU: TITIK LEKUKAN BISA DIJADIKAN SPLICE POINT] ===

  // Variabel penanda apakah sedang menggambar jalur pelanggan atau jalur ODP
  let currentEditingType = 'customer'; // 'customer' atau 'odp'
  let currentEditingOdpTargetId = null;

// === [FUNGSI BARU: RENDER SEMUA JALUR KABEL & ODP SEKITAR SEBAGAI PANDUAN JALUR] ===
  function renderBackgroundCableReferences(editorMap, excludeType, excludeId) {
    if (!editorMap) return;

    // 1. Tampilkan semua ODP yang ada di sekitar sebagai patokan tiang/box
    odps.forEach(o => {
      if (o.lat && o.lng) {
        const oLat = parseFloat(o.lat);
        const oLng = parseFloat(o.lng);

        const miniOdpIcon = L.divIcon({
          className: 'custom-div-icon',
          html: `
            <div style="background:#f59e0b; border:1.5px solid #fff; border-radius:4px; width:16px; height:16px; display:flex; align-items:center; justify-content:center; color:#fff; font-size:9px; box-shadow:0 0 4px rgba(0,0,0,0.5);">
              <i class="bi bi-box-seam-fill"></i>
            </div>
          `,
          iconSize: [16, 16],
          iconAnchor: [8, 8]
        });

        L.marker([oLat, oLng], { icon: miniOdpIcon, interactive: true })
          .addTo(editorMap)
          .bindTooltip(`ODP: ${escapeHtml(o.name)}`, { permanent: false, direction: 'top' });
      }
    });

    // 2. Render seluruh Jalur Trunk Antar-ODP yang sudah ada
    odps.forEach(o => {
      // Lewati jika ini adalah jalur ODP yang sedang diedit saat ini
      if (excludeType === 'odp' && Number(o.id) === Number(excludeId)) return;

      if (o.cable_path) {
        try {
          const parsed = JSON.parse(o.cable_path);
          let pts = (parsed && typeof parsed === 'object' && !Array.isArray(parsed) && Array.isArray(parsed.points))
            ? parsed.points 
            : (Array.isArray(parsed) ? parsed : []);

          if (pts.length >= 2) {
            const coords = pts.map(p => [
              (typeof p.lat === 'number' ? p.lat : p[0]),
              (typeof p.lng === 'number' ? p.lng : p[1])
            ]);

            const lineColor = (parsed && parsed.color) ? parsed.color : '#f59e0b';

            // Garis referensi transparan dengan outline gelap tipis agar jelas di atas satelit
            L.polyline(coords, {
              color: '#000000',
              weight: 5,
              opacity: 0.35,
              interactive: false
            }).addTo(editorMap);

            L.polyline(coords, {
              color: lineColor,
              weight: 3,
              opacity: 0.65,
              dashArray: '4, 4',
              interactive: false
            }).addTo(editorMap);

            // Render titik splice jalur lain dengan icon kecil
            pts.forEach((p, pIdx) => {
              if (pIdx > 0 && pIdx < pts.length - 1 && p.isSplice) {
                const sLat = (typeof p.lat === 'number' ? p.lat : p[0]);
                const sLng = (typeof p.lng === 'number' ? p.lng : p[1]);

                L.circleMarker([sLat, sLng], {
                  radius: 4,
                  fillColor: '#9333ea',
                  color: '#ffffff',
                  weight: 1.5,
                  fillOpacity: 0.8,
                  interactive: false
                }).addTo(editorMap);
              }
            });
          }
        } catch(e) {}
      }
    });

    // 3. Render seluruh Jalur Kabel Pelanggan lain yang sudah ada
    customers.forEach(c => {
      // Lewati pelanggan yang sedang aktif diedit jalurnya
      if (excludeType === 'customer' && Number(c.id) === Number(excludeId)) return;

      if (c.cable_path) {
        try {
          const parsed = JSON.parse(c.cable_path);
          let pts = (parsed && typeof parsed === 'object' && !Array.isArray(parsed) && Array.isArray(parsed.points))
            ? parsed.points 
            : (Array.isArray(parsed) ? parsed : []);

          if (pts.length >= 2) {
            const coords = pts.map(p => [
              (typeof p.lat === 'number' ? p.lat : p[0]),
              (typeof p.lng === 'number' ? p.lng : p[1])
            ]);

            L.polyline(coords, {
              color: '#38bdf8', // Biru muda redup untuk jalur pelanggan lain
              weight: 2.5,
              opacity: 0.5,
              dashArray: '3, 4',
              interactive: false
            }).addTo(editorMap);
          }
        } catch(e) {}
      }
    });
  }

  // === [PERBAIKAN: START CABLE DRAWING PELANGGAN DENGAN PARSING SEMUA FORMAT DATA] ===
  function startCableDrawing(customerId, lat, lng, odpId) {
    const odp = odpMap[odpId];
    if (!odp) return alert('Data ODP tidak ditemukan atau belum dipilih');

    currentEditingType = 'customer';
    currentEditingCustomer = customerId;
    currentEditingOdpTargetId = null;
    openModal('cablePathModal');

    setTimeout(() => {
      try {
        if (drawingMap) drawingMap.remove();
        
        drawingMap = L.map('cable-drawing-map').setView([lat, lng], 17);
        L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
          maxZoom: 22, subdomains: ['mt0', 'mt1', 'mt2', 'mt3']
        }).addTo(drawingMap);
		
		renderBackgroundCableReferences(drawingMap, 'customer', customerId);
		
        const customer = customers.find(c => Number(c.id) === Number(customerId));
        let pathCoords = [];
        
        if (customer && customer.cable_path) {
          try {
            const parsed = JSON.parse(customer.cable_path);
            if (parsed && typeof parsed === 'object' && !Array.isArray(parsed) && Array.isArray(parsed.points)) {
              pathCoords = parsed.points;
            } else if (Array.isArray(parsed)) {
              pathCoords = parsed;
            }
          } catch(e) {}
        }
        
        // Jika belum ada jalur atau titik kurang dari 2, buat 5 titik interpolasi awal
        if (!pathCoords || !Array.isArray(pathCoords) || pathCoords.length < 2) {
          pathCoords = interpolatePoints([parseFloat(lat), parseFloat(lng)], odp.coord, 5);
        }

        // Normalisasi koordinat ke array objek standar [{lat, lng, isSplice, loss}]
        window.__activeCablePointsData = pathCoords.map(pt => ({
          lat: (typeof pt.lat === 'number') ? pt.lat : (Array.isArray(pt) ? parseFloat(pt[0]) : parseFloat(pt)),
          lng: (typeof pt.lng === 'number') ? pt.lng : (Array.isArray(pt) ? parseFloat(pt[1]) : parseFloat(pt)),
          isSplice: Boolean(pt.isSplice),
          loss: pt.isSplice ? 0.20 : 0.0
        }));

        const is_active = customer ? customer.status === 'active' : true;
        const cableColor = is_active ? '#3b82f6' : '#ef4444';

        drawingPolyline = L.polyline(window.__activeCablePointsData.map(p => [p.lat, p.lng]), {
          color: cableColor, weight: 6, dashArray: '5, 5', interactive: false
        }).addTo(drawingMap);

        renderEditorMarkers();

        setTimeout(() => {
          drawingMap.invalidateSize();
          drawingMap.fitBounds(drawingPolyline.getBounds(), { padding: [50, 50] });
        }, 200);
      } catch (err) {
        console.error("Drawing map error:", err);
      }
    }, 600);
  }

  // === [FUNGSI BARU: GAMBAR JALUR KABEL TRUNK ANTAR ODP] ===
  // Variabel penyimpan warna kabel saat diedit
  window.__currentCableColor = '#f59e0b';

  function changeCableColor(hexColor) {
    if (!hexColor) return;
    window.__currentCableColor = hexColor;

    // Ubah warna polyline di canvas editor secara realtime
    if (drawingPolyline) {
      drawingPolyline.setStyle({ color: hexColor });
    }

    // Update active highlight tombol warna
    document.querySelectorAll('.cable-color-btn').forEach(btn => {
      if (btn.dataset.color.toLowerCase() === hexColor.toLowerCase()) {
        btn.style.borderColor = '#0f172a';
        btn.style.transform = 'scale(1.2)';
      } else {
        btn.style.borderColor = '#ffffff';
        btn.style.transform = 'scale(1)';
      }
    });

    const customPicker = document.getElementById('cableCustomColorPicker');
    if (customPicker) customPicker.value = hexColor;
  }

  function startOdpCableDrawing(childOdpId, lat, lng, parentOdpId) {
    const parentOdp = odpMap[parentOdpId];
    if (!parentOdp) return alert('Data ODP Induk tidak ditemukan');

    currentEditingType = 'odp';
    currentEditingOdpTargetId = childOdpId;
    currentEditingCustomer = null;
    window.__currentCableColor = '#f59e0b'; // default
    openModal('cablePathModal');

    setTimeout(() => {
      try {
        if (drawingMap) drawingMap.remove();
        
        drawingMap = L.map('cable-drawing-map').setView([lat, lng], 17);
        L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
          maxZoom: 22, subdomains: ['mt0', 'mt1', 'mt2', 'mt3']
        }).addTo(drawingMap);
		
		renderBackgroundCableReferences(drawingMap, 'odp', childOdpId);

        const childOdp = odps.find(o => o.id === childOdpId);
        let pathCoords = [];
        let initialColor = '#f59e0b';

        if (childOdp && childOdp.cable_path) {
          try {
            const parsed = JSON.parse(childOdp.cable_path);
            if (parsed && typeof parsed === 'object' && !Array.isArray(parsed) && Array.isArray(parsed.points)) {
              pathCoords = parsed.points;
              initialColor = parsed.color || '#f59e0b';
            } else if (Array.isArray(parsed)) {
              pathCoords = parsed;
            }
          } catch(e) {}
        }
        
        if (!pathCoords || pathCoords.length <= 2) {
          pathCoords = interpolatePoints([parseFloat(lat), parseFloat(lng)], parentOdp.coord, 5);
        }

        window.__activeCablePointsData = pathCoords.map(pt => ({
          lat: (typeof pt.lat === 'number') ? pt.lat : (Array.isArray(pt) ? pt[0] : parseFloat(pt)),
          lng: (typeof pt.lng === 'number') ? pt.lng : (Array.isArray(pt) ? pt[1] : parseFloat(pt)),
          isSplice: Boolean(pt.isSplice),
          loss: pt.isSplice ? 0.20 : 0.0
        }));

        changeCableColor(initialColor);

        drawingPolyline = L.polyline(window.__activeCablePointsData.map(p => [p.lat, p.lng]), {
          color: initialColor, weight: 6, dashArray: '5, 5', interactive: false
        }).addTo(drawingMap);

        renderEditorMarkers();

        setTimeout(() => {
          drawingMap.invalidateSize();
          drawingMap.fitBounds(drawingPolyline.getBounds(), { padding: [50, 50] });
        }, 200);
      } catch (err) {
        console.error("Drawing ODP map error:", err);
      }
    }, 600);
  }

  // === [PERBAIKAN: SIMPAN JALUR KABEL DENGAN PERHITUNGAN AKURAT & MODAL MODERN] ===
  async function saveCablePath() {
    if (!drawingPolyline) return;
    const pts = getFlatLatLngs();
    if (!pts || pts.length < 2) return alert('Titik jalur kabel belum lengkap.');

    const distanceMeters = calculatePolylineLengthMeters(pts.map(p => [p.lat, p.lng]));
    const spliceCount = pts.filter((p, idx) => idx > 0 && idx < pts.length - 1 && p.isSplice).length;

    // 1. Simpan Jalur ODP Trunk jika tipe ODP
    if (currentEditingType === 'odp' && currentEditingOdpTargetId) {
      const payloadData = {
        color: window.__currentCableColor || '#f59e0b',
        points: pts
      };
      const pathJson = JSON.stringify(payloadData);

      try {
        const res = await fetch(`/admin/api/odps/${currentEditingOdpTargetId}/cable-path`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ path: pathJson })
        });
        const data = await res.json();
        if (data.ok) {
          closeModal('cablePathModal');
          const childOdp = odps.find(o => Number(o.id) === Number(currentEditingOdpTargetId));
          const parentOdp = childOdp ? odpMap[childOdp.parent_odp_id]?.data : null;
          
          const fiberLoss = parseFloat(((distanceMeters / 1000) * 0.40).toFixed(2));
          const spliceLoss = parseFloat((spliceCount * 0.20).toFixed(2));
          const totalCableLoss = parseFloat((fiberLoss + spliceLoss + 0.40).toFixed(2));

          showModernSaveSuccessModal({
            title: 'Jalur Kabel Trunk ODP Disimpan!',
            targetName: `ODP: ${childOdp ? childOdp.name : 'ODP Anak'}`,
            portLabel: parentOdp ? `Dari ${parentOdp.name}` : 'ODP Induk',
            portOutputDbm: parentOdp ? (parentOdp.input_power_dbm || 9.0) : 9.0,
            distanceMeters,
            fiberLoss,
            spliceCount,
            spliceLoss,
            totalDropLoss: totalCableLoss,
            finalRxDbm: parseFloat(((parentOdp ? parentOdp.input_power_dbm || 9.0 : 9.0) - totalCableLoss).toFixed(2)),
            status: 'TRUNK OK',
            statusBadgeColor: '#2563eb'
          });
        } else {
          alert('Gagal menyimpan jalur ODP: ' + data.error);
        }
      } catch (e) {
        alert('Error: ' + e.message);
      }
      return;
    }

    // 2. Simpan Jalur Pelanggan jika tipe Customer
    if (!currentEditingCustomer) return;
    const customer = customers.find(c => Number(c.id) === Number(currentEditingCustomer));
    if (!customer || !customer.odp_id) {
      alert('Pelanggan ini belum dihubungkan ke ODP manapun!');
      return;
    }

    const parentOdpObj = odpMap[customer.odp_id]?.data;
    if (!parentOdpObj) {
      alert('Data ODP asal pelanggan tidak ditemukan!');
      return;
    }

    // Hitung loss drop core
    const fiberLoss = parseFloat(((distanceMeters / 1000) * 0.40).toFixed(2));
    const spliceLoss = parseFloat((spliceCount * 0.20).toFixed(2));

    // AMBIL DAYA PORT ODP YANG DIGUNAKAN PELANGGAN INI (Bukan daya box!)
    const odpPorts = parentOdpObj.ports || [];
    const linkedPort = odpPorts.find(p => p.target_type === 'CUSTOMER' && Number(p.target_id) === Number(customer.id));

    let portOutputDbm = -7.46;
    let portLabel = 'Port ODP';
    let dbConnNear = 'PIGTAIL';
    let dbConnFar = 'FASTCON';

    if (linkedPort) {
      const sIdx = Number(linkedPort.splitter_index || 1) - 1;
      const pNum = Number(linkedPort.port_number || 1);
      portLabel = `Splitter #${sIdx + 1} [P-${pNum}]`;
      portOutputDbm = calculateUniversalPortPower(parentOdpObj, sIdx, pNum);

      if (linkedPort.connector_near) dbConnNear = linkedPort.connector_near;
      if (linkedPort.connector_far) dbConnFar = linkedPort.connector_far;
    } else {
      const baseDbm = parseFloat(parentOdpObj.input_power_dbm !== undefined ? parentOdpObj.input_power_dbm : 7.54);
      portOutputDbm = parseFloat((baseDbm - 10.5 - 0.20).toFixed(2));
    }

    const nearLoss = connectorLossMap[dbConnNear] || 0.20;
    const farLoss = connectorLossMap[dbConnFar] || 0.50;

    // Total susut kabel drop core sampai ke modem
    const totalDropLoss = parseFloat((nearLoss + fiberLoss + spliceLoss + farLoss).toFixed(2));
    const finalRxDbm = parseFloat((portOutputDbm - totalDropLoss).toFixed(2));

    let status = 'BAGUS';
    let statusBadgeColor = '#10b981';
    if (finalRxDbm < -21.0 && finalRxDbm >= -25.0) {
      status = 'WARNING / KURANG IDEAL';
      statusBadgeColor = '#f59e0b';
    } else if (finalRxDbm < -25.0) {
      status = 'CRITICAL / LOS';
      statusBadgeColor = '#ef4444';
    }

    const customerPathJson = JSON.stringify(pts);

    try {
      const res = await fetch(`/admin/api/customers/${currentEditingCustomer}/cable-path`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ path: customerPathJson })
      });
      
      const data = await res.json();
      if (data.ok) {
        // Update data memori lokal
        customer.cable_path = customerPathJson;

        closeModal('cablePathModal');

        // TAMPILKAN MODAL MODERN ELEGAN
        showModernSaveSuccessModal({
          title: 'Jalur Kabel Berhasil Disimpan!',
          targetName: `Pelanggan: ${customer.name}`,
          portLabel: `${parentOdpObj.name} [${portLabel}]`,
          portOutputDbm,
          distanceMeters,
          fiberLoss,
          spliceCount,
          spliceLoss,
          totalDropLoss,
          finalRxDbm,
          status,
          statusBadgeColor
        });
      } else {
        alert('Gagal menyimpan: ' + data.error);
      }
    } catch (e) {
      alert('Error: ' + e.message);
    }
  }
