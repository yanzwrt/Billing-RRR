window.__selectedActivePortKey = null;

const connectorLossMap = {
  PIGTAIL: 0.30, // Fusion Splice Pigtail ~0.20 dB - ~0.30 dB
  FASTCON: 1.00  // Fast Connector mekanis ~0.50 dB - 1.20 dB
};

function renderPortAllocationUI(existingPorts = []) {
  window.__currentEditingPorts = existingPorts;
  const visualContainer = document.getElementById('odp-visual-box-ports');
  const hiddenInputsContainer = document.getElementById('hidden-ports-form-inputs');
  if (!visualContainer) return;

  visualContainer.innerHTML = '';
  if (hiddenInputsContainer) hiddenInputsContainer.innerHTML = '';

  const rows = document.querySelectorAll('.splitter-row');
  if (rows.length === 0) {
    visualContainer.innerHTML = '<div style="color: #64748b; font-size: 12px; text-align: center; padding: 24px; font-weight: 600;">Belum ada splitter dalam box ODP ini. Klik "+ Tambah Splitter" di atas.</div>';
    document.getElementById('port-active-editor').style.display = 'none';
    return;
  }

  const baseInputDbm = parseFloat(document.getElementById('e_odp_input_power')?.value || 9.0);
  let globalPortCounter = 1;
  const portDataList = [];

  rows.forEach((row, sIndex) => {
    const typeSelect = row.querySelector('.splitter-type');
    const ratioSelect = row.querySelector('.splitter-ratio');
    if (!typeSelect || !ratioSelect) return;

    const type = typeSelect.value;
    const ratio = ratioSelect.value || (type === 'PLC' ? '1:8' : '5:95');
    const portCount = getPortCountFromRatio(type, ratio);
    const inputForThisSplitter = getSplitterInputPower(sIndex, baseInputDbm);

    // Unit Box Splitter dengan Tema Terang (Light Theme)
    const unitDiv = document.createElement('div');
    unitDiv.className = 'odp-splitter-unit';

    unitDiv.innerHTML = `
      <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1.5px solid #f1f5f9; padding-bottom: 6px; margin-bottom: 8px;">
        <span style="font-size: 11.5px; font-weight: 800; color: #0284c7; text-transform: uppercase;">
          <i class="bi bi-hdd-fill me-1"></i> Splitter #${sIndex + 1} (${type} ${ratio})
        </span>
        <span style="font-size: 11px; color: #475569; font-family: monospace; background: #f1f5f9; padding: 2px 8px; border-radius: 4px; border: 1px solid #e2e8f0;">
          Input Daya: <strong style="color: #0f172a;">${inputForThisSplitter > 0 ? '+' : ''}${inputForThisSplitter} dBm</strong>
        </span>
      </div>
      <div class="odp-ports-grid" id="splitter-ports-grid-${sIndex + 1}"></div>
    `;

    visualContainer.appendChild(unitDiv);
    const gridEl = unitDiv.querySelector(`#splitter-ports-grid-${sIndex + 1}`);

    for (let p = 1; p <= portCount; p++) {
      let portLabel = `P-${p}`;
      let ratioLoss = 10.5;

      if (type === 'FBT') {
        const parts = ratio.split(':');
        const losses = (splitterLossMap.FBT && splitterLossMap.FBT[ratio]) ? splitterLossMap.FBT[ratio] : [14.0, 0.4];
        if (p === 1) {
          portLabel = `P-1 (${parts[0] || '5'}%)`;
          ratioLoss = losses[0];
        } else {
          portLabel = `P-2 (${parts[1] || '95'}%)`;
          ratioLoss = losses[1];
        }
      } else {
        ratioLoss = (splitterLossMap.PLC && splitterLossMap.PLC[ratio]) ? splitterLossMap.PLC[ratio] : 7.4;
      }

      // === [PERBAIKAN: PARSE KEDUA UJUNG KONEKTOR SECARA KONSISTEN] ===
      const matchedPort = existingPorts.find(ep => ep.port_number === p && Number(ep.splitter_index || 1) === (sIndex + 1)) ||
                          existingPorts.find(ep => ep.port_number === globalPortCounter);

      const targetType = matchedPort ? matchedPort.target_type : 'EMPTY';
      const targetId = matchedPort ? matchedPort.target_id : '';

      // Ekstrak konektor pangkal (near) dan ujung jauh (far)
      let parsedNear = 'PIGTAIL';
      let parsedFar = (targetType === 'CUSTOMER' ? 'FASTCON' : 'PIGTAIL');

      if (matchedPort) {
        if (matchedPort.connector_near) parsedNear = matchedPort.connector_near;
        else if (matchedPort.connector_type && String(matchedPort.connector_type).includes('_')) {
          parsedNear = String(matchedPort.connector_type).split('_')[0];
        } else if (matchedPort.connector_type) {
          parsedNear = matchedPort.connector_type;
        }

        if (matchedPort.connector_far) parsedFar = matchedPort.connector_far;
        else if (matchedPort.connector_type && String(matchedPort.connector_type).includes('_')) {
          parsedFar = String(matchedPort.connector_type).split('_')[1];
        }
      }

      const connectorNear = parsedNear;
      const connectorFar = parsedFar;
      const connectorLoss = connectorLossMap[connectorNear] || 0.20;

      // Hitung daya port di ODP ini (dipotong konektor pangkal box)
      const portOutputDbm = parseFloat((inputForThisSplitter - ratioLoss - connectorLoss).toFixed(2));

      // Indikator LED status
      let ledClass = 'led-empty';
