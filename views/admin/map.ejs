  // ─── REALTIME SPARKLINE CHART (LIVE SPEED MBPS) ───────────────────────────
  const customerTrafficIntervals = {};
  const customerTrafficSeries = {};

  function drawSparkline(canvas, series, maxMbps, color) {
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const w = canvas.width;
    const h = canvas.height;
    const padX = 4;
    const padY = 4;
    const innerW = w - padX * 2;
    const innerH = h - padY * 2;
    const max = Number.isFinite(maxMbps) && maxMbps > 0 ? maxMbps : 10;
    let vals = Array.isArray(series) ? series : [];

    ctx.clearRect(0, 0, w, h);

    // Garis latar belakang tipis
    ctx.strokeStyle = 'rgba(148, 163, 184, 0.22)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    for (let i = 0; i <= 3; i++) {
      const y = padY + (innerH * i) / 3;
      ctx.moveTo(padX, y);
      ctx.lineTo(padX + innerW, y);
    }
    ctx.stroke();

    if (vals.length === 1) vals = [vals[0], vals[0]];
    if (vals.length < 2) return;

    const toY = (v) => {
      const n = Math.max(0, Number(v || 0) || 0);
      const r = Math.min(1, n / max);
      return padY + innerH * (1 - r);
    };

    const grad = ctx.createLinearGradient(padX, padY, padX + innerW, padY);
    grad.addColorStop(0, color);
    grad.addColorStop(1, 'rgba(255,255,255,0.0)');

    ctx.beginPath();
    for (let i = 0; i < vals.length; i++) {
      const x = padX + (innerW * i) / (vals.length - 1);
      const y = toY(vals[i]);
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }
    ctx.strokeStyle = color;
    ctx.lineWidth = 2;
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';
    ctx.stroke();

    ctx.lineTo(padX + innerW, padY + innerH);
    ctx.lineTo(padX, padY + innerH);
    ctx.closePath();
    ctx.fillStyle = grad;
    ctx.globalAlpha = 0.22;
    ctx.fill();
    ctx.globalAlpha = 1;
  }

  function setOverlay(customerId, kind, text) {
    const el = document.getElementById(`cust_${customerId}_${kind}_state`);
    if (!el) return;
    const t = String(text || '').trim();
    el.textContent = t;
    if (t) el.classList.add('on');
    else el.classList.remove('on');
  }

  // Format kecepatan Mbps (jika di bawah 1 Mbps tampilkan dalam Kbps)
  function formatMbps(mbps) {
    const m = Number(mbps || 0);
    if (m <= 0) return '0.00 Mbps';
    if (m < 1) {
      return (m * 1024).toFixed(1) + ' Kbps';
    }
    return m.toFixed(2) + ' Mbps';
  }

  // Fungsi konversi byte otomatis (Bytes ke KB, MB, GB, TB)
  function formatBytes(bytes) {
    const b = Number(bytes || 0);
    if (b <= 0) return '0 MB';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
    const i = Math.floor(Math.log(b) / Math.log(k));
    return parseFloat((b / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  }

  // --- [KODE PERBAIKAN: MENYESUAIKAN ARGUMEN JAVASCRIPT] ---
  function updatePopupTrafficLive(customerId, totalRxBytes, totalTxBytes, rxMbps, txMbps, labelOverride) {
    const dlCanvas = document.getElementById(`cust_${customerId}_dl_chart`);
    const ulCanvas = document.getElementById(`cust_${customerId}_ul_chart`);
    
    const dlValEl = document.getElementById(`cust_${customerId}_dl_val`);
    const ulValEl = document.getElementById(`cust_${customerId}_ul_val`);
    
    // Elemen Total Harian
    const dailyDlEl = document.getElementById(`cust_${customerId}_daily_dl`);
    const dailyUlEl = document.getElementById(`cust_${customerId}_daily_ul`);

    const dlMax = Number(dlCanvas && dlCanvas.dataset ? dlCanvas.dataset.max : 10) || 10;
    const ulMax = Number(ulCanvas && ulCanvas.dataset ? ulCanvas.dataset.max : 10) || 10;

    if (!customerTrafficSeries[customerId]) customerTrafficSeries[customerId] = { dl: [], ul: [] };
    const st = customerTrafficSeries[customerId];

    if (labelOverride) {
      setOverlay(customerId, 'dl', labelOverride);
      setOverlay(customerId, 'ul', labelOverride);
      if (dlValEl) dlValEl.textContent = '-';
      if (ulValEl) ulValEl.textContent = '-';
      if (dailyDlEl) dailyDlEl.textContent = '-';
      if (dailyUlEl) dailyUlEl.textContent = '-';
      st.dl = [];
      st.ul = [];
      drawSparkline(dlCanvas, [0, 0], dlMax, 'rgba(59,130,246,0.6)');
      drawSparkline(ulCanvas, [0, 0], ulMax, 'rgba(34,197,94,0.6)');
      return;
    }

    setOverlay(customerId, 'dl', '');
    setOverlay(customerId, 'ul', '');

    // 1. Tampilkan Total Akumulasi Harian (Download & Upload)
    if (dailyDlEl) dailyDlEl.textContent = formatBytes(totalRxBytes);
    if (dailyUlEl) dailyUlEl.textContent = formatBytes(totalTxBytes);

    // 2. Tampilkan Grafik Realtime Mbps di bawahnya
    const dlSpeed = Math.max(0, Number(rxMbps || 0) || 0);
    const ulSpeed = Math.max(0, Number(txMbps || 0) || 0);

    if (dlValEl) dlValEl.textContent = formatMbps(dlSpeed);
    if (ulValEl) ulValEl.textContent = formatMbps(ulSpeed);

    st.dl.push(dlSpeed);
    st.ul.push(ulSpeed);
    if (st.dl.length > 20) st.dl = st.dl.slice(-20);
    if (st.ul.length > 20) st.ul = st.ul.slice(-20);

    drawSparkline(dlCanvas, st.dl, dlMax, '#3b82f6');
    drawSparkline(ulCanvas, st.ul, ulMax, '#22c55e');
  }

  // === [PERBAIKAN: PASTIKAN POP-UP MAP MENGAMBIL TOTAL HARIAN (DAILY)] ===
  async function refreshCustomerTrafficPopup(customerId) {
    try {
      const r = await fetch(`/admin/api/customers/${customerId}/pppoe-traffic`, { cache: 'no-store' });
      const data = await r.json();
      if (!data || !data.ok) {
        updatePopupTrafficLive(customerId, 0, 0, 0, 0, 'Error');
        return;
      }
      if (!data.available) {
        updatePopupTrafficLive(customerId, 0, 0, 0, 0, 'N/A');
        return;
      }
      if (!data.online) {
        updatePopupTrafficLive(customerId, 0, 0, 0, 0, 'Offline');
        return;
      }

      // Mengambil data HARIAN (dailyRxBytes & dailyTxBytes) untuk Peta
      const totalDownloadBytes = Number(data.dailyRxBytes || 0); // Download Harian
      const totalUploadBytes = Number(data.dailyTxBytes || 0);   // Upload Harian
      const downloadSpeed = Number(data.rxMbps || 0);            // Live DL Mbps
      const uploadSpeed = Number(data.txMbps || 0);              // Live UL Mbps

      updatePopupTrafficLive(customerId, totalDownloadBytes, totalUploadBytes, downloadSpeed, uploadSpeed, '');
    } catch (err) {
      updatePopupTrafficLive(customerId, 0, 0, 0, 0, 'Offline');
    }
  }
