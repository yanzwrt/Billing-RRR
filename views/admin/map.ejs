// === [KODE BARU: LOGIKA PELACAK TITIK CUT OTDR & INTERPOLASI KOORDINAT] ===
window.__otdrActiveContext = null;
let currentOtdrCutMarker = null;
let currentOtdrHighlightPolylines = [];

function openOtdrModal(type, targetId) {
  let routeTitle = '';
  let startName = '';
  let endName = '';
  let pathCoords = [];

  if (type === 'odp') {
    const childOdp = odps.find(o => Number(o.id) === Number(targetId));
    if (!childOdp || !childOdp.parent_odp_id) return alert('Data ODP Induk tidak ditemukan');
    const parentOdp = odpMap[childOdp.parent_odp_id];
    if (!parentOdp) return alert('ODP Induk tidak valid');

    startName = parentOdp.data?.name || 'ODP Induk';
    endName = childOdp.name;
    routeTitle = `${startName} ➜ ${endName} (Trunk)`;

    // Ambil koordinat jalur
    if (childOdp.cable_path) {
      try {
        const parsed = JSON.parse(childOdp.cable_path);
        const pts = (parsed && typeof parsed === 'object' && !Array.isArray(parsed) && Array.isArray(parsed.points))
          ? parsed.points : (Array.isArray(parsed) ? parsed : []);
        pathCoords = pts.map(p => [(typeof p.lat === 'number' ? p.lat : p[0]), (typeof p.lng === 'number' ? p.lng : p[1])]);
      } catch(e) {}
    }
    if (pathCoords.length < 2) {
      pathCoords = [parentOdp.coord, [parseFloat(childOdp.lat), parseFloat(childOdp.lng)]];
    }

  } else if (type === 'customer') {
    const cust = customers.find(c => Number(c.id) === Number(targetId));
    if (!cust || !cust.odp_id) return alert('Pelanggan ini belum terhubung ke ODP');
    const parentOdp = odpMap[cust.odp_id];
    if (!parentOdp) return alert('ODP asal pelanggan tidak ditemukan');

    startName = parentOdp.data?.name || 'ODP';
    endName = cust.name;
    routeTitle = `${startName} ➜ ${endName} (Drop Core)`;

    if (cust.cable_path) {
      try {
        const parsed = JSON.parse(cust.cable_path);
        const pts = (parsed && typeof parsed === 'object' && !Array.isArray(parsed) && Array.isArray(parsed.points))
          ? parsed.points : (Array.isArray(parsed) ? parsed : []);
        pathCoords = pts.map(p => [(typeof p.lat === 'number' ? p.lat : p[0]), (typeof p.lng === 'number' ? p.lng : p[1])]);
      } catch(e) {}
    }
    if (pathCoords.length < 2) {
      pathCoords = [parentOdp.coord, [parseFloat(cust.lat), parseFloat(cust.lng)]];
    }
  }

  const totalMeters = calculatePolylineLengthMeters(pathCoords);

  window.__otdrActiveContext = {
    type,
    targetId,
    startName,
    endName,
    pathCoords,
    totalMeters
  };

  document.getElementById('otdr_route_title').textContent = routeTitle;
  document.getElementById('otdr_route_meta').innerHTML = `Total Panjang Jalur Kabel: <strong>${totalMeters} Meter</strong> (${(totalMeters/1000).toFixed(2)} km)`;
  document.getElementById('otdr_dir_forward_text').textContent = `Dari (${startName}) menuju (${endName})`;
  document.getElementById('otdr_dir_backward_text').textContent = `Tembak Balik dari (${endName}) menuju (${startName})`;
  document.getElementById('otdr_meter_input').value = '';
  document.getElementById('otdr_meter_input').max = totalMeters + 100;
  document.getElementById('otdr_slack_range').value = 0;
  document.getElementById('otdr_slack_label').textContent = '0%';

  openModal('otdrModal');
  setTimeout(() => document.getElementById('otdr_meter_input').focus(), 300);
}

function updateOtdrDirectionHint() {
  const dir = document.querySelector('input[name="otdr_direction"]:checked')?.value || 'forward';
  const ctx = window.__otdrActiveContext;
  if (!ctx) return;
  const startPoint = dir === 'forward' ? ctx.startName : ctx.endName;
  document.getElementById('otdr_distance_hint').textContent = `*Jarak dihitung dari titik tembak: ${startPoint}.`;
}

function executeOtdrFaultLocator() {
  const ctx = window.__otdrActiveContext;
  if (!ctx) return;

  const rawMeter = parseFloat(document.getElementById('otdr_meter_input').value);
  if (!rawMeter || rawMeter <= 0) {
    return alert('Harap masukkan angka meter jarak pembacaan OTDR.');
  }

  const slackPercent = parseFloat(document.getElementById('otdr_slack_range').value || 0);
  // Kompensasi jika ada gulungan tiang: kabel riil di peta lebih pendek dari meteran kaca OTDR
  const effectiveMeter = rawMeter / (1 + (slackPercent / 100));

  const dir = document.querySelector('input[name="otdr_direction"]:checked')?.value || 'forward';
  let points = [...ctx.pathCoords];
  if (dir === 'backward') {
    points.reverse(); // Balik titik jika tembakan laser dari arah ujung hilir
  }

  // Algoritma interpolasi koordinat di sepanjang segmen kabel
  let accumulatedDistance = 0;
  let targetPoint = null;
  let splitIndex = 0;
  let segRatio = 0;

  for (let i = 0; i < points.length - 1; i++) {
    const p1 = L.latLng(points[i][0], points[i][1]);
    const p2 = L.latLng(points[i+1][0], points[i+1][1]);
    const segDist = p1.distanceTo(p2);

    if (accumulatedDistance + segDist >= effectiveMeter) {
      const remainingInSeg = effectiveMeter - accumulatedDistance;
      segRatio = remainingInSeg / (segDist || 1);
      const targetLat = p1.lat + (p2.lat - p1.lat) * segRatio;
      const targetLng = p1.lng + (p2.lng - p1.lng) * segRatio;
      targetPoint = [targetLat, targetLng];
      splitIndex = i;
      break;
    }
    accumulatedDistance += segDist;
  }

  // Jika jarak tembakan melebihi ujung kabel
  if (!targetPoint) {
    targetPoint = points[points.length - 1];
    splitIndex = points.length - 2;
  }

  closeModal('otdrModal');

  // Bersihkan marker & garis highlight OTDR lama jika ada
  if (currentOtdrCutMarker) {
    map.removeLayer(currentOtdrCutMarker);
  }
  if (currentOtdrHighlightPolylines && currentOtdrHighlightPolylines.length > 0) {
    currentOtdrHighlightPolylines.forEach(pl => map.removeLayer(pl));
    currentOtdrHighlightPolylines = [];
  }

  // Bagi garis kabel menjadi 2 segmen: Normal (Hijau) & Putus (Merah putus-putus)
  const okCoords = points.slice(0, splitIndex + 1);
  okCoords.push(targetPoint);

  const brokenCoords = [targetPoint, ...points.slice(splitIndex + 1)];

  const okLine = L.polyline(okCoords, {
    color: '#22c55e',
    weight: 6,
    opacity: 0.95
  }).addTo(map);

  const brokenLine = L.polyline(brokenCoords, {
    color: '#ef4444',
    weight: 6,
    opacity: 0.95,
    dashArray: '8, 8'
  }).addTo(map);

  currentOtdrHighlightPolylines = [okLine, brokenLine];

  // Tancapkan Marker Animasi Kedip Merah (✂️ Cut Point)
  const cutIcon = L.divIcon({
    className: 'custom-onu-icon',
    html: `
      <div class="otdr-cut-pin" title="Perkiraan Lokasi Putus OTDR (${rawMeter} m)">
        <i class="bi bi-scissors"></i>
      </div>
    `,
    iconSize: [26, 26],
    iconAnchor: [13, 13]
  });

  currentOtdrCutMarker = L.marker(targetPoint, { icon: cutIcon, zIndexOffset: 9999 }).addTo(map);

  const startName = dir === 'forward' ? ctx.startName : ctx.endName;
  const endName = dir === 'forward' ? ctx.endName : ctx.startName;
  const remainingDist = Math.max(0, Math.round(ctx.totalMeters - rawMeter));
  const gmapsUrl = `https://www.google.com/maps/search/?api=1&query=${targetPoint[0]},${targetPoint[1]}`;

  currentOtdrCutMarker.bindPopup(`
    <div style="font-size: 12px; width: 230px;">
      <div style="font-weight: 800; font-size: 13px; color: #dc2626; border-bottom: 1.5px solid #fee2e2; padding-bottom: 4px; margin-bottom: 6px;">
        <i class="bi bi-exclamation-octagon-fill me-1"></i> Perkiraan Titik Putus Kabel
      </div>
      <div style="font-size: 11.5px; color: #0f172a; margin-bottom: 4px;">
        Jarak OTDR: <strong style="color: #dc2626; font-size: 13px;">${rawMeter} Meter</strong>
      </div>
      <div style="font-size: 11px; color: #475569; margin-bottom: 2px;">
        Dari: <strong>${escapeHtml(startName)}</strong>
      </div>
      <div style="font-size: 11px; color: #475569; margin-bottom: 4px;">
        Sisa ke ${escapeHtml(endName)}: <strong>${remainingDist} Meter</strong>
      </div>
      <div style="font-size: 10px; font-family: monospace; color: #64748b; margin-bottom: 8px;">
        GPS: ${targetPoint[0].toFixed(6)}, ${targetPoint[1].toFixed(6)}
      </div>
      <a href="${gmapsUrl}" target="_blank" class="btn btn-sm btn-p" style="display: block; text-align: center; font-weight: 800; text-decoration: none; color: #ffffff !important;">
        <i class="bi bi-google me-1"></i> Buka di Google Maps
      </a>
    </div>
  `);

  // Peta meluncur fokus ke titik kejadian
  map.flyTo(targetPoint, 18, { duration: 1.2 });
  setTimeout(() => {
    currentOtdrCutMarker.openPopup();
  }, 1300);
}

// ==========AWAL KODE: CONTROLLER LOGIKA GESER SPLITTER DI POPUP ODP (OPSI B)============
  window.__currentOdpSlideState = {};

  function switchOdpSplitterSlide(odpId, targetIndex, totalSlides) {
    if (!totalSlides || totalSlides <= 1) return;

    window.__currentOdpSlideState[odpId] = targetIndex;

    // 1. Ganti tampilan Slide Port
    for (let i = 0; i < totalSlides; i++) {
      const slideEl = document.getElementById(`slide_odp_${odpId}_${i}`);
      const pillEl = document.getElementById(`pill_odp_${odpId}_${i}`);
      
      if (slideEl) {
        if (i === targetIndex) slideEl.classList.add('active');
        else slideEl.classList.remove('active');
      }

      if (pillEl) {
        if (i === targetIndex) pillEl.classList.add('active');
        else pillEl.classList.remove('active');
      }
    }

    // 2. Ganti Teks Judul Splitter
    const odpObj = globalOdps.find(o => Number(o.id) === Number(odpId));
    if (odpObj) {
      const splitters = odpObj.splitters || [];
      const sp = splitters[targetIndex] || { splitter_type: 'PLC', splitter_ratio: '1:8' };
      const titleEl = document.getElementById(`title_odp_${odpId}`);
      if (titleEl) {
        titleEl.innerHTML = `<i class="bi bi-hdd-network text-primary"></i> Splitter #${targetIndex + 1}: ${sp.splitter_type || 'PLC'} (${sp.splitter_ratio || '1:8'})`;
      }
    }
  }

  function prevOdpSplitterSlide(odpId, totalSlides) {
    let currentIdx = window.__currentOdpSlideState[odpId] || 0;
    let nextIdx = (currentIdx - 1 + totalSlides) % totalSlides;
    switchOdpSplitterSlide(odpId, nextIdx, totalSlides);
  }

  function nextOdpSplitterSlide(odpId, totalSlides) {
    let currentIdx = window.__currentOdpSlideState[odpId] || 0;
    let nextIdx = (currentIdx + 1) % totalSlides;
    switchOdpSplitterSlide(odpId, nextIdx, totalSlides);
  }
