function recalculateEstimatedPower() {
  const manualCheckbox = document.getElementById('manual_override_dbm');
  const inputField = document.getElementById('e_odp_input_power');
  const infoContainer = document.getElementById('odp_cable_distance_info');
  const infoText = document.getElementById('odp_distance_text');
  if (!inputField) return;

  const parentSelect = document.getElementById('e_odp_parent');
  const parentId = parentSelect ? parentSelect.value : '';
  const currentChildId = window.__currentEditingOdpId || null;
  const childLat = parseFloat(document.getElementById('e_odp_lat')?.value || 0);
  const childLng = parseFloat(document.getElementById('e_odp_lng')?.value || 0);

  const calc = getOdpIncomingPower(currentChildId, parentId, childLat, childLng);

  if (!manualCheckbox || !manualCheckbox.checked) {
    inputField.value = calc.powerDbm;
  }

  if (infoContainer && infoText) {
    if (parentId) {
      infoContainer.style.display = 'block';
      infoText.innerHTML = `Sumber: <strong>${calc.portSource}</strong> | Jarak Kabel: <strong>${calc.distanceMeters} m</strong> (${(calc.distanceMeters / 1000).toFixed(2)} km) | Loss Kabel: <strong>-${calc.cableLossDb} dB</strong>`;
    } else {
      infoContainer.style.display = 'none';
    }
  }

  // Update visualisasi port sisa di splitter box ini
  if (typeof renderPortAllocationUI === 'function') {
    renderPortAllocationUI(window.__currentEditingPorts || []);
  }
}
