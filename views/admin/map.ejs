    { val: '20:80', label: '20:80 (Cabang 20%)' },
    { val: '50:50', label: '50:50 (Simetris FBT)' }
  ]
};

const splitterLossMap = {
  PLC: { '1:2': 3.7, '1:4': 7.4, '1:8': 10.5, '1:16': 13.8, '1:32': 17.5 },
  FBT: { 
    '1:99': [20.0, 0.1], // [Cabang 1%, Trunk 99%]
    '5:95': [14.0, 0.4], // [Cabang 5%, Trunk 95%]
    '10:90': [10.5, 0.5], // [Cabang 10%, Trunk 90%]
    '20:80': [7.2, 0.9], // [Cabang 20%, Trunk 80%]
    '50:50': [3.5, 3.5]  
  }
};

// === [FUNGSI STANDAR UNIVERSAL: HITUNG DAYA KELUARAN PORT ADAPTER ODP] ===
function calculateUniversalPortPower(odpObj, sIdx, pNum) {
  if (!odpObj) return -9.0;
  const baseBoxInput = parseFloat(odpObj.input_power_dbm !== undefined && odpObj.input_power_dbm !== null ? odpObj.input_power_dbm : 9.0);
  const splitters = odpObj.splitters || [];
  const ports = odpObj.ports || [];

  // Fungsi rekursif untuk menentukan daya input splitter ke-sIdx pada ODP tersebut
  function getSplitterInPower(idx) {
    if (idx === 0) return baseBoxInput;
    const targetSplitterNum = idx + 1;

    // 1. Cari port internal di box ini yang mengarah ke splitter tersebut (Parsing aman format SPLITTER_2 maupun angka murni)
    const feedingPort = ports.find(p => {
      const rawTarget = String(p.target_type || '') + '_' + String(p.target_id || '');
      const cleanTargetId = Number(String(p.target_id || '').replace(/[^0-9]/g, ''));
      const isInternal = (p.target_type === 'INTERNAL_SPLITTER' || p.target_type === 'SPLITTER' || rawTarget.includes('SPLITTER'));
      return isInternal && cleanTargetId === targetSplitterNum;
    });

    if (feedingPort) {
      const srcSplitterIdx = Number(feedingPort.splitter_index || 1) - 1;
      const srcPortNum = Number(feedingPort.port_number || 1);
      const srcIn = getSplitterInPower(srcSplitterIdx);

      const srcSpConfig = splitters[srcSplitterIdx] || { splitter_type: 'FBT', splitter_ratio: '5:95' };
      const sType = srcSpConfig.splitter_type || 'FBT';
      const sRatio = srcSpConfig.splitter_ratio || (sType === 'PLC' ? '1:4' : '5:95');

      let loss = 0.4;
      if (sType === 'FBT') {
        const losses = (splitterLossMap.FBT && splitterLossMap.FBT[sRatio]) ? splitterLossMap.FBT[sRatio] : [14.0, 0.4];
        // JIKA PORT 1 (Cabang) -> losses[0], JIKA PORT 2 (Trunk) -> losses[1]
        loss = (srcPortNum === 1) ? losses[0] : losses[1];
      } else {
        loss = (splitterLossMap.PLC && splitterLossMap.PLC[sRatio]) ? splitterLossMap.PLC[sRatio] : 7.4;
      }

      const cNear = feedingPort.connector_near || feedingPort.connector_type || 'PIGTAIL';
      const connLoss = connectorLossMap[cNear] || 0.20;
      return parseFloat((srcIn - loss - connLoss).toFixed(2));
    }

    // 2. Fallback splitter bertingkat jika jumper belum diset eksplisit:
    // WAJIB AMBIL DARI TRUNK (Port 2 / losses[1]) bukan cabang (losses[0])!
    const prevIdx = idx - 1;
    const prevIn = getSplitterInPower(prevIdx);
    const prevSp = splitters[prevIdx] || { splitter_type: 'FBT', splitter_ratio: '5:95' };
    if (prevSp.splitter_type === 'FBT') {
      const losses = (splitterLossMap.FBT && splitterLossMap.FBT[prevSp.splitter_ratio]) ? splitterLossMap.FBT[prevSp.splitter_ratio] : [14.0, 0.4];
      return parseFloat((prevIn - losses[1] - 0.20).toFixed(2)); // 👈 SUDAH DIPERBAIKI: Ambil losses[1] (Trunk 95%)!
    } else {
      const loss = (splitterLossMap.PLC && splitterLossMap.PLC[prevSp.splitter_ratio]) ? splitterLossMap.PLC[prevSp.splitter_ratio] : 7.4;
      return parseFloat((prevIn - loss - 0.20).toFixed(2));
    }
  }

  // Hitung input splitter target
  const splitterInputPower = getSplitterInPower(sIdx);
  const targetSplitter = splitters[sIdx] || { splitter_type: 'PLC', splitter_ratio: '1:4' };
  const sType = targetSplitter.splitter_type || 'PLC';
  const sRatio = targetSplitter.splitter_ratio || (sType === 'PLC' ? '1:4' : '5:95');

  // Rasio loss spesifik: PLC (1:2, 1:4, 1:8, dst) atau FBT
  let ratioLoss = 7.4;
  if (sType === 'FBT') {
    const losses = (splitterLossMap.FBT && splitterLossMap.FBT[sRatio]) ? splitterLossMap.FBT[sRatio] : [14.0, 0.4];
    ratioLoss = (pNum === 1) ? losses[0] : losses[1];
  } else {
    ratioLoss = (splitterLossMap.PLC && splitterLossMap.PLC[sRatio]) !== undefined 
      ? splitterLossMap.PLC[sRatio] 
      : 7.4;
  }

  // Cari port spesifik untuk konektor pangkal
  const currentPort = ports.find(p => Number(p.splitter_index || 1) === (sIdx + 1) && Number(p.port_number) === Number(pNum));
  let nearConn = 'PIGTAIL';
  if (currentPort) {
    if (currentPort.connector_near) nearConn = currentPort.connector_near;
    else if (currentPort.connector_type && String(currentPort.connector_type).includes('_')) {
      nearConn = String(currentPort.connector_type).split('_')[0];
    } else if (currentPort.connector_type) {
      nearConn = currentPort.connector_type;
    }
  }

  const nearConnLoss = connectorLossMap[nearConn] || 0.20;
  return parseFloat((splitterInputPower - ratioLoss - nearConnLoss).toFixed(2));
}

//skrip kalkulator plc atau fbt baru

function getPortCountFromRatio(type, ratio) {
  if (type === 'PLC') {
    const match = String(ratio).match(/1:(\d+)/);
    if (match && match[1]) return parseInt(match[1], 10);
    return 8; 
  } else if (type === 'FBT') {
    return 2; // FBT selalu 2 port utama (Port 1 = Cabang, Port 2 = Trunk)
  }
  return 8;
}

// === [KODE FINAL AKURAT: DETEKSI PORT SUMBER SPLITTER INTERNAL] ===
function getSplitterInputPower(sIndex, basePower) {
  if (sIndex === 0) return basePower; // Splitter #1 selalu dapat langsung dari kabel masuk box

  const targetSplitterNum = sIndex + 1; // Contoh: Splitter #2 -> targetSplitterNum = 2
  const portsList = window.__currentEditingPorts || [];

  // 1. Cari port mana saja di box ini yang tujuannya ke Splitter N
  // Bisa berupa target_type === 'INTERNAL_SPLITTER' atau target_type === 'SPLITTER'
  let feedingPort = portsList.find(p => 
    (p.target_type === 'INTERNAL_SPLITTER' || p.target_type === 'SPLITTER') && 
    (Number(p.target_id) === targetSplitterNum || String(p.target_id) === String(targetSplitterNum))
  );

  // Jika belum ada di portsList, cek dari elemen input form yang aktif di halaman
  if (!feedingPort) {
    const hiddenInputs = document.querySelectorAll('input[name="port_targets[]"]');
    for (const hIn of hiddenInputs) {
      if (hIn.value === `SPLITTER_${targetSplitterNum}`) {
        const pKey = hIn.id ? hIn.id.replace('hidden_target_', '') : '';
        if (pKey) {
          const parts = pKey.split('_');
          feedingPort = {
            splitter_index: Number(parts[0]),
            port_number: Number(parts[1]),
            connector_type: 'PIGTAIL'
          };
          break;
        }
      }
    }
  }

  // 2. Jika ditemukan port yang mengarah ke splitter ini, hitung dayanya secara presisi
  if (feedingPort) {
    const srcSplitterIdx = Number(feedingPort.splitter_index || 1) - 1;
    const srcPortNum = Number(feedingPort.port_number || 1);
    const srcInPower = getSplitterInputPower(srcSplitterIdx, basePower);

    const rows = document.querySelectorAll('.splitter-row');
    const sourceRow = rows[srcSplitterIdx];
    const sType = sourceRow ? sourceRow.querySelector('.splitter-type')?.value : 'FBT';
    const sRatio = sourceRow ? sourceRow.querySelector('.splitter-ratio')?.value : '5:95';

    let loss = 0.4;
    if (sType === 'FBT') {
      const losses = (splitterLossMap.FBT && splitterLossMap.FBT[sRatio]) ? splitterLossMap.FBT[sRatio] : [14.0, 0.4];
      // JIKA PORT 1 (Cabang 5%) -> losses[0] (14 dB)
      // JIKA PORT 2 (Trunk 95%) -> losses[1] (0.4 dB)
      loss = (srcPortNum === 1) ? losses[0] : losses[1];
    } else {
      loss = (splitterLossMap.PLC && splitterLossMap.PLC[sRatio]) ? splitterLossMap.PLC[sRatio] : 7.4;
    }

    const connLoss = connectorLossMap[feedingPort.connector_near || feedingPort.connector_type || 'PIGTAIL'] || 0.20;
    return parseFloat((srcInPower - loss - connLoss).toFixed(2));
  }

  // 3. Fallback jika splitter di bawahnya belum dipilihkan sumbernya di dropdown:
  // Cek splitter tepat di atasnya (sIndex - 1)
  const prevSplitterIdx = sIndex - 1;
  const rows = document.querySelectorAll('.splitter-row');
  const prevRow = rows[prevSplitterIdx];
  if (prevRow) {
    const pType = prevRow.querySelector('.splitter-type')?.value || 'FBT';
    const pRatio = prevRow.querySelector('.splitter-ratio')?.value || '5:95';
    const prevInPower = getSplitterInputPower(prevSplitterIdx, basePower);

    if (pType === 'FBT') {
      const losses = (splitterLossMap.FBT && splitterLossMap.FBT[pRatio]) ? splitterLossMap.FBT[pRatio] : [14.0, 0.4];
      // Prioritaskan Trunk 95% (+ losses[1]) jika daya hulu cukup besar, atau sesuaikan dengan port 2
      return parseFloat((prevInPower - losses[1] - 0.20).toFixed(2));
    } else {
      const loss = (splitterLossMap.PLC && splitterLossMap.PLC[pRatio]) ? splitterLossMap.PLC[pRatio] : 7.4;
      return parseFloat((prevInPower - loss - 0.20).toFixed(2));
    }
  }

  return basePower;
}
