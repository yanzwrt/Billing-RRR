      else if (targetType === 'CHILD_ODP') { ledClass = 'led-odp'; statusTooltip = 'ODP Trunk'; }
      else if (targetType === 'INTERNAL_SPLITTER') { ledClass = 'led-internal'; statusTooltip = 'Jumper Internal'; }

      const portKey = `${sIndex + 1}_${p}`;
