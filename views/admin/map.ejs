        <div class="adapter-hole"></div>
        <div style="font-size: 10px; font-weight: 900; font-family: monospace; color: #f8fafc; text-shadow: 0 1px 2px rgba(0,0,0,0.6);">
          ${portOutputDbm > 0 ? '+' : ''}${portOutputDbm}
        </div>
      `;

      const currentPortObj = {
        portKey,
        splitterIndex: sIndex + 1,
        portNumber: p,
        portLabel,
        splitterType: type,
        splitterRatio: ratio,
        inputPower: inputForThisSplitter,
        ratioLoss,
        connectorType: connectorNear,
        connectorNear: connectorNear, // 👈 Disimpan eksplisit
        connectorFar: connectorFar,   // 👈 Disimpan eksplisit
        connectorLoss,
        outputDbm: portOutputDbm,
        targetType,
        targetId
      };
      portDataList.push(currentPortObj);

      adapterEl.onclick = () => selectAndOpenPortEditor(currentPortObj);
      gridEl.appendChild(adapterEl);

      // Simpan input form hidden
      if (hiddenInputsContainer) {
        hiddenInputsContainer.innerHTML += `
          <input type="hidden" name="port_numbers[]" value="${p}">
          <input type="hidden" name="port_splitter_indices[]" value="${sIndex + 1}">
          <input type="hidden" id="hidden_target_${portKey}" name="port_targets[]" value="${buildTargetRawVal(targetType, targetId, globalPortCounter)}">
          <input type="hidden" id="hidden_connector_${portKey}" name="port_connectors[]" value="${connectorNear}_${connectorFar}">
        `;
      }

      globalPortCounter++;
    }
  });

  window.__currentPortDataList = portDataList;

  // Pertahankan panel form port jika ada yang aktif
  if (window.__selectedActivePortKey) {
    const activeObj = portDataList.find(p => p.portKey === window.__selectedActivePortKey);
    if (activeObj) selectAndOpenPortEditor(activeObj);
  }
}

function buildTargetRawVal(type, id, defaultCounter) {
  if (type === 'CUSTOMER' && id) return `CUSTOMER_${id}`;
  if (type === 'CHILD_ODP' && id) return `CHILD_ODP_${id}`;
  if (type === 'INTERNAL_SPLITTER' && id) return `SPLITTER_${id}`;
  return `EMPTY_${defaultCounter}`;
}

