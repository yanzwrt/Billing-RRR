<script>
function openModal(id) { document.getElementById(id).classList.add('show'); }
function closeModal(id) { document.getElementById(id).classList.remove('show'); }

function switchTab(tabName) {
  document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
  
  const targetTab = document.getElementById('tab-' + tabName);
  const targetBtn = document.getElementById('btn-tab-' + tabName);
  if (targetTab) targetTab.classList.add('active');
  if (targetBtn) targetBtn.classList.add('active');
}

/**
 * Filter Kartu ONU Secara Instan saat Diketik di Kotak Pencarian
 */
function filterOnuCards() {
  const query = (document.getElementById('onuSearchInput').value || '').toLowerCase().trim();
  const cards = document.querySelectorAll('#configuredList .onu-card');
  
  cards.forEach(card => {
    const text = card.innerText.toLowerCase();
    card.style.display = text.includes(query) ? '' : 'none';
  });
}

/**
 * Deteksi Merk Asli Modem ONU dari Awalan Serial Number (Vendor ID)
 */
function detectOnuBrand(sn) {
  if (!sn) return { name: 'GENERIC', css: 'generic' };
  
  const clean = sn.replace(/[^a-zA-Z0-9]/g, '').toUpperCase();
  
  if (clean.startsWith('46485454') || clean.startsWith('FHTT') || clean.startsWith('FH')) {
    return { name: 'FIBERHOME', css: 'fiberhome' };
  }
  if (clean.startsWith('48575443') || clean.startsWith('HWTC') || clean.startsWith('HW')) {
    return { name: 'HUAWEI', css: 'huawei' };
  }
  if (clean.startsWith('5A544547') || clean.startsWith('ZTEG') || clean.startsWith('ZTE')) {
    return { name: 'ZTE', css: 'zte' };
  }
  if (clean.startsWith('43444154') || clean.startsWith('CDAT')) {
    return { name: 'C-DATA', css: 'cdata' };
  }
  if (clean.startsWith('56534F4C') || clean.startsWith('VSOL')) {
    return { name: 'VSOL', css: 'vsol' };
  }
  if (clean.startsWith('414C434C') || clean.startsWith('ALCL')) {
    return { name: 'NOKIA', css: 'nokia' };
  }
  if (clean.startsWith('5853544E') || clean.startsWith('XSTN') || clean.startsWith('XONT')) {
    return { name: 'XPON', css: 'generic' };
  }

  return { name: 'XPON', css: 'generic' };
}

function formatBytes(bytesPerSec) {
  if (!bytesPerSec || bytesPerSec <= 0) return '0 bps';
  const bitsPerSec = Number(bytesPerSec) * 8;

  if (bitsPerSec >= 1000000000) {
    return (bitsPerSec / 1000000000).toFixed(2) + ' Gbps';
  }
  if (bitsPerSec >= 1000000) {
    return (bitsPerSec / 1000000).toFixed(2) + ' Mbps';
  }
  if (bitsPerSec >= 1000) {
    return (bitsPerSec / 1000).toFixed(2) + ' Kbps';
  }
  return Math.round(bitsPerSec) + ' bps';
}

document.addEventListener('DOMContentLoaded', () => {
  scanConfiguredONUs();
});

// --- AWAL GANTI FUNGSI scanConfiguredONUs() DI onu_provision.ejs ---
async function scanConfiguredONUs() {
  const listDiv = document.getElementById('configuredList');
  const selOlt = document.getElementById('provisionOltSelect');
  const oltId = selOlt ? selOlt.value : '';

  listDiv.innerHTML = '<div class="hint" style="text-align:center;padding:40px"><i class="bi bi-arrow-repeat spin" style="font-size:32px;color:#3b82f6"></i><p style="margin-top:10px;color:#64748b">Mengambil data ONU via MIB SNMP...</p></div>';
  
  try {
    const response = await fetch('/admin/onu-provision/scan-configured', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ oltId })
    });
    
    const data = await response.json();
    
    if (data.success && data.onus && data.onus.length > 0) {
      let html = '';
      data.onus.forEach(onu => {
        const brand = detectOnuBrand(onu.sn);
        const isOnline = String(onu.status || '').toLowerCase() === 'online';

        html += `
          <div class="onu-card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;border-bottom:1px solid #f1f5f9;padding-bottom:10px;flex-wrap:wrap;gap:8px;">
              <div style="display:flex;align-items:center;gap:6px">
                <span class="vendor-badge vendor-${brand.css}">${brand.name}</span>
                <span class="onu-status ${isOnline ? 'online' : 'offline'}">${isOnline ? 'Online' : 'Offline'}</span>
                <span class="onu-title">${onu.name}</span>
              </div>
              <div style="display:flex;gap:6px">
                <button onclick="showOnuDetailModal('${data.oltId}', '${onu.index}', '${onu.name}')" class="btn btn-sm btn-outline-info py-0 px-2" style="font-size:11px;" title="Lihat Detail & Trafik Live">
                  <i class="bi bi-info-circle"></i> Detail
                </button>
                <button onclick="renameConfiguredOnu('${data.oltId}', '${onu.index}', '${onu.name}')" class="btn-action-icon" title="Ubah Nama (MIB)">
                  <i class="bi bi-pencil"></i>
                </button>
                <button onclick="rebootConfiguredOnu('${data.oltId}', '${onu.index}')" class="btn-action-icon reboot" title="Reboot ONU (MIB)">
                  <i class="bi bi-arrow-clockwise"></i>
                </button>
                <button onclick="deleteAndUnbindOnu('${data.oltId}', '${onu.index}', '${onu.sn}')" class="btn-action-icon delete" title="Unbind / Hapus (MIB)">
                  <i class="bi bi-trash"></i>
                </button>
              </div>
            </div>
            
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px">
              <div>
                <div class="onu-prop-label">Serial Number</div>
                <div class="onu-prop-val mono">${onu.sn}</div>
              </div>
              <div>
                <div class="onu-prop-label">Interface / ID</div>
                <div class="onu-prop-val">${onu.id || onu.index}</div>
              </div>
              <div>
                <div class="onu-prop-label">Sinyal RX / TX</div>
                <div class="onu-prop-val">
                  <span style="color: ${parseFloat(onu.rx) < -27 ? '#ef4444' : '#16a34a'}">${onu.rx || 'N/A'}</span> / 
                  <span style="color: #64748b">${onu.tx || 'N/A'}</span>
                </div>
              </div>
              <div>
                <div class="onu-prop-label">Uptime / Jarak</div>
                <div class="onu-prop-val">${onu.uptime || '-'} / ${onu.distance || '-'}</div>
              </div>
              ${onu.customer_name ? `
              <div>
                <div class="onu-prop-label">Nama Pelanggan</div>
                <div class="onu-prop-val" style="color:#0284c7"><i class="bi bi-person-fill"></i> ${onu.customer_name}</div>
              </div>
              ` : ''}
            </div>
          </div>
        `;
      });
      listDiv.innerHTML = html;
      // Jalankan filter jika sebelumnya ada teks di search box
      filterOnuCards();
    } else {
      const errorMsg = data.error || 'Tidak ada ONU terkonfigurasi';
      listDiv.innerHTML = `<div class="hint" style="text-align:center;padding:40px"><i class="bi bi-info-circle" style="font-size:32px;color:#f59e0b"></i><p style="margin-top:10px;color:#64748b">${errorMsg}</p></div>`;
    }
  } catch (error) {
    listDiv.innerHTML = '<div class="alert alert-d"><i class="bi bi-exclamation-circle"></i> Error: ' + error.message + '</div>';
  }
}

