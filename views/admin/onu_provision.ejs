/* --- DIALOG CENTER (PENGGANTI ALERT, CONFIRM, DAN PROMPT) --- */
function showCustomAlert(message, type = 'info', title = null) {
  return new Promise((resolve) => {
    const overlay = document.getElementById('customDialogOverlay');
    const iconEl = document.getElementById('customDialogIcon');
    const titleEl = document.getElementById('customDialogTitle');
    const msgEl = document.getElementById('customDialogMsg');
    const inputContainer = document.getElementById('customDialogInputContainer');
    const btnsEl = document.getElementById('customDialogBtns');

    const icons = {
      success: '<i class="bi bi-check-circle-fill"></i>',
      danger: '<i class="bi bi-x-circle-fill"></i>',
      warning: '<i class="bi bi-exclamation-triangle-fill"></i>',
      info: '<i class="bi bi-info-circle-fill"></i>'
    };

    const defaultTitles = {
      success: 'Berhasil',
      danger: 'Terjadi Kesalahan',
      warning: 'Perhatian',
      info: 'Informasi'
    };

    inputContainer.style.display = 'none';
    iconEl.className = 'custom-dialog-icon ' + type;
    iconEl.innerHTML = icons[type] || icons.info;
    titleEl.textContent = title || defaultTitles[type] || 'Pemberitahuan';
    msgEl.innerHTML = message;

    btnsEl.innerHTML = `
      <button type="button" class="btn btn-p px-4 fw-bold" id="btn-dialog-ok">OK</button>
    `;

    overlay.classList.add('active');

    document.getElementById('btn-dialog-ok').onclick = () => {
      overlay.classList.remove('active');
      resolve(true);
    };
  });
}

function showCustomConfirm(message, title = 'Konfirmasi Tindakan', type = 'warning') {
  return new Promise((resolve) => {
    const overlay = document.getElementById('customDialogOverlay');
    const iconEl = document.getElementById('customDialogIcon');
    const titleEl = document.getElementById('customDialogTitle');
    const msgEl = document.getElementById('customDialogMsg');
    const inputContainer = document.getElementById('customDialogInputContainer');
    const btnsEl = document.getElementById('customDialogBtns');

    const icons = {
      warning: '<i class="bi bi-question-circle-fill"></i>',
      danger: '<i class="bi bi-exclamation-octagon-fill"></i>',
      info: '<i class="bi bi-arrow-repeat"></i>'
    };

    inputContainer.style.display = 'none';
    iconEl.className = 'custom-dialog-icon ' + type;
    iconEl.innerHTML = icons[type] || icons.warning;
    titleEl.textContent = title;
    msgEl.innerHTML = message;

    btnsEl.innerHTML = `
      <button type="button" class="btn btn-g px-3" id="btn-dialog-cancel">Batal</button>
      <button type="button" class="btn ${type === 'danger' ? 'btn-d' : 'btn-p'} px-4 fw-bold" id="btn-dialog-confirm">Lanjutkan</button>
    `;

    overlay.classList.add('active');

    document.getElementById('btn-dialog-cancel').onclick = () => {
      overlay.classList.remove('active');
      resolve(false);
    };

    document.getElementById('btn-dialog-confirm').onclick = () => {
      overlay.classList.remove('active');
      resolve(true);
    };
  });
}

function showCustomPrompt(message, defaultValue = '', title = 'Ubah Data') {
  return new Promise((resolve) => {
    const overlay = document.getElementById('customDialogOverlay');
    const iconEl = document.getElementById('customDialogIcon');
    const titleEl = document.getElementById('customDialogTitle');
    const msgEl = document.getElementById('customDialogMsg');
    const inputContainer = document.getElementById('customDialogInputContainer');
    const inputEl = document.getElementById('customDialogInput');
    const btnsEl = document.getElementById('customDialogBtns');

    iconEl.className = 'custom-dialog-icon info';
    iconEl.innerHTML = '<i class="bi bi-pencil-square"></i>';
    titleEl.textContent = title;
    msgEl.innerHTML = message;
    
    inputContainer.style.display = 'block';
    inputEl.value = defaultValue;

    btnsEl.innerHTML = `
      <button type="button" class="btn btn-g px-3" id="btn-dialog-cancel">Batal</button>
      <button type="button" class="btn btn-p px-4 fw-bold" id="btn-dialog-submit">Simpan</button>
    `;

    overlay.classList.add('active');
    setTimeout(() => { inputEl.focus(); inputEl.select(); }, 150);

    const submitAction = () => {
      const val = inputEl.value;
      overlay.classList.remove('active');
      resolve(val);
    };

    document.getElementById('btn-dialog-cancel').onclick = () => {
      overlay.classList.remove('active');
      resolve(null);
    };

    document.getElementById('btn-dialog-submit').onclick = submitAction;
    inputEl.onkeydown = (e) => {
      if (e.key === 'Enter') submitAction();
    };
  });
}

// ─── MODAL DETAIL PERANGKAT & TRAFIK LIVE MIKROTIK ───
let currentDetailTimer = null;

async function showOnuDetailModal(oltId, index, name) {
  openModal('onuDetailModal');
  document.getElementById('onu-detail-loading').style.display = 'block';
  document.getElementById('onu-detail-content').style.display = 'none';

  let linkedCustomerId = null;

  async function loadDetail() {
    try {
      const res = await fetch(`/admin/olts/${encodeURIComponent(oltId)}/onu/${encodeURIComponent(index)}/detail`);
      const result = await res.json();
      if (!result.success) return;

      const d = result.data;
      document.getElementById('det-onu-name').innerText = d.name || name || '-';
      document.getElementById('det-onu-sn').innerText = d.sn || '-';
      
      const rxVal = parseFloat(d.rx);
      const rxEl = document.getElementById('det-onu-rx');
      rxEl.innerText = d.rx || '-';
      rxEl.style.color = (!isNaN(rxVal) && rxVal < -27) ? '#ef4444' : '#16a34a';

      document.getElementById('det-onu-tx').innerText = d.tx || '-';
      document.getElementById('det-onu-dist').innerText = d.distance || '-';
      document.getElementById('det-onu-temp').innerText = d.temp || '-';

      const st = document.getElementById('det-onu-status');
      const isOnline = String(d.status || '').toLowerCase() === 'online';
      st.className = `onu-status ${isOnline ? 'online' : 'offline'}`;
      st.innerText = isOnline ? 'Online' : 'Offline';

      // === MULAI PERUBAHAN: TAMPILAN DATA PELANGGAN + LINK BUKA HALAMAN PELANGGAN ===
      const detailLinkBtn = document.getElementById('det-cust-detail-link');

      if (d.customer) {
        linkedCustomerId = d.customer.id;
        
        // Atur link ke halaman pelanggan (akan terbuka langsung di tab yang sama)
        if (detailLinkBtn) {
          detailLinkBtn.href = `/admin/customers?open_detail_id=${encodeURIComponent(d.customer.id)}&highlight=${encodeURIComponent(d.customer.id)}`;
          detailLinkBtn.style.display = 'inline-flex';
        }
      // === SELESAI PERUBAHAN: SET URL LANGSUNG DI TAB YANG SAMA ===
        
        // Aktifkan dan atur tautan langsung ke halaman data pelanggan
        if (detailLinkBtn) {
          detailLinkBtn.href = `/admin/customers?open_detail_id=${encodeURIComponent(d.customer.id)}&highlight=${encodeURIComponent(d.customer.id)}`;
          detailLinkBtn.style.display = 'inline-flex';
        }

        const rawPhone = (d.customer.phone || '').replace(/[^0-9]/g, '');
        let waHtml = '<span class="text-muted">-</span>';
        if (rawPhone) {
          const formattedPhone = rawPhone.startsWith('0') ? '62' + rawPhone.slice(1) : rawPhone;
          waHtml = `<a href="https://wa.me/${formattedPhone}" target="_blank" style="color:#16a34a; text-decoration:none; font-weight:700;">
                      <i class="bi bi-whatsapp me-1"></i>${d.customer.phone}
                    </a>`;
        }

        document.getElementById('det-cust-info').innerHTML = `
          <table class="cust-table-rows">
            <tbody>
              <tr>
                <td class="cust-label-col"><i class="bi bi-person me-1"></i> Nama Pelanggan</td>
                <td class="cust-val-col text-primary">${d.customer.name || '-'}</td>
              </tr>
              <tr>
                <td class="cust-label-col"><i class="bi bi-shield-lock me-1"></i> Akun PPPoE</td>
                <td class="cust-val-col font-monospace" style="color:#2563eb;">${d.customer.pppoe_username || '-'}</td>
              </tr>
              <tr>
                <td class="cust-label-col"><i class="bi bi-telephone me-1"></i> WhatsApp</td>
                <td class="cust-val-col">${waHtml}</td>
              </tr>
              <tr>
                <td class="cust-label-col"><i class="bi bi-geo-alt me-1"></i> Alamat</td>
                <td class="cust-val-col" style="font-weight:500;">${d.customer.address || '-'}</td>
              </tr>
            </tbody>
          </table>
        `;
      } else {
        linkedCustomerId = null;
        if (detailLinkBtn) {
          detailLinkBtn.style.display = 'none';
        }
        document.getElementById('det-cust-info').innerHTML = `
          <div class="text-center py-2 text-muted small">
            <i class="bi bi-info-circle me-1"></i> Modem ini belum ditautkan ke data pelanggan manapun.
          </div>
        `;
      }
      // === SELESAI PERUBAHAN: TAMPILAN DATA PELANGGAN + LINK BUKA HALAMAN PELANGGAN ===

      document.getElementById('onu-detail-loading').style.display = 'none';
      document.getElementById('onu-detail-content').style.display = 'block';
    } catch (err) {}
  }

  async function pollCustomerLiveTraffic() {
    if (!linkedCustomerId) return;
    try {
      const tRes = await fetch(`/admin/api/customers/${linkedCustomerId}/pppoe-traffic`);
      if (tRes.ok) {
        const tData = await tRes.json();
        if (tData.ok && tData.online) {
          const downloadBps = Math.round((tData.rxMbps || 0) * 1000000 / 8);
          const uploadBps = Math.round((tData.txMbps || 0) * 1000000 / 8);

          document.getElementById('det-traffic-rx').innerText = formatBytes(downloadBps);
          document.getElementById('det-traffic-tx').innerText = formatBytes(uploadBps);
        } else {
          document.getElementById('det-traffic-rx').innerText = '0 bps (Idle)';
          document.getElementById('det-traffic-tx').innerText = '0 bps (Idle)';
        }
      }
    } catch (e) {}
  }

  await loadDetail();
  await pollCustomerLiveTraffic();

  if (currentDetailTimer) clearInterval(currentDetailTimer);
  currentDetailTimer = setInterval(pollCustomerLiveTraffic, 1500);
}

function closeOnuDetailModal() {
  if (currentDetailTimer) clearInterval(currentDetailTimer);
  closeModal('onuDetailModal');
}

/**
 * UNBIND / HAPUS ONU DENGAN DIALOG CENTER
 */
async function deleteAndUnbindOnu(oltId, index, sn) {
  const confirmed = await showCustomConfirm(
    `Apakah Anda yakin ingin <strong>UNBIND / MENGHAPUS</strong> ONU ini via MIB SNMP?<br><br>
    <div style="font-family:monospace; font-size:12px; background:rgba(0,0,0,0.05); padding:8px; border-radius:6px; text-align:left;">
      <strong>Index:</strong> ${index}<br>
      <strong>SN:</strong> ${sn}
    </div>
    <div class="mt-2 text-danger small">Setelah dihapus, ONU akan kembali ke status 'Belum Terkonfigurasi'.</div>`,
    'Unbind / Hapus ONU?',
    'danger'
  );

  if (!confirmed) return;

  try {
    const res = await fetch('/admin/onu-provision/delete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ 
        oltId, 
        index, 
        sn,
        params: { index, sn, onuId: index }
      })
    });
    
    const data = await res.json();
    if (data.success) {
      await showCustomAlert('ONU berhasil di-unbind via MIB SNMP!', 'success', 'Berhasil');
      switchTab('unconfigured');
      scanUnconfiguredONUs();
    } else {
      await showCustomAlert('Gagal unbind ONU: ' + (data.error || 'Terjadi kesalahan'), 'danger');
    }
  } catch (error) {
    showCustomAlert('Error koneksi: ' + error.message, 'danger');
  }
}

/**
 * REBOOT ONU DENGAN DIALOG CENTER
 */
async function rebootConfiguredOnu(oltId, index) {
  const confirmed = await showCustomConfirm(
    `Apakah Anda yakin ingin me-reboot ONU dengan ID <strong>${index}</strong> via MIB SNMP?`,
    'Reboot Modem ONU',
    'warning'
  );

  if (!confirmed) return;

  try {
    const res = await fetch(`/admin/olts/${oltId}/onu/${index}/reboot`, { method: 'POST' });
    const data = await res.json();
    if (data.success) {
      await showCustomAlert('Perintah reboot via MIB SNMP berhasil dikirim!', 'success', 'Perintah Dikirim');
      scanConfiguredONUs();
    } else {
      await showCustomAlert('Gagal: ' + data.error, 'danger');
    }
  } catch (error) {
    showCustomAlert('Error: ' + error.message, 'danger');
  }
}

/**
 * RENAME ONU DENGAN DIALOG CENTER
 */
async function renameConfiguredOnu(oltId, index, oldName) {
  const newName = await showCustomPrompt('Masukkan nama baru untuk perangkat ONU:', oldName, 'Ubah Nama ONU');
  if (!newName || newName.trim() === '') return;

  try {
    const res = await fetch(`/admin/olts/${oltId}/onu/${index}/rename`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams({ name: newName.trim() })
    });
    const data = await res.json();
    if (data.success) {
      await showCustomAlert('Nama ONU berhasil diubah via MIB SNMP!', 'success', 'Berhasil Diubah');
      scanConfiguredONUs();
    } else {
      await showCustomAlert('Gagal: ' + data.error, 'danger');
    }
  } catch (error) {
    showCustomAlert('Error: ' + error.message, 'danger');
  }
}
// === SELESAI PERUBAHAN: HANDLER DETAIL LIVE RAPI & CENTER MODAL DIALOGS ===
