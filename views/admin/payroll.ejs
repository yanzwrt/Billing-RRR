<!-- ==================== MODAL EDIT RINCIAN SLIP ==================== -->
<div class="mo" id="editSlipModal" style="display:none">
  <div class="mb mo-box-custom" style="max-width:580px">
    <div class="mb-hd">
      <h6 id="editSlipTitle" style="font-size:15px;margin:0;font-weight:700"><i class="bi bi-pencil-square"></i> Edit Rincian Slip Gaji</h6>
      <button type="button" class="mo-close" onclick="closeEditSlipModal()">&times;</button>
    </div>
    <form method="POST" id="editSlipForm">
      <div class="mb-bd" style="max-height:75vh;overflow-y:auto;padding:18px">
        <div style="background:var(--bg,#f1f5f9);border-radius:8px;padding:10px 14px;margin-bottom:14px;font-size:12px;border:1px solid var(--border)">
          <strong>Karyawan:</strong> <span id="es_emp_name"></span> (<span id="es_emp_type"></span>)<br>
          <strong>Periode:</strong> <span id="es_period"></span>
        </div>

        <div class="form-group-title">Kehadiran &amp; Absensi</div>
        <div style="display:grid;grid-template-columns:repeat(3, 1fr);gap:10px;margin-bottom:14px">
          <div>
            <label style="font-size:11px;font-weight:600;color:var(--muted)">Hari Hadir</label>
            <input type="number" name="working_days" id="es_working_days" class="fc-custom" required>
          </div>
          <div>
            <label style="font-size:11px;font-weight:600;color:var(--muted)">Hari Absen</label>
            <input type="number" name="absent_days" id="es_absent_days" class="fc-custom" value="0">
          </div>
          <div>
            <label style="font-size:11px;font-weight:600;color:var(--muted)">Hari Terlambat</label>
            <input type="number" name="late_days" id="es_late_days" class="fc-custom" value="0">
          </div>
        </div>

        <div class="form-group-title">Tambahan, Lembur &amp; Bonus</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px">
          <div>
            <label style="font-size:11px;font-weight:600;color:var(--muted)">Jam Lembur (Jam)</label>
            <input type="number" step="0.5" name="overtime_hours" id="es_overtime_hours" class="fc-custom" value="0">
          </div>
          <div>
            <label style="font-size:11px;font-weight:600;color:var(--muted)">Bonus Lembur (Rp)</label>
            <input type="number" name="overtime_bonus" id="es_overtime_bonus" class="fc-custom" value="0">
          </div>
          <div>
            <label style="font-size:11px;font-weight:600;color:var(--muted)">Bonus Tiket (Rp)</label>
            <input type="number" name="ticket_bonus" id="es_ticket_bonus" class="fc-custom" value="0">
          </div>
          <div>
            <label style="font-size:11px;font-weight:600;color:var(--muted)">Komisi Tagihan (Rp)</label>
            <input type="number" name="collection_commission" id="es_collection_commission" class="fc-custom" value="0">
          </div>
        </div>

        <div class="form-group-title">Potongan Gaji</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px">
          <div>
            <label style="font-size:11px;font-weight:600;color:var(--muted)">Potongan Absen (Rp)</label>
            <input type="number" name="absence_deduction" id="es_absence_deduction" class="fc-custom" value="0">
          </div>
          <div>
            <label style="font-size:11px;font-weight:600;color:var(--muted)">Potongan Terlambat (Rp)</label>
            <input type="number" name="late_deduction" id="es_late_deduction" class="fc-custom" value="0">
          </div>
          <div>
            <label style="font-size:11px;font-weight:600;color:var(--muted)">Potongan Lain / Kasbon (Rp)</label>
            <input type="number" name="other_deduction" id="es_other_deduction" class="fc-custom" value="0">
