          <div>
            <label style="font-size:11px;font-weight:600;color:var(--muted)">Keterangan Potongan</label>
            <input type="text" name="other_deduction_note" id="es_other_deduction_note" class="fc-custom" placeholder="Kasbon, denda, dll">
          </div>
        </div>

        <div>
          <label style="font-size:11px;font-weight:600;color:var(--muted)">Catatan Slip</label>
          <input type="text" name="notes" id="es_notes" class="fc-custom" placeholder="Catatan apresiasi / info penyesuaian">
