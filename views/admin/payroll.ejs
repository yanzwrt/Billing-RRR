<script>
let payrollData = {};
try {
  payrollData = <%- JSON.stringify(employees.reduce(function(acc, e) { 
    if(e.payroll) {
      let sSal = {};
      if (typeof e.payroll.site_salaries === 'string') {
        try { sSal = JSON.parse(e.payroll.site_salaries); } catch(_) { sSal = {}; }
      } else if (typeof e.payroll.site_salaries === 'object' && e.payroll.site_salaries !== null) {
        sSal = e.payroll.site_salaries;
      }
      acc[e.employee_type + "_" + e.id] = {
        ...e.payroll,
        site_salaries_obj: sSal
      };
    }
    return acc; 
  }, {})) %>;
} catch (err) {
  console.error("Gagal parse payrollData:", err);
  payrollData = {};
}

function switchTab(name){
  document.querySelectorAll('.tab-btn').forEach((b,i) => b.classList.toggle('active', (name==='settings'?i===0:i===1)));
  document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
  document.getElementById('tab-'+name).classList.add('active');
}

function calculateTotalBaseSalary() {
  const s1 = parseInt(document.getElementById('f_site_1').value) || 0;
  const s2 = parseInt(document.getElementById('f_site_2').value) || 0;
  const s3 = parseInt(document.getElementById('f_site_3').value) || 0;
  const total = s1 + s2 + s3;
  document.getElementById('f_base').value = total;
  document.getElementById('lbl_total_base').textContent = 'Rp ' + total.toLocaleString('id-ID');
}

function editPayroll(type, id, name){
  document.getElementById('modalTitle').innerHTML = '<i class="bi bi-pencil-square"></i> Set Gaji — ' + name;
  document.getElementById('f_type').value = type;
  document.getElementById('f_id').value = id;
  const d = payrollData[type+'_'+id];
  
  let sMap = {};
  if (d) {
    if (d.site_salaries_obj) {
      sMap = d.site_salaries_obj;
    } else if (typeof d.site_salaries === 'string') {
      try { sMap = JSON.parse(d.site_salaries); } catch(e) { sMap = {}; }
    } else if (typeof d.site_salaries === 'object' && d.site_salaries !== null) {
      sMap = d.site_salaries;
    }
  }
  
  const site1Val = sMap['site-1'] !== undefined ? sMap['site-1'] : 0;
  const site2Val = sMap['site-2'] !== undefined ? sMap['site-2'] : 0;
  const site3Val = sMap['site-3'] !== undefined ? sMap['site-3'] : 0;

  document.getElementById('f_site_1').value = site1Val;
  document.getElementById('f_site_2').value = site2Val;
  document.getElementById('f_site_3').value = site3Val;
  
  if (site1Val === 0 && site2Val === 0 && site3Val === 0 && d && d.base_salary) {
    document.getElementById('f_site_1').value = d.base_salary;
  }
  calculateTotalBaseSalary();

  document.getElementById('f_days').value = d ? d.working_days_per_month : 26;
  document.getElementById('f_transport').value = d ? d.transport_allowance : 0;
  document.getElementById('f_meal').value = d ? d.meal_allowance : 0;
  document.getElementById('f_phone').value = d ? d.phone_allowance : 0;
  document.getElementById('f_other').value = d ? d.other_allowance : 0;
  document.getElementById('f_other_note').value = d ? d.other_allowance_note : '';
  document.getElementById('f_absence').value = d ? d.absence_deduction_per_day : 0;
  document.getElementById('f_bonus').value = d ? d.bonus_per_ticket : 0;
  document.getElementById('f_commission').value = d ? d.commission_percentage : 0;
  document.getElementById('payrollModal').style.display = 'flex';
}

function closeModal(){ document.getElementById('payrollModal').style.display = 'none'; }

function openEditSlipModal(slip){
  document.getElementById('editSlipTitle').innerHTML = '<i class="bi bi-pencil-square"></i> Edit Slip #' + slip.id + ' — ' + slip.employee_name;
  document.getElementById('editSlipForm').action = '/admin/payroll/slip/' + slip.id + '/update';
  document.getElementById('es_emp_name').textContent = slip.employee_name;
  document.getElementById('es_emp_type').textContent = slip.employee_type.toUpperCase();
  document.getElementById('es_period').textContent = slip.period_month + '/' + slip.period_year;

  document.getElementById('es_working_days').value = slip.working_days || 0;
  document.getElementById('es_absent_days').value = slip.absent_days || 0;
  document.getElementById('es_late_days').value = slip.late_days || 0;

  document.getElementById('es_overtime_hours').value = slip.overtime_hours || 0;
  document.getElementById('es_overtime_bonus').value = slip.overtime_bonus || 0;
  document.getElementById('es_ticket_bonus').value = slip.ticket_bonus || 0;
  document.getElementById('es_collection_commission').value = slip.collection_commission || 0;

  document.getElementById('es_absence_deduction').value = slip.absence_deduction || 0;
  document.getElementById('es_late_deduction').value = slip.late_deduction || 0;
  document.getElementById('es_other_deduction').value = slip.other_deduction || 0;
  document.getElementById('es_other_deduction_note').value = slip.other_deduction_note || '';
  document.getElementById('es_notes').value = slip.notes || '';

  document.getElementById('editSlipModal').style.display = 'flex';
}

function closeEditSlipModal(){
  document.getElementById('editSlipModal').style.display = 'none';
}

function sendSlipWA(id){
  // Buat modal/prompt pilihan centang sederhana yang elegan
  const modalHtml = `
    <div class="mo show" id="waChoiceModal" style="display:flex;z-index:9999">
      <div class="mb mo-box-custom" style="max-width:380px">
        <div class="mb-hd">
          <h6 style="margin:0;font-size:15px;font-weight:700"><i class="bi bi-whatsapp" style="color:#22c55e"></i> Kirim Slip Gaji via WA</h6>
          <button type="button" class="mo-close" onclick="document.getElementById('waChoiceModal').remove()">&times;</button>
        </div>
        <div class="mb-bd" style="padding:18px;font-size:13px">
          <p style="margin-bottom:14px;color:var(--muted)">Pilih metode pengiriman dokumen untuk karyawan ini:</p>
          <label style="display:flex;align-items:center;gap:10px;margin-bottom:10px;cursor:pointer">
            <input type="checkbox" id="chk_wa_text" checked style="width:16px;height:16px"> 
            <span>Kirim Pesan Rincian Teks WA</span>
          </label>
          <label style="display:flex;align-items:center;gap:10px;cursor:pointer">
            <input type="checkbox" id="chk_wa_pdf" checked style="width:16px;height:16px"> 
            <span>Kirim Lampiran Dokumen PDF (Berlogo)</span>
          </label>
        </div>
        <div class="mb-ft" style="border-top:1px solid var(--border);padding:12px 18px;display:flex;justify-content:flex-end;gap:8px">
          <button type="button" class="btn btn-g btn-sm" onclick="document.getElementById('waChoiceModal').remove()">Batal</button>
          <button type="button" class="btn btn-p btn-sm" id="btnConfirmSendWa">Kirim Sekarang</button>
        </div>
      </div>
    </div>
  `;

  // Sisipkan ke body
  const div = document.createElement('div');
  div.innerHTML = modalHtml;
  document.body.appendChild(div);

  document.getElementById('btnConfirmSendWa').onclick = function() {
    const sendWaText = document.getElementById('chk_wa_text').checked;
    const sendWaPdf = document.getElementById('chk_wa_pdf').checked;
    
    document.getElementById('waChoiceModal').remove();

    if(!sendWaText && !sendWaPdf) {
      alert('Pilih minimal satu metode pengiriman!');
      return;
    }

    const btn = event.target;
    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = 'Mengirim...';

    fetch('/admin/payroll/slip/'+id+'/send-wa', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ send_wa: sendWaText, send_pdf: sendWaPdf })
    })
    .then(r => r.json())
    .then(d => {
      btn.disabled = false;
      btn.innerHTML = originalText;
      alert(d.success ? '✓ Slip gaji berhasil dikirim ke WhatsApp!' : '✗ ' + (d.message || 'Gagal mengirim'));
    })
    .catch(e => {
      btn.disabled = false;
      btn.innerHTML = originalText;
      alert('Error: ' + e.message);
    });
  };
}

document.getElementById('payrollModal').addEventListener('click',function(e){if(e.target===this)closeModal()});
document.getElementById('editSlipModal').addEventListener('click',function(e){if(e.target===this)closeEditSlipModal()});
</script>
</body>
</html>