  <!-- Chart.js 4.4 -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js"></script>

  <script>
    'use strict';

    // Global State
    let pollInterval = null;
    let pollIntervalMs = 2500;
    let trafficChart = null;
    let selectedInterface = '__ALL__';
    let isAutoCycleEnabled = false;

    // === PENAMBAHAN: STORAGE MAPPING INTERFACE TERKUNCI PER ROUTER ===
    function getSavedRouterInterfaces() {
      try {
        return JSON.parse(localStorage.getItem('noc_router_interfaces') || '{}');
      } catch (_) {
        return {};
      }
    }

    function saveRouterInterface(routerId, ifaceName) {
      try {
        const mapping = getSavedRouterInterfaces();
        mapping[String(routerId)] = ifaceName;
        localStorage.setItem('noc_router_interfaces', JSON.stringify(mapping));
      } catch (_) {}
    }

    function getLockedInterfaceForRouter(routerId) {
      const mapping = getSavedRouterInterfaces();
      return mapping[String(routerId)] || '__ALL__';
    }
    // ================================================================
    let cycleTimer = null;
    let isAudioAlertEnabled = false;
    let previousTrafficSamples = {};
    let peakRxRate = 0;
    let peakTxRate = 0;
    let chartHistory = {
      labels: [],
      rx: [],
      tx: []
    };
    const MAX_CHART_POINTS = 30;

    // CENTER MODAL UTILITY
    let modalCallback = null;
    function showCenterModal({ title = 'Pemberitahuan', message = '', type = 'info', confirm = false, onConfirm = null }) {
      const modal = document.getElementById('nocCenterModal');
      const titleEl = document.getElementById('modalTitle');
      const msgEl = document.getElementById('modalMsg');
      const iconEl = document.getElementById('modalIcon');
      const actionsEl = document.getElementById('modalActions');

      titleEl.textContent = title;
      msgEl.textContent = message;
      modalCallback = onConfirm;

      if (type === 'error' || type === 'danger') {
        iconEl.innerHTML = '<i class="bi bi-exclamation-triangle-fill"></i>';
        iconEl.style.color = 'var(--rose)';
        iconEl.style.background = 'var(--rose-glow)';
      } else if (type === 'success') {
        iconEl.innerHTML = '<i class="bi bi-check-circle-fill"></i>';
        iconEl.style.color = 'var(--emerald)';
        iconEl.style.background = 'var(--emerald-glow)';
      } else {
        iconEl.innerHTML = '<i class="bi bi-info-circle-fill"></i>';
        iconEl.style.color = 'var(--cyan)';
        iconEl.style.background = 'var(--cyan-glow)';
      }

      if (confirm) {
        actionsEl.innerHTML = `
          <button type="button" class="btn-modal btn-modal-cancel" onclick="closeCenterModal(false)">Batal</button>
          <button type="button" class="btn-modal btn-modal-ok" onclick="closeCenterModal(true)">Ya, Lanjutkan</button>
        `;
      } else {
        actionsEl.innerHTML = `
          <button type="button" class="btn-modal btn-modal-ok" onclick="closeCenterModal(true)">Mengerti</button>
        `;
      }

      modal.classList.add('show');
    }

    function closeCenterModal(confirmed) {
      const modal = document.getElementById('nocCenterModal');
      modal.classList.remove('show');
      if (typeof modalCallback === 'function' && confirmed) {
        modalCallback();
      }
      modalCallback = null;
    }

    // TOGGLE TEMA DARK / LIGHT (SINKRON KE LOCALSTORAGE ADMIN)
    function toggleDisplayTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const nextTheme = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', nextTheme);
      localStorage.setItem('app-theme', nextTheme);
      updateThemeButtonUI(nextTheme);

      // Refresh warna grid dan teks Chart.js
      if (trafficChart) {
        const isLight = nextTheme === 'light';
        trafficChart.options.scales.x.grid.color = isLight ? 'rgba(15, 23, 42, 0.06)' : 'rgba(255, 255, 255, 0.05)';
        trafficChart.options.scales.x.ticks.color = isLight ? '#475569' : '#94a3b8';
        trafficChart.options.scales.y.grid.color = isLight ? 'rgba(15, 23, 42, 0.06)' : 'rgba(255, 255, 255, 0.05)';
        trafficChart.options.scales.y.ticks.color = isLight ? '#475569' : '#94a3b8';
        trafficChart.options.plugins.legend.labels.color = isLight ? '#334155' : '#94a3b8';
        trafficChart.update('none');
      }
    }

    function updateThemeButtonUI(theme) {
      const isLight = theme === 'light';
      const icon = document.getElementById('theme-btn-icon');
      const text = document.getElementById('theme-btn-text');
      if (icon) icon.className = isLight ? 'bi bi-sun-fill' : 'bi bi-moon-stars-fill';
      if (text) text.textContent = isLight ? 'Terang' : 'Gelap';
    }

    // Audio Alert Synthesizer
    let audioCtx = null;
    function playBeepAlert(freq = 660, duration = 0.25) {
      if (!isAudioAlertEnabled) return;
      try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + duration);
      } catch (_) {}
    }

    document.addEventListener('DOMContentLoaded', () => {
      const savedTheme = localStorage.getItem('app-theme') || 'dark';
      updateThemeButtonUI(savedTheme);

      // Kembalikan router terakhir yang dipilih pengguna jika ada
      const savedRouterId = localStorage.getItem('noc_selected_router_id');
      const routerSelect = document.getElementById('router-select');
      if (savedRouterId && routerSelect) {
        const optionExists = Array.from(routerSelect.options).some(o => o.value === savedRouterId);
        if (optionExists) {
          routerSelect.value = savedRouterId;
        }
      }

      // Ambil interface yang terkunci untuk router yang sedang aktif
      const currentRouterId = routerSelect ? routerSelect.value : 'settings_json';
      selectedInterface = getLockedInterfaceForRouter(currentRouterId);

      startClock();
      initChart();
      loadData();
      startPolling();
    });

    // Digital Clock
    function startClock() {
      const clockEl = document.getElementById('live-clock');
      const dateEl = document.getElementById('live-date');
      const days = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
      const months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];

      function tick() {
        const now = new Date();
        const h = String(now.getHours()).padStart(2, '0');
        const m = String(now.getMinutes()).padStart(2, '0');
        const s = String(now.getSeconds()).padStart(2, '0');
        clockEl.textContent = `${h}:${m}:${s} WIB`;

        const dayName = days[now.getDay()];
        const d = now.getDate();
        const monthName = months[now.getMonth()];
        const y = now.getFullYear();
        dateEl.textContent = `${dayName}, ${d} ${monthName} ${y}`;
      }
      tick();
      setInterval(tick, 1000);
    }

    // Init Chart dengan Skala Dinamis (Adaptive Scaling)
    function initChart() {
      const ctx = document.getElementById('traffic-live-chart').getContext('2d');
      const isLight = (document.documentElement.getAttribute('data-theme') === 'light');

      const rxGradient = ctx.createLinearGradient(0, 0, 0, 200);
      rxGradient.addColorStop(0, 'rgba(0, 242, 254, 0.25)');
      rxGradient.addColorStop(1, 'rgba(0, 242, 254, 0.00)');

      const txGradient = ctx.createLinearGradient(0, 0, 0, 200);
      txGradient.addColorStop(0, 'rgba(16, 185, 129, 0.25)');
      txGradient.addColorStop(1, 'rgba(16, 185, 129, 0.00)');

      trafficChart = new Chart(ctx, {
        type: 'line',
        data: {
          labels: [],
          datasets: [
            {
              label: 'Download (RX)',
              data: [],
              borderColor: '#00f2fe',
              backgroundColor: rxGradient,
              borderWidth: 2,
              fill: true,
              tension: 0.3,
              pointRadius: 0,
              pointHoverRadius: 4
            },
            {
              label: 'Upload (TX)',
              data: [],
              borderColor: '#10b981',
              backgroundColor: txGradient,
              borderWidth: 2,
              fill: true,
              tension: 0.3,
              pointRadius: 0,
              pointHoverRadius: 4
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: { duration: 250 },
          plugins: {
            legend: {
              position: 'top',
              align: 'end',
              labels: {
                color: isLight ? '#334155' : '#94a3b8',
                boxWidth: 10,
                font: { family: 'Inter', size: 10.5, weight: '600' }
              }
            },
            tooltip: {
              mode: 'index',
              intersect: false,
              callbacks: {
                label: function(ctx) {
                  return ` ${ctx.dataset.label}: ${ctx.parsed.y.toFixed(2)} Mbps`;
                }
              }
            }
          },
          scales: {
            x: {
              grid: { color: isLight ? 'rgba(15, 23, 42, 0.06)' : 'rgba(255, 255, 255, 0.05)' },
              ticks: { color: isLight ? '#475569' : '#94a3b8', font: { family: 'JetBrains Mono', size: 9.5 } }
            },
            y: {
              beginAtZero: true,
              grace: '10%', /* Memberi jarak nafas di atas garis tanpa membuat grafik tenggelam */
              grid: { color: isLight ? 'rgba(15, 23, 42, 0.06)' : 'rgba(255, 255, 255, 0.05)' },
              ticks: {
                color: isLight ? '#475569' : '#94a3b8',
                font: { family: 'JetBrains Mono', size: 9.5 },
                callback: function(v) { return v.toFixed(1) + ' M'; }
              }
            }
          }
        }
      });
    }

    function formatSpeed(bps) {
      if (bps >= 1000 * 1000 * 1000) return { val: (bps / 1e9).toFixed(2), unit: 'Gbps' };
      if (bps >= 1000 * 1000) return { val: (bps / 1e6).toFixed(2), unit: 'Mbps' };
      if (bps >= 1000) return { val: (bps / 1000).toFixed(1), unit: 'kbps' };
      return { val: bps.toFixed(0), unit: 'bps' };
    }

    function formatBytes(bytes) {
      if (!bytes || bytes === 0) return '0 B';
      const k = 1024;
      const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return (bytes / Math.pow(k, i)).toFixed(1) + ' ' + sizes[i];
    }

    function setGaugeArc(circleId, percent) {
      const el = document.getElementById(circleId);
      if (!el) return;
      const circumference = 251.2;
      const offset = circumference - (Math.min(100, Math.max(0, percent)) / 100) * circumference;
      el.style.strokeDashoffset = offset;
    }

    function startPolling() {
      if (pollInterval) clearInterval(pollInterval);
      pollInterval = setInterval(loadData, pollIntervalMs);
    }

    function updatePollInterval() {
      const select = document.getElementById('refresh-interval-select');
      pollIntervalMs = Number(select.value) || 2500;
      startPolling();
    }

    // Switch Router: Otomatis membaca & mengunci interface yang pernah dipilih untuk router ini
    function switchRouter() {
      const currentRouterId = document.getElementById('router-select').value;
      
      // Ambil interface yang tersimpan untuk router ini
      selectedInterface = getLockedInterfaceForRouter(currentRouterId);

      // Simpan router terakhir yang dipilih agar saat refresh tetap di router ini
      localStorage.setItem('noc_selected_router_id', currentRouterId);

      // Bersihkan dan tandai ulang dropdown interface agar dipaksa render ulang
      const selector = document.getElementById('interface-chart-selector');
      if (selector) {
        selector.removeAttribute('data-loaded-router-id');
        selector.innerHTML = '<option value="__ALL__">Semua Interface (Total)</option>';
      }

      // Bersihkan cache sampel trafik router sebelumnya agar tidak ada lonjakan nilai
      previousTrafficSamples = {};
      chartHistory = { labels: [], rx: [], tx: [] };
      peakRxRate = 0;
      peakTxRate = 0;
      if (trafficChart) {
        trafficChart.data.labels = [];
        trafficChart.data.datasets[0].data = [];
        trafficChart.data.datasets[1].data = [];
        trafficChart.update();
      }
      const overlay = document.getElementById('loading-overlay');
      if (overlay) {
        overlay.style.opacity = '1';
        overlay.style.pointerEvents = 'auto';
      }
      loadData();
    }
	
	// Switch Interface: Otomatis mengunci pilihan interface ke Router yang sedang aktif
    function switchChartInterface() {
      const currentRouterId = document.getElementById('router-select').value;
      selectedInterface = document.getElementById('interface-chart-selector').value;
      
      // KUNCI interface ini khusus untuk router yang aktif saat ini
      saveRouterInterface(currentRouterId, selectedInterface);

      chartHistory = { labels: [], rx: [], tx: [] };
      if (trafficChart) {
        trafficChart.data.labels = [];
        trafficChart.data.datasets[0].data = [];
        trafficChart.data.datasets[1].data = [];
        trafficChart.update();
      }
    }

    function toggleAutoCycle() {
      isAutoCycleEnabled = !isAutoCycleEnabled;
      const btn = document.getElementById('cycle-toggle-btn');
      const text = document.getElementById('cycle-btn-text');
      if (isAutoCycleEnabled) {
        btn.classList.add('active');
        text.textContent = 'Rotasi: ON';
        cycleTimer = setInterval(() => {
          const select = document.getElementById('router-select');
          let nextIndex = select.selectedIndex + 1;
          if (nextIndex >= select.options.length) nextIndex = 0;
          select.selectedIndex = nextIndex;
          switchRouter();
        }, 20000);
      } else {
        btn.classList.remove('active');
        text.textContent = 'Rotasi: OFF';
        if (cycleTimer) clearInterval(cycleTimer);
      }
    }

    function toggleAudioAlert() {
      isAudioAlertEnabled = !isAudioAlertEnabled;
      const btn = document.getElementById('audio-toggle-btn');
      const icon = document.getElementById('audio-btn-icon');
      const text = document.getElementById('audio-btn-text');
      if (isAudioAlertEnabled) {
        btn.classList.add('active');
        icon.className = 'bi bi-volume-up';
        text.textContent = 'Audio: ON';
        playBeepAlert(880, 0.15);
      } else {
        btn.classList.remove('active');
        icon.className = 'bi bi-volume-mute';
        text.textContent = 'Audio';
      }
    }

    function toggleFullscreen() {
      const icon = document.getElementById('fs-icon');
      const text = document.getElementById('fs-text');
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().then(() => {
          icon.className = 'bi bi-fullscreen-exit';
          text.textContent = 'Exit Screen';
        }).catch(err => console.error(err));
      } else {
        document.exitFullscreen().then(() => {
          icon.className = 'bi bi-fullscreen';
          text.textContent = 'Fullscreen';
        });
      }
    }

    // MAIN TELEMETRY LOADER
    async function loadData() {
      const routerId = document.getElementById('router-select').value;
      const now = Date.now();

      try {
        const url = `/api/noc/data?routerId=${encodeURIComponent(routerId)}`;
        const res = await fetch(url);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();

        // Sembunyikan overlay
        const overlay = document.getElementById('loading-overlay');
        overlay.style.opacity = '0';
        overlay.style.pointerEvents = 'none';

        // Update Pulse status
        document.getElementById('header-pulse-text').textContent = data.warning ? 'DEGRADED' : 'OPERATIONAL';
        document.getElementById('header-pulse').style.color = data.warning ? 'var(--amber)' : 'var(--emerald)';

        // 1. Hardware Vitals
        const r = data.router || {};
        document.getElementById('board-model-badge').innerHTML = `<i class="bi bi-hdd-network"></i> ${r.boardName || 'MikroTik'} (${r.version || ''})`;
        document.getElementById('vital-board-name').textContent = r.boardName || '-';
        document.getElementById('vital-version').textContent = r.version || '-';
        document.getElementById('vital-cpu-freq').textContent = `${r.cpuFrequency || '-'} MHz (${r.cpuCount || 1} Cores)`;
        document.getElementById('router-uptime-badge').textContent = `Up: ${r.uptime || '-'}`;

        // 1. UPDATE SUHU & VOLTASE MIKROTIK (ROS v6 & ROS v7 RB5009 / hEX)
        const tempValEl = document.getElementById('kpi-temp-val');
        const tempUnitEl = document.getElementById('kpi-temp-unit');
        const voltSepEl = document.getElementById('kpi-volt-separator');
        const voltValEl = document.getElementById('kpi-volt-val');
        const voltUnitEl = document.getElementById('kpi-volt-unit');
        const vitalTempEl = document.getElementById('vital-temp');
        const vitalVoltEl = document.getElementById('vital-voltage');

        if (r.temperature !== null && r.temperature !== undefined) {
          if (tempValEl) {
            tempValEl.textContent = r.temperature;
            if (r.temperature >= 60) tempValEl.style.color = 'var(--rose)';
            else if (r.temperature >= 50) tempValEl.style.color = 'var(--amber)';
            else tempValEl.style.color = 'inherit';
          }
          if (tempUnitEl) { tempUnitEl.textContent = '°C'; tempUnitEl.style.display = 'inline'; }
          if (voltSepEl) voltSepEl.style.display = 'inline';
          
          // Pastikan nilai voltase terpasang dengan rapi
          const displayVolt = (r.voltage !== null && r.voltage !== undefined && r.voltage !== '') ? r.voltage : '24.0';
          if (voltValEl) {
            voltValEl.textContent = displayVolt;
            voltValEl.style.display = 'inline';
            voltValEl.style.fontSize = '20px';
          }
          if (voltUnitEl) { voltUnitEl.textContent = 'V'; voltUnitEl.style.display = 'inline'; }
          if (vitalTempEl) vitalTempEl.textContent = `${r.temperature} °C`;
          if (vitalVoltEl) vitalVoltEl.textContent = `${displayVolt} V`;
        } else {
          // Fallback router tanpa sensor suhu (misal seri hEX)
          if (tempValEl) tempValEl.textContent = `${r.cpuCount || 4}x`;
          if (tempUnitEl) { tempUnitEl.textContent = `${r.cpuFrequency || 880}MHz`; tempUnitEl.style.display = 'inline'; }
          if (voltSepEl) voltSepEl.style.display = 'inline';
          if (voltValEl) {
            voltValEl.textContent = (r.architecture && r.architecture !== '-') ? r.architecture : 'MMIPS';
            voltValEl.style.fontSize = '14px';
            voltValEl.style.display = 'inline';
          }
          if (voltUnitEl) voltUnitEl.style.display = 'none';
          if (vitalTempEl) vitalTempEl.textContent = '-';
          if (vitalVoltEl) vitalVoltEl.textContent = '-';
        }

        // CPU Radial
        const cpuVal = Math.round(r.cpuLoad || 0);
        document.getElementById('cpu-gauge-num').textContent = `${cpuVal}%`;
        document.getElementById('cpu-detail-text').textContent = `${r.cpuCount || 1} Cores @ ${r.cpuFrequency || 0}MHz`;
        setGaugeArc('cpu-gauge-bar', cpuVal);

        // Memory Radial
        const memPercent = Math.round(r.memoryPercent || 0);
        const freeMb = Math.round((r.freeMemory || 0) / (1024 * 1024));
        const totalMb = Math.round((r.totalMemory || 0) / (1024 * 1024));
        document.getElementById('mem-gauge-num').textContent = `${memPercent}%`;
        document.getElementById('mem-detail-text').textContent = `${freeMb} MB / ${totalMb} MB`;
        setGaugeArc('mem-gauge-bar', memPercent);

        // Storage / Disk
        const hddPercent = Math.round(r.hddPercent || 0);
        const freeHddMb = Math.round((r.freeHdd || 0) / (1024 * 1024));
        const totalHddMb = Math.round((r.totalHdd || 0) / (1024 * 1024));
        document.getElementById('hdd-percent-text').textContent = `${hddPercent}%`;
        document.getElementById('hdd-fill').style.width = `${hddPercent}%`;
        document.getElementById('hdd-free-val').textContent = `Free: ${freeHddMb} MB`;
        document.getElementById('hdd-total-val').textContent = `Total: ${totalHddMb} MB`;

        // Host Server Info
        if (data.server) {
          document.getElementById('vital-node-ver').textContent = data.server.nodeVersion || '-';
          document.getElementById('vital-server-ram').textContent = `${data.server.hostMemoryUsedMb || '-'} / ${data.server.hostMemoryTotalMb || '-'} MB (${data.server.hostMemPercent || 0}%)`;
        }

        // 2. Interfaces & Speed Calculations
        const ifaces = data.interfaces || [];
        document.getElementById('iface-count-badge').textContent = `${ifaces.length} Interfaces`;

        // Sinkronisasi & Kunci Dropdown Interface (Pasti update saat ganti router)
        const selector = document.getElementById('interface-chart-selector');
        if (selector) {
          const currentLoadedRouter = selector.getAttribute('data-loaded-router-id');

          // Jika router berubah atau dropdown belum pernah diisi untuk router ini
          if (currentLoadedRouter !== String(routerId)) {
            selector.innerHTML = '<option value="__ALL__">Semua Interface (Total)</option>';

            ifaces.forEach(i => {
              const opt = document.createElement('option');
              opt.value = i.name;
              opt.textContent = `${i.name} (${i.type})`;
              selector.appendChild(opt);
            });

            // Tandai bahwa dropdown ini sekarang berisi interface milik routerId ini
            selector.setAttribute('data-loaded-router-id', String(routerId));

            // Ambil nama interface yang pernah dikunci untuk router ini
            const lockedIface = getLockedInterfaceForRouter(routerId);
            selectedInterface = lockedIface;

            const exists = Array.from(selector.options).some(o => o.value === lockedIface);
            if (exists) {
              selector.value = lockedIface;
            } else {
              selector.value = '__ALL__';
              selectedInterface = '__ALL__';
            }
          }
        }

        let totalCurrentRxBps = 0;
        let totalCurrentTxBps = 0;
        let selectedIfaceRxBps = 0;
        let selectedIfaceTxBps = 0;

        const tableBody = document.getElementById('interfaces-tbody');
        let tableRowsHtml = '';

        ifaces.forEach(i => {
          const prev = previousTrafficSamples[i.name];
          let rxSpeedBps = 0;
          let txSpeedBps = 0;

          if (prev && prev.time < now) {
            const deltaSec = (now - prev.time) / 1000;
            if (deltaSec > 0.4 && deltaSec < 20) {
              const deltaRx = i.bytesIn >= prev.bytesIn ? (i.bytesIn - prev.bytesIn) : 0;
              const deltaTx = i.bytesOut >= prev.bytesOut ? (i.bytesOut - prev.bytesOut) : 0;
              rxSpeedBps = Math.min((deltaRx * 8) / deltaSec, 1000 * 1000 * 1000); // Batas maksimum 1 Gbps
              txSpeedBps = Math.min((deltaTx * 8) / deltaSec, 1000 * 1000 * 1000);
            }
          }

          previousTrafficSamples[i.name] = {
            bytesIn: i.bytesIn,
            bytesOut: i.bytesOut,
            running: i.running,
            time: now
          };

          if (prev && prev.running && !i.running && !i.disabled) {
            playBeepAlert(440, 0.4);
          }

          if (i.running && !i.disabled && !i.isDynamic) {
            totalCurrentRxBps += rxSpeedBps;
            totalCurrentTxBps += txSpeedBps;
          }

          if (selectedInterface === i.name) {
            selectedIfaceRxBps = rxSpeedBps;
            selectedIfaceTxBps = txSpeedBps;
          }

          const rxFormatted = formatSpeed(rxSpeedBps);
          const txFormatted = formatSpeed(txSpeedBps);
          const totalAccumulated = formatBytes(i.bytesIn + i.bytesOut);

          tableRowsHtml += `
            <tr>
              <td>
                <div class="iface-name-col">
                  <span class="link-led ${i.running ? 'up' : 'down'}" title="${i.running ? 'Link UP' : 'Link DOWN'}"></span>
                  <span>${i.name}</span>
                  ${i.comment ? `<span style="font-size:10px;color:var(--text-dim)">[${i.comment}]</span>` : ''}
                </div>
              </td>
              <td><span class="badge-pill">${i.type}</span></td>
              <td>
                <span style="font-size:10px;font-weight:700;color:${i.running ? 'var(--emerald)' : 'var(--rose)'}">
                  ${i.running ? 'RUNNING' : (i.disabled ? 'DISABLED' : 'DOWN')}
                </span>
              </td>
              <td style="text-align:right">
                <span class="rate-pill rx">↓ ${rxFormatted.val} ${rxFormatted.unit}</span>
              </td>
              <td style="text-align:right">
                <span class="rate-pill tx">↑ ${txFormatted.val} ${txFormatted.unit}</span>
              </td>
              <td style="text-align:right;font-family:'JetBrains Mono';font-size:10.5px;color:var(--text-muted)">
                ${totalAccumulated}
              </td>
            </tr>
          `;
        });

        tableBody.innerHTML = tableRowsHtml;

        // Chart & KPI
        const chartRxBps = selectedInterface === '__ALL__' ? totalCurrentRxBps : selectedIfaceRxBps;
        const chartTxBps = selectedInterface === '__ALL__' ? totalCurrentTxBps : selectedIfaceTxBps;

        const rxFormattedTotal = formatSpeed(chartRxBps);
        const txFormattedTotal = formatSpeed(chartTxBps);
        const combinedBps = chartRxBps + chartTxBps;
        const combinedFormatted = formatSpeed(combinedBps);

        document.getElementById('kpi-rx-val').textContent = rxFormattedTotal.val;
        document.getElementById('kpi-rx-unit').textContent = rxFormattedTotal.unit;
        document.getElementById('kpi-tx-val').textContent = txFormattedTotal.val;
        document.getElementById('kpi-tx-unit').textContent = txFormattedTotal.unit;
        document.getElementById('kpi-total-bandwidth').innerHTML = `<i class="bi bi-activity"></i> Total: ${combinedFormatted.val} ${combinedFormatted.unit}`;
        document.getElementById('kpi-rx-interface').innerHTML = `<i class="bi bi-hdd-network"></i> ${selectedInterface === '__ALL__' ? 'All Interfaces' : selectedInterface}`;

        const currentRxMbps = chartRxBps / 1e6;
        const currentTxMbps = chartTxBps / 1e6;
        if (currentRxMbps > peakRxRate) peakRxRate = currentRxMbps;
        if (currentTxMbps > peakTxRate) peakTxRate = currentTxMbps;
        document.getElementById('kpi-rx-peak').textContent = `Peak: ${peakRxRate.toFixed(1)} Mbps`;
        document.getElementById('kpi-tx-peak').textContent = `Peak: ${peakTxRate.toFixed(1)} Mbps`;

        // Update Chart
        const timeLabel = new Date().toTimeString().slice(3, 8);
        chartHistory.labels.push(timeLabel);
        chartHistory.rx.push(Number(currentRxMbps.toFixed(2)));
        chartHistory.tx.push(Number(currentTxMbps.toFixed(2)));

        if (chartHistory.labels.length > MAX_CHART_POINTS) {
          chartHistory.labels.shift();
          chartHistory.rx.shift();
          chartHistory.tx.shift();
        }

        // Skala chart adaptif: mengikuti data yang sedang aktif di layar
        const currentActiveMax = Math.max(...chartHistory.rx, ...chartHistory.tx, 1);
        document.getElementById('chart-max-rate').textContent = `Max: ${currentActiveMax.toFixed(1)} Mbps`;

        if (trafficChart) {
          trafficChart.data.labels = chartHistory.labels;
          trafficChart.data.datasets[0].data = chartHistory.rx;
          trafficChart.data.datasets[1].data = chartHistory.tx;
          trafficChart.update('none');
        }

        // 3. Subscribers & Infrastructure
        const cl = data.clients || {};
        const pppoe = cl.pppoe || {};
        const hotspot = cl.hotspot || {};
        const acs = data.acs || {};
        const billing = cl.billing || {};

        // Top KPI
        document.getElementById('kpi-pppoe-online').textContent = pppoe.active || 0;
        document.getElementById('kpi-pppoe-total').textContent = `/ ${pppoe.total || 0} Total (All PPPoE)`;
        document.getElementById('kpi-pppoe-offline').innerHTML = `<i class="bi bi-circle-fill" style="color:${(pppoe.offline || 0) > 0 ? 'var(--rose)' : 'var(--text-dim)'};font-size:7px"></i> ${pppoe.offline || 0} Offline`;
        document.getElementById('kpi-pppoe-ratio').textContent = `${pppoe.activePercent || 0}% Active`;

        document.getElementById('kpi-hotspot-active').textContent = hotspot.active || 0;
        document.getElementById('kpi-hotspot-total').textContent = `/ ${hotspot.total || 0} Vouchers`;

        // 2. UPDATE TR-069 & FIBER OPTIC (DENGAN NULL-SAFETY GUARD)
        const totalOnt = Number(acs?.total || 0);
        const onlineOnt = Number(acs?.online || 0);
        const criticalOnt = Number(acs?.critical || 0);

        const ontSummaryEl = document.getElementById('kpi-ont-summary');
        if (ontSummaryEl) {
          ontSummaryEl.innerHTML = `<i class="bi bi-modem"></i> ONT: ${onlineOnt} Online`;
        }

        const opticalBadge = document.getElementById('kpi-optical-alert');
        if (opticalBadge) {
          if (criticalOnt > 0) {
            opticalBadge.textContent = `${criticalOnt} Kritis!`;
            opticalBadge.style.color = 'var(--rose)';
          } else if (onlineOnt > 0) {
            opticalBadge.textContent = 'Fiber OK';
            opticalBadge.style.color = 'var(--emerald)';
          } else {
            opticalBadge.textContent = 'Standby';
            opticalBadge.style.color = 'var(--text-muted)';
          }
        }

        // PPPoE Ratio Box
        const pppoeRatioEl = document.getElementById('pppoe-ratio-num');
        const pppoeBarFill = document.getElementById('pppoe-bar-fill');
        const pppoeBarOnline = document.getElementById('pppoe-bar-online');
        const pppoeBarOffline = document.getElementById('pppoe-bar-offline');
        if (pppoeRatioEl) pppoeRatioEl.textContent = `${pppoe.activePercent || 0}%`;
        if (pppoeBarFill) pppoeBarFill.style.width = `${pppoe.activePercent || 0}%`;
        if (pppoeBarOnline) pppoeBarOnline.textContent = `Online: ${pppoe.active || 0}`;
        if (pppoeBarOffline) pppoeBarOffline.textContent = `Offline: ${pppoe.offline || 0}`;

        // Hotspot Ratio Box
        const hotspotPercent = (hotspot.total > 0) ? Math.round(((hotspot.active || 0) / hotspot.total) * 100) : 0;
        const hotspotRatioEl = document.getElementById('hotspot-ratio-num');
        const hotspotBarFill = document.getElementById('hotspot-bar-fill');
        const hotspotBarActive = document.getElementById('hotspot-bar-active');
        const hotspotBarTotal = document.getElementById('hotspot-bar-total');
        if (hotspotRatioEl) hotspotRatioEl.textContent = `${hotspotPercent}%`;
        if (hotspotBarFill) hotspotBarFill.style.width = `${hotspotPercent}%`;
        if (hotspotBarActive) hotspotBarActive.textContent = `Active: ${hotspot.active || 0}`;
        if (hotspotBarTotal) hotspotBarTotal.textContent = `${hotspot.routerName || 'Hotspot'}: ${hotspot.total || 0}`;

        // Progress Bar Kanan: TR-069 Fiber Modems
        const ontPercent = totalOnt > 0 ? Math.round((onlineOnt / totalOnt) * 100) : 0;
        const ontRatioNum = document.getElementById('ont-ratio-num');
        const ontBarFill = document.getElementById('ont-bar-fill');
        const ontBarOnline = document.getElementById('ont-bar-online');
        const ontBarCritical = document.getElementById('ont-bar-critical');
        if (ontRatioNum) ontRatioNum.textContent = `${ontPercent}%`;
        if (ontBarFill) ontBarFill.style.width = `${ontPercent}%`;
        if (ontBarOnline) ontBarOnline.textContent = `Online: ${onlineOnt} / ${totalOnt}`;
        if (ontBarCritical) ontBarCritical.textContent = `Kritis: ${criticalOnt}`;

        document.getElementById('cust-active-val').textContent = `${billing.active || 0} Pelanggan`;
        document.getElementById('cust-suspended-val').textContent = `${billing.suspended || 0} Pelanggan`;
        document.getElementById('client-total-badge').textContent = `${(pppoe.active || 0) + (hotspot.active || 0)} Sesi Aktif`;
        document.getElementById('sec-blocked-val').textContent = `${data.security ? (data.security.blockedCount || 0) : 0} Kali`;

      } catch (err) {
        console.error('NOC Load Error:', err);
        const headerPulseText = document.getElementById('header-pulse-text');
        const headerPulse = document.getElementById('header-pulse');
        if (headerPulseText) headerPulseText.textContent = 'DISCONNECTED';
        if (headerPulse) headerPulse.style.color = 'var(--rose)';

        // PASTIKAN OVERLAY LOADING LANGSUNG HILANG
        const overlay = document.getElementById('loading-overlay');
        if (overlay) {
          overlay.style.opacity = '0';
          overlay.style.pointerEvents = 'none';
        }
      }
    }
  </script>
</body>
</html>