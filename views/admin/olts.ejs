        <button type="button" class="btn btn-g" onclick="closeModal('editOltModal')"><%= t('common.cancel', 'Batal') %></button>
        <button type="submit" class="btn btn-p">Update Perangkat</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Detail Perangkat & Trafik ONU (Realtime MikroTik & Optik) -->
<div class="mo" id="onuDetailModal">
  <div class="mb" style="max-width: 650px;">
    <div class="mh" style="display:flex;justify-content:space-between;align-items:center;">
      <span class="mt" style="font-size:15px; font-weight:700;">
        <i class="bi bi-hdd-network text-primary"></i> Detail Perangkat ONU
      </span>
      <button type="button" class="mc" onclick="closeOnuDetailModal()">&times;</button>
    </div>
    <div class="mbody" style="padding:20px;">
      <div id="onu-detail-loading" style="text-align:center; padding:30px; display:none;">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="text-muted small mt-2">Mengambil data perangkat & trafik live...</p>
      </div>

      <div id="onu-detail-content">
        <!-- Header Info -->
        <div style="padding:14px; border-radius:10px; margin-bottom:16px; display:flex; justify-content:space-between; align-items:center; border:1px solid #e2e8f0;">
          <!-- ============================================================================ -->
          <!-- >>> AWAL PERUBAHAN HTML: Tambahan baris tampilan MAC Address Pelanggan <<< -->
          <!-- ============================================================================ -->
          <div>
            <h5 id="det-onu-name" style="margin:0; font-weight:700;">-</h5>
            <span id="det-onu-sn" style="font-family:monospace; font-size:12px; color:#64748b; display:block;">-</span>
            <span style="font-family:monospace; font-size:11px; color:#0284c7; font-weight:700; display:block; margin-top:2px;">MAC: <span id="det-onu-mac">-</span></span>
            <span style="font-family:monospace; font-size:11px; color:#10b981; font-weight:700; display:block; margin-top:2px;">User: <span id="det-onu-username">-</span></span>
          </div>
          <!-- ============================================================================ -->
          <!-- >>> AKHIR PERUBAHAN HTML <<< -->
          <!-- ============================================================================ -->
          <span id="det-onu-status" class="status-pill-v2 pill-online">Online</span>
        </div>

        <!-- KOTAK BERDAMPINGAN: LIVE THROUGHPUT (KIRI) & TOTAL PEMAKAIAN (KANAN) -->
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
          
          <!-- KOTAK KIRI: LIVE THROUGHPUT TRAFIK (MIKROTIK) -->
          <div style="border:1px solid #bfdbfe; border-radius:10px; padding:10px; background:rgba(59,130,246,0.02);">
            <div style="font-size:10px; font-weight:700; text-transform:uppercase; color:#2563eb; margin-bottom:6px; display:flex; align-items:center; gap:4px;">
              <i class="bi bi-activity"></i> Live Throughput
            </div>
            <div style="display:flex; flex-direction:column; gap:6px; text-align:center;">
              <div style="padding:6px; border-radius:6px; border:1px solid #e2e8f0; background:#fff;">
                <div style="font-size:9px; color:#16a34a; font-weight:700;"><i class="bi bi-arrow-down"></i> DOWNLOAD / RX</div>
                <strong id="det-traffic-rx" style="font-size:12px; font-weight:800; color:#1e293b;">0 bps</strong>
              </div>
              <div style="padding:6px; border-radius:6px; border:1px solid #e2e8f0; background:#fff;">
                <div style="font-size:9px; color:#2563eb; font-weight:700;"><i class="bi bi-arrow-up"></i> UPLOAD / TX</div>
                <strong id="det-traffic-tx" style="font-size:12px; font-weight:800; color:#1e293b;">0 bps</strong>
              </div>
            </div>
          </div>

          <!-- KOTAK KANAN: TOTAL AKUMULASI PEMAKAIAN -->
          <div style="border:1px solid #cbd5e1; border-radius:10px; padding:10px; background:#f8fafc;">
            <div style="font-size:10px; font-weight:700; text-transform:uppercase; color:#64748b; margin-bottom:6px; display:flex; align-items:center; gap:4px;">
              <i class="bi bi-pie-chart"></i> Total Pemakaian
            </div>
            <div style="display:flex; flex-direction:column; gap:6px; text-align:center;">
              <div style="padding:6px; border-radius:6px; border:1px solid #cbd5e1; background:#fff;">
                <div style="font-size:9px; color:#0284c7; font-weight:700;"><i class="bi bi-download"></i> TOTAL RX</div>
                <strong id="det-total-rx" style="font-size:12px; font-weight:800; color:#1e293b;">-</strong>
              </div>
              <div style="padding:6px; border-radius:6px; border:1px solid #cbd5e1; background:#fff;">
                <div style="font-size:9px; color:#db2777; font-weight:700;"><i class="bi bi-upload"></i> TOTAL TX</div>
                <strong id="det-total-tx" style="font-size:12px; font-weight:800; color:#1e293b;">-</strong>
              </div>
            </div>
          </div>

        </div>
        
        <!-- Info Total Kuota di bawahnya -->
        <div style="font-size:11px; color:#64748b; margin-bottom:16px; text-align:center; background:#f1f5f9; padding:6px; border-radius:6px;">
          Total Kuota Terpakai (FUP): <strong id="det-total-fup" style="color:#1e293b;">-</strong>
        </div>

        <!-- Spesifikasi Optik & Jarak -->
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(130px, 1fr)); gap:10px; margin-bottom:16px;">
          <div style="border:1px solid #e2e8f0; border-radius:8px; padding:10px;">
            <div style="font-size:10px; color:#64748b; font-weight:700;">RX OPTICAL</div>
            <strong id="det-onu-rx" style="color:#059669; font-size:13px;">-</strong>
          </div>
          <div style="border:1px solid #e2e8f0; border-radius:8px; padding:10px;">
            <div style="font-size:10px; color:#64748b; font-weight:700;">TX OPTICAL</div>
            <strong id="det-onu-tx" style="color:#0284c7; font-size:13px;">-</strong>
          </div>
          <div style="border:1px solid #e2e8f0; border-radius:8px; padding:10px;">
            <div style="font-size:10px; color:#64748b; font-weight:700;">ESTIMASI JARAK</div>
            <strong id="det-onu-dist" style="font-size:13px;">-</strong>
          </div>
          <div style="border:1px solid #e2e8f0; border-radius:8px; padding:10px;">
            <div style="font-size:10px; color:#64748b; font-weight:700;">SUHU MODEM</div>
            <strong id="det-onu-temp" style="font-size:13px;">-</strong>
          </div>
        </div>

        <!-- Informasi Pelanggan Terkait -->
        <div id="det-cust-box" style="border:1px dashed #cbd5e1; border-radius:10px; padding:12px; font-size:12px;">
          <div style="font-weight:700; margin-bottom:6px;"><i class="bi bi-person-badge"></i> Data Pelanggan Terhubung:</div>
          <div id="det-cust-info" class="text-muted">Mencari data billing...</div>
        </div>
      </div>
    </div>
    <!-- >>> [AWAL PERUBAHAN]: Menambahkan tombol Aksi Cepat di Footer Modal <<< -->
    <div class="mf" style="display:flex; justify-content:space-between; align-items:center;">
      <div>
        <button type="button" class="btn btn-sm btn-outline-primary" id="btn-goto-customer" style="display:none;" onclick="goToCustomerDetail()">
          <i class="bi bi-person-lines-fill me-1"></i> Detail Pelanggan
        </button>
      </div>
      <div class="d-flex gap-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="refreshCurrentOnuDetail()">
          <i class="bi bi-arrow-clockwise me-1"></i> Refresh Data Perangkat
        </button>
        <button type="button" class="btn btn-g btn-sm" onclick="closeOnuDetailModal()">Tutup</button>
      </div>
    </div>
    <!-- >>> [AKHIR PERUBAHAN] <<< -->
  </div>
</div>

<div id="olt-data-store" data-olts='<%- JSON.stringify(olts || []) %>' style="display:none;"></div>

<script>
// ============================================================================
// >>> [BLOK UTAMA SCRIPT OLT YANG DISEMPURNAKAN DAN AMAN] <<<
// ============================================================================

let currentDetailTimer = null;
let currentModalOltId = null;
let currentModalIndex = null;
let currentModalName = null;
let activeLinkedCustomerId = null;

async function showOnuDetailModal(oltId, index, name) {
  currentModalOltId = oltId;
  currentModalIndex = index;
  currentModalName = name;
  
  openModal('onuDetailModal');
  document.getElementById('onu-detail-loading').style.display = 'block';
  document.getElementById('onu-detail-content').style.display = 'none';
  const btnGoto = document.getElementById('btn-goto-customer');
  if (btnGoto) btnGoto.style.display = 'none';

  let linkedCustomerId = null;

  async function loadDetail() {
    try {
      const res = await fetch(`/admin/olts/${encodeURIComponent(oltId)}/onu/${encodeURIComponent(index)}/detail`);
      const result = await res.json();
      if (!result.success) return;

      // ============================================================================
      // >>> AWAL PERUBAHAN: AMBIL MAC DARI DATA PELANGGAN / MIKROTIK (AMAN) <<<
      // ============================================================================
      const d = result.data;
      document.getElementById('det-onu-name').innerText = d.name || name || '-';
      document.getElementById('det-onu-sn').innerText = 'SN: ' + (d.sn || '-');
      
      // Ambil MAC dari data billing pelanggan atau session
      const resolvedMac = (d.customer && d.customer.mac_address && d.customer.mac_address !== '-') 
        ? d.customer.mac_address 
        : '-';
      document.getElementById('det-onu-mac').innerText = 'MAC: ' + resolvedMac;
      // ============================================================================
      // >>> AKHIR PERUBAHAN <<<
      // ============================================================================
      document.getElementById('det-onu-rx').innerText = d.rx || '-';
      document.getElementById('det-onu-tx').innerText = d.tx || '-';
      document.getElementById('det-onu-dist').innerText = d.distance || '-';
      document.getElementById('det-onu-temp').innerText = d.temp || '-';

      const st = document.getElementById('det-onu-status');
      st.className = `status-pill-v2 ${d.status === 'Online' ? 'pill-online' : 'pill-offline'}`;
      st.innerText = d.status;

      if (d.customer) {
        linkedCustomerId = d.customer.id;
        activeLinkedCustomerId = d.customer.id;
        if (btnGoto) btnGoto.style.display = 'inline-block';
        
        // >>> AMBIL MAC & USERNAME DARI DATA PELANGGAN / SESI MIKROTIK <<<
        const resolvedMac = (d.customer.mac_address && d.customer.mac_address !== '-') ? d.customer.mac_address : (d.mac_address || '-');
        const resolvedUser = d.customer.pppoe_username || '-';

        document.getElementById('det-onu-mac').innerText = resolvedMac;
        document.getElementById('det-onu-username').innerText = resolvedUser;
        // -----------------------------------------------------------------

        const totalRxBytes = Number(d.customer.bytes_out || 0);
        const totalTxBytes = Number(d.customer.bytes_in || 0);
        const totalSumBytes = totalRxBytes + totalTxBytes;
        
        document.getElementById('det-total-rx').innerText = formatBytesVal(totalRxBytes);
        document.getElementById('det-total-tx').innerText = formatBytesVal(totalTxBytes);
        
        const limitGB = d.customer.fup_limit_gb || 0;
        const useFup = d.customer.use_fup === 1;
        document.getElementById('det-total-fup').innerText = formatBytesVal(totalSumBytes) + (useFup && limitGB > 0 ? ` (Limit FUP: ${limitGB} GB)` : ' (Unlimited)');
        document.getElementById('det-cust-info').innerHTML = `
          <div style="line-height:1.6;">
            <strong>Nama Pelanggan:</strong> <span style="font-weight:700;">${d.customer.name}</span><br>
            <strong>Username PPPoE:</strong> <code style="color:#2563eb;font-weight:700;">${resolvedUser}</code><br>
            <strong>No. WhatsApp:</strong> ${d.customer.phone || '-'}<br>
            <strong>Alamat:</strong> ${d.customer.address || '-'}
          </div>
        `;
      } else {
        linkedCustomerId = null;
        activeLinkedCustomerId = null;
        if (btnGoto) btnGoto.style.display = 'none';

        // Jika belum terhubung ke pelanggan
        document.getElementById('det-onu-mac').innerText = d.mac_address || '-';
        document.getElementById('det-onu-username').innerText = '-';

        document.getElementById('det-total-rx').innerText = '-';
        document.getElementById('det-total-tx').innerText = '-';
        document.getElementById('det-total-fup').innerText = '-';
        document.getElementById('det-cust-info').innerHTML = `
          <span class="text-muted">Modem ini belum ditautkan ke akun pelanggan di menu Data Pelanggan.</span>
        `;
      }

      document.getElementById('onu-detail-loading').style.display = 'none';
      document.getElementById('onu-detail-content').style.display = 'block';
    } catch (err) {}
  }

  async function pollCustomerLiveTraffic() {
    if (!linkedCustomerId) return;
    try {
      const tRes = await fetch(`/admin/api/customers/${linkedCustomerId}/pppoe-traffic`);
      if (tRes.ok) {
        const tData = await tRes.json();
        if (tData.ok && tData.online) {
          const downloadBps = Math.round((tData.txMbps || 0) * 1000000 / 8);
          const uploadBps = Math.round((tData.rxMbps || 0) * 1000000 / 8);

          document.getElementById('det-traffic-rx').innerText = formatBytes(downloadBps);
          document.getElementById('det-traffic-tx').innerText = formatBytes(uploadBps);
        } else {
          document.getElementById('det-traffic-rx').innerText = '0 bps (Idle)';
          document.getElementById('det-traffic-tx').innerText = '0 bps (Idle)';
        }
      }
    } catch (e) {}
  }

  await loadDetail();
  await pollCustomerLiveTraffic();

  if (currentDetailTimer) clearInterval(currentDetailTimer);
  currentDetailTimer = setInterval(pollCustomerLiveTraffic, 1500);
}

function closeOnuDetailModal() {
  if (currentDetailTimer) clearInterval(currentDetailTimer);
  closeModal('onuDetailModal');
}

// Fungsi pembantu untuk format byte ke MB, GB, TB di modal detail
function formatBytesVal(b) {
  const num = Number(b) || 0;
  if (num <= 0) return '0 B';
  const k = 1024;
  const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
  const i = Math.floor(Math.log(num) / Math.log(k));
  return (num / Math.pow(k, i)).toFixed(2) + ' ' + sizes[i];
}

// Fungsi tombol menuju halaman detail pelanggan (Langsung navigasi di halaman yang sama)
// Fungsi tombol menuju halaman detail pelanggan (Membawa ID & otomatis buka modal detail)
function goToCustomerDetail() {
  if (activeLinkedCustomerId) {
    // Mengarahkan ke halaman Data Pelanggan dengan parameter open_detail_id
    window.location.href = `/admin/customers?open_detail_id=${activeLinkedCustomerId}`;
  }
}

// Fungsi tombol refresh data perangkat khusus di modal detail
async function refreshCurrentOnuDetail() {
  if (!currentModalOltId || !currentModalIndex) return;
  document.getElementById('onu-detail-loading').style.display = 'block';
  document.getElementById('onu-detail-content').style.display = 'none';
  await showOnuDetailModal(currentModalOltId, currentModalIndex, currentModalName);
}

const I18N = {
  lang: "<%= lang || 'id' %>",
  confirmDeleteOlt: "<%= t('admin.olts.confirm_delete', 'Hapus OLT ini?') %>",
  serverConnectFailed: "<%= t('admin.olts.errors.server_connect_failed', 'Gagal menghubungi server') %>",
  noOnuData: "<%= t('admin.olts.empty_no_onu', 'Tidak ada data ONU ditemukan.') %>",
  tryAgain: "<%= t('admin.olts.actions.try_again', 'Coba Lagi') %>",
  renamePrompt: "<%= t('admin.olts.actions.rename_prompt', 'Masukkan nama baru untuk ONU:') %>",
  renameTitle: "Ubah Nama",
  rebootTitle: "Reboot ONU",
  confirmReboot: "Yakin ingin reboot ONU ini?",
  rebootSent: "Perintah reboot berhasil dikirim via MIB SNMP.",
  failedPrefix: "Gagal: ",
  errorPrefix: "Error: ",
  statusOnline: "Online",
  statusOffline: "Offline"
};

function openModal(id) { document.getElementById(id).classList.add('show'); }
function closeModal(id) { document.getElementById(id).classList.remove('show'); }

const oltsData = JSON.parse(document.getElementById('olt-data-store').dataset.olts);

function editOlt(id) {
  const olt = oltsData.find(o => o.id == id);
  if (!olt) return;
  document.getElementById('editOltForm').action = '/admin/olts/' + olt.id + '/update';
  document.getElementById('e_name').value = olt.name;
  document.getElementById('e_host').value = olt.host;
  document.getElementById('e_snmp_port').value = olt.snmp_port;
  document.getElementById('e_brand').value = olt.brand;
  document.getElementById('e_snmp_community').value = olt.snmp_community;
  document.getElementById('e_telnet_port').value = olt.telnet_port || 23;
  document.getElementById('e_web_user').value = olt.web_user || 'admin';
  document.getElementById('e_web_password').value = olt.web_password || '';
  document.getElementById('e_enable_password').value = olt.enable_password || '';
  document.getElementById('e_is_active').value = olt.is_active ? '1' : '0';
  closeModal('manageOltsModal');
  openModal('editOltModal');
}

function formatBytes(bytesPerSec) {
  if (!bytesPerSec || bytesPerSec <= 0) return '0 bps';
  const bitsPerSec = Number(bytesPerSec) * 8;

  if (bitsPerSec >= 1000000000) {
    return (bitsPerSec / 1000000000).toFixed(2) + ' Gbps';
  }
  if (bitsPerSec >= 1000000) {
    return (bitsPerSec / 1000000).toFixed(2) + ' Mbps';
  }
  if (bitsPerSec >= 1000) {
    return (bitsPerSec / 1000).toFixed(2) + ' Kbps';
  }
  return Math.round(bitsPerSec) + ' bps';
}

async function loadOltDashboard(id) {
  if (!id) return;
  
  const overlay = document.getElementById('loading-overlay');
  if (overlay) overlay.style.display = 'flex';
  
  try {
    const url = (id === 'all') ? `/admin/olts/all/stats?full=true` : `/admin/olts/${id}/stats?full=true`;
    const res = await fetch(url);
    if (!res.ok) throw new Error(I18N.serverConnectFailed);
    const stats = await res.json();
    
    document.getElementById('stat-total-onu').innerText = stats.onus_total || 0;
    document.getElementById('stat-online-onu').innerText = stats.onus_online || 0;
    document.getElementById('stat-offline-onu').innerText = stats.onus_offline || 0;
    document.getElementById('stat-weak-onu').innerText = stats.onus_weak || 0;
    
    document.getElementById('stat-temp').innerText = stats.temp || 'N/A';
    document.getElementById('stat-cpu').innerText = stats.cpu || 'N/A';
    document.getElementById('stat-ram').innerText = stats.ram || 'N/A';
    document.getElementById('stat-uptime').innerText = stats.uptime || 'N/A';
    document.getElementById('stat-traffic-in').innerText = formatBytes(stats.uplink_rx || 0);
    document.getElementById('stat-traffic-out').innerText = formatBytes(stats.uplink_tx || 0);

    const tbody = document.getElementById('onu-table-body');
    if (stats.onus && stats.onus.length > 0) {
      document.getElementById('search-container').style.display = 'block';
      tbody.innerHTML = stats.onus.map((onu, index) => {
        const statusVal = String(onu.status || '');
        const isOnline = statusVal.toLowerCase() === 'online';
        const statusClass = isOnline ? 'pill-online' : 'pill-offline';
        const rxVal = parseFloat(onu.rx);
        let rxClass = 'power-good';
        if (!Number.isFinite(rxVal)) rxClass = '';
        else if (rxVal < -27) rxClass = 'power-danger';
        else if (rxVal < -24) rxClass = 'power-warning';
        const targetOltId = onu.olt_id || id;
        
        const custBadge = onu.customer_name ? `<div class="mt-1" style="font-size:11px;color:#2563eb;font-weight:600;"><i class="bi bi-person-fill"></i> ${onu.customer_name}</div>` : '';
        
        return `<tr>
          <td>${index + 1}</td>
          <td><code class="sn-mac">${onu.id || '-'}</code></td>
          <td>
            <strong>${onu.name || '-'}</strong>
            ${custBadge}
          </td>
          <td><code class="sn-mac">${formatSn(onu.sn) || '-'}</code></td>
          <td>
            <span class="status-pill-v2 ${statusClass}"><i class="bi bi-circle-fill" style="font-size:6px;"></i> ${isOnline ? 'Online' : 'Offline'}</span>
          </td>
          <td><span class="power-badge">${onu.tx || 'N/A'}</span></td>
          <td><span class="power-badge ${rxClass}">${onu.rx || 'N/A'}</span></td>
          <td><span class="small text-muted">${onu.distance != null ? onu.distance : '-'}</span></td>
          <td style="text-align:right">
            <div class="d-flex justify-content-end gap-1">
              <button class="btn btn-sm btn-outline-info py-0 px-2" onclick="showOnuDetailModal('${targetOltId}', '${onu.index}', '${onu.name}')" style="font-size: 11px;" title="Lihat Detail & Trafik ONU">
                <i class="bi bi-info-circle"></i> Detail
              </button>
              <button class="btn-action-v2 btn-rename-v2" onclick="renameOnuPrompt('${targetOltId}', '${onu.index}', '${onu.name}')" title="Ubah Nama"><i class="bi bi-pencil-square"></i></button>
              <button class="btn-action-v2 btn-reboot-v2" onclick="rebootOnu('${targetOltId}', '${onu.index}')" title="Reboot ONU"><i class="bi bi-arrow-clockwise"></i></button>
            </div>
          </td>
        </tr>`;
      }).join('');
    } else {
      document.getElementById('search-container').style.display = 'none';
      tbody.innerHTML = `<tr><td colspan="9">
        <div class="empty-state">
          <i class="bi bi-exclamation-triangle"></i>
          <p>${stats.error || I18N.noOnuData}</p>
        </div>
      </td></tr>`;
    }
  } catch (e) {
    document.getElementById('onu-table-body').innerHTML = `<tr><td colspan="9" class="text-center p-5 text-danger">${I18N.errorPrefix}${e.message}</td></tr>`;
  } finally {
    if (overlay) overlay.style.display = 'none';
  }
}

function formatSn(sn) {
  if (!sn || typeof sn !== 'string') return sn || '-';
  const raw = sn.trim();
  if (!raw || raw === '-' || raw === 'N/A') return raw;
  const clean = raw.replace(/[^a-zA-Z0-9]/g, '').toUpperCase();
  if (/^[0-9A-F]{12}$/.test(clean) || /^[0-9A-F]{16}$/.test(clean)) {
    return clean.match(/.{1,2}/g).join(':');
  }
  return raw;
}

function handleOltChange() {
  const id = document.getElementById('olt-selector').value;
  if (id) loadOltDashboard(id);
}

function refreshCurrentOlt() {
  handleOltChange();
}

function filterOnuTable() {
  const input = document.getElementById('onu-search');
  const filter = input.value.toLowerCase().trim();
  const filterClean = filter.replace(/[:\-\.]/g, '');
  const rows = document.querySelectorAll('#onu-table-body tr');
  
  rows.forEach(row => {
    const text = row.innerText.toLowerCase();
    const textClean = text.replace(/[:\-\.]/g, '');
    row.style.display = (text.includes(filter) || (filterClean && textClean.includes(filterClean))) ? '' : 'none';
  });
}

async function renameOnuPrompt(oltId, index, oldName) {
  const newName = prompt(I18N.renamePrompt, oldName);
  if (!newName || newName === oldName) return;
  try {
    const res = await fetch(`/admin/olts/${oltId}/onu/${index}/rename`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams({ name: newName })
    });
    const data = await res.json();
    if (data.success) { refreshCurrentOlt(); } else { alert(I18N.failedPrefix + data.error); }
  } catch (e) { alert(I18N.errorPrefix + e.message); }
}

async function rebootOnu(oltId, index) {
  if (!confirm(I18N.confirmReboot)) return;
  try {
    const res = await fetch(`/admin/olts/${oltId}/onu/${index}/reboot`, { method: 'POST' });
    const data = await res.json();
    if (data.success) { alert(I18N.rebootSent); } else { alert(I18N.failedPrefix + data.error); }
  } catch (e) { alert(I18N.errorPrefix + e.message); }
}

async function testExistingOlt(id) {
  if (!confirm('Uji koneksi SNMP ke OLT ini?')) return;
  const overlay = document.getElementById('loading-overlay');
  if (overlay) overlay.style.display = 'flex';
  try {
    const res = await fetch(`/admin/olts/${id}/test-connection`, { method: 'POST' });
    const data = await res.json();
    alert((data.success ? '✅ ' : '⚠️ ') + (data.message || 'Hasil tes koneksi selesai.'));
  } catch (e) {
    alert('❌ Error: ' + e.message);
  } finally {
    if (overlay) overlay.style.display = 'none';
  }
}

// Timer Trafik Uplink (1 Detik)
let liveTrafficTimer = null;
let currentScreenRx = 0;
let currentScreenTx = 0;

async function fetchLiveTrafficOnly() {
  const selector = document.getElementById('olt-selector');
  if (!selector || !selector.value || selector.value === 'all') return;
  const id = selector.value;

  try {
    const res = await fetch(`/admin/olts/${id}/stats?full=false`);
    if (!res.ok) return;
    const stats = await res.json();

    if (stats.uplink_rx && stats.uplink_rx > 0) {
      currentScreenRx = stats.uplink_rx;
      document.getElementById('stat-traffic-in').innerText = formatBytes(currentScreenRx);
    }
    
    if (stats.uplink_tx && stats.uplink_tx > 0) {
      currentScreenTx = stats.uplink_tx;
      document.getElementById('stat-traffic-out').innerText = formatBytes(currentScreenTx);
    }

    if (stats.temp && stats.temp !== 'N/A') document.getElementById('stat-temp').innerText = stats.temp;
    if (stats.cpu && stats.cpu !== 'N/A') document.getElementById('stat-cpu').innerText = stats.cpu;
    if (stats.ram && stats.ram !== 'N/A') document.getElementById('stat-ram').innerText = stats.ram;
    if (stats.uptime && stats.uptime !== 'N/A') document.getElementById('stat-uptime').innerText = stats.uptime;
  } catch (e) {}
}

// Timer Auto-Refresh Tabel ONU (10 Detik)
let onuTableRefreshTimer = null;

async function fetchLiveOnuTableOnly() {
  const selector = document.getElementById('olt-selector');
  if (!selector || !selector.value || selector.value === 'all') return;
  const id = selector.value;

  try {
    const res = await fetch(`/admin/olts/${id}/stats?full=true`);
    if (!res.ok) return;
    const stats = await res.json();

    document.getElementById('stat-total-onu').innerText = stats.onus_total || 0;
    document.getElementById('stat-online-onu').innerText = stats.onus_online || 0;
    document.getElementById('stat-offline-onu').innerText = stats.onus_offline || 0;
    document.getElementById('stat-weak-onu').innerText = stats.onus_weak || 0;

    const tbody = document.getElementById('onu-table-body');
    if (stats.onus && stats.onus.length > 0) {
      document.getElementById('search-container').style.display = 'block';
      
      const searchInput = document.getElementById('onu-search');
      const currentFilter = searchInput ? searchInput.value : '';

      tbody.innerHTML = stats.onus.map((onu, index) => {
        const statusVal = String(onu.status || '');
        const isOnline = statusVal.toLowerCase() === 'online';
        const statusClass = isOnline ? 'pill-online' : 'pill-offline';
        const rxVal = parseFloat(onu.rx);
        let rxClass = 'power-good';
        if (!Number.isFinite(rxVal)) rxClass = '';
        else if (rxVal < -27) rxClass = 'power-danger';
        else if (rxVal < -24) rxClass = 'power-warning';
        const targetOltId = onu.olt_id || id;
        
        const custBadge = onu.customer_name ? `<div class="mt-1" style="font-size:11px;color:#2563eb;font-weight:600;"><i class="bi bi-person-fill"></i> ${onu.customer_name}</div>` : '';
        
        return `<tr>
          <td>${index + 1}</td>
          <td><code class="sn-mac">${onu.id || '-'}</code></td>
          <td>
            <strong>${onu.name || '-'}</strong>
            ${custBadge}
          </td>
          <td><code class="sn-mac">${formatSn(onu.sn) || '-'}</code></td>
          <td>
            <span class="status-pill-v2 ${statusClass}"><i class="bi bi-circle-fill" style="font-size:6px;"></i> ${isOnline ? 'Online' : 'Offline'}</span>
          </td>
          <td><span class="power-badge">${onu.tx || 'N/A'}</span></td>
          <td><span class="power-badge ${rxClass}">${onu.rx || 'N/A'}</span></td>
          <td><span class="small text-muted">${onu.distance != null ? onu.distance : '-'}</span></td>
          <td style="text-align:right">
            <div class="d-flex justify-content-end gap-1">
              <button class="btn btn-sm btn-outline-info py-0 px-2" onclick="showOnuDetailModal('${targetOltId}', '${onu.index}', '${onu.name}')" style="font-size: 11px;" title="Lihat Detail & Trafik ONU">
                <i class="bi bi-info-circle"></i> Detail
              </button>
              <button class="btn-action-v2 btn-rename-v2" onclick="renameOnuPrompt('${targetOltId}', '${onu.index}', '${onu.name}')" title="Ubah Nama"><i class="bi bi-pencil-square"></i></button>
              <button class="btn-action-v2 btn-reboot-v2" onclick="rebootOnu('${targetOltId}', '${onu.index}')" title="Reboot ONU"><i class="bi bi-arrow-clockwise"></i></button>
            </div>
          </td>
        </tr>`;
      }).join('');

      if (currentFilter) {
        filterOnuTable();
      }
    }

    const nowTime = new Date().toLocaleTimeString('id-ID');
    const updateLabel = document.getElementById('last-update');
    if (updateLabel) updateLabel.innerText = nowTime;

  } catch (e) {}
}
//PENCARIAN DETAIL PELANGGAN LEWAT OLT
document.addEventListener('DOMContentLoaded', () => {
  const urlParams = new URLSearchParams(window.location.search);
  const openDetailId = urlParams.get('open_detail_id');
  const searchParam = urlParams.get('search');
  
  const targetId = openDetailId || searchParam;

  if (targetId) {
    // Cari langsung di array data pelanggan berdasarkan ID yang cocok persis
    if (Array.isArray(customersData) && customersData.length > 0) {
      const foundIndex = customersData.findIndex(c => String(c.id) === String(targetId));
      if (foundIndex !== -1) {
        setTimeout(() => {
          viewCustDetail(foundIndex);
        }, 300);
      }
    }
  }
});

document.addEventListener('DOMContentLoaded', () => {
  const selector = document.getElementById('olt-selector');
  if (selector && selector.value) {
    handleOltChange();
  }

  if (liveTrafficTimer) clearInterval(liveTrafficTimer);
  liveTrafficTimer = setInterval(fetchLiveTrafficOnly, 1000);

  if (onuTableRefreshTimer) clearInterval(onuTableRefreshTimer);
  onuTableRefreshTimer = setInterval(fetchLiveOnuTableOnly, 10000);
});

</script>
