<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Live Chat WhatsApp | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    .chat-layout { display: grid; grid-template-columns: 340px 1fr; gap: 16px; height: calc(100vh - 120px); min-height: 520px; }
    .chat-inbox { background: var(--bg2); border: 1px solid var(--border); border-radius: 12px; display: flex; flex-direction: column; overflow: hidden; }
    .chat-inbox-header { padding: 12px 16px; border-bottom: 1px solid var(--border); font-weight: 700; display: flex; align-items: center; justify-content: space-between; }
    .chat-inbox-search { padding: 10px 14px; border-bottom: 1px solid var(--border); }
    .chat-user-list { flex: 1; overflow-y: auto; }
    
    .chat-user-item { padding: 12px 16px; border-bottom: 1px solid var(--border); cursor: pointer; transition: background .15s; display: flex; gap: 10px; align-items: center; position: relative; }
    .chat-user-item:hover { background: rgba(255,255,255,0.04); }
    .chat-user-item.active { background: var(--pdim) !important; border-left: 3px solid var(--primary); }
    .chat-user-item:hover .btn-del-user { opacity: 1; }
    .btn-del-user { opacity: 0; transition: opacity .15s; background: none; border: none; color: #ef4444; font-size: 13px; padding: 2px 4px; border-radius: 4px; cursor: pointer; flex-shrink: 0; }
    .btn-del-user:hover { background: rgba(239, 68, 68, 0.15); }


    .chat-user-avatar { width: 40px; height: 40px; border-radius: 50%; background: var(--primary); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 16px; flex-shrink: 0; position: relative; }
    .chat-user-info { flex: 1; min-width: 0; }
    .chat-user-header { display: flex; align-items: center; justify-content: space-between; gap: 6px; }
    .chat-user-name { font-size: 13px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--text); display: flex; align-items: center; gap: 6px; }
    .chat-user-last { font-size: 11px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 2px; }
    .chat-user-time { font-size: 10px; color: var(--muted); flex-shrink: 0; }

    /* Badge Pesan Baru (Bulat Hijau Bersinar) */
    .chat-unread-badge {
      display: inline-flex; align-items: center; justify-content: center;
      min-width: 18px; height: 18px; padding: 0 5px;
      font-size: 10px; font-weight: 800; color: #ffffff;
      background: #10b981; border-radius: 10px;
      box-shadow: 0 0 8px rgba(16, 185, 129, 0.4);
      animation: pulseBadge 2s infinite ease-in-out;
      flex-shrink: 0;
    }
    @keyframes pulseBadge {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.1); }
    }

    .chat-user-item.has-unread .chat-user-name { color: #10b981; }
    .chat-user-item.has-unread .chat-user-last { font-weight: 700; color: var(--text); }


    .chat-main { background: var(--bg2); border: 1px solid var(--border); border-radius: 12px; display: flex; flex-direction: column; overflow: hidden; height: 100%; }
    .chat-main-header { padding: 14px 18px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; background: var(--bg); }
    .chat-main-title { font-weight: 700; font-size: 15px; }
    .chat-messages { flex: 1; padding: 18px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; background: rgba(0,0,0,0.02); }
    
    .msg-bubble { max-width: 75%; padding: 10px 14px; border-radius: 12px; font-size: 13px; line-height: 1.4; position: relative; word-wrap: break-word; }
    .msg-bubble.inbound { align-self: flex-start; background: var(--bg3); color: var(--text); border-bottom-left-radius: 2px; }
    .msg-bubble.outbound { align-self: flex-end; background: var(--primary); color: #ffffff; border-bottom-right-radius: 2px; }
    .msg-meta { font-size: 10px; opacity: 0.75; text-align: right; margin-top: 4px; display: flex; align-items: center; justify-content: flex-end; gap: 6px; }
	/* Tampilan Centang WhatsApp Asli */
    .msg-status-tick { font-size: 12px; font-weight: 700; letter-spacing: -2px; margin-left: 2px; }
    .msg-status-tick.sent { color: rgba(255,255,255,0.7); } /* Centang 1 (Terkirim, HP lawan belum aktif) */
    .msg-status-tick.delivered { color: rgba(255,255,255,0.95); } /* Centang 2 Abu-abu (HP lawan aktif, pesan masuk) */
    .msg-status-tick.read { color: #38bdf8 !important; } /* Centang 2 BIRU (Pesan sudah dibaca) */
    .msg-gateway { font-size: 9px; padding: 1px 4px; border-radius: 4px; background: rgba(255,255,255,0.2); }
    .msg-actions { display: inline-flex; align-items: center; gap: 6px; margin-left: 6px; }
    .btn-msg-icon { background: none; border: none; padding: 0 2px; color: inherit; cursor: pointer; opacity: 0.7; font-size: 12px; line-height: 1; transition: opacity .15s, transform .1s; }
    .btn-msg-icon:hover { opacity: 1; transform: scale(1.15); }
    .btn-del-chat { padding: 4px 10px; font-size: 11px; border-radius: 6px; display: none; align-items: center; gap: 4px; }

    .chat-input-area { padding: 12px 16px; border-top: 1px solid var(--border); display: flex; gap: 10px; align-items: center; background: var(--bg); }
    .chat-input-area textarea { flex: 1; height: 46px; border-radius: 8px; resize: none; padding: 10px 12px; font-size: 13px; line-height: 1.3; }

    @media (max-width: 768px) {
      .chat-layout { grid-template-columns: 1fr; height: auto; }
      .chat-inbox { height: 350px; }
      .chat-main { height: 480px; }
    }
	
	/* === AWAL TAMBAHAN CSS: MODAL KONFIRMASI MODERN === */
    .confirm-modal-overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,0.55);
      backdrop-filter: blur(4px); z-index: 99999;
      display: none; align-items: center; justify-content: center;
      animation: fadeInOverlay .18s ease;
    }
    .confirm-modal-box {
      background: var(--bg2); border: 1px solid var(--border);
      width: 100%; max-width: 420px; border-radius: 14px;
      padding: 22px; box-shadow: 0 16px 36px rgba(0,0,0,0.3);
      text-align: center; transform: scale(0.95);
      animation: popModalBox .18s ease forwards;
    }
    @keyframes fadeInOverlay { from { opacity: 0; } to { opacity: 1; } }
    @keyframes popModalBox { from { transform: scale(0.95); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    
    .confirm-modal-icon {
      width: 54px; height: 54px; border-radius: 50%;
      margin: 0 auto 14px; display: flex; align-items: center; justify-content: center;
      font-size: 26px;
    }
    .confirm-modal-icon.danger { background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); }
    .confirm-modal-icon.warning { background: rgba(245, 158, 11, 0.15); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3); }
    
    .confirm-modal-title { font-size: 16px; font-weight: 700; color: var(--text); margin-bottom: 8px; }
    .confirm-modal-desc { font-size: 13px; color: var(--muted); line-height: 1.5; margin-bottom: 20px; word-break: break-word; }
    .confirm-modal-actions { display: flex; gap: 10px; justify-content: center; }
    .confirm-modal-actions button { min-width: 110px; padding: 8px 16px; font-weight: 600; border-radius: 8px; }
/* === AKHIR TAMBAHAN CSS: MODAL KONFIRMASI MODERN === */
	
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'whatsapp_live_chat', company }) %>
<div class="mw">
  <div class="topbar">
    <div class="tb-title">
      <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
      <i class="bi bi-chat-dots-fill"></i> Live Chat WhatsApp
    </div>
    <div class="tb-right">
      <span class="badge <%= gatewayType === 'meta' ? 'bs' : 'bp' %>">
        <i class="bi bi-<%= gatewayType === 'meta' ? 'meta' : 'whatsapp' %>"></i> <%= gatewayType === 'meta' ? 'Meta Cloud API (Resmi)' : 'Baileys Web (Gratis)' %>
      </span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </div>

  <div class="page">
    <% if (msg) { %>
      <div class="alert alert-<%= msg.type==='success'?'s':'d' %> mb16">
        <i class="bi bi-<%= msg.type==='success'?'check-circle':'exclamation-triangle' %>"></i> <%= msg.text %>
      </div>
    <% } %>

    <div class="chat-layout">
      <!-- INBOX LEFT PANEL -->
      <div class="chat-inbox">
        <div class="chat-inbox-header">
          <span><i class="bi bi-inbox-fill"></i> Percakapan</span>
          <div style="display:flex;gap:4px">
            <button class="btn btn-p btn-sm" onclick="openNewChatModal()" title="Mulai Chat Baru"><i class="bi bi-plus-lg"></i></button>
            <button class="btn btn-g btn-sm" onclick="loadConversations()" title="Refresh Chat"><i class="bi bi-arrow-clockwise"></i></button>
            <button class="btn btn-d btn-sm" onclick="clearAllConversations()" title="Hapus Seluruh Riwayat Chat Semua Orang"><i class="bi bi-trash3-fill"></i></button>
          </div>
        </div>
        <div class="chat-inbox-search">
          <input type="text" id="chatSearch" class="fc" placeholder="Cari nama atau nomor..." onkeyup="filterUserList()">
        </div>
        <div class="chat-user-list" id="userList">
          <div class="text-center text-muted py-4" style="padding:20px;">Memuat percakapan...</div>
        </div>
      </div>

      <!-- MAIN CHAT RIGHT PANEL -->
      <div class="chat-main">
        <div class="chat-main-header">
          <div>
            <div class="chat-main-title" id="chatHeaderTitle">
              <i class="bi bi-person-circle"></i> Memuat chat...
            </div>
            <div id="chatHeaderSub" style="font-size:11px;" class="text-muted"></div>
          </div>
          <div>
            <button type="button" class="btn btn-d btn-sm btn-del-chat" id="btnDeleteConversation" onclick="deleteActiveConversation()" title="Hapus Riwayat Chat Orang Ini">
              <i class="bi bi-trash"></i> Hapus Percakapan
            </button>
          </div>
        </div>

        <div class="chat-messages" id="chatMessages">
          <div style="margin:auto;text-align:center;color:var(--muted)">
            <i class="bi bi-chat-text" style="font-size:48px;display:block;margin-bottom:10px;"></i>
            Pilih pelanggan dari daftar di sebelah kiri atau klik <strong>+ Chat Baru</strong> untuk membalas/mengirim WhatsApp.
          </div>
        </div>

        <form class="chat-input-area" id="chatForm" onsubmit="sendChatMessage(event)">
          <input type="hidden" id="activePhone" value="">
          <textarea id="chatInput" class="fc" placeholder="Tulis pesan WhatsApp... (Tekan Enter untuk kirim, Shift+Enter untuk baris baru)" disabled required onkeydown="handleKeyDown(event)"></textarea>
          <button type="submit" class="btn btn-p" id="sendBtn" disabled>
            <i class="bi bi-send-fill"></i> Kirim
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- MODAL CHAT BARU -->
<div class="mo" id="newChatModal">
  <div class="mb" style="max-width:520px;">
    <div class="mh">
      <span class="mt"><i class="bi bi-chat-plus-fill"></i> Mulai Percakapan WhatsApp Baru</span>
      <button type="button" class="mc" onclick="closeModal('newChatModal')">&times;</button>
    </div>
    <div class="mbody">
      <div class="fg mb12">
        <label class="fl">Pilih Pelanggan Terdaftar:</label>
        <select class="fs" id="selectCustomerPhone" onchange="document.getElementById('manualPhoneInput').value=this.value">
          <option value="">-- Pilih dari Daftar Pelanggan --</option>
          <% if (typeof customers !== 'undefined' && customers) { %>
            <% customers.forEach(c => { %>
              <% if (c.phone) { %>
                <option value="<%= c.phone %>"><%= c.name %> (<%= c.phone %>) - <%= c.area || 'Area Default' %></option>
              <% } %>
            <% }) %>
          <% } %>
        </select>
      </div>
      <div class="fg">
        <label class="fl">Atau Ketik Nomor WA Manual:</label>
        <input type="text" id="manualPhoneInput" class="fc" placeholder="Contoh: 08123456789 atau 628123456789">
      </div>
    </div>
    <div class="mf">
      <button type="button" class="btn btn-g" onclick="closeModal('newChatModal')">Batal</button>
      <button type="button" class="btn btn-p" onclick="startNewChatFromModal()"><i class="bi bi-chat-dots-fill"></i> Buka Chat</button>
    </div>
  </div>
</div>

<!-- === AWAL TAMBAHAN HTML: DIALOG MODAL KONFIRMASI CUSTOM === -->
<div class="confirm-modal-overlay" id="customConfirmModal">
  <div class="confirm-modal-box">
    <div class="confirm-modal-icon danger" id="customConfirmIcon">
      <i class="bi bi-exclamation-triangle-fill"></i>
    </div>
    <div class="confirm-modal-title" id="customConfirmTitle">Konfirmasi Hapus</div>
    <div class="confirm-modal-desc" id="customConfirmDesc">Apakah Anda yakin ingin menghapus data ini?</div>
    <div class="confirm-modal-actions">
      <button type="button" class="btn btn-g btn-sm" id="customConfirmCancelBtn">Batal</button>
      <button type="button" class="btn btn-d btn-sm" id="customConfirmOkBtn">Ya, Hapus</button>
    </div>
  </div>
</div>
<!-- === AKHIR TAMBAHAN HTML: DIALOG MODAL KONFIRMASI CUSTOM === -->

<script>
let conversationsData = [];
let activePhone = '';

async function loadConversations() {
  try {
    const res = await fetch('/admin/api/whatsapp/conversations');
    const data = await res.json();
    if (data.ok) {
      conversationsData = data.conversations || [];
      renderUserList(conversationsData);

      // Auto open first conversation if available and not selected yet
      if (!activePhone && conversationsData.length > 0) {
        const first = conversationsData[0];
        const name = first.customer_name || first.phone;
        openChat(first.phone, name);
      }
    }
  } catch (e) {
    console.error('Error loading conversations:', e);
  }
}

/* === AWAL PERUBAHAN: RENDER USER LIST DENGAN BADGE PESAN BARU === */
function renderUserList(list) {
  const container = document.getElementById('userList');
  if (!list || list.length === 0) {
    container.innerHTML = `<div class="text-center text-muted" style="padding:24px;">Belum ada percakapan WhatsApp. Klik <b>+</b> untuk chat baru.</div>`;
    return;
  }

  container.innerHTML = list.map(c => {
    const name = c.customer_name || c.phone;
    const initial = name.replace(/\(.*?\)/g, '').trim().charAt(0).toUpperCase() || 'W';
    const isActive = c.phone === activePhone ? 'active' : '';
    const unreadCount = Number(c.unread_count || 0);
    // Jika chat sedang aktif dibuka, sembunyikan badgenya
    const showBadge = (unreadCount > 0 && c.phone !== activePhone);
    const hasUnreadClass = showBadge ? 'has-unread' : '';

    const dateStr = c.created_at ? new Date(c.created_at).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) : '';
    const safeName = escapeHtml(name);
    
    return `
      <div class="chat-user-item ${isActive} ${hasUnreadClass}" onclick="openChat('${c.phone}', '${safeName}')">
        <div class="chat-user-avatar">
          ${initial}
        </div>
        <div class="chat-user-info">
          <div class="chat-user-header">
            <div class="chat-user-name">
              <span>${safeName}</span>
              ${showBadge ? `<span class="chat-unread-badge" title="${unreadCount} pesan baru belum dibuka">${unreadCount}</span>` : ''}
            </div>
            <div class="chat-user-time">${dateStr}</div>
          </div>
          <div class="chat-user-last">${escapeHtml(c.message_text || '')}</div>
        </div>
        <button type="button" class="btn-del-user" title="Hapus chat orang ini" onclick="deleteConversationByPhone(event, '${c.phone}', '${safeName}')">
          <i class="bi bi-trash"></i>
        </button>
      </div>
    `;
  }).join('');
}

function filterUserList() {
  const q = document.getElementById('chatSearch').value.toLowerCase();
  const filtered = conversationsData.filter(c => 
    (c.customer_name && c.customer_name.toLowerCase().includes(q)) || 
    (c.phone && c.phone.includes(q))
  );
  renderUserList(filtered);
}

function openNewChatModal() {
  document.getElementById('newChatModal').classList.add('show');
}

function closeModal(id) {
  document.getElementById(id).classList.remove('show');
}

function startNewChatFromModal() {
  const phoneVal = document.getElementById('manualPhoneInput').value.trim();
  if (!phoneVal) {
    alert('Harap pilih pelanggan atau ketik nomor WhatsApp.');
    return;
  }
  closeModal('newChatModal');
  
  const selectEl = document.getElementById('selectCustomerPhone');
  const selectedOption = Array.from(selectEl.options).find(o => o.value === phoneVal);
  const name = selectedOption ? selectedOption.text.split(' (')[0] : phoneVal;
  
  openChat(phoneVal, name);
}

/* === AWAL PERUBAHAN: OPENCHAT DENGAN TRIGGER MARK-READ === */
async function openChat(phone, name) {
  activePhone = phone;
  document.getElementById('activePhone').value = phone;
  document.getElementById('chatHeaderTitle').innerHTML = `<i class="bi bi-person-fill"></i> ${escapeHtml(name)}`;
  document.getElementById('chatHeaderSub').innerText = `📱 ${phone}`;
  
  const inputEl = document.getElementById('chatInput');
  const sendBtn = document.getElementById('sendBtn');
  const delChatBtn = document.getElementById('btnDeleteConversation');
  
  inputEl.disabled = false;
  sendBtn.disabled = false;
  if (delChatBtn) delChatBtn.style.display = 'inline-flex';

  const found = conversationsData.find(c => c.phone === phone);
  if (found) found.unread_count = 0;

  renderUserList(conversationsData);
  loadChatMessages(phone, true);

  // Kirim sinyal ke WA server bahwa admin telah membuka dan membaca chat ini (Centang Biru)
  fetch('/admin/api/whatsapp/mark-read', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ phone })
  }).catch(() => {});
}
/* === AKHIR PERUBAHAN === */

async function loadChatMessages(phone, showSpinner = false) {
  const container = document.getElementById('chatMessages');
  if (showSpinner) {
    container.innerHTML = `<div class="text-center text-muted" style="margin:auto;"><i class="bi bi-arrow-repeat spin"></i> Memuat pesan...</div>`;
  }
  
  try {
    const res = await fetch(`/admin/api/whatsapp/messages?phone=${encodeURIComponent(phone)}`);
    const data = await res.json();
    if (data.ok) {
      const messages = data.messages || [];
      if (messages.length === 0) {
        container.innerHTML = `<div class="text-center text-muted" style="margin:auto;">Belum ada pesan dengan nomor ini. Ketik pesan di bawah dan tekan Enter untuk memulai.</div>`;
        return;
      }
      
      /* === AWAL PERUBAHAN: STATUS CENTANG 1 VS CENTANG 2 VS CENTANG BIRU === */
      container.innerHTML = messages.map(m => {
        const isOutbound = m.direction === 'outbound';
        const timeStr = m.created_at ? new Date(m.created_at).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) : '';
        const gatewayBadge = m.gateway === 'meta' ? 'Meta API' : 'Baileys';
        
        // Logika Centang:
        // status 'read' = Centang 2 Biru
        // status 'delivered' = Centang 2 Abu-abu (Tanda HP aktif dan pesan masuk)
        // status 'sent' = Centang 1 Abu-abu (Terkirim ke server WA, tapi HP tujuan belum menerima/tidak aktif)
        let tickHtml = '';
        if (isOutbound) {
          if (m.status === 'read') {
            tickHtml = '<span class="msg-status-tick read" title="Sudah Dibaca">✓✓</span>';
          } else if (m.status === 'delivered') {
            tickHtml = '<span class="msg-status-tick delivered" title="Tersampaikan ke HP (Aktif)">✓✓</span>';
          } else {
            tickHtml = '<span class="msg-status-tick sent" title="Terkirim ke server (HP belum menerima / offline)">✓</span>';
          }
        }

        const rawText = m.message_text || '';
        const escapedText = escapeHtml(rawText);

        return `
          <div class="msg-bubble ${isOutbound ? 'outbound' : 'inbound'}" id="msg-row-${m.id}">
            <div>${escapedText.replace(/\n/g, '<br>')}</div>
            <div class="msg-meta">
              <span class="msg-gateway">${gatewayBadge}</span>
              <span>${timeStr}</span>
              ${tickHtml}
              <div class="msg-actions">

                <button type="button" class="btn-msg-icon" onclick="copyTextMessage(this, \`${escapedText.replace(/`/g, '\\`')}\`)" title="Salin Pesan">
                  <i class="bi bi-clipboard"></i>
                </button>
                <button type="button" class="btn-msg-icon text-danger" onclick="deleteSingleMessage(${m.id})" title="Hapus Pesan Ini">
                  <i class="bi bi-trash"></i>
                </button>
              </div>
            </div>
          </div>
        `;
      }).join('');
      
      container.scrollTop = container.scrollHeight;
    }
  } catch (e) {
    if (showSpinner) {
      container.innerHTML = `<div class="text-center text-danger" style="margin:auto;">Gagal memuat pesan: ${e.message}</div>`;
    }
  }
}

function copyTextMessage(btn, text) {
  if (!navigator.clipboard) {
    const ta = document.createElement('textarea');
    ta.value = text;
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    document.body.removeChild(ta);
  } else {
    navigator.clipboard.writeText(text);
  }

  const icon = btn.querySelector('i');
  if (icon) {
    icon.className = 'bi bi-check-lg text-success';
    setTimeout(() => {
      icon.className = 'bi bi-clipboard';
    }, 1500);
  }
}

/* === AWAL PERUBAHAN JAVASCRIPT: CUSTOM CONFIRM MODAL === */

// Fungsi Helper untuk memunculkan Modal Konfirmasi Modern
function showConfirmDialog({
  title = 'Konfirmasi Hapus',
  desc = 'Apakah Anda yakin ingin menghapus item ini?',
  okText = 'Ya, Hapus',
  cancelText = 'Batal',
  type = 'danger' // 'danger' atau 'warning'
}) {
  return new Promise((resolve) => {
    const overlay = document.getElementById('customConfirmModal');
    const titleEl = document.getElementById('customConfirmTitle');
    const descEl = document.getElementById('customConfirmDesc');
    const okBtn = document.getElementById('customConfirmOkBtn');
    const cancelBtn = document.getElementById('customConfirmCancelBtn');
    const iconEl = document.getElementById('customConfirmIcon');

    titleEl.innerText = title;
    descEl.innerHTML = desc;
    okBtn.innerText = okText;
    cancelText = cancelText;

    if (type === 'warning') {
      iconEl.className = 'confirm-modal-icon warning';
      iconEl.innerHTML = '<i class="bi bi-exclamation-circle-fill"></i>';
      okBtn.className = 'btn btn-w btn-sm';
    } else {
      iconEl.className = 'confirm-modal-icon danger';
      iconEl.innerHTML = '<i class="bi bi-trash3-fill"></i>';
      okBtn.className = 'btn btn-d btn-sm';
    }

    overlay.style.display = 'flex';

    const cleanUp = (result) => {
      overlay.style.display = 'none';
      okBtn.onclick = null;
      cancelBtn.onclick = null;
      resolve(result);
    };

    okBtn.onclick = () => cleanUp(true);
    cancelBtn.onclick = () => cleanUp(false);
  });
}

// 1. Hapus Pesan Satu-satu
async function deleteSingleMessage(msgId) {
  const confirmed = await showConfirmDialog({
    title: 'Hapus Pesan?',
    desc: 'Pesan yang dihapus tidak dapat dipulihkan kembali dari layar obrolan.',
    okText: 'Hapus Pesan'
  });
  if (!confirmed) return;

  try {
    const res = await fetch(`/admin/api/whatsapp/messages/${msgId}/delete`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    });
    const data = await res.json();
    if (data.success) {
      const el = document.getElementById(`msg-row-${msgId}`);
      if (el) {
        el.style.transition = 'all .25s ease';
        el.style.opacity = '0';
        el.style.transform = 'scale(0.9)';
        setTimeout(() => el.remove(), 250);
      }
    } else {
      alert('Gagal menghapus pesan: ' + (data.error || 'Terjadi kesalahan'));
    }
  } catch (err) {
    alert('Gagal request: ' + err.message);
  }
}

// 2. Hapus Percakapan Per Orang (dari Daftar Kontak Kiri)
async function deleteConversationByPhone(event, phone, name) {
  if (event) event.stopPropagation();

  const confirmed = await showConfirmDialog({
    title: 'Hapus Percakapan?',
    desc: `Seluruh riwayat obrolan dengan <strong>${name}</strong> (${phone}) akan dihapus secara permanen.`,
    okText: 'Hapus Chat'
  });
  if (!confirmed) return;

  try {
    const res = await fetch('/admin/api/whatsapp/conversations/delete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ phone })
    });
    const data = await res.json();
    if (data.success) {
      if (activePhone === phone) {
        resetActiveChatView();
      }
      await loadConversations();
    } else {
      alert('Gagal menghapus percakapan: ' + (data.error || 'Terjadi kesalahan'));
    }
  } catch (err) {
    alert('Gagal request: ' + err.message);
  }
}

// 3. Hapus Percakapan Per Orang (dari Header Chat Kanan)
async function deleteActiveConversation() {
