/* === AKHIR PERUBAHAN JAVASCRIPT: CUSTOM CONFIRM MODAL === */

function resetActiveChatView() {
  activePhone = '';
  document.getElementById('activePhone').value = '';
  document.getElementById('chatMessages').innerHTML = `
    <div style="margin:auto;text-align:center;color:var(--muted)">
      <i class="bi bi-chat-text" style="font-size:48px;display:block;margin-bottom:10px;"></i>
      Pilih pelanggan dari daftar di sebelah kiri atau klik <strong>+ Chat Baru</strong> untuk membalas/mengirim WhatsApp.
    </div>`;
  const delChatBtn = document.getElementById('btnDeleteConversation');
  if (delChatBtn) delChatBtn.style.display = 'none';
  document.getElementById('chatHeaderTitle').innerHTML = '<i class="bi bi-person-circle"></i> Memuat chat...';
  document.getElementById('chatHeaderSub').innerText = '';
  document.getElementById('chatInput').disabled = true;
  document.getElementById('sendBtn').disabled = true;
}

function handleKeyDown(event) {
  if (event.key === 'Enter' && !event.shiftKey) {
    event.preventDefault();
    sendChatMessage(event);
  }
}

async function sendChatMessage(e) {
  if (e) e.preventDefault();
  const phone = document.getElementById('activePhone').value;
  const inputEl = document.getElementById('chatInput');
  const text = inputEl.value.trim();

  if (!phone) {
    alert('Silakan pilih percakapan atau nomor tujuan terlebih dahulu.');
    return;
  }
  if (!text) return;

  const sendBtn = document.getElementById('sendBtn');
  sendBtn.disabled = true;

  try {
    const res = await fetch('/admin/api/whatsapp/send-direct', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ phone, message: text })
    });
    const data = await res.json();
    if (data.success) {
      inputEl.value = '';
      await loadChatMessages(phone, false);
      await loadConversations();
      inputEl.focus();
    } else {
      const errDetail = typeof data.error === 'object' ? (data.error.message || JSON.stringify(data.error)) : String(data.error || 'Terjadi kesalahan');
      alert('Gagal mengirim pesan WA: ' + errDetail);
    }
  } catch (err) {
    alert('Gagal membuat request: ' + err.message);
  } finally {
    sendBtn.disabled = false;
  }
}

function escapeHtml(str) {
  return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}


let lastSoundboxEventId = 0;

// Polling Pemutar Suara Soundbox
async function pollSoundboxAudio() {
  try {
    const res = await fetch(`/admin/api/soundbox/poll?afterId=${lastSoundboxEventId}`);
    const data = await res.json();
    if (data.success && Array.isArray(data.events) && data.events.length > 0) {
      for (const ev of data.events) {
        if (ev.id > lastSoundboxEventId) lastSoundboxEventId = ev.id;
        if (ev.speechText) {
          playSpeechAudio(ev.speechText);
        }
      }
    }
  } catch (err) {
    // Silent polling error
  }
}

// Fungsi Memutar Suara TTS Menggunakan Audio Element / Web Speech API
function playSpeechAudio(text) {
  try {
    // 1. Coba putar audio MP3 via endpoint Voice TTS Server
    const audio = new Audio(`/admin/api/voice-assistant/tts?text=${encodeURIComponent(text)}`);
    audio.play().catch(() => {
      // 2. Fallback instan ke SpeechSynthesis browser jika autoplay server diblokir
      if ('speechSynthesis' in window) {
        const utter = new SpeechSynthesisUtterance(text);
        utter.lang = 'id-ID';
        utter.rate = 1.05;
        window.speechSynthesis.speak(utter);
      }
    });
  } catch (_) {}
}

document.addEventListener('DOMContentLoaded', () => {
  loadConversations();
  
  // Polling percakapan & pesan baru setiap 5 detik
  setInterval(() => {
    loadConversations();
    if (activePhone) loadChatMessages(activePhone, false);
  }, 5000);

  // Inisialisasi awal ID soundbox agar tidak membacakan chat masa lalu saat web baru dibuka
  fetch('/admin/api/soundbox/poll?afterId=0')
    .then(r => r.json())
    .then(d => {
      if (d.events && d.events.length > 0) {
        lastSoundboxEventId = d.events[d.events.length - 1].id;
      }
      // Mulai dengarkan suara event baru setiap 3 detik
      setInterval(pollSoundboxAudio, 3000);
    })
    .catch(() => {
      setInterval(pollSoundboxAudio, 3000);
    });
});
