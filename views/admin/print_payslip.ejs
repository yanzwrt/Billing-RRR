<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Slip Gaji #<%= slip.id %> — <%= slip.employee_name %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:'Segoe UI',Arial,sans-serif;font-size:12.5px;color:#0f172a;background:#fff;padding:20px}
    .slip{max-width:680px;margin:0 auto;border:1px solid #cbd5e1;border-radius:8px;padding:30px;background:#fff;box-shadow:0 4px 6px -1px rgba(0,0,0,0.05)}
    
    /* Kop Surat & Logo */
    .header{display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid #0f172a;padding-bottom:15px;margin-bottom:20px}
    .comp-logo{max-height:50px;max-width:140px;object-fit:contain}
    .logo-placeholder{width:45px;height:45px;background:#e0f2fe;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:bold;color:#0284c7}
    .comp-info h1{font-size:15px;font-weight:800;color:#0f172a;text-transform:uppercase;margin:0 0 2px 0}
    .comp-info p{margin:0;color:#64748b;font-size:9px;line-height:1.35}
    .doc-title-box{text-align:right}
    .doc-title{font-size:18px;font-weight:800;color:#4f46e5;text-transform:uppercase;margin:0 0 2px 0}
    .doc-period{font-size:11px;font-weight:700;color:#334155}

    /* Info Karyawan */
    .info-card{background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:12px 16px;margin-bottom:20px;display:flex;justify-content:space-between;align-items:center}
    .info-left div{margin-bottom:3px}
    .info-left div:last-child{margin-bottom:0}
    .label{color:#64748b;font-weight:600}
    .value{font-weight:700;color:#0f172a}
    
    .status-badge{padding:3px 10px;border-radius:12px;font-size:10.5px;font-weight:700;text-transform:uppercase}
    .status-draft{background:#f1f5f9;color:#64748b}
    .status-approved{background:#dbeafe;color:#1d4ed8}
    .status-paid{background:#dcfce7;color:#15803d}

    /* Tabel Rincian */
    table{width:100%;border-collapse:collapse;margin-bottom:20px}
    th,td{padding:8px 10px;text-align:left;border-bottom:1px solid #e2e8f0;font-size:12px}
    th{background:#f1f5f9;color:#334155;font-weight:700;text-transform:uppercase;font-size:10.5px}
    .amount{text-align:right;font-family:Consolas,monospace;font-weight:600}
    .section-header{background:#f8fafc;font-weight:800;color:#475569;font-size:11px;text-transform:uppercase;letter-spacing:0.5px}
    
    /* Gaji Bersih Box */
    .net-box{background:#4f46e5;color:#fff;border-radius:6px;padding:12px 18px;display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
    .net-title{font-size:12px;font-weight:800;letter-spacing:0.5px;text-transform:uppercase}
    .net-amount{font-size:20px;font-weight:800;font-family:Consolas,monospace}

    /* Tanda Tangan */
    .footer{margin-top:30px;display:flex;justify-content:space-between;font-size:11px;page-break-inside:avoid}
    .sign-box{text-align:center;width:180px}
    .sign-title{color:#475569;margin-bottom:50px}
    .sign-line{border-top:1px solid #334155;padding-top:4px;font-weight:700;text-transform:uppercase}

    @media print{
      @page{size:A4 portrait;margin:10mm 15mm}
      body{padding:0;background:#fff !important;-webkit-print-color-adjust:exact !important;print-color-adjust:exact !important}
      .slip{border:none !important;box-shadow:none !important;max-width:100% !important;padding:0 !important}
      .no-print{display:none !important}
    }
    .no-print{margin:20px auto;max-width:680px;text-align:center;display:flex;justify-content:center;gap:10px}
    .btn{padding:8px 20px;border:none;border-radius:6px;cursor:pointer;font-weight:600;font-size:12px;display:inline-flex;align-items:center;gap:6px}
    .btn-primary{background:#4f46e5;color:#fff}.btn-secondary{background:#64748b;color:#fff}
  </style>
</head>
<body>

<div class="no-print">
  <button class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer"></i> Cetak / Simpan PDF</button>
  <button class="btn btn-secondary" onclick="window.close()"><i class="bi bi-x-lg"></i> Tutup Halaman</button>
</div>

<div class="slip">
  <!-- Header / Kop Surat -->
  <div class="header">
    <div style="display:flex;align-items:center;gap:12px">
      <% if (hasLogo) { %>
        <img src="/img/logo.png" alt="Logo" class="comp-logo">
      <% } else { %>
        <div class="logo-placeholder"><span><%= (company || 'I').charAt(0) %></span></div>
      <% } %>
      <% if (hasLogo) { %>
        <img src="/img/logo.png" alt="Logo" class="comp-logo">
      <% } else { %>
        <div class="logo-placeholder"><span><%= (company || 'I').charAt(0) %></span></div>
      <% } %>
      <div class="comp-info">
        <h1><%= company %></h1>
        <p>Pusat Layanan Internet &amp; Telekomunikasi</p>
        <p>Dokumen Resmi Kepegawaian &amp; Payroll</p>
      </div>
    </div>
    <div class="doc-title-box">
      <div class="doc-title">Slip Gaji</div>
      <div class="doc-period">Periode: <%= ['','Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'][slip.period_month] %> <%= slip.period_year %></div>
    </div>
  </div>

  <!-- Informasi Karyawan -->
  <div class="info-card">
    <div class="info-left">
      <div><span class="label">Nama Karyawan:</span> <span class="value" style="font-size:14px"><%= slip.employee_name %></span></div>
      <div style="margin-top:4px"><span class="label">Jabatan / Unit:</span> <span class="value"><%= slip.employee_type === 'technician' ? 'Teknisi Lapangan' : slip.employee_type === 'cashier' ? 'Kasir / Admin' : 'Kolektor Tagihan' %></span> (ID: #<%= slip.employee_id %>)</div>
    </div>
    <div>
      <span class="status-badge status-<%= slip.status %>"><%= slip.status === 'paid' ? 'LUNAS (PAID)' : slip.status.toUpperCase() %></span>
    </div>
  </div>

  <!-- Tabel Komponen -->
  <table>
    <thead>
      <tr>
        <th>Keterangan Komponen Gaji</th>
        <th class="amount">Jumlah (IDR)</th>
      </tr>
    </thead>
    <tbody>
      <tr class="section-header"><td colspan="2"><i class="bi bi-plus-circle"></i> Pendapatan &amp; Tunjangan</td></tr>
      <tr><td>Gaji Pokok Utama</td><td class="amount">Rp <%= slip.base_salary.toLocaleString('id-ID') %></td></tr>
      <% if(slip.transport_allowance) { %><tr><td>Tunjangan Transport</td><td class="amount">Rp <%= slip.transport_allowance.toLocaleString('id-ID') %></td></tr><% } %>
      <% if(slip.meal_allowance) { %><tr><td>Tunjangan Makan</td><td class="amount">Rp <%= slip.meal_allowance.toLocaleString('id-ID') %></td></tr><% } %>
      <% if(slip.phone_allowance) { %><tr><td>Tunjangan Pulsa / Komunikasi</td><td class="amount">Rp <%= slip.phone_allowance.toLocaleString('id-ID') %></td></tr><% } %>
      <% if(slip.other_allowance) { %><tr><td>Tunjangan Lain (<%= slip.other_allowance_note || '-' %>)</td><td class="amount">Rp <%= slip.other_allowance.toLocaleString('id-ID') %></td></tr><% } %>
      <% if(slip.ticket_bonus) { %><tr><td>Bonus Performa Tiket (<%= slip.total_tickets_resolved || 0 %> Tiket Selesai)</td><td class="amount" style="color:#15803d">+Rp <%= slip.ticket_bonus.toLocaleString('id-ID') %></td></tr><% } %>
      <% if(slip.collection_commission) { %><tr><td>Komisi Penagihan Tagihan</td><td class="amount" style="color:#15803d">+Rp <%= slip.collection_commission.toLocaleString('id-ID') %></td></tr><% } %>
      <% if(slip.overtime_bonus) { %><tr><td>Bonus Lembur (<%= slip.overtime_hours || 0 %> Jam)</td><td class="amount" style="color:#15803d">+Rp <%= slip.overtime_bonus.toLocaleString('id-ID') %></td></tr><% } %>
      <tr style="font-weight:700;background:#f8fafc"><td>Total Pendapatan Kotor (Gross)</td><td class="amount">Rp <%= slip.gross_salary.toLocaleString('id-ID') %></td></tr>

      <% if(slip.total_deductions > 0) { %>
      <tr class="section-header"><td colspan="2"><i class="bi bi-dash-circle"></i> Potongan &amp; Pengurangan</td></tr>
      <% if(slip.absence_deduction) { %><tr><td>Potongan Ketidakhadiran (<%= slip.absent_days || 0 %> Hari)</td><td class="amount" style="color:#ef4444">-Rp <%= slip.absence_deduction.toLocaleString('id-ID') %></td></tr><% } %>
      <% if(slip.late_deduction) { %><tr><td>Potongan Keterlambatan (<%= slip.late_days || 0 %> Hari)</td><td class="amount" style="color:#ef4444">-Rp <%= slip.late_deduction.toLocaleString('id-ID') %></td></tr><% } %>
      <% if(slip.other_deduction) { %><tr><td>Potongan Kasbon / Lain (<%= slip.other_deduction_note || '-' %>)</td><td class="amount" style="color:#ef4444">-Rp <%= slip.other_deduction.toLocaleString('id-ID') %></td></tr><% } %>
      <tr style="font-weight:700;background:#f8fafc"><td>Total Seluruh Potongan</td><td class="amount" style="color:#ef4444">-Rp <%= slip.total_deductions.toLocaleString('id-ID') %></td></tr>
      <% } %>
    </tbody>
  </table>

  <!-- Box Gaji Bersih -->
  <div class="net-box">
    <div class="net-title">Gaji Bersih (Take Home Pay)</div>
    <div class="net-amount">Rp <%= slip.net_salary.toLocaleString('id-ID') %></div>
  </div>

  <% if(slip.notes) { %>
  <div style="font-size:11.5px;color:#475569;margin-bottom:20px;padding:10px 14px;background:#f8fafc;border-left:3px solid #4f46e5;border-radius:4px">
    <strong>Catatan Manajemen:</strong> <%= slip.notes %>
  </div>
  <% } %>

  <!-- Tanda Tangan -->
  <div class="footer">
    <div class="sign-box">
      <div class="sign-title">Penerima,</div>
      <div class="sign-line"><%= slip.employee_name %></div>
    </div>
    <div class="sign-box">
      <div class="sign-title">Disetujui Oleh,</div>
      <div class="sign-line">Manajemen / Admin</div>
    </div>
  </div>

  <div style="text-align:center;margin-top:25px;font-size:9.5px;color:#94a3b8">
    Dokumen ini dicetak secara komputerisasi dari Sistem Billing pada <%= (typeof getNowLocal === 'function') ? getNowLocal() : new Date().toLocaleString('id-ID') %> — Slip ID: #<%= slip.id %>
  </div>
</div>

<script>
  window.onload = function() {
    setTimeout(function() {
      if (!window.location.search.includes('noprint')) {
        // window.print(); // Uncomment jika ingin otomatis memunculkan jendela cetak saat dibuka
      }
    }, 400);
  };
</script>
</body>
</html>