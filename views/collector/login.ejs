<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> | <%= company %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <!-- ================================================================= -->
  <!-- [TAMBAHAN 1: ASET PWA, META STATUS BAR & STYLE TOMBOL KOLEKTOR]   -->
  <!-- ================================================================= -->
  <link rel="manifest" href="/manifest-collector.webmanifest">
  <meta name="theme-color" content="#0f172a">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="apple-touch-icon" href="/img/logo.png">
  <link rel="icon" href="/img/logo.png">

  <style>
    body{background:#0f172a;color:#e2e8f0}
    .card{background:rgba(30,41,59,.92);border:1px solid rgba(148,163,184,.18)}
    .form-control{background:rgba(15,23,42,.55);border:1px solid rgba(148,163,184,.18);color:#e2e8f0}
    .form-control:focus{box-shadow:none;border-color:rgba(99,102,241,.75)}

    /* Styling Tombol Install Aplikasi Kolektor */
    .btn-pwa-collector {
      background: rgba(245, 158, 11, 0.15);
      color: #fbbf24;
      border: 1px solid rgba(245, 158, 11, 0.4);
      border-radius: 8px;
      padding: 10px;
      font-size: 14px;
      font-weight: 700;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 12px;
      cursor: pointer;
      transition: all 0.25s ease;
    }
    .btn-pwa-collector:hover {
      background: #f59e0b;
      color: #0f172a;
      box-shadow: 0 4px 15px rgba(245, 158, 11, 0.4);
      transform: translateY(-1px);
    }
    .pwa-collector-modal {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(6px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 99999;
      padding: 20px;
    }
    .pwa-collector-modal.active { display: flex; }
    .pwa-collector-card {
      background: #1e293b;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 16px;
      max-width: 400px;
      width: 100%;
      padding: 24px;
      color: #f8fafc;
      text-align: left;
      box-shadow: 0 20px 40px rgba(0,0,0,0.6);
    }
    .pwa-step-collector {
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(148, 163, 184, 0.14);
      border-radius: 10px;
      padding: 12px;
      font-size: 12px;
      line-height: 1.6;
      margin-bottom: 10px;
      color: #cbd5e1;
    }
    .pwa-step-collector strong { color: #60a5fa; }
  </style>
</head>
<body>
  <div class="container" style="max-width:420px;padding-top:60px">
    <div class="mb-3 text-center">
      <div style="font-weight:800;letter-spacing:-.02em"><%= company %></div>
      <div class="text-secondary" style="font-size:12px">Portal Kolektor</div>
    </div>
    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>
    <div class="card p-3">
      <form method="POST" action="/collector/login">
        <div class="mb-3">
          <label class="form-label">Username</label>
          <input class="form-control" name="username" autocomplete="username" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Password</label>
          <input type="password" class="form-control" name="password" autocomplete="current-password" required>
        </div>
        <button class="btn btn-primary w-100" type="submit">Masuk</button>
      </form>

      <!-- ================================================================= -->
      <!-- [TAMBAHAN 2: TOMBOL INSTALL APLIKASI KOLEKTOR]                    -->
      <!-- ================================================================= -->
      <button type="button" id="btn-collector-install" class="btn-pwa-collector" onclick="triggerCollectorPwaInstall()">
        <i class="bi bi-download"></i> Install Aplikasi Kolektor
      </button>
    </div>
  </div>

  <!-- ================================================================= -->
  <!-- [TAMBAHAN 3: MODAL PANDUAN & SCRIPT LOGIKA PWA KOLEKTOR]          -->
  <!-- ================================================================= -->
  <div class="pwa-collector-modal" id="pwaCollectorModal">
    <div class="pwa-collector-card">
      <h6 class="fw-bold text-warning mb-2 d-flex align-items-center gap-2">
        <i class="bi bi-cash-stack"></i> Pasang Aplikasi Kolektor
      </h6>
      <p style="font-size:12px;color:#94a3b8;margin-bottom:14px">
        Akses data tagihan, catat pembayaran pelanggan di lapangan, dan cetak struk thermal langsung dari layar HP tanpa membuka browser.
      </p>

      <div class="pwa-step-collector">
        <strong><i class="bi bi-android2"></i> Android (Google Chrome):</strong><br>
        1. Ketuk icon titik tiga <strong>(⋮)</strong> di pojok kanan atas browser.<br>
        2. Pilih <strong>"Install Aplikasi"</strong> atau <strong>"Tambahkan ke Layar Utama"</strong>.<br>
        3. Konfirmasi dengan menekan tombol <strong>Install</strong>.
      </div>

      <div class="pwa-step-collector">
        <strong><i class="bi bi-apple"></i> iPhone / iPad (Safari):</strong><br>
        1. Ketuk tombol <strong>Bagikan / Share</strong> (<i class="bi bi-share"></i>).<br>
        2. Gulir ke bawah dan pilih <strong>"Add to Home Screen"</strong>.<br>
        3. Ketuk <strong>Add</strong> di pojok kanan atas.
      </div>

      <button type="button" class="btn btn-primary w-100 mt-2" onclick="closeCollectorPwaModal()">
        Mengerti, Tutup
      </button>
    </div>
  </div>

  <script>
    // [FUNGSI 1: PENANGKAP EVENT INSTALL BROWSER ANDROID]
    let deferredCollectorPrompt = null;
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredCollectorPrompt = e;
      const installBtn = document.getElementById('btn-collector-install');
      if (installBtn) {
        installBtn.style.boxShadow = '0 0 14px rgba(245, 158, 11, 0.45)';
      }
    });

    // [FUNGSI 2: PEMICU POPUP INSTALASI SAAT TOMBOL DIKLIK]
    function triggerCollectorPwaInstall() {
      if (deferredCollectorPrompt) {
        deferredCollectorPrompt.prompt();
        deferredCollectorPrompt.userChoice.then((choiceResult) => {
          if (choiceResult.outcome === 'accepted') {
            console.log('PWA Kolektor berhasil dipasang');
          }
          deferredCollectorPrompt = null;
        });
      } else {
        document.getElementById('pwaCollectorModal').classList.add('active');
      }
    }

    // [FUNGSI 3: PENUTUP MODAL PANDUAN]
    function closeCollectorPwaModal() {
      document.getElementById('pwaCollectorModal').classList.remove('active');
    }

    // [FUNGSI 4: PENDAFTARAN SERVICE WORKER SCOPE KOLEKTOR]
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js', { scope: '/collector' }).catch(() => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      });
    }

    // [FUNGSI 5: DETEKSI APLIKASI TELAH TERPASANG]
    window.addEventListener('appinstalled', () => {
      deferredCollectorPrompt = null;
      const installBtn = document.getElementById('btn-collector-install');
      if (installBtn) installBtn.style.display = 'none';
    });
  </script>
</body>
</html>